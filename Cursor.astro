---
// Silver star cursor with star-dust trail. Hidden on touch devices and for reduced motion (via global CSS).
---
<div class="comet-layer" aria-hidden="true">
<div id="dust-layer"></div>
<div class="cstar off" id="cstar">
<svg width="32" height="32" viewBox="0 0 24 24" style="overflow: visible">
<defs>
<linearGradient id="pf-silver" x1="0" y1="0" x2="1" y2="1">
<stop offset="0" stop-color="#FFFFFF"></stop>
<stop offset="0.45" stop-color="#D9DDE4"></stop>
<stop offset="0.7" stop-color="#A9AFB9"></stop>
<stop offset="1" stop-color="#E8EBF0"></stop>
</linearGradient>
</defs>
<path d="M12 0 C12.9 7.6 16.4 11.1 24 12 C16.4 12.9 12.9 16.4 12 24 C11.1 16.4 7.6 12.9 0 12 C7.6 11.1 11.1 7.6 12 0 Z" fill="url(#pf-silver)" stroke="#F4F5F7" stroke-width="0.4" stroke-linejoin="round"></path>
</svg>
</div>
</div>

<script>
  const star = document.getElementById('cstar') as HTMLElement | null;
  const layer = document.getElementById('dust-layer') as HTMLElement | null;
  if (star && layer && window.matchMedia('(hover: hover)').matches) {
    const tones = ['#F2F0F5', '#D9DDE4', '#B9BEC8'];
    const CONTENT = 'a, button, p, h1, h2, h3, nav, svg, img, label, input, .chip, .skill, .wcard, .tcard, .zcard, .sp-card, .dk-card';
    const m = { x: -100, y: -100 };
    const p = { x: -100, y: -100 };
    const st = { inside: false, rest: false, gone: false, hot: false, hide: false };
    type Dust = { el: HTMLSpanElement; x: number; y: number; vx: number; vy: number; born: number; life: number; seed: number };
    let dust: Dust[] = [];
    let raf = 0;
    let lastMove = 0;
    let restT: number | undefined, idleT: number | undefined, hideT: number | undefined;

    const paint = () => {
      star.className = 'cstar' + (st.hot ? ' hot' : '') + (st.hide ? ' hide' : '') + (st.rest ? ' rest' : '') + ((!st.inside || st.gone) ? ' off' : '');
    };

    const loop = (now: number) => {
      const dx = m.x - p.x, dy = m.y - p.y;
      p.x += dx * 0.3;
      p.y += dy * 0.3;
      const lag = Math.hypot(dx, dy);
      star.style.left = p.x.toFixed(1) + 'px';
      star.style.top = p.y.toFixed(1) + 'px';
      if (st.inside && !st.hide && now - lastMove < 80 && lag > 0.8) {
        const n = lag > 10 ? 2 : 1;
        for (let i = 0; i < n; i++) {
          const s = 0.8 + Math.random() * 1.3;
          const el = document.createElement('span');
          el.className = 'dust';
          el.style.width = el.style.height = s.toFixed(2) + 'px';
          el.style.margin = (-s / 2).toFixed(2) + 'px 0 0 ' + (-s / 2).toFixed(2) + 'px';
          el.style.backgroundColor = tones[Math.floor(Math.random() * tones.length)];
          layer.appendChild(el);
          dust.push({ el, x: p.x + (Math.random() - 0.5) * 6, y: p.y + (Math.random() - 0.5) * 6, vx: (Math.random() - 0.5) * 0.22, vy: 0.05 + Math.random() * 0.3, born: now, life: 650 + Math.random() * 650, seed: Math.random() * 6.28 });
        }
      }
      const keep: Dust[] = [];
      for (const d of dust) {
        const age = (now - d.born) / d.life;
        if (age >= 1) { d.el.remove(); continue; }
        d.x += d.vx; d.y += d.vy;
        const tw = 0.65 + 0.35 * Math.sin(age * 18 + d.seed);
        d.el.style.left = d.x.toFixed(1) + 'px';
        d.el.style.top = d.y.toFixed(1) + 'px';
        d.el.style.opacity = Math.max(0, (1 - age) * tw).toFixed(2);
        keep.push(d);
      }
      while (keep.length > 70) { const d = keep.shift(); d && d.el.remove(); }
      dust = keep;
      raf = (lag > 0.3 || dust.length) ? requestAnimationFrame(loop) : 0;
    };

    window.addEventListener('mousemove', (e) => {
      const tg = e.target as Element | null;
      const over = !!(tg && tg.closest && tg.closest(CONTENT));
      if (over) {
        if (!hideT && !st.hide) hideT = window.setTimeout(() => { hideT = undefined; st.hide = true; st.hot = false; paint(); }, 700);
      } else {
        clearTimeout(hideT); hideT = undefined;
        st.hide = false;
      }
      st.hot = !st.hide && !!(tg && tg.closest && tg.closest('a, button'));
      m.x = e.clientX; m.y = e.clientY;
      if (!st.inside || st.gone) { p.x = m.x; p.y = m.y; }
      lastMove = performance.now();
      st.inside = true; st.rest = false; st.gone = false;
      paint();
      clearTimeout(restT); restT = window.setTimeout(() => { st.rest = true; paint(); }, 220);
      clearTimeout(idleT); idleT = window.setTimeout(() => { st.gone = true; paint(); }, 5000);
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });

    document.documentElement.addEventListener('mouseleave', () => {
      for (const d of dust) d.el.remove();
      dust = [];
      clearTimeout(restT); clearTimeout(idleT); clearTimeout(hideT); hideT = undefined;
      st.inside = false; st.rest = false;
      paint();
    });
  }
</script>
