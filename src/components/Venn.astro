---
// Hero Venn (from the "kritikal marks" sheet): listens, thinks, solves, and a path forward where they meet.
// Hover a circle and it says "grab me"; grab one and flick it, it bounces off the edges and springs home.
// Wide stages (720px+) put the lower callouts to the sides; narrower ones put them under the diagram.
---
<div class="vn-stage" id="vn-stage">
<svg class="vn-svg" id="vn-svg" role="group" aria-label="Venn diagram: listens, thinks and solves. Where they meet: a path forward. Overlaps: research they can trust; a clear brief, gaps caught early; words people understand.">
<g id="vn-c"></g>
<g id="vn-dyn" style="pointer-events: none"></g>
</svg>
</div>

<script>
  const C = { fg: '#efefee', red: '#d2453f', gold: '#d8c9a3', mute: '#8a8d96' };
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NS = 'http://www.w3.org/2000/svg';
  const f = (n: number) => Math.round(n * 100) / 100;
  const stage = document.getElementById('vn-stage') as HTMLElement;
  const vsvg = document.getElementById('vn-svg') as unknown as SVGSVGElement;
  const vcg = document.getElementById('vn-c') as unknown as SVGGElement;
  const dyn = document.getElementById('vn-dyn') as unknown as SVGGElement;

  type Callout = { x: number; y: number; anc: string; lx: number; ly: number; lines: string[]; fs: number };
  const V = {
    W: 0, SH: 560, R: 130, desk: true, homes: [] as number[][], P: [] as number[][], vel: [] as number[][],
    drag: -1, gx: 0, gy: 0, px: 0, py: 0, pulses: [] as { x: number; y: number; t: number }[], off: [false, false, false],
    circles: [] as SVGCircleElement[], c: {} as Record<string, Callout>, hov: -1, hold: [0, 0, 0], act: [0, 0, 0], at: [0, 0, 0],
    fly: [-1, -1, -1], flash: [] as { s: string; p: number; t: number }[], hist: [] as number[][]
  };
  const NAMES = ['LISTENS', 'THINKS', 'SOLVES'];
  const DESC = [['curious how people', 'got to a conclusion'], ['spots the gaps,', 'tightens the thinking'], ['turns a goal into', 'a clear brief']];

  const layout = () => {
    const W = stage.getBoundingClientRect().width;
    if (!W) return false;
    if (V.homes.length && Math.abs(W - V.W) < 0.5) return false;
    V.W = W; V.desk = W >= 720;
    let R: number, cy: number, SH: number;
    const cx = W / 2;
    if (V.desk) { SH = 560; R = Math.min(132, (W - 380) / 3.15); cy = SH / 2 - 0.166 * R; }
    else { R = Math.min(112, (W - 32) * 0.3); cy = 78 + 1.332 * R; SH = 78 + 3 * R + 112; }
    R = Math.round(R); V.R = R; V.SH = SH; stage.style.height = SH + 'px';
    const s = 1.15 * R;
    V.homes = [[cx - s / 2, cy - 0.2887 * s], [cx + s / 2, cy - 0.2887 * s], [cx, cy + 0.5774 * s]].map((p) => [Math.round(p[0] / 18) * 18, Math.round(p[1] / 18) * 18]);
    V.P = V.homes.map((p) => p.slice());
    V.vel = [[0, 0], [0, 0], [0, 0]];
    V.off = [false, false, false]; V.pulses = []; V.drag = -1; V.fly = [-1, -1, -1]; V.flash = []; V.hist = []; V.hov = -1;
    const hy = (V.homes[0][1] + V.homes[1][1] + V.homes[2][1]) / 3;
    const topY = V.homes[0][1] - R, botY = V.homes[2][1] + R;
    const fs = V.desk ? 16 : 13;
    V.c.t = { x: cx, y: topY - 26, anc: 'middle', lx: cx, ly: topY - 14, lines: ['research they can trust'], fs };
    if (V.desk) {
      V.c.r = { x: cx + 1.78 * R, y: hy + 0.375 * R + 4, anc: 'start', lx: cx + 1.78 * R - 10, ly: hy + 0.375 * R - 1, lines: ['a clear brief,', 'gaps caught early'], fs };
      V.c.l = { x: cx - 1.78 * R, y: hy + 0.375 * R + 4, anc: 'end', lx: cx - 1.78 * R + 10, ly: hy + 0.375 * R - 1, lines: ['words people', 'understand'], fs };
    } else {
      V.c.r = { x: cx + 0.95 * R, y: botY + 36, anc: 'middle', lx: cx + 0.95 * R, ly: botY + 36 - fs - 6, lines: ['a clear brief,', 'gaps caught early'], fs };
      V.c.l = { x: cx - 0.95 * R, y: botY + 36, anc: 'middle', lx: cx - 0.95 * R, ly: botY + 36 - fs - 6, lines: ['words people', 'understand'], fs };
    }
    if (!V.circles.length) {
      for (let i = 0; i < 3; i++) {
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('class', 'vc');
        vcg.appendChild(c); V.circles.push(c);
      }
    }
    V.circles.forEach((c, i) => { c.setAttribute('r', String(R)); c.setAttribute('cx', String(f(V.P[i][0]))); c.setAttribute('cy', String(f(V.P[i][1]))); });
    return true;
  };

  const vtxt = (x: number, y: number, s: string, anc: string, ff: string, fs: number, fill: string, style: string) =>
    `<text x="${f(x)}" y="${f(y)}" text-anchor="${anc}" font-family="${ff}" font-size="${fs}" fill="${fill}" style="${style}">${s}</text>`;

  const renderDyn = (now: number) => {
    const R = V.R, P = V.P;
    let out = '';
    const g = [(P[0][0] + P[1][0] + P[2][0]) / 3, (P[0][1] + P[1][1] + P[2][1]) / 3];
    const anchor = (a: number, b: number, k: number) => {
      const mx = (P[a][0] + P[b][0]) / 2 - g[0], my = (P[a][1] + P[b][1]) / 2 - g[1];
      let l = Math.hypot(mx, my), ux: number, uy: number;
      if (l < 1) { ux = g[0] - P[k][0]; uy = g[1] - P[k][1]; l = Math.hypot(ux, uy) || 1; ux /= l; uy /= l; }
      else { ux = mx / l; uy = my / l; }
      return [g[0] + ux * 0.75 * R, g[1] + uy * 0.75 * R];
    };
    for (let i = 0; i < 3; i++) {
      const hx = V.homes[i][0], hy = V.homes[i][1];
      out += `<path d="M${f(hx - 4)} ${f(hy)}H${f(hx + 4)}M${f(hx)} ${f(hy - 4)}V${f(hy + 4)}" stroke="${C.gold}" stroke-width=".7" opacity=".55" fill="none"/>`;
    }
    ([[0, 1, 2, V.c.t], [1, 2, 0, V.c.r], [0, 2, 1, V.c.l]] as [number, number, number, Callout][]).forEach(([a0, b0, k0, c]) => {
      const a = anchor(a0, b0, k0);
      out += `<line x1="${f(a[0])}" y1="${f(a[1])}" x2="${f(c.lx)}" y2="${f(c.ly)}" stroke="${C.gold}" stroke-width=".7" opacity=".65"/><circle cx="${f(a[0])}" cy="${f(a[1])}" r="2.2" fill="${C.gold}"/>`;
      c.lines.forEach((s, j) => { out += vtxt(c.x, c.y + j * c.fs * 1.25, s, c.anc, 'Kalam, cursive', c.fs, C.gold, ''); });
    });
    const fsL = V.desk ? 13 : 11, fsD = 13;
    for (let i = 0; i < 3; i++) {
      const dx = P[i][0] - g[0], dy = P[i][1] - g[1], dl = Math.hypot(dx, dy) || 1;
      const lx = P[i][0] + dx / dl * 0.54 * R, ly = P[i][1] + dy / dl * 0.54 * R;
      out += vtxt(lx, ly, NAMES[i], 'middle', 'Commissioner, sans-serif', fsL, C.fg, 'letter-spacing:.16em;font-weight:600');
      if (V.desk) DESC[i].forEach((s, j) => { out += vtxt(lx, ly + fsD * 1.35 * (j + 1) + 2, s, 'middle', 'Kalam, cursive', fsD, C.mute, ''); });
    }
    const fc = Math.max(12, Math.min(16, R * 0.105));
    out += `<circle cx="${f(g[0])}" cy="${f(g[1] - fc * 1.25)}" r="3.6" fill="${C.red}"/>`;
    out += vtxt(g[0], g[1] + fc * 0.2, 'a path', 'middle', 'Newsreader, Georgia, serif', fc, C.gold, 'font-style:italic');
    out += vtxt(g[0], g[1] + fc * 1.45, 'forward', 'middle', 'Newsreader, Georgia, serif', fc, C.gold, 'font-style:italic');
    V.pulses = V.pulses.filter((p) => now - p.t < 450);
    V.pulses.forEach((p) => {
      const t = (now - p.t) / 450, e = 1 - Math.pow(1 - t, 3);
      out += `<circle cx="${f(p.x)}" cy="${f(p.y)}" r="${f(4 + 16 * e)}" fill="none" stroke="${C.gold}" stroke-width="1" opacity="${f(1 - t)}"/>`;
    });
    V.flash = V.flash.filter((e) => now - e.t < 380);
    V.flash.forEach((e) => {
      const t = (now - e.t) / 380, L = V.R * (1.3 - 0.5 * t), a = e.p - L / 2, b = e.p + L / 2, o = f(1 - t);
      const ln = e.s === 'l' ? [1.5, a, 1.5, b] : e.s === 'r' ? [V.W - 1.5, a, V.W - 1.5, b] : e.s === 't' ? [a, 1.5, b, 1.5] : [a, V.SH - 1.5, b, V.SH - 1.5];
      out += `<line x1="${f(ln[0])}" y1="${f(ln[1])}" x2="${f(ln[2])}" y2="${f(ln[3])}" stroke="${C.gold}" stroke-width="2.4" stroke-linecap="round" opacity="${o}"/>`;
    });
    dyn.innerHTML = out;
  };

  // Returns true while something is still moving, so the loop can rest when the diagram is still.
  const update = (dt: number, now: number) => {
    if (!V.homes.length) return false;
    const H = V.homes, R = V.R, lo = R + 2, hx = V.W - R - 2, hy = V.SH - R - 2;
    const steps = Math.max(1, Math.ceil(dt / 0.008)), h = dt / steps;
    let busy = V.pulses.length > 0 || V.flash.length > 0;
    for (let i = 0; i < 3; i++) {
      const P = V.P[i], v = V.vel[i];
      if (RM) {
        if (V.drag === i) { P[0] = Math.min(Math.max(V.px - V.gx, lo), hx); P[1] = Math.min(Math.max(V.py - V.gy, lo), hy); }
        else { P[0] = H[i][0]; P[1] = H[i][1]; }
        v[0] = 0; v[1] = 0;
      } else {
        for (let s = 0; s < steps; s++) {
          let tx = H[i][0], ty = H[i][1], k = 140, c = 12;
          if (V.drag === i) { tx = V.px - V.gx; ty = V.py - V.gy; k = 700; c = 46; }
          else if (V.fly[i] >= 0) { const q = Math.min(V.fly[i] / 1.5, 1); k = 6 + 134 * q * q; c = 1 + 11 * q; V.fly[i] += h; }
          v[0] += (k * (tx - P[0]) - c * v[0]) * h; v[1] += (k * (ty - P[1]) - c * v[1]) * h;
          P[0] += v[0] * h; P[1] += v[1] * h;
          if (P[0] < lo) { P[0] = lo; if (v[0] < 0) { if (-v[0] > 140) V.flash.push({ s: 'l', p: P[1], t: now }); v[0] = -v[0] * 0.82; } }
          if (P[0] > hx) { P[0] = hx; if (v[0] > 0) { if (v[0] > 140) V.flash.push({ s: 'r', p: P[1], t: now }); v[0] = -v[0] * 0.82; } }
          if (P[1] < lo) { P[1] = lo; if (v[1] < 0) { if (-v[1] > 140) V.flash.push({ s: 't', p: P[0], t: now }); v[1] = -v[1] * 0.82; } }
          if (P[1] > hy) { P[1] = hy; if (v[1] > 0) { if (v[1] > 140) V.flash.push({ s: 'b', p: P[0], t: now }); v[1] = -v[1] * 0.82; } }
        }
        if (V.fly[i] >= 1.5) V.fly[i] = -1;
      }
      const hd = Math.hypot(P[0] - H[i][0], P[1] - H[i][1]), sp = Math.hypot(v[0], v[1]);
      if (hd > 4) V.off[i] = true;
      else if (V.off[i] && V.drag !== i && V.fly[i] < 0 && hd < 0.7 && sp < 10) {
        V.off[i] = false; P[0] = H[i][0]; P[1] = H[i][1]; v[0] = 0; v[1] = 0;
        V.pulses.push({ x: H[i][0], y: H[i][1], t: now });
      }
      const want = (V.hov === i || V.drag === i || now < V.hold[i]) ? 1 : 0;
      V.act[i] += (want - V.act[i]) * (RM ? 1 : 1 - Math.exp(-dt * (want ? 9 : 5)));
      const ac = V.act[i], wg = RM ? 0 : 2.5 * Math.sin(V.at[i] * 28) * Math.exp(-V.at[i] * 7) * (ac > 0.01 ? 1 : 0), ce = V.circles[i];
      ce.setAttribute('cx', String(f(P[0] + wg))); ce.setAttribute('cy', String(f(P[1]))); ce.setAttribute('r', String(f(R + 3 * ac)));
      ce.style.stroke = `rgba(201,205,213,${f(0.6 + 0.4 * ac)})`; ce.style.fill = `rgba(201,205,213,${f(0.06 + 0.07 * ac)})`;
      if (V.act[i] > 0.01) V.at[i] += dt; else V.at[i] = 0;
      if (V.off[i] || V.drag === i || Math.abs(want - V.act[i]) > 0.005 || sp > 0.5) busy = true;
    }
    renderDyn(now);
    return busy;
  };

  const vpos = (e: PointerEvent) => { const r = stage.getBoundingClientRect(); V.px = e.clientX - r.left; V.py = e.clientY - r.top; };
  const nearest = () => {
    let best = -1, bd = 1e9;
    for (let i = 0; i < 3; i++) { const d = Math.hypot(V.px - V.P[i][0], V.py - V.P[i][1]); if (d < V.R && d < bd) { bd = d; best = i; } }
    return best;
  };
  stage.addEventListener('pointermove', (e) => {
    vpos(e);
    if (V.drag >= 0) { const n = performance.now(); V.hist.push([n, V.px, V.py]); while (V.hist.length && n - V.hist[0][0] > 90) V.hist.shift(); }
    else if (e.pointerType !== 'touch') V.hov = nearest();
    wake();
  });
  stage.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') { V.hov = -1; wake(); } });
  vsvg.addEventListener('pointerdown', (e) => {
    const t = e.target as Element;
    if (!t.classList || !t.classList.contains('vc')) return;
    vpos(e);
    const best = nearest();
    if (best < 0) return;
    V.drag = best; V.gx = V.px - V.P[best][0]; V.gy = V.py - V.P[best][1];
    V.fly[best] = -1; V.hist = [[performance.now(), V.px, V.py]];
    V.hold[best] = performance.now() + 900;
    try { t.setPointerCapture(e.pointerId); } catch { /* capture is optional */ }
    e.preventDefault();
    wake();
  });
  const vend = () => {
    const d = V.drag;
    if (d < 0) return;
    V.drag = -1;
    const hs = V.hist, n = hs.length;
    let vx = 0, vy = 0;
    if (n > 1) {
      const dtm = (hs[n - 1][0] - hs[0][0]) / 1000;
      if (dtm > 0.01) { vx = (hs[n - 1][1] - hs[0][1]) / dtm; vy = (hs[n - 1][2] - hs[0][2]) / dtm; }
    }
    let sp = Math.hypot(vx, vy);
    if (sp > 2600) { vx *= 2600 / sp; vy *= 2600 / sp; sp = 2600; }
    if (sp > 220 && !RM) { V.vel[d] = [vx, vy]; V.fly[d] = 0; }
    V.hist = [];
    wake();
  };
  vsvg.addEventListener('pointerup', vend);
  vsvg.addEventListener('pointercancel', vend);
  vsvg.addEventListener('lostpointercapture', vend);

  let raf = 0, last = 0;
  const frame = (now: number) => {
    const dt = Math.min((now - last) / 1000, 0.05); last = now;
    raf = update(dt, now) ? requestAnimationFrame(frame) : 0;
  };
  function wake() { if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } }

  const remeasure = () => { layout(); wake(); };
  if ('ResizeObserver' in window) new ResizeObserver(remeasure).observe(stage);
  else addEventListener('resize', remeasure);
  remeasure();
  if (document.fonts) document.fonts.ready.then(wake);
</script>
