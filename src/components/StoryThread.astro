<div class="tl-lead"><svg class="tl-thread" width="200" height="40" viewBox="0 0 200 40" aria-hidden="true"><path d={thread(200)} fill="none" stroke="rgb(210,69,63)" stroke-width="1.6" stroke-linecap="round"></path></svg></div>

