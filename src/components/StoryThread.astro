<script>
  // Each timeline on the page (option A and option B) runs on its own.
  document.querySelectorAll<HTMLElement>('.tl-wrap').forEach((wrap) => {
    const scroller = wrap.querySelector('.tl-scroller') as HTMLElement;
    const track = wrap.querySelector('.tl-track') as HTMLElement;
    const lead = wrap.querySelector('.tl-lead') as HTMLElement;
    const zoom = wrap.querySelector('.tl-zoom') as HTMLButtonElement;
    const items = Array.from(wrap.querySelectorAll<HTMLElement>('.tl-item'));
    const count = items.length;
    let active = 0;
    let zoomed = false;

    const left = (i: number) => items[i].offsetLeft - lead.offsetWidth;
    const goTo = (i: number) => scroller.scrollTo({ left: left(Math.max(0, Math.min(count - 1, i))), behavior: 'smooth' });

    const onScroll = () => {
      if (zoomed) return;
      let best = 0, dist = Infinity;
      items.forEach((_, i) => {
        const d = Math.abs(left(i) - scroller.scrollLeft);
        if (d < dist) { dist = d; best = i; }
      });
      active = best;
    };

    // Zoom out: scale the whole route down to fit the width, like the case study overview.
    const setZoom = (on: boolean, land?: number) => {
      zoomed = on;
      wrap.classList.toggle('zoomed', on);
      zoom.setAttribute('aria-pressed', String(on));
      zoom.textContent = on ? 'back to one moment' : 'see the whole route';
      if (on) {
        scroller.scrollLeft = 0;
        const s = scroller.clientWidth / track.scrollWidth;
        track.style.transform = `scale(${s})`;
        scroller.style.height = `${Math.ceil(740 * s)}px`;
      } else {
        track.style.transform = '';
        scroller.style.height = '';
        requestAnimationFrame(() => {
          scroller.scrollLeft = left(land ?? active);
          active = land ?? active;
        });
      }
    };

    scroller.addEventListener('scroll', onScroll, { passive: true });
    scroller.addEventListener('keydown', (e) => {
      if (zoomed) return;
      const keys: Record<string, number> = { ArrowRight: active + 1, ArrowLeft: active - 1, Home: 0, End: count - 1 };
      if (e.key in keys) { e.preventDefault(); goTo(keys[e.key]); }
    });
    items.forEach((it, i) => it.addEventListener('click', (e) => {
      if (!zoomed) return;
      e.preventDefault();
      setZoom(false, i);
    }));
    zoom.addEventListener('click', () => setZoom(!zoomed));
    window.addEventListener('resize', () => { if (zoomed) setZoom(true); });
  });
</script>
