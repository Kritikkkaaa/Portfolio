---
// Second fold: my scenic route. One red thread of milestones; detours wander off below the main road
// (which carries on as a dotted line) and come back. Each milestone: greyed date, what i did, what i learnt,
// and a small thing to play with beside the text. Text in [brackets] is a placeholder to fill in.
const ICP = '/work/icp-positioning-messaging-nexus';
const OPENING_W = 380;
const NODE = 28;
const RED = 'rgb(210,69,63)';

const straight = (w: number) => `M0 20 L${w} 20`;
const bumped = (w: number, n: number) =>
  `M0 20 C${n * 0.25} 20 ${n * 0.25} 15 ${n * 0.5} 15 S${n * 0.75} 20 ${n} 20 C${n + (w - n) * 0.25} 20 ${n + (w - n) * 0.25} 25 ${n + (w - n) * 0.5} 25 S${n + (w - n) * 0.75} 20 ${w} 20`;
// A detour: leaves the road, wanders along a wobbly path at depth D, and climbs back before the next milestone.
const wander = (w: number, nd: number, D: number) => {
  const y = 20 + D;
  const end = w - nd * 0.8;
  const step = 34;
  let d = `M0 20 C${nd * 0.55} 20 ${nd * 0.4} ${y} ${nd} ${y}`;
  let x = nd, k = 0;
  while (x + step < end) {
    const amp = (k % 2 ? -1 : 1) * (5 + (k % 3) * 2.5);
    d += ` Q${x + step / 2} ${y + amp} ${x + step} ${y}`;
    x += step; k++;
  }
  d += ` C${x + (w - x) * 0.45} ${y} ${x + (w - x) * 0.55} 20 ${w} 20`;
  return d;
};

type Milestone = { id: string; label: string; date: string; title: string; learnt: string; side: 'up' | 'down'; width: number; detour?: boolean; link?: { text: string; href?: string }; now?: boolean };
const milestones: Milestone[] = [
  { id: 'tedx', label: 'TEDx', date: 'apr 2022', title: 'TEDx', learnt: 'after leaving school, i helped organize a TEDx event.', side: 'up', width: 600 },
  { id: 'art', label: 'Art internship', date: '[mon yy] → [mon yy]', title: 'Art internship', learnt: 'i made sales calls on commission, and earned money doing it.', side: 'down', width: 600 },
  { id: 'cad', label: 'AutoCAD', date: '[mon yy]', title: 'AutoCAD, and other tools', learnt: 'i started learning AutoCAD and a handful of other tools.', side: 'down', width: 780, detour: true },
  { id: 'plane', label: 'Plane', date: '[mon yy] → [mon yy]', title: 'Plane', learnt: 'i joined as an intern and spent most of my time on cold outreach for discovery. Vihar introduced me to product. about eight months in, i moved into marketing and helped get the website launch over the line.', side: 'up', width: 640, link: { text: 'case study · soon' } },
  { id: 'ea', label: 'Freelance EA', date: '[mon yy] → [mon yy]', title: 'Freelance EA work', learnt: 'i learned about product, taste and community, and wrote some of my best work here.', side: 'down', width: 780, detour: true },
  { id: 'marmeto', label: 'Marmeto', date: '[mon yy] → [mon yy]', title: 'Marmeto', learnt: 'i joined as a PM and worked on the design system.', side: 'up', width: 600, link: { text: 'see my work on the design system · soon' } },
  { id: 'nexus', label: 'Nexus', date: '[mon yy] → [mon yy]', title: 'Nexus', learnt: 'i built it zero to one, then took it to market myself: every demo became a requirement, every requirement a sprint.', side: 'down', width: 640, link: { text: 'See how I found who Nexus is for', href: ICP } },
  { id: 'now', label: 'Now', date: 'now', title: 'i’m on the hunt again.', learnt: 'looking for the next place to build, and to be useful.', side: 'up', width: 600, now: true }
];
const DEPTH = 150;
const nodeX = (m: Milestone) => (m.detour ? Math.round(m.width * 0.16) : NODE);
const swatches = ['#E8EBF0', '#D8C9A3', '#9FB0C8', 'rgb(210,69,63)', '#3A3842'];
const quote = 'thinking and expressing what i think are two different things.'.split(' ');
const loop = ['demo', 'requirement', 'sprint'];
---
<section id="work" class="tl-wrap" aria-label="My scenic route">
<div class="tl-head">
<h2>My scenic route<span style="color: var(--tl-red)">.</span></h2>
<span class="hd-note">it was never a straight line</span>
<button type="button" class="tl-zoom" aria-pressed="false" aria-label="Zoom out to see the whole route" title="See the whole route">
<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 L20.5 20.5 M7.5 10.5 H13.5"></path><path class="zoom-plus" d="M10.5 7.5 V13.5"></path></svg>
</button>
</div>
<div class="tl-scroller" tabindex="0" role="region" aria-roledescription="timeline" aria-label="Timeline. Use the left and right arrow keys to move between milestones.">
<div class="tl-track">
<div class="tl-lead"><svg class="tl-thread" width="200" height="40" viewBox="0 0 200 40" aria-hidden="true"><path d={straight(200)} fill="none" stroke={RED} stroke-width="1.6" stroke-linecap="round"></path></svg></div>

<article class="tl-item tl-open" style={`width: ${OPENING_W}px`}>
<svg class="tl-thread" width={OPENING_W} height="40" viewBox={`0 0 ${OPENING_W} 40`} aria-hidden="true"><path d={straight(OPENING_W)} fill="none" stroke={RED} stroke-width="1.6" stroke-linecap="round"></path></svg>
<p class="tl-open-a">I turned 18 and dad said <em>College.</em></p>
</article>

{milestones.map((m, i) => (
<article class={`tl-item ${m.side}${m.now ? ' now' : ''}${m.detour ? ' detour' : ''}`} style={`width: ${m.width}px`} aria-label={m.detour ? `${m.label}, a detour` : m.label}>
<svg class="tl-thread" width={m.width} height="40" viewBox={`0 0 ${m.width} 40`} aria-hidden="true">
{m.detour ? <>
<path d={straight(m.width)} fill="none" stroke={RED} stroke-width="1.3" stroke-dasharray="4 6" opacity="0.7"></path>
<path d={wander(m.width, nodeX(m), DEPTH)} fill="none" stroke={RED} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
</> : <path d={bumped(m.width, NODE)} fill="none" stroke={RED} stroke-width="1.6" stroke-linecap="round"></path>}
</svg>
<span class="tl-node" style={`left: ${nodeX(m) - 7}px${m.detour ? `; top: ${343 + DEPTH}px` : ''}`}></span>
<span class="tl-idx" style={`left: ${nodeX(m) + 14}px${m.detour ? `; top: ${360 + DEPTH}px` : ''}`}>{String(i + 1).padStart(2, '0')}</span>
<div class="tl-card" style={`left: ${nodeX(m)}px; width: ${m.width - nodeX(m) - 36}px${m.detour ? `; top: ${350 + DEPTH}px` : ''}`}>
<div class="ms">
<div class="ms-text">
<div class="ms-date">{m.date}</div>
<h3>{m.title}</h3>
<p>{m.learnt}</p>
{m.link && (m.link.href
  ? <a class="ms-link" href={m.link.href}>{m.link.text}<span aria-hidden="true"> →</span></a>
  : <span class="ms-soon">{m.link.text}</span>)}
</div>

<div class="ms-toy">
{m.id === 'tedx' && <>
<button type="button" class="toy-ticket" aria-pressed="false" aria-label="Tear the ticket stub">
<span class="tt-main"><small>admit one</small><b>TEDx</b><span class="tt-stamp">admitted</span></span>
<span class="tt-stub">no. 001</span>
</button>
<span class="toy-hint">tear the stub</span>
</>}

{m.id === 'art' && <>
<button type="button" class="toy-tally" aria-label="Make a call. Calls made: 0">
<svg width="170" height="48" viewBox="0 0 170 48" aria-hidden="true"><g class="tally-marks"></g></svg>
<span class="tally-count">0 calls made</span>
</button>
<span class="toy-hint">click to make a call</span>
</>}

{m.id === 'cad' && <>
<div class="toy-cad">
<svg width="190" height="96" viewBox="0 0 190 96" aria-hidden="true">
<rect class="cad-box" x="14" y="10" width="110" height="46" fill="none" stroke="#C9CDD5" stroke-width="1.2"></rect>
<rect x="26" y="22" width="30" height="34" fill="none" stroke="#8A8D96" stroke-width="1" stroke-dasharray="3 3"></rect>
<line class="cad-dim" x1="14" y1="74" x2="124" y2="74" stroke={RED} stroke-width="1"></line>
<line x1="14" y1="62" x2="14" y2="80" stroke={RED} stroke-width="0.8"></line>
<line class="cad-tick" x1="124" y1="62" x2="124" y2="80" stroke={RED} stroke-width="0.8"></line>
<text class="cad-num" x="69" y="70" font-size="9" text-anchor="middle" fill="#C9CDD5" letter-spacing="1">1100</text>
</svg>
<span class="cad-handle" role="slider" tabindex="0" aria-label="Wall length" aria-valuemin="400" aria-valuemax="1600" aria-valuenow="1100"></span>
</div>
<span class="toy-hint">drag the corner</span>
</>}

{m.id === 'plane' && <>
<div class="toy-plane">
<div class="pl-labels"><span class="pl-a on"><b>intern</b>cold outreach for discovery</span><span class="pl-b"><b>marketing</b>website launch</span></div>
<input class="pl-range" type="range" min="0" max="100" value="0" aria-label="Slide from intern to marketing">
<span class="pl-mid">~ 8 months</span>
</div>
<span class="toy-hint">slide through it</span>
</>}

{m.id === 'ea' && <>
<button type="button" class="toy-quote" aria-pressed="false" aria-label="Thinking and expressing what i think are two different things. Click to put the words in order.">
{quote.map((w, k) => <span class="qw" style={`--qx: ${((k * 37) % 70) - 30}px; --qy: ${((k * 53) % 46) - 20}px; --qr: ${((k * 29) % 40) - 20}deg`}>{w}</span>)}
</button>
<span class="toy-hint">click to express it</span>
</>}

{m.id === 'marmeto' && <>
<div class="toy-tokens">
<div class="tk-swatches" role="group" aria-label="Colour tokens">
{swatches.map((c, k) => <button type="button" class={`tk-sw${k === 3 ? ' on' : ''}`} style={`background: ${c}`} data-c={c} aria-label={`Colour token ${k + 1}`}></button>)}
</div>
<div class="tk-space" role="group" aria-label="Spacing tokens">
{[4, 8, 12, 16].map((s, k) => <button type="button" class={`tk-sp${k === 2 ? ' on' : ''}`} data-s={s} aria-label={`Spacing ${s}`}><span style={`width: ${s}px; height: ${s}px`}></span></button>)}
</div>
<div class="tk-preview" style="--tk: rgb(210,69,63); --sp: 12px"><span class="tk-chip">button</span><span class="tk-chip ghost">button</span></div>
</div>
<span class="toy-hint">pick a token</span>
</>}

{m.id === 'nexus' && <>
<button type="button" class="toy-loop" aria-label="Turn the loop: demo, requirement, sprint">
<svg width="150" height="150" viewBox="0 0 150 150" aria-hidden="true">
<circle cx="75" cy="75" r="50" fill="none" stroke="#3A3842" stroke-width="1" stroke-dasharray="3 5"></circle>
<g class="lp-arrow"><path d="M75 25 A50 50 0 0 1 118 50" fill="none" stroke={RED} stroke-width="1.6" stroke-linecap="round"></path><path d="M118 50 l-8 -1 l5 -6 z" fill={RED}></path></g>
</svg>
{loop.map((l, k) => <span class={`lp-word w${k}${k === 0 ? ' on' : ''}`}>{l}</span>)}
</button>
<span class="toy-hint">turn the loop</span>
</>}

{m.id === 'now' && <>
<button type="button" class="toy-compass" aria-label="Spin the compass: where next?">
<svg width="120" height="120" viewBox="0 0 120 120" aria-hidden="true">
<circle cx="60" cy="60" r="46" fill="none" stroke="#3A3842" stroke-width="1"></circle>
<g fill="#8A8D96" font-size="8" letter-spacing="1" text-anchor="middle"><text x="60" y="22">N</text><text x="102" y="63">E</text><text x="60" y="106">S</text><text x="18" y="63">W</text></g>
<g class="cp-needle"><path d="M60 24 L65 60 L55 60 Z" fill={RED}></path><path d="M60 96 L65 60 L55 60 Z" fill="#C9CDD5"></path><circle cx="60" cy="60" r="3" fill="#141319" stroke="#C9CDD5"></circle></g>
</svg>
<span class="cp-out">where next?</span>
</button>
<span class="toy-hint">spin it</span>
</>}
</div>
</div>
</div>
</article>
))}

<div class="tl-tail" aria-hidden="true"></div>
</div>
</div>
</section>

<script>
  const wrap = document.querySelector('.tl-wrap') as HTMLElement;
  const scroller = wrap.querySelector('.tl-scroller') as HTMLElement;
  const track = wrap.querySelector('.tl-track') as HTMLElement;
  const lead = wrap.querySelector('.tl-lead') as HTMLElement;
  const zoom = wrap.querySelector('.tl-zoom') as HTMLButtonElement;
  const items = Array.from(wrap.querySelectorAll<HTMLElement>('.tl-item'));
  const count = items.length;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let active = 0;
  let zoomed = false;

  const left = (i: number) => items[i].offsetLeft - lead.offsetWidth;
  const goTo = (i: number) => scroller.scrollTo({ left: left(Math.max(0, Math.min(count - 1, i))), behavior: calm ? 'auto' : 'smooth' });
  scroller.addEventListener('scroll', () => {
    if (zoomed) return;
    let best = 0, dist = Infinity;
    items.forEach((_, i) => {
      const d = Math.abs(left(i) - scroller.scrollLeft);
      if (d < dist) { dist = d; best = i; }
    });
    active = best;
  }, { passive: true });
  scroller.addEventListener('keydown', (e) => {
    if (zoomed || (e.target as Element).closest('.ms-toy')) return;
    const keys: Record<string, number> = { ArrowRight: active + 1, ArrowLeft: active - 1, Home: 0, End: count - 1 };
    if (e.key in keys) { e.preventDefault(); goTo(keys[e.key]); }
  });

  // Zoom: the same magnifier as the case study. Minus shows the whole route; plus (or a click on a milestone) goes back in.
  const setZoom = (on: boolean, land?: number) => {
    zoomed = on;
    wrap.classList.toggle('zoomed', on);
    zoom.classList.toggle('in', on);
    zoom.setAttribute('aria-pressed', String(on));
    zoom.setAttribute('aria-label', on ? 'Zoom back in' : 'Zoom out to see the whole route');
    if (on) {
      scroller.scrollLeft = 0;
      const s = scroller.clientWidth / track.scrollWidth;
      track.style.transform = `scale(${s})`;
      scroller.style.height = `${Math.ceil(740 * s)}px`;
    } else {
      track.style.transform = '';
      scroller.style.height = '';
      if (land !== undefined) active = land;
      requestAnimationFrame(() => { scroller.scrollLeft = left(active); });
    }
  };
  zoom.addEventListener('click', () => setZoom(!zoomed));
  items.forEach((it, i) => it.addEventListener('click', (e) => {
    if (!zoomed) return;
    e.preventDefault();
    e.stopPropagation();
    setZoom(false, i);
  }, true));
  window.addEventListener('resize', () => { if (zoomed) setZoom(true); });

  // TEDx: tear the stub.
  wrap.querySelectorAll<HTMLButtonElement>('.toy-ticket').forEach((b) => b.addEventListener('click', () => {
    const on = !b.classList.contains('torn');
    b.classList.toggle('torn', on);
    b.setAttribute('aria-pressed', String(on));
  }));

  // Art internship: each click is a call; every fifth strikes through the group.
  wrap.querySelectorAll<HTMLButtonElement>('.toy-tally').forEach((b) => {
    const g = b.querySelector('.tally-marks') as SVGGElement;
    const out = b.querySelector('.tally-count') as HTMLElement;
    let n = 0;
    const NS = 'http://www.w3.org/2000/svg';
    const line = (x1: number, y1: number, x2: number, y2: number, red: boolean) => {
      const l = document.createElementNS(NS, 'line');
      Object.entries({ x1, y1, x2, y2 }).forEach(([k, v]) => l.setAttribute(k, String(v)));
      l.setAttribute('stroke', red ? 'rgb(210,69,63)' : '#C9CDD5');
      l.setAttribute('stroke-width', '1.6');
      l.setAttribute('stroke-linecap', 'round');
      l.classList.add('tally-new');
      g.appendChild(l);
    };
    b.addEventListener('click', () => {
      if (n >= 20) { n = 0; g.textContent = ''; }
      const grp = Math.floor(n / 5), k = n % 5, x0 = 6 + grp * 42;
      if (k < 4) line(x0 + k * 8, 8, x0 + k * 8, 40, false);
      else line(x0 - 4, 34, x0 + 30, 12, true);
      n++;
      out.textContent = `${n} call${n === 1 ? '' : 's'} made`;
      b.setAttribute('aria-label', `Make a call. Calls made: ${n}`);
    });
  });

  // AutoCAD: drag the corner to stretch the wall; the dimension follows.
  wrap.querySelectorAll<HTMLElement>('.toy-cad').forEach((t) => {
    const box = t.querySelector('.cad-box') as SVGRectElement;
    const dim = t.querySelector('.cad-dim') as SVGLineElement;
    const tick = t.querySelector('.cad-tick') as SVGLineElement;
    const num = t.querySelector('.cad-num') as SVGTextElement;
    const handle = t.querySelector('.cad-handle') as HTMLElement;
    const set = (w: number) => {
      w = Math.max(40, Math.min(160, w));
      const x2 = 14 + w;
      box.setAttribute('width', String(w));
      dim.setAttribute('x2', String(x2));
      tick.setAttribute('x1', String(x2));
      tick.setAttribute('x2', String(x2));
      num.setAttribute('x', String(14 + w / 2));
      num.textContent = String(w * 10);
      handle.style.left = `${x2}px`;
      handle.setAttribute('aria-valuenow', String(w * 10));
    };
    let dragging = false, startX = 0, startW = 110;
    handle.addEventListener('pointerdown', (e) => {
      dragging = true; startX = e.clientX; startW = Number(box.getAttribute('width'));
      handle.setPointerCapture(e.pointerId);
      e.stopPropagation();
    });
    handle.addEventListener('pointermove', (e) => { if (dragging) set(startW + (e.clientX - startX)); });
    handle.addEventListener('pointerup', () => { dragging = false; });
    handle.addEventListener('keydown', (e) => {
      const w = Number(box.getAttribute('width'));
      if (e.key === 'ArrowRight') { e.preventDefault(); set(w + 10); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); set(w - 10); }
    });
    set(110);
  });

  // Plane: slide from intern to marketing.
  wrap.querySelectorAll<HTMLElement>('.toy-plane').forEach((t) => {
    const r = t.querySelector('.pl-range') as HTMLInputElement;
    const a = t.querySelector('.pl-a') as HTMLElement;
    const b = t.querySelector('.pl-b') as HTMLElement;
    const paint = () => {
      const v = Number(r.value);
      r.style.setProperty('--v', `${v}%`);
      a.classList.toggle('on', v < 50);
      b.classList.toggle('on', v >= 50);
    };
    r.addEventListener('input', paint);
    r.addEventListener('pointerdown', (e) => e.stopPropagation());
    paint();
  });

  // Freelance EA: scattered thoughts fall into a sentence.
  wrap.querySelectorAll<HTMLButtonElement>('.toy-quote').forEach((b) => b.addEventListener('click', () => {
    const on = !b.classList.contains('said');
    b.classList.toggle('said', on);
    b.setAttribute('aria-pressed', String(on));
  }));

  // Marmeto: pick colour and spacing tokens; the sample buttons update.
  wrap.querySelectorAll<HTMLElement>('.toy-tokens').forEach((t) => {
    const prev = t.querySelector('.tk-preview') as HTMLElement;
    t.querySelectorAll<HTMLButtonElement>('.tk-sw').forEach((b) => b.addEventListener('click', () => {
      t.querySelectorAll('.tk-sw').forEach((x) => x.classList.toggle('on', x === b));
      prev.style.setProperty('--tk', b.dataset.c!);
    }));
    t.querySelectorAll<HTMLButtonElement>('.tk-sp').forEach((b) => b.addEventListener('click', () => {
      t.querySelectorAll('.tk-sp').forEach((x) => x.classList.toggle('on', x === b));
      prev.style.setProperty('--sp', `${b.dataset.s}px`);
    }));
  });

  // Nexus: demo → requirement → sprint, round and round.
  wrap.querySelectorAll<HTMLButtonElement>('.toy-loop').forEach((b) => {
    const arrow = b.querySelector('.lp-arrow') as SVGGElement;
    const words = Array.from(b.querySelectorAll<HTMLElement>('.lp-word'));
    let k = 0;
    b.addEventListener('click', () => {
      k++;
      arrow.style.transform = `rotate(${k * 120}deg)`;
      words.forEach((w, i) => w.classList.toggle('on', i === k % 3));
    });
  });

  // Now: spin the compass.
  wrap.querySelectorAll<HTMLButtonElement>('.toy-compass').forEach((b) => {
    const needle = b.querySelector('.cp-needle') as SVGGElement;
    const out = b.querySelector('.cp-out') as HTMLElement;
    const next = ['product', 'growth', 'GTM', 'positioning', 'somewhere new'];
    let turn = 0, last = -1;
    b.addEventListener('click', () => {
      let i = Math.floor(Math.random() * next.length);
      if (i === last) i = (i + 1) % next.length;
      last = i;
      turn += 720 + i * 72;
      needle.style.transform = `rotate(${turn}deg)`;
      out.textContent = '…';
      window.setTimeout(() => { out.textContent = `next: ${next[i]}`; }, calm ? 0 : 1100);
    });
  });
</script>
