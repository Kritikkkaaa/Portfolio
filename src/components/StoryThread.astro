<article class={`tl-item ${m.side}${m.now ? ' now' : ''}`} style={`width: ${m.width}px`} aria-label={m.label}>
<svg class="tl-thread" width={m.width} height="40" viewBox={`0 0 ${m.width} 40`} aria-hidden="true">
{m.detour ? <>
<path d={thread(m.width)} fill="none" stroke="rgb(210,69,63)" stroke-width="1.3" stroke-dasharray="4 6" opacity="0.7"></path>
<path d={detourThread(m.width, nodeX(m), m.detour)} fill="none" stroke="rgb(210,69,63)" stroke-width="1.6" stroke-linecap="round"></path>
</> : <path d={variant === 'loops' ? loopedThread(m.width, NODE, m.loops ?? [], m.side === 'up' ? 1 : -1) : thread(m.width, NODE)} fill="none" stroke="rgb(210,69,63)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
