<p>i joined as an intern and spent most of my time on cold outreach for discovery. Vihar introduced me to product.</p>
<p>about eight months in, i moved into marketing and helped get the website launch over the line.</p>
<div class="tl-mini" aria-hidden="true">
<div class="tl-mini-line"></div>
<div class="tl-mini-pt" style="left: 0"><b>intern</b><span>cold outreach for discovery</span></div>
<div class="tl-mini-pt" style="left: 100%; transform: translateX(-100%); align-items: flex-end; text-align: right"><b>marketing</b><span>website launch</span></div>
<span class="tl-mini-dot" style="left: 0"></span>
<span class="tl-mini-dot" style="left: 100%; margin-left: -7px"></span>
<span class="tl-mini-mid">~ 8 months</span>
</div>
<p class="tl-opens"><span>opened up</span> product, from the inside. <span class="tl-fill">[more]</span></p>
<span class="tl-soon">case study · soon</span>
</div>
<div class="tl-polaroid" aria-hidden="true">
<svg class="hd-pin" width="22" height="26" viewBox="0 0 22 26" style="position: absolute; left: 50%; top: -14px; margin-left: -11px; z-index: 1"><ellipse cx="13" cy="22" rx="6" ry="2" fill="rgba(0,0,0,0.45)"></ellipse><circle cx="11" cy="10" r="8" fill="rgb(210,69,63)"></circle><circle cx="8.5" cy="7.5" r="2.4" fill="rgba(255,255,255,0.35)"></circle><path d="M11 17 L11 24" stroke="rgb(169,175,185)" stroke-width="1.2"></path></svg>
<div class="tl-polaroid-img">[ photo ]</div>
<span>[ caption ]</span>
</div>
</div>}

{m.id === 'ea' && <>
<div class="tl-date"><span><span class="tl-fill">[mon yy]</span> → <span class="tl-fill">[mon yy]</span></span></div>
<h3>Freelance EA work</h3>
<p>i learned about product, taste and community, and wrote some of my best work here.</p>
<blockquote>thinking and expressing what i think are two different things.</blockquote>
<p class="tl-opens"><span>opened up</span> <span class="tl-fill">[what this opened up]</span></p>
</>}

{m.id === 'marmeto' && <>
<div class="tl-date"><span><span class="tl-fill">[mon yy]</span> → <span class="tl-fill">[mon yy]</span></span></div>
<h3>Marmeto</h3>
<p>i joined as a PM and worked on the design system.</p>
<div class="tl-tokens" aria-hidden="true">
{swatches.map((c, k) => <span style={`background: ${c}`}><i>--c-{k + 1}</i></span>)}
<div class="tl-scale">{[4, 8, 12, 16, 24].map((s) => <span style={`width: ${s}px; height: ${s}px`}></span>)}<small>space</small></div>
</div>
<span class="tl-soon">See my work on the design system · soon</span>
</>}

{m.id === 'nexus' && <div class="tl-nexus">
<div class="tl-nexus-text">
<div class="tl-date"><span><span class="tl-fill">[mon yy]</span> → <span class="tl-fill">[mon yy]</span></span></div>
<h3>Nexus</h3>
<p>i built it zero to one, then took it to market myself: every demo became a requirement, every requirement a sprint.</p>
<div class="tl-stats">
<div><b>250+</b><span>organic installs in launch week</span></div>
<div><b>65.5%</b><span>merchant activation, up from 32% in a week</span></div>
</div>
<a class="ft-secondary" href={ICP}>See how I found who Nexus is for<span aria-hidden="true">→</span></a>
</div>
<figure class="tl-fig">
<img src="/case/icp-nexus/icp-table.png" alt="The Nexus ideal customer profile: business, Shopify plan, region, trigger moment and job to be done, each with its evidence." width="1084" height="660" loading="lazy">
<figcaption>final ICP!</figcaption>
</figure>
</div>}

{m.id === 'now' && <>
<div class="tl-date"><span>now</span></div>
<h3>i’m on the hunt again.</h3>
<p>looking for the next place to build, and to be useful. <span class="tl-fill">[what i’m looking for]</span></p>
</>}

</div>
</article>
))}

<div class="tl-tail" aria-hidden="true"></div>
</div>

<div class="tl-controls">
<button class="tl-btn" id="tl-prev" type="button" aria-label="Previous moment" disabled>←</button>
<div class="tl-dots" role="tablist" aria-label="Moments">
{labels.map((l, i) => <button class={`tl-dot${i === 0 ? ' on' : ''}`} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={l} title={l} data-i={i}></button>)}
</div>
<button class="tl-btn" id="tl-next" type="button" aria-label="Next moment">→</button>
<span class="tl-count" id="tl-count" data-labels={JSON.stringify(labels)}><b>00</b> / {String(labels.length - 1).padStart(2, '0')} · start</span>
</div>
</section>

<script>
  const scroller = document.getElementById('tl-scroller') as HTMLElement;
  const lead = document.getElementById('tl-lead') as HTMLElement;
  const prev = document.getElementById('tl-prev') as HTMLButtonElement;
  const next = document.getElementById('tl-next') as HTMLButtonElement;
  const counter = document.getElementById('tl-count') as HTMLElement;
  const labels: string[] = JSON.parse(counter.dataset.labels!);
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.tl-dot'));
  const items = Array.from(scroller.querySelectorAll<HTMLElement>('.tl-item'));
  const count = items.length;
  const total = String(count - 1).padStart(2, '0');
  let active = 0;

  const left = (i: number) => items[i].offsetLeft - lead.offsetWidth;
  const goTo = (i: number) => scroller.scrollTo({ left: left(Math.max(0, Math.min(count - 1, i))), behavior: 'smooth' });

  const paint = () => {
    prev.disabled = active === 0;
    next.disabled = active === count - 1;
    dots.forEach((d, i) => {
      d.classList.toggle('on', i === active);
      d.setAttribute('aria-selected', String(i === active));
    });
    counter.innerHTML = `<b>${String(active).padStart(2, '0')}</b> / ${total} · ${labels[active]}`;
  };
  const onScroll = () => {
    let best = 0, dist = Infinity;
    items.forEach((_, i) => {
      const d = Math.abs(left(i) - scroller.scrollLeft);
      if (d < dist) { dist = d; best = i; }
    });
    if (best !== active) { active = best; paint(); }
  };

  scroller.addEventListener('scroll', onScroll, { passive: true });
  scroller.addEventListener('keydown', (e) => {
    const keys: Record<string, number> = { ArrowRight: active + 1, ArrowLeft: active - 1, Home: 0, End: count - 1 };
    if (e.key in keys) { e.preventDefault(); goTo(keys[e.key]); }
  });
  prev.addEventListener('click', () => goTo(active - 1));
  next.addEventListener('click', () => goTo(active + 1));
  dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
  paint();
</script>
