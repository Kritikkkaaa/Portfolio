---
import Milestone from './Milestone.astro';
// Second fold: my scenic route. One red thread of milestones. Detours wander off the main road (which carries on
// as a dotted line) and come back; a stretch of two jobs at once splits into two strands until Marmeto.
// Each milestone: greyed date, what i did, what i learnt, and a small thing to play with beside the text.
const ICP = '/work/icp-positioning-messaging-nexus';
const NODE = 28;
const D = 80;
const RED = 'rgb(210,69,63)';

const straight = (w: number) => `M0 20 L${w} 20`;
const bumped = (w: number, n: number) =>
  `M0 20 C${n * 0.25} 20 ${n * 0.25} 15 ${n * 0.5} 15 S${n * 0.75} 20 ${n} 20 C${n + (w - n) * 0.25} 20 ${n + (w - n) * 0.25} 25 ${n + (w - n) * 0.5} 25 S${n + (w - n) * 0.75} 20 ${w} 20`;
// Leaves the road, wanders along a wobbly path D away (dir -1 = above, 1 = below), and comes back at the far end.
const wander = (w: number, nd: number, dir: number) => {
  const y = 20 + dir * D;
  const end = w - nd * 0.8;
  const step = 34;
  let d = `M0 20 C${nd * 0.55} 20 ${nd * 0.4} ${y} ${nd} ${y}`;
  let x = nd, k = 0;
  while (x + step < end) {
    const amp = (k % 2 ? -1 : 1) * (5 + (k % 3) * 2.5);
    d += ` Q${x + step / 2} ${y + amp} ${x + step} ${y}`;
    x += step; k++;
  }
  return d + ` C${x + (w - x) * 0.45} ${y} ${x + (w - x) * 0.55} 20 ${w} 20`;
};

type Toy = 'ticket' | 'phone' | 'plan' | 'ui' | 'kanban' | 'landing' | 'kitchen' | 'tabs' | 'taste' | 'cart' | 'quote' | 'tokens' | 'priority' | 'compass';
type Card = { date: string; title: string; learnt: string; toy: Toy; link?: { text: string; href?: string } };
type Stop = { kind: 'road' | 'detour' | 'split'; side?: 'up' | 'down'; width: number; label: string; cards: Card[] };
const stops: Stop[] = [
  { kind: 'road', side: 'up', width: 330, label: 'TEDx', cards: [{ date: 'jul 2021', title: 'Curated a 6 hour long TEDx event', learnt: '120 attendees, 9 speakers, 5.5 lacs in sponsorships and <em>10k steps</em> daily.', toy: 'ticket' }] },
  { kind: 'road', side: 'down', width: 520, label: 'GTM intern', cards: [{ date: 'may 2022', title: 'GTM Intern making Cold calls', learnt: 'Found out that I am very good at understanding what people want and how to give it to them.', toy: 'phone' }] },
  { kind: 'road', side: 'up', width: 605, label: 'Plane', cards: [{ date: 'mar → jul 2023', title: 'First real job at Plane!', learnt: 'What is product? What is first principles thinking, and why does any of it matter?', toy: 'kanban' }] },
  { kind: 'road', side: 'down', width: 560, label: 'Product Marketing Engineer', cards: [{ date: 'aug 2023 → may 2024', title: 'Product Marketing Engineer', learnt: 'Everything from landing pages, documents, community management. I did my best work at Plane!', toy: 'landing' }] },
  { kind: 'detour', side: 'up', width: 680, label: 'Freelancing', cards: [{ date: 'jun → dec 2025', title: 'Freelancing', learnt: 'I found out that I am a good writer with horrible grammar! Also that, bringing people together over food is an art I want to practice. Learnt to form not just thoughts, but opinions.', toy: 'kitchen' }] },
  { kind: 'road', side: 'up', width: 560, label: 'Nexus', cards: [{ date: 'aug 2025 → sep 2026', title: 'Built a marketplace app from scratch!', learnt: 'Learnt how to care for opinions and egos, how to build a product magnified, why build scalable systems and manage my first team.', toy: 'tabs', link: { text: 'See how I found who Nexus is for', href: ICP } }] },
  { kind: 'road', side: 'down', width: 480, label: 'Next gig', cards: [{ date: '', title: 'Making my next gig happen!', learnt: '', toy: 'compass' }] }
];
let n = 0;
const numbered = stops.map((s) => ({ ...s, nums: s.cards.map(() => String(++n).padStart(2, '0')) }));
const nodeX = (s: Stop) => (s.kind === 'road' ? NODE : Math.round(s.width * 0.1));
---
<section id="work" class="tl-wrap" aria-label="My journey so far">
<div class="tl-head">
<h2>My journey so far!</h2>
<span class="hd-note">it was never a straight line</span>
</div>
<div class="tl-scroller" tabindex="0" role="region" aria-roledescription="timeline" aria-label="Timeline. Use the left and right arrow keys to move between milestones.">
<div class="tl-track">
<div class="tl-lead"><svg class="tl-thread" width="200" height="40" viewBox="0 0 200 40" aria-hidden="true"><path d={straight(200)} fill="none" stroke={RED} stroke-width="1.6" stroke-linecap="round"></path></svg></div>


{numbered.map((s) => {
  const nx = nodeX(s);
  const cw = s.width - nx - 36;
  // Each card on this stop: which side of the road it hangs, and how far off the road its strand runs.
  const placed = s.kind === 'split'
    ? [{ c: s.cards[0], side: 'up', off: -D, num: s.nums[0] }, { c: s.cards[1], side: 'down', off: D, num: s.nums[1] }]
    : [{ c: s.cards[0], side: s.side!, off: s.kind === 'detour' ? (s.side === 'up' ? -D : D) : 0, num: s.nums[0] }];
  return (
<article class={`tl-item ${s.kind}${s.side ? ' ' + s.side : ''}`} style={`width: ${s.width}px`} aria-label={s.kind === 'road' ? s.label : `${s.label}, off the main road`}>
<svg class="tl-thread" width={s.width} height="40" viewBox={`0 0 ${s.width} 40`} aria-hidden="true">
{s.kind === 'road' && <path d={bumped(s.width, NODE)} fill="none" stroke={RED} stroke-width="1.6" stroke-linecap="round"></path>}
{s.kind === 'detour' && <>
<path d={straight(s.width)} fill="none" stroke={RED} stroke-width="1.3" stroke-dasharray="4 6" opacity="0.7"></path>
<path d={wander(s.width, nx, s.side === 'up' ? -1 : 1)} fill="none" stroke={RED} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
</>}
{s.kind === 'split' && <>
<path d={straight(s.width)} fill="none" stroke={RED} stroke-width="1.3" stroke-dasharray="4 6" opacity="0.7"></path>
<path d={wander(s.width, nx, -1)} fill="none" stroke={RED} stroke-width="1.6" stroke-dasharray="5 5" stroke-linecap="round"></path>
<path d={wander(s.width, nx, 1)} fill="none" stroke={RED} stroke-width="1.6" stroke-dasharray="5 5" stroke-linecap="round"></path>
</>}
</svg>
{placed.map((p) => <>
<span class="tl-node" style={`left: ${nx - 7}px; top: ${343 + p.off}px`}></span>
<div class={`tl-card ${p.side}`} style={`left: ${nx}px; width: ${cw}px; ${p.side === 'up' ? `bottom: ${390 - p.off}px` : `top: ${350 + p.off}px`}`}>
<Milestone c={p.c} />
</div>
</>)}
</article>
  );
})}

<div class="tl-tail"><p class="tl-close">Every detour i took, brought me to <em>marketing</em> anyway!</p></div>
</div>
</div>
<div class="rv" id="rv" hidden>
<svg class="rv-line" aria-hidden="true"></svg>
{numbered.map((s, i) => s.cards.map((c, k) => <div class="rv-card" data-stop={i} data-k={k} data-kind={s.kind}><Milestone c={c} /></div>))}
<p class="rv-close">Every detour i took, brought me to <em>marketing</em> anyway!</p>
</div>
<div class="tl-cta">
<a class="ft-secondary" href="/work">See my work<span aria-hidden="true">→</span></a>
<a class="tl-resume" href="https://drive.google.com/file/d/1IPT2eeox1bCwBc_nGS3Vlu_2IADxWtbV?utm_source=portfolio&utm_medium=scenic-route&utm_campaign=hunt-2026&utm_id=kritikal-work" target="_blank" rel="noopener">See resume</a>
</div>
</section>

<script>
  const wrap = document.querySelector('.tl-wrap') as HTMLElement;
  const scroller = wrap.querySelector('.tl-scroller') as HTMLElement;
  const lead = wrap.querySelector('.tl-lead') as HTMLElement;
  const zoom = wrap.querySelector('.tl-zoom') as HTMLButtonElement | null;
  const items = Array.from(wrap.querySelectorAll<HTMLElement>('.tl-item'));
  const count = items.length;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let active = 0;
  let zoomed = false;

  // On short windows the timeline shrinks a little (never below 80%) so the heading, the route and the buttons fit together.
  const fit = () => {
    const z = innerWidth < 900 ? 1 : Math.max(0.8, Math.min(1, (innerHeight - 250) / 640));
    scroller.style.setProperty('zoom', z === 1 ? '' : String(z));
  };
  fit();
  window.addEventListener('resize', fit);

  const left = (i: number) => items[i].offsetLeft - lead.offsetWidth;
  const goTo = (i: number) => scroller.scrollTo({ left: left(Math.max(0, Math.min(count - 1, i))), behavior: calm ? 'auto' : 'smooth' });
  scroller.addEventListener('scroll', () => {
    if (zoomed) return;
    let best = 0, dist = Infinity;
    items.forEach((_, i) => {
      const d = Math.abs(left(i) - scroller.scrollLeft);
      if (d < dist) { dist = d; best = i; }
    });
    active = best;
  }, { passive: true });
  scroller.addEventListener('keydown', (e) => {
    if (zoomed || (e.target as Element).closest('.ms-toy')) return;
    const keys: Record<string, number> = { ArrowRight: active + 1, ArrowLeft: active - 1, Home: 0, End: count - 1 };
    if (e.key in keys) { e.preventDefault(); goTo(keys[e.key]); }
  });

  // Zoom: the same magnifier as the case study. Minus shows the whole route; plus (or a click on a milestone) goes back in.
  // Zoomed out: the timeline fades away and the route is laid out as a river, three stops per row,
  // snaking left to right, then right to left. Cards stay full size; the fold grows as tall as it needs.
  const river = document.getElementById('rv') as HTMLElement;
  const line = river.querySelector('.rv-line') as SVGSVGElement;
  const rcards = Array.from(river.querySelectorAll<HTMLElement>('.rv-card'));
  const rclose = river.querySelector('.rv-close') as HTMLElement;
  const RD = 44, PER = 3, RED = 'rgb(210,69,63)';
  const wob = (x0: number, x1: number, y: number) => {
    const dir = x1 > x0 ? 1 : -1, step = 30 * dir;
    let d = '', x = x0, k = 0;
    while ((x1 - (x + step)) * dir > 0) { const a = (k % 2 ? -1 : 1) * (4 + (k % 3) * 2); d += ` Q${x + step / 2} ${y + a} ${x + step} ${y}`; x += step; k++; }
    return d + ` L${x1} ${y}`;
  };
  // A stretch of road through one cell that leaves the line by dy, wanders, and comes back.
  const offroad = (xa: number, xb: number, y: number, dy: number) => {
    const dir = xb > xa ? 1 : -1, ramp = 34 * dir, yy = y + dy;
    return `M${xa} ${y} C${xa + ramp * 0.6} ${y} ${xa + ramp * 0.4} ${yy} ${xa + ramp} ${yy}` + wob(xa + ramp, xb - ramp, yy) + ` C${xb - ramp * 0.4} ${yy} ${xb - ramp * 0.6} ${y} ${xb} ${y}`;
  };
  const layoutRiver = () => {
    const W = river.clientWidth, colW = W / PER, pad = 18, cardW = Math.min(colW - 56, 340);
    const stops: { kind: string; cards: HTMLElement[] }[] = [];
    rcards.forEach((c) => {
      const i = Number(c.dataset.stop);
      (stops[i] ||= { kind: c.dataset.kind!, cards: [] }).cards.push(c);
      c.style.width = cardW + 'px';
    });
    const rows = Math.ceil(stops.length / PER);
    let top = 24, paths = '', nodes = '';
    for (let r = 0; r < rows; r++) {
      const ltr = r % 2 === 0;
      const idx = stops.map((_, i) => i).slice(r * PER, r * PER + PER);
      const col = (j: number) => (ltr ? j : PER - 1 - j);
      const cellX = (j: number) => col(j) * colW;
      // Room above the line: a detour bump, or the upper card of a split.
      let above = RD + 30;
      idx.forEach((i) => { if (stops[i].kind === 'split') above = Math.max(above, RD + 24 + stops[i].cards[0].offsetHeight); });
      const y = top + above;
      let below = 0;
      idx.forEach((i, j) => {
        const s = stops[i], x0 = cellX(j), nx = x0 + pad + 6;
        const place = (c: HTMLElement, cy: number, up: boolean) => {
          c.classList.toggle('up', up);
          c.style.left = nx + 'px';
          c.style.top = (up ? cy - c.offsetHeight : cy) + 'px';
          nodes += `<circle cx="${nx}" cy="${cy}" r="6" fill="${RED}" stroke="rgb(20,20,22)" stroke-width="4"/>`;
          if (!up) below = Math.max(below, cy + c.offsetHeight - y);
        };
        if (s.kind === 'split') { place(s.cards[0], y - RD, true); place(s.cards[1], y + RD, false); }
        else if (s.kind === 'detour') place(s.cards[0], y - RD, false);
        else place(s.cards[0], y, false);
      });
      // The road for this row, travelling in its direction; detour and split cells leave the line.
      const xs = (j: number) => (ltr ? cellX(j) : cellX(j) + colW), xe = (j: number) => (ltr ? cellX(j) + colW : cellX(j));
      idx.forEach((i, j) => {
        const k = stops[i].kind, a = xs(j), b = xe(j);
        if (k === 'road') paths += `<path d="M${a} ${y} L${b} ${y}" stroke="${RED}" stroke-width="1.6" fill="none"/>`;
        else {
          paths += `<path d="M${a} ${y} L${b} ${y}" stroke="${RED}" stroke-width="1.3" stroke-dasharray="4 6" opacity=".7" fill="none"/>`;
          const dash = k === 'split' ? ' stroke-dasharray="5 5"' : '';
          paths += `<path d="${offroad(a, b, y, -RD)}" stroke="${RED}" stroke-width="1.6"${dash} fill="none" stroke-linecap="round"/>`;
          if (k === 'split') paths += `<path d="${offroad(a, b, y, RD)}" stroke="${RED}" stroke-width="1.6"${dash} fill="none" stroke-linecap="round"/>`;
        }
      });
      const nextTop = y + Math.max(below, 60) + 60;
      if (r < rows - 1) {
        // Turn down at the row's end into the next row's line.
        const edge = ltr ? W : 0, out = ltr ? 1 : -1;
        let nAbove = RD + 30;
        stops.slice((r + 1) * PER, (r + 2) * PER).forEach((s) => { if (s.kind === 'split') nAbove = Math.max(nAbove, RD + 24 + s.cards[0].offsetHeight); });
        const ny = nextTop + nAbove;
        paths += `<path d="M${edge} ${y} C${edge + out * 70} ${y} ${edge + out * 70} ${ny} ${edge} ${ny}" stroke="${RED}" stroke-width="1.6" fill="none"/>`;
      } else {
        // The route ends here: a short dotted tail off the last row, and the closing line under it.
        const end = ltr ? W : 0, out = ltr ? -1 : 1;
        paths += `<path d="M${end} ${y} l${-out * 40} 0" stroke="${RED}" stroke-width="1.3" stroke-dasharray="4 6" opacity=".7" fill="none"/>`;
        rclose.style.top = (nextTop - 20) + 'px';
        rclose.style.left = ltr ? 'auto' : '0';
        rclose.style.right = ltr ? '0' : 'auto';
        top = nextTop - 20 + rclose.offsetHeight + 40;
        break;
      }
      top = nextTop;
    }
    river.style.height = top + 'px';
    line.setAttribute('viewBox', `0 0 ${W} ${top}`);
    line.style.height = top + 'px';
    line.innerHTML = paths + nodes;
  };
  const setZoom = (on: boolean) => {
    zoomed = on;
    zoom?.classList.toggle('in', on);
    zoom?.setAttribute('aria-pressed', String(on));
    zoom?.setAttribute('aria-label', on ? 'Back to the timeline' : 'Zoom out to see the whole route');
    const show = on ? river : scroller, hide = on ? scroller : river;
    hide.classList.add('fading');
    window.setTimeout(() => {
      hide.hidden = true;
      hide.classList.remove('fading');
      show.hidden = false;
      show.classList.add('fading');
      if (on) layoutRiver();
      requestAnimationFrame(() => show.classList.remove('fading'));
      wrap.classList.toggle('zoomed', on);
    }, calm ? 0 : 220);
  };
  zoom?.addEventListener('click', () => setZoom(!zoomed));
  window.addEventListener('resize', () => { if (zoomed) layoutRiver(); });

  const each = <T extends HTMLElement>(sel: string, fn: (el: T) => void) => wrap.querySelectorAll<T>(sel).forEach(fn);
  const toggle = (b: HTMLElement, cls: string) => {
    const on = !b.classList.contains(cls);
    b.classList.toggle(cls, on);
    b.setAttribute('aria-pressed', String(on));
  };

  // TEDx: tear the stub.
  each<HTMLButtonElement>('.toy-ticket', (b) => b.addEventListener('click', () => toggle(b, 'torn')));

  // Sales intern: the phone rings and says hello.
  each<HTMLButtonElement>('.toy-phone', (b) => {
    let hang = 0;
    b.addEventListener('click', () => {
      window.clearTimeout(hang);
      b.classList.remove('ring', 'said');
      void b.offsetWidth;
      b.classList.add('ring', 'said');
      hang = window.setTimeout(() => b.classList.remove('ring', 'said'), calm ? 2400 : 2700);
    });
  });

  // AutoCAD: start in the nuances, step back to the bird's eye view.
  each<HTMLButtonElement>('.toy-plan', (b) => b.addEventListener('click', () => {
    toggle(b, 'away');
    (b.querySelector('.plan-cap') as HTMLElement).textContent = b.classList.contains('away') ? 'bird’s eye · 1:200' : '1:20';
  }));

  // Plane: a small marketing board. Click a card to send it to the next column, or drag it where it should go.
  each<HTMLElement>('.toy-kanban', (t) => {
    const cards = Array.from(t.querySelectorAll<HTMLButtonElement>('.kb-card'));
    const names = ['to do', 'in progress', 'done'];
    const PITCH = 88, TOP = 26, ROW = 30;
    const col = cards.map((c) => Number(c.dataset.col));
    let order = cards.map((_, i) => i);
    let dragging: HTMLButtonElement | null = null;
    const paint = () => {
      const rows = [0, 0, 0];
      order.forEach((i) => {
        const c = cards[i];
        c.classList.toggle('done', col[i] === 2);
        c.setAttribute('aria-label', `${c.textContent}, ${names[col[i]]}. Click to move it to ${names[(col[i] + 1) % 3]}.`);
        if (c === dragging) return;
        c.style.left = `${col[i] * PITCH + 4}px`;
        c.style.top = `${TOP + rows[col[i]] * ROW}px`;
        rows[col[i]]++;
      });
    };
    const place = (i: number, to: number) => { col[i] = to; order = [...order.filter((x) => x !== i), i]; paint(); };
    let mute = false;
    cards.forEach((c, i) => {
      c.addEventListener('click', () => { if (!mute) place(i, (col[i] + 1) % 3); });
      c.addEventListener('pointerdown', (e) => {
        if (e.button) return;
        const x0 = e.clientX, y0 = e.clientY, l0 = parseFloat(c.style.left), t0 = parseFloat(c.style.top);
        let moved = false;
        c.setPointerCapture(e.pointerId);
        const move = (m: PointerEvent) => {
          const dx = m.clientX - x0, dy = m.clientY - y0;
          if (!moved && Math.hypot(dx, dy) < 6) return;
          moved = true; dragging = c; c.classList.add('drag');
          c.style.left = `${l0 + dx}px`; c.style.top = `${t0 + dy}px`;
        };
        const up = () => {
          c.removeEventListener('pointermove', move); c.removeEventListener('pointerup', up); c.removeEventListener('pointercancel', up);
          if (!moved) return;
          const to = Math.max(0, Math.min(2, Math.round((parseFloat(c.style.left) - 4) / PITCH)));
          dragging = null; c.classList.remove('drag');
          mute = true; window.setTimeout(() => { mute = false; }, 0);
          place(i, to);
        };
        c.addEventListener('pointermove', move); c.addEventListener('pointerup', up); c.addEventListener('pointercancel', up);
      });
    });
    paint();
  });

  // Freelancing: click to pause or play the six panel picture.
  each<HTMLButtonElement>('.toy-kt', (b) => b.addEventListener('click', () => toggle(b, 'paused')));

  // Marketplace app: tabs of the workspace (board, Slack, docs, Notion) switch on their own, or on a click.
  each<HTMLElement>('.toy-tabs', (t) => {
    const tabs = Array.from(t.querySelectorAll<HTMLButtonElement>('.tb-tab'));
    const panes = Array.from(t.querySelectorAll<HTMLElement>('.tb-pane'));
    tabs.forEach((b, i) => b.addEventListener('click', () => {
      tabs.forEach((x, j) => { x.classList.toggle('on', j === i); x.setAttribute('aria-selected', String(j === i)); });
      panes.forEach((x, j) => x.classList.toggle('on', j === i));
    }));
  });

  // Product Marketing Engineer: a landing page wireframe fills in and becomes the real page.
  each<HTMLButtonElement>('.toy-wf', (b) => b.addEventListener('click', () => toggle(b, 'built')));

  // Product Marketing Engineer: the same headline, with more taste each click.
  each<HTMLButtonElement>('.toy-taste', (b) => {
    const lines = ['Project management software for teams.', 'Plan, track and ship, together.', 'The open-source alternative to Jira.'];
    const words = ['bland', 'better', 'sharp'];
    const head = b.querySelector('.ta-head') as HTMLElement;
    const fill = b.querySelector('.ta-fill') as HTMLElement;
    const label = b.querySelector('.ta-label b') as HTMLElement;
    let i = 0;
    b.addEventListener('click', () => {
      i = (i + 1) % lines.length;
      head.classList.remove('in');
      void head.offsetWidth;
      head.textContent = lines[i];
      head.classList.add('in');
      fill.style.width = `${[18, 58, 96][i]}%`;
      label.textContent = words[i];
    });
  });

  // Shopify agency: add to cart, the item drops into the bag.
  each<HTMLElement>('.toy-cart', (t) => {
    const add = t.querySelector('.ct-add') as HTMLButtonElement;
    const bag = t.querySelector('.ct-bag') as HTMLElement;
    const num = t.querySelector('.ct-count') as HTMLElement;
    let c = 0;
    add.addEventListener('click', () => {
      const dot = document.createElement('span');
      dot.className = 'ct-fly';
      t.appendChild(dot);
      const a = add.getBoundingClientRect(), z = bag.getBoundingClientRect(), o = t.getBoundingClientRect();
      dot.style.left = `${a.left - o.left + a.width / 2}px`;
      dot.style.top = `${a.top - o.top}px`;
      dot.style.setProperty('--dx', `${z.left - a.left - a.width / 2 + z.width / 2}px`);
      dot.style.setProperty('--dy', `${z.top - a.top + 6}px`);
      window.setTimeout(() => {
        dot.remove();
        num.textContent = String(++c);
        bag.classList.remove('bump');
        void bag.offsetWidth;
        bag.classList.add('bump');
      }, calm ? 0 : 650);
    });
  });

  // EA: scattered thoughts fall into a sentence.
  each<HTMLButtonElement>('.toy-quote', (b) => b.addEventListener('click', () => toggle(b, 'said')));

  // Marmeto: pick colour and spacing tokens; the sample buttons update.
  each<HTMLElement>('.toy-tokens', (t) => {
    const prev = t.querySelector('.tk-preview') as HTMLElement;
    t.querySelectorAll<HTMLButtonElement>('.tk-sw').forEach((b) => b.addEventListener('click', () => {
      t.querySelectorAll('.tk-sw').forEach((x) => x.classList.toggle('on', x === b));
      prev.style.setProperty('--tk', b.dataset.c!);
    }));
    t.querySelectorAll<HTMLButtonElement>('.tk-sp').forEach((b) => b.addEventListener('click', () => {
      t.querySelectorAll('.tk-sp').forEach((x) => x.classList.toggle('on', x === b));
      prev.style.setProperty('--sp', `${b.dataset.s}px`);
    }));
  });

  // Nexus: click a ticket to make it P0; the rest move down.
  each<HTMLElement>('.toy-priority', (t) => {
    const cards = Array.from(t.querySelectorAll<HTMLButtonElement>('.pr-ticket'));
    let order = cards.map((_, i) => i);
    const paint = () => order.forEach((ci, pos) => {
      cards[ci].style.top = `${pos * 40}px`;
      (cards[ci].querySelector('.pr-p') as HTMLElement).textContent = `P${pos}`;
      cards[ci].classList.toggle('top', pos === 0);
    });
    cards.forEach((c, ci) => c.addEventListener('click', () => {
      order = [ci, ...order.filter((x) => x !== ci)];
      paint();
    }));
    paint();
  });

  // Next gig: spin the compass.
  each<HTMLButtonElement>('.toy-compass', (b) => {
    const needle = b.querySelector('.cp-needle') as SVGGElement;
    const next = ['product', 'growth', 'GTM', 'positioning', 'somewhere new'];
    let turn = 0, last = -1;
    b.addEventListener('click', () => {
      let i = Math.floor(Math.random() * next.length);
      if (i === last) i = (i + 1) % next.length;
      last = i;
      turn += 720 + i * 72;
      needle.style.transform = `rotate(${turn}deg)`;
    });
  });

  // Idle demos: while a toy is on screen it plays its own trick on a slow loop, like a short video, so it is clear it can be played with.
  // It stops for good the moment someone touches that toy, waits while the pointer is over it, and stays still with reduced motion.
  if (!calm) {
    const press = (el: Element | null) => (el as HTMLElement | null)?.click();
    const demos: Record<string, { every: number; step: (box: HTMLElement, k: number) => void }> = {
      '.toy-ticket': { every: 2800, step: (b) => press(b.querySelector('.toy-ticket')) },
      '.toy-phone': { every: 4200, step: (b) => press(b.querySelector('.toy-phone')) },
      '.toy-kanban': { every: 1700, step: (b, k) => { const c = b.querySelectorAll('.kb-card'); press(c[(k * 2) % c.length]); } },
      '.toy-tabs': { every: 2600, step: (b, k) => { const t = b.querySelectorAll('.tb-tab'); press(t[(k + 1) % t.length]); } },
      '.toy-wf': { every: 3200, step: (b) => press(b.querySelector('.toy-wf')) },
      '.toy-taste': { every: 2600, step: (b) => press(b.querySelector('.toy-taste')) },
      '.toy-quote': { every: 3200, step: (b) => press(b.querySelector('.toy-quote')) },
      '.toy-compass': { every: 4600, step: (b) => press(b.querySelector('.toy-compass')) },
      '.toy-tokens': { every: 1500, step: (b, k) => {
        const sw = b.querySelectorAll('.tk-sw'), sp = b.querySelectorAll('.tk-sp');
        press(k % 2 ? sp[(k >> 1) % sp.length] : sw[(k >> 1) % sw.length]);
      } },
      '.toy-priority': { every: 2400, step: (b) => {
        const lowest = Array.from(b.querySelectorAll<HTMLElement>('.pr-ticket')).sort((x, y) => parseInt(y.style.top) - parseInt(x.style.top))[0];
        press(lowest);
      } },
    };
    wrap.querySelectorAll<HTMLElement>('.ms-toy').forEach((box) => {
      const sel = Object.keys(demos).find((s) => box.querySelector(s));
      if (!sel) return;
      const demo = demos[sel];
      let timer = 0, first = 0, k = 0, over = false, done = false;
      const tick = () => { if (!over && !done && !document.hidden) demo.step(box, k++); };
      const stop = () => { window.clearInterval(timer); window.clearTimeout(first); timer = first = 0; };
      const start = () => { if (timer || done) return; first = window.setTimeout(tick, 900); timer = window.setInterval(tick, demo.every); };
      new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.6 }).observe(box);
      box.addEventListener('pointerenter', () => { over = true; });
      box.addEventListener('pointerleave', () => { over = false; });
      const touched = (e: Event) => { if (e.isTrusted) { done = true; stop(); } };
      box.addEventListener('pointerdown', touched);
      box.addEventListener('keydown', touched);
    });
  }
</script>
