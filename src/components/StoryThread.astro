---
// Second fold: my scenic route, as a horizontal thread of moments. Option A loops and knots; option B branches off on detours.
// Ported from the Alloy prototype (StoryThread.tsx). Text in [brackets] is a placeholder to fill in.
interface Props { variant?: 'loops' | 'detours'; first?: boolean }
const { variant = 'loops', first = true } = Astro.props;
const ICP = '/work/icp-positioning-messaging-nexus';
const OPENING_W = 600;
const NODE = 28;

const thread = (w: number, n?: number) =>
  n === undefined
    ? `M0 20 L${w} 20`
    : `M0 20 C${n * 0.25} 20 ${n * 0.25} 15 ${n * 0.5} 15 S${n * 0.75} 20 ${n} 20 C${n + (w - n) * 0.25} 20 ${n + (w - n) * 0.25} 25 ${n + (w - n) * 0.5} 25 S${n + (w - n) * 0.75} 20 ${w} 20`;

// A loop: the thread doubles back on itself at cx, curling to the free side of the card (dir 1 = down, -1 = up).
type Loop = { at: number; r: number };
const loopPath = (cx: number, r: number, dir: number) => {
  const b = 20 + dir * 2.2 * r;
  return `L${cx - r} 20 C${cx + 1.7 * r} 20 ${cx + 1.7 * r} ${b} ${cx} ${b} C${cx - 1.7 * r} ${b} ${cx - 1.4 * r} ${20 - dir * 0.4 * r} ${cx + r} 20`;
};
const loopedThread = (w: number, n: number, loops: Loop[], dir: number) => {
  const bump = `M0 20 C${n * 0.25} 20 ${n * 0.25} 15 ${n * 0.5} 15 S${n * 0.75} 20 ${n} 20`;
  return bump + loops.map((l) => loopPath(l.at * w, l.r, dir)).join(' ') + ` L${w} 20`;
};
// A detour: the thread leaves the main line, runs at depth D, and comes back before the next moment.
const detourThread = (w: number, nd: number, D: number) =>
  `M0 20 C${nd * 0.55} 20 ${nd * 0.45} ${20 + D} ${nd} ${20 + D} L${w - nd} ${20 + D} C${w - nd * 0.45} ${20 + D} ${w - nd * 0.55} 20 ${w} 20`;

type Moment = { id: string; label: string; width: number; side: string; now?: boolean; loops?: Loop[]; detour?: number };
const base: Moment[] = [
  { id: 'tedx', label: 'TEDx', width: 400, side: 'up' },
  { id: 'art', label: 'Art internship', width: 420, side: 'down' },
  { id: 'cad', label: 'AutoCAD', width: 400, side: 'up' },
  { id: 'plane', label: 'Plane', width: 700, side: 'down' },
  { id: 'ea', label: 'Freelance EA', width: 480, side: 'up' },
  { id: 'marmeto', label: 'Marmeto', width: 460, side: 'down' },
  { id: 'nexus', label: 'Nexus', width: 820, side: 'up' },
  { id: 'now', label: 'Now', width: 440, side: 'down', now: true }
];
// Option A: loops and knots between moments (one big loop = a turn, two small ones = a knot).
const loopsA: Record<string, Loop[]> = {
  tedx: [{ at: 0.72, r: 26 }],
  art: [{ at: 0.6, r: 10 }, { at: 0.66, r: 10 }],
  cad: [{ at: 0.7, r: 34 }],
  plane: [{ at: 0.82, r: 22 }],
  ea: [{ at: 0.62, r: 11 }, { at: 0.68, r: 11 }],
  marmeto: [{ at: 0.74, r: 30 }],
  nexus: [{ at: 0.9, r: 18 }]
};
// Option B: AutoCAD and Freelance EA sit on side branches below the main line.
const DETOUR = 96;
const moments: Moment[] = base.map((m) => {
  if (variant === 'loops') return { ...m, loops: loopsA[m.id] ?? [] };
  if (m.id === 'cad') return { ...m, side: 'down', width: 540, detour: DETOUR };
  if (m.id === 'ea') return { ...m, side: 'down', width: 640, detour: DETOUR };
  return m;
});
const nodeX = (m: Moment) => (m.detour ? Math.round(m.width * 0.2) : NODE);
const tag = variant === 'loops' ? 'A' : 'B';
const swatches = ['#E8EBF0', '#C9CDD5', '#8A8D96', '#3A3842', '#141319'];
---
<section id={first ? 'work' : undefined} class="tl-wrap" aria-label={`My scenic route, option ${tag}`}>
