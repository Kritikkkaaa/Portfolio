---
// Second fold: how i got into product, as a horizontal thread of moments.
// Ported from the Alloy prototype (StoryThread.tsx). Text in [brackets] is a placeholder to fill in.
const ICP = '/work/icp-positioning-messaging-nexus';
const OPENING_W = 600;
const NODE = 28;

const thread = (w: number, n?: number) =>
  n === undefined
    ? `M0 20 L${w} 20`
    : `M0 20 C${n * 0.25} 20 ${n * 0.25} 15 ${n * 0.5} 15 S${n * 0.75} 20 ${n} 20 C${n + (w - n) * 0.25} 20 ${n + (w - n) * 0.25} 25 ${n + (w - n) * 0.5} 25 S${n + (w - n) * 0.75} 20 ${w} 20`;

const moments = [
  { id: 'tedx', label: 'TEDx', width: 400, side: 'up' },
  { id: 'art', label: 'Art internship', width: 420, side: 'down' },
  { id: 'cad', label: 'AutoCAD', width: 400, side: 'up' },
  { id: 'plane', label: 'Plane', width: 700, side: 'down' },
  { id: 'ea', label: 'Freelance EA', width: 480, side: 'up' },
  { id: 'marmeto', label: 'Marmeto', width: 460, side: 'down' },
  { id: 'nexus', label: 'Nexus', width: 820, side: 'up' },
  { id: 'now', label: 'Now', width: 440, side: 'down', now: true }
];
const labels = ['start', ...moments.map((m) => m.label)];
const swatches = ['#E8EBF0', '#C9CDD5', '#8A8D96', '#3A3842', '#141319'];
---
<section id="work" class="tl-wrap" aria-label="How I got into product">
<div class="tl-scroller" id="tl-scroller" tabindex="0" role="region" aria-roledescription="timeline" aria-label="Timeline. Use the left and right arrow keys to move between moments.">
<div class="tl-lead" id="tl-lead"><svg class="tl-thread" width="200" height="40" viewBox="0 0 200 40" aria-hidden="true"><path d={thread(200)} fill="none" stroke="rgb(210,69,63)" stroke-width="1.6" stroke-linecap="round"></path></svg></div>

<article class="tl-item tl-open" style={`width: ${OPENING_W}px`}>
<svg class="tl-thread" width={OPENING_W} height="40" viewBox={`0 0 ${OPENING_W} 40`} aria-hidden="true"><path d={thread(OPENING_W)} fill="none" stroke="rgb(210,69,63)" stroke-width="1.6" stroke-linecap="round"></path></svg>
<p class="tl-open-a">I was an adult.</p>
<p class="tl-open-b">I was out of school.</p>
</article>

{moments.map((m, i) => (
<article class={`tl-item ${m.side}${m.now ? ' now' : ''}`} style={`width: ${m.width}px`} aria-label={m.label}>
<svg class="tl-thread" width={m.width} height="40" viewBox={`0 0 ${m.width} 40`} aria-hidden="true"><path d={thread(m.width, NODE)} fill="none" stroke="rgb(210,69,63)" stroke-width="1.6" stroke-linecap="round"></path></svg>
<span class="tl-node" style={`left: ${NODE - 7}px`}></span>
<span class="tl-idx" style={`left: ${NODE + 14}px`}>{String(i + 1).padStart(2, '0')}</span>
<div class="tl-card" style={`left: ${NODE}px; width: ${m.width - NODE - 36}px`}>

{m.id === 'tedx' && <>
<div class="tl-date"><span>apr 2022</span><em>tentative</em></div>
<h3>TEDx</h3>
<p>after leaving school, i helped organize a TEDx event.</p>
<div class="tl-ticket" aria-hidden="true"><div class="tl-ticket-main"><small>admit one</small><b>TEDx<span>[ event ]</span></b></div><div class="tl-ticket-stub">x</div></div>
<p class="tl-opens"><span>opened up</span> <span class="tl-fill">[what this opened up]</span></p>
</>}

{m.id === 'art' && <>
<div class="tl-date"><span><span class="tl-fill">[mon yy]</span> → <span class="tl-fill">[mon yy]</span></span></div>
<h3><span class="tl-fill">[internship name, from LinkedIn]</span></h3>
<p>the art internship. i made sales calls on commission, and earned money doing it.</p>
<svg class="tl-art" width="150" height="46" viewBox="0 0 150 46" aria-hidden="true">
{[0, 1, 2, 3].map((k) => <line x1={8 + k * 11} y1="6" x2={8 + k * 11} y2="30" stroke="#C9CDD5" stroke-width="1.5" stroke-linecap="round"></line>)}
<line x1="2" y1="26" x2="48" y2="10" stroke="rgb(210,69,63)" stroke-width="1.5" stroke-linecap="round"></line>
{[0, 1, 2].map((k) => <line x1={66 + k * 11} y1="6" x2={66 + k * 11} y2="30" stroke="#C9CDD5" stroke-width="1.5" stroke-linecap="round"></line>)}
<text x="2" y="44" font-size="8.5" letter-spacing="1.6" fill="#8A8D96">CALLS MADE</text>
</svg>
<p class="tl-opens"><span>opened up</span> <span class="tl-fill">[what this opened up]</span></p>
</>}

{m.id === 'cad' && <>
<div class="tl-date"><span><span class="tl-fill">[mon yy]</span></span></div>
<h3>AutoCAD, and other tools</h3>
<p>i started learning AutoCAD and a handful of other tools.</p>
<svg class="tl-art" width="170" height="74" viewBox="0 0 170 74" aria-hidden="true">
<rect x="14" y="8" width="120" height="40" fill="none" stroke="#C9CDD5" stroke-width="1.2"></rect>
<rect x="26" y="20" width="30" height="28" fill="none" stroke="#8A8D96" stroke-width="1" stroke-dasharray="3 3"></rect>
<circle cx="104" cy="28" r="9" fill="none" stroke="#8A8D96" stroke-width="1"></circle>
<line x1="14" y1="62" x2="134" y2="62" stroke="rgb(210,69,63)" stroke-width="1"></line>
<path d="M14 62 l6 -3 v6 z M134 62 l-6 -3 v6 z" fill="rgb(210,69,63)"></path>
<line x1="14" y1="50" x2="14" y2="68" stroke="rgb(210,69,63)" stroke-width="0.8"></line>
<line x1="134" y1="50" x2="134" y2="68" stroke="rgb(210,69,63)" stroke-width="0.8"></line>
<text x="74" y="58" font-size="8.5" text-anchor="middle" fill="#C9CDD5" letter-spacing="1">1200</text>
</svg>
<p class="tl-opens"><span>why i started</span> <span class="tl-fill">[what made me start]</span></p>
</>}

{m.id === 'plane' && <div class="tl-plane">
<div class="tl-plane-text">
<div class="tl-date"><span><span class="tl-fill">[mon yy]</span> → <span class="tl-fill">[mon yy]</span></span></div>
