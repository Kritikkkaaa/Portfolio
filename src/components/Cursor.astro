---
// Silver star cursor, a pond-ripple wobble on the sky behind it, and a light wobble on text under it.
// Hidden on touch devices and for reduced motion (via global CSS and the media checks below).
---
<svg class="fx-defs" aria-hidden="true" width="0" height="0" focusable="false">
<filter id="pond" primitiveUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
<feFlood flood-color="rgb(128,128,128)" result="flat"></feFlood>
<feImage class="pond-drop" x="-999" y="-999" width="1" height="1" preserveAspectRatio="none" result="r0"></feImage>
<feImage class="pond-drop" x="-999" y="-999" width="1" height="1" preserveAspectRatio="none" result="r1"></feImage>
<feImage class="pond-drop" x="-999" y="-999" width="1" height="1" preserveAspectRatio="none" result="r2"></feImage>
<feImage class="pond-drop" x="-999" y="-999" width="1" height="1" preserveAspectRatio="none" result="r3"></feImage>
<feMerge result="map"><feMergeNode in="flat"></feMergeNode><feMergeNode in="r0"></feMergeNode><feMergeNode in="r1"></feMergeNode><feMergeNode in="r2"></feMergeNode><feMergeNode in="r3"></feMergeNode></feMerge>
<feDisplacementMap id="pond-amp" in="SourceGraphic" in2="map" scale="0" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
</filter>
<filter id="wob" x="-5%" y="-20%" width="110%" height="140%" color-interpolation-filters="sRGB">
<feTurbulence id="wob-noise" type="fractalNoise" baseFrequency="0.015 0.05" numOctaves="1" seed="3" result="n"></feTurbulence>
<feDisplacementMap id="wob-amp" in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
</filter>
</svg>

<div class="comet-layer" aria-hidden="true">
<div class="cstar off" id="cstar">
<svg width="32" height="32" viewBox="0 0 24 24" style="overflow: visible">
<defs>
<linearGradient id="pf-silver" x1="0" y1="0" x2="1" y2="1">
<stop offset="0" stop-color="#FFFFFF"></stop>
<stop offset="0.45" stop-color="#D9DDE4"></stop>
<stop offset="0.7" stop-color="#A9AFB9"></stop>
<stop offset="1" stop-color="#E8EBF0"></stop>
</linearGradient>
</defs>
<path d="M12 0 C12.9 7.6 16.4 11.1 24 12 C16.4 12.9 12.9 16.4 12 24 C11.1 16.4 7.6 12.9 0 12 C7.6 11.1 11.1 7.6 12 0 Z" fill="url(#pf-silver)" stroke="#F4F5F7" stroke-width="0.4" stroke-linejoin="round"></path>
</svg>
</div>
</div>

<script>
  const star = document.getElementById('cstar') as HTMLElement | null;
  const fine = window.matchMedia('(hover: hover)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (star && fine) {
    const CONTENT = 'a, button, p, h1, h2, h3, nav, svg, img, label, input, .chip, .skill, .wcard, .tcard, .zcard, .sp-card, .dk-card';
    const m = { x: -100, y: -100 };
    const p = { x: -100, y: -100 };
    const st = { inside: false, rest: false, gone: false, hot: false, hide: false };
    let raf = 0;
    let restT: number | undefined, idleT: number | undefined, hideT: number | undefined;

    const paint = () => {
      star.className = 'cstar' + (st.hot ? ' hot' : '') + (st.hide ? ' hide' : '') + (st.rest ? ' rest' : '') + ((!st.inside || st.gone) ? ' off' : '');
    };

    // Pond: each drop is a ring-shaped displacement map that spreads out from where the cursor passed.
    const sky = document.querySelector<HTMLElement>('.space');
    const amp = document.getElementById('pond-amp');
    const slots = Array.from(document.querySelectorAll<SVGFEImageElement>('.pond-drop'));
    const drops: { x: number; y: number; born: number }[] = [];
    let energy = 0;
    let lastDrop = { x: -999, y: -999 };
    const ripple = (() => {
      const n = 128, c = document.createElement('canvas');
      c.width = c.height = n;
      const ctx = c.getContext('2d');
      if (!ctx) return '';
      const img = ctx.createImageData(n, n);
      for (let j = 0; j < n; j++) for (let i = 0; i < n; i++) {
        const x = (i + 0.5) / n * 2 - 1, y = (j + 0.5) / n * 2 - 1, r = Math.hypot(x, y) || 1e-6;
        const w = r < 1 ? Math.sin(r * Math.PI * 5) * Math.sin(r * Math.PI) : 0;
        const k = (j * n + i) * 4;
        img.data[k] = Math.round(128 + 127 * w * x / r);
        img.data[k + 1] = Math.round(128 + 127 * w * y / r);
        img.data[k + 2] = 128;
        img.data[k + 3] = 255;
      }
      ctx.putImageData(img, 0, 0);
      return c.toDataURL();
    })();
    const pond = !calm && !!(sky && amp && ripple && slots.length);
    if (pond) slots.forEach((s) => s.setAttribute('href', ripple));
    const LIFE = 1400;

    // Text under the cursor: a light, liquid wobble that eases in and out.
    const noise = document.getElementById('wob-noise');
    const wobAmp = document.getElementById('wob-amp');
    const TEXT = 'h1, h2, h3, p, li, .skill';
    let wobEl: HTMLElement | null = null;
    let wob = 0;

    const loop = (now: number) => {
      const dx = m.x - p.x, dy = m.y - p.y;
      p.x += dx * 0.3;
      p.y += dy * 0.3;
      const lag = Math.hypot(dx, dy);
      star.style.left = p.x.toFixed(1) + 'px';
      star.style.top = p.y.toFixed(1) + 'px';

      let busy = lag > 0.3;
      if (pond && sky && amp) {
        while (drops.length && now - drops[0].born > LIFE) drops.shift();
        energy *= 0.96;
        slots.forEach((s, i) => {
          const d = drops[i];
          if (!d) { s.setAttribute('x', '-999'); s.setAttribute('y', '-999'); return; }
          const t = (now - d.born) / LIFE;
          const size = 40 + t * 320;
          s.setAttribute('x', (d.x - size / 2).toFixed(1));
          s.setAttribute('y', (d.y - size / 2).toFixed(1));
          s.setAttribute('width', size.toFixed(1));
          s.setAttribute('height', size.toFixed(1));
        });
        const live = drops.length > 0 && energy > 0.02;
        amp.setAttribute('scale', live ? (energy * 26).toFixed(1) : '0');
        sky.style.filter = live ? 'url(#pond)' : '';
        busy = busy || live;
      }
      if (!calm && noise && wobAmp) {
        const target = wobEl ? 1 : 0;
        wob += (target - wob) * 0.12;
        const t = now / 1000;
        noise.setAttribute('baseFrequency', (0.015 + 0.004 * Math.sin(t * 1.7)).toFixed(4) + ' ' + (0.05 + 0.012 * Math.cos(t * 2.3)).toFixed(4));
        wobAmp.setAttribute('scale', (wob * 3.5).toFixed(2));
        if (!wobEl && wob < 0.02) {
          document.querySelectorAll('.wob').forEach((el) => el.classList.remove('wob'));
          wob = 0;
        } else busy = true;
      }
      raf = busy ? requestAnimationFrame(loop) : 0;
    };

    window.addEventListener('mousemove', (e) => {
      const tg = e.target as Element | null;
      const over = !!(tg && tg.closest && tg.closest(CONTENT));
      if (over) {
        if (!hideT && !st.hide) hideT = window.setTimeout(() => { hideT = undefined; st.hide = true; st.hot = false; paint(); }, 700);
      } else {
        clearTimeout(hideT); hideT = undefined;
        st.hide = false;
      }
      st.hot = !st.hide && !!(tg && tg.closest && tg.closest('a, button'));
      m.x = e.clientX; m.y = e.clientY;
      if (!st.inside || st.gone) { p.x = m.x; p.y = m.y; }
      st.inside = true; st.rest = false; st.gone = false;
      paint();
      clearTimeout(restT); restT = window.setTimeout(() => { st.rest = true; paint(); }, 220);
      clearTimeout(idleT); idleT = window.setTimeout(() => { st.gone = true; paint(); }, 5000);

      if (pond) {
        const now = performance.now();
        if (Math.hypot(m.x - lastDrop.x, m.y - lastDrop.y) > 60) {
          drops.push({ x: m.x, y: m.y, born: now });
          while (drops.length > slots.length) drops.shift();
          lastDrop = { x: m.x, y: m.y };
        }
        energy = Math.min(1, energy + 0.08);
      }
      if (!calm) {
        const txt = tg && tg.closest ? tg.closest<HTMLElement>(TEXT) : null;
        if (txt !== wobEl) {
          if (wobEl && txt) wobEl.classList.remove('wob');
          wobEl = txt;
          if (wobEl) wobEl.classList.add('wob');
        }
      }
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });

    document.documentElement.addEventListener('mouseleave', () => {
      clearTimeout(restT); clearTimeout(idleT); clearTimeout(hideT); hideT = undefined;
      st.inside = false; st.rest = false;
      wobEl = null;
      paint();
      if (!raf) raf = requestAnimationFrame(loop);
    });
  }
</script>
