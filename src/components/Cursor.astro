---
// The overlap cursor (from the "kritikal marks" sheet), on every page.
// Mouse: two 9px circles with a red lens where they overlap; the leading one is the hotspot, the trailing one lags.
// Over anything clickable they merge into one red ball. A click makes it hop 2cm and bounce to a stop.
// Touch: no persistent cursor; a tap flashes the two circles sliding together. Reduced motion: no lag, hop or spring.
---
<svg class="ov-cursor" id="ov-cursor" aria-hidden="true"></svg>

<script>
  const ov = document.getElementById('ov-cursor') as unknown as SVGSVGElement;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const C = { fg: '#efefee', red: '#d2453f' };
  const HOP = 2 * 96 / 2.54, G = 4200, REST = 0.55;
  const HOT = 'a, button, summary, label, [role=button], .vc, input[type=range], select';
  const f = (n: number) => Math.round(n * 100) / 100;
  const lensD = (r: number, d: number) => {
    const h = Math.sqrt(Math.max(r * r - (d / 2) * (d / 2), 0));
    return `M0 ${f(-h)}A${f(r)} ${f(r)} 0 0 1 0 ${f(h)}A${f(r)} ${f(r)} 0 0 1 0 ${f(-h)}Z`;
  };
  const pair = (ax: number, ay: number, bx: number, by: number, r: number, op: number, so: number, lo: number) => {
    const dx = bx - ax, dy = by - ay, d = Math.max(Math.hypot(dx, dy), 0.01);
    const ang = d > 0.02 ? Math.atan2(dy, dx) * 180 / Math.PI : 0;
    const ring = `fill="none" stroke="${C.fg}" stroke-width="1.4" stroke-opacity="${f(so)}"`;
    return `<g opacity="${f(op)}" transform="translate(${f((ax + bx) / 2)} ${f((ay + by) / 2)}) rotate(${f(ang)})">` +
      (d < 2 * r ? `<path d="${lensD(r, d)}" fill="${C.red}" fill-opacity="${f(lo)}"/>` : '') +
      `<circle cx="${f(-d / 2)}" cy="0" r="${f(r)}" ${ring}/><circle cx="${f(d / 2)}" cy="0" r="${f(r)}" ${ring}/></g>`;
  };

  const S = { x: 0, y: 0, active: false, hover: false, qx: 0, qy: 0, mg: 0, rr: 9, vr: 0, h: 0, v: 0, sq: 0, launch: false, tr: [] as number[][], taps: [] as number[][] };
  if (fine) document.documentElement.classList.add('ov-on');

  addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch') return;
    S.x = e.clientX; S.y = e.clientY;
    if (!S.active) { S.active = true; S.qx = S.x + 11; S.qy = S.y; }
    wake();
  }, { passive: true });
  addEventListener('pointerover', (e) => {
    if (e.pointerType === 'touch') return;
    const t = e.target as Element;
    const typing = !!(t.closest && t.closest('input:not([type=range]):not([type=button]):not([type=submit]), textarea, [contenteditable]'));
    S.hover = !typing && !!(t.closest && t.closest(HOT));
    ov.style.visibility = typing ? 'hidden' : '';
    wake();
  });
  document.documentElement.addEventListener('pointerleave', () => { S.active = false; S.hover = false; wake(); });
  addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'touch') { S.taps.push([e.clientX, e.clientY, performance.now()]); wake(); return; }
    S.x = e.clientX; S.y = e.clientY; S.launch = true; wake();
  }, { passive: true });

  // Returns true while anything is still moving.
  const update = (dt: number, now: number) => {
    const live = S.active, px = S.x, py = S.y;
    let busy = false;
    const merge = live && S.hover;
    const mgT = merge ? 1 : 0;
    S.mg += (mgT - S.mg) * (RM ? 1 : 1 - Math.exp(-dt * 16));
    const rt = merge ? 8.5 : 9;
    if (RM) { S.rr = rt; S.vr = 0; }
    else { S.vr += (320 * (rt - S.rr) - 15 * S.vr) * dt; S.rr += S.vr * dt; }
    if (S.rr < 3) S.rr = 3;
    const tx = merge ? px : px + 11, ty = py;
    const k = RM ? 1 : 1 - Math.exp(-dt * (merge ? 16 : 10));
    S.qx += (tx - S.qx) * k; S.qy += (ty - S.qy) * k;
    const dx = S.qx - px, dy = S.qy - py, dl = Math.hypot(dx, dy);
    if (dl > 34) { S.qx = px + dx / dl * 34; S.qy = py + dy / dl * 34; }
    if (Math.hypot(S.qx - tx, S.qy - ty) > 0.2 || Math.abs(S.mg - mgT) > 0.01 || Math.abs(S.rr - rt) > 0.02) busy = true;

    if (S.launch) { S.launch = false; if (!RM && live) { S.v = Math.sqrt(2 * G * HOP); S.h = Math.max(S.h, 0.01); } }
    if (!live) { S.h = 0; S.v = 0; S.sq = 0; S.tr = []; }
    if (S.h > 0 || S.v > 0) {
      busy = true;
      S.v -= G * dt; S.h += S.v * dt;
      if (S.h <= 0) { S.h = 0; const imp = -S.v; S.v = imp * REST; S.sq = Math.min(imp / 800, 1); if (S.v < 90) S.v = 0; }
    }
    S.sq *= Math.exp(-dt * 14);
    if (S.sq > 0.01) busy = true;
    const air = S.h > 0.5, st = air ? Math.min(Math.abs(S.v) / 1800, 0.28) : 0;
    const sy = 1 + st - 0.34 * S.sq, sx = 1 / (1 + st) + 0.42 * S.sq;

    let out = '';
    if (live) {
      if (S.h > 2) S.tr.push([px, py - S.h, now]);
      while (S.tr.length && now - S.tr[0][2] > 200) S.tr.shift();
      if (S.tr.length) busy = true;
      S.tr.forEach((t) => {
        const o = 0.38 * (1 - (now - t[2]) / 200);
        if (o > 0.02) out += `<circle cx="${f(t[0])}" cy="${f(t[1])}" r="${f(S.rr * 0.92)}" fill="${C.red}" opacity="${f(o)}"/>`;
      });
      const ox = px, oy = py + S.rr;
      out += `<g transform="translate(${f(ox)} ${f(oy - S.h)}) scale(${f(sx)} ${f(sy)}) translate(${f(-ox)} ${f(-oy)})">` +
        pair(px, py, S.qx, S.qy, S.rr, 1, 1 - S.mg, 0.95 + 0.05 * S.mg) + '</g>';
    }
    S.taps = S.taps.filter((t) => now - t[2] < 850);
    S.taps.forEach((t) => {
      busy = true;
      const p = (now - t[2]) / 850;
      const o2 = p < 0.7 ? 1 : 1 - (p - 0.7) / 0.3, tt = RM ? 1 : Math.min(p / 0.5, 1);
      const e2 = 1 - Math.pow(1 - tt, 3), dd = Math.max(34 * (1 - e2) + 4, 0.01);
      out += pair(t[0] - dd / 2, t[1], t[0] + dd / 2, t[1], 13, o2, 1, 0.95);
    });
    ov.innerHTML = out;
    return busy;
  };

  let raf = 0, last = 0;
  const frame = (now: number) => {
    const dt = Math.min((now - last) / 1000, 0.05); last = now;
    raf = update(dt, now) ? requestAnimationFrame(frame) : 0;
  };
  function wake() { if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } }
</script>
