---
// Top-right nav (from the "kritikal marks" sheet): the overlap mark as a reading meter.
// At the top of the page the circles overlap a little; as you scroll they close in into one red disc.
// Click it to open the menu: the circles part, a red dot appears, and the links hang from a gold hairline.
const SUBSTACK = 'https://substack.com/@verykritikal/posts?utm_source=Portfolio&utm_medium=Nav&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const links = [
  { label: 'home', href: '/' },
  { label: 'work', href: '/work' },
  { label: 'writing', href: SUBSTACK, external: true },
  { label: 'get coffee', href: '/#coffee' }
];
---
<nav class="mk-nav" id="mk-nav" aria-label="Main">
<button class="mk-btn" id="mk-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mk-menu"></button>
<ul class="mk-menu" id="mk-menu">
{links.map((l, i) => <li style={`--i: ${i}`}><a href={l.href} tabindex="-1" {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></li>)}
</ul>
</nav>

<script>
  const C = { fg: '#efefee', red: '#d2453f' };
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const f = (n: number) => Math.round(n * 100) / 100;
  const box = document.getElementById('mk-nav') as HTMLElement;
  const btn = document.getElementById('mk-btn') as HTMLButtonElement;
  const menu = document.getElementById('mk-menu') as HTMLElement;
  const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
  const lensD = (r: number, d: number) => {
    const h = Math.sqrt(Math.max(r * r - (d / 2) * (d / 2), 0));
    return `M0 ${f(-h)}A${f(r)} ${f(r)} 0 0 1 0 ${f(h)}A${f(r)} ${f(r)} 0 0 1 0 ${f(-h)}Z`;
  };
  // sc = scroll 0..1 (circles close in), hov = hover nudge, o = menu open (circles part, red dot between)
  const mark = (sc: number, hov: number, o: number) => {
    const r = 17, d = Math.max(15 * (1 - sc) * (1 - o) + 26 * o - 3 * hov * (1 - o), 0.01);
    const so = Math.min(d / 5, 1);
    const ring = `fill="none" stroke="${C.fg}" stroke-width="3.2" stroke-opacity="${f(so)}"`;
    const dot = o > 0.02 ? `<circle cx="32" cy="32" r="${f(5.5 * o)}" fill="${C.red}"/>` : '';
    return `<svg viewBox="0 0 64 64" width="48" height="48" aria-hidden="true"><g transform="translate(32 32)">` +
      (d < 2 * r ? `<path d="${lensD(r, d)}" fill="${C.red}"/>` : '') +
      `<circle cx="${f(-d / 2)}" cy="0" r="${r}" ${ring}/><circle cx="${f(d / 2)}" cy="0" r="${r}" ${ring}/></g>${dot}</svg>`;
  };

  const N = { open: false, sc: 0, hov: 0, th: 0, o: 0, key: '' };
  const target = () => {
    const de = document.documentElement;
    return Math.min(Math.max(scrollY / Math.max(1, de.scrollHeight - innerHeight), 0), 1);
  };
  const setOpen = (b: boolean) => {
    N.open = b;
    menu.classList.toggle('on', b);
    btn.setAttribute('aria-expanded', String(b));
    items.forEach((a) => a.setAttribute('tabindex', b ? '0' : '-1'));
    wake();
  };
  btn.addEventListener('click', () => setOpen(!N.open));
  btn.addEventListener('pointerenter', () => { N.th = 1; wake(); });
  btn.addEventListener('pointerleave', () => { N.th = 0; wake(); });
  btn.addEventListener('focus', () => { N.th = 1; wake(); });
  btn.addEventListener('blur', () => { N.th = 0; wake(); });
  items.forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('pointerdown', (e) => { if (N.open && !box.contains(e.target as Node)) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && N.open) { setOpen(false); btn.focus(); } });
  addEventListener('scroll', () => wake(), { passive: true });

  let raf = 0, last = 0;
  const frame = (now: number) => {
    const dt = Math.min((now - last) / 1000, 0.05); last = now;
    const ts = target(), oT = N.open ? 1 : 0;
    const ease = (rate: number) => (RM ? 1 : 1 - Math.exp(-dt * rate));
    N.sc += (ts - N.sc) * ease(10);
    N.hov += (N.th - N.hov) * ease(14);
    N.o += (oT - N.o) * ease(12);
    const k = Math.round(N.sc * 600) + ',' + Math.round(N.hov * 300) + ',' + Math.round(N.o * 300);
    if (k !== N.key) { N.key = k; btn.innerHTML = mark(N.sc, N.hov, N.o); }
    const moving = Math.abs(ts - N.sc) > 0.001 || Math.abs(N.th - N.hov) > 0.003 || Math.abs(oT - N.o) > 0.003;
    raf = moving ? requestAnimationFrame(frame) : 0;
  };
  function wake() { if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } }
  N.sc = target();
  btn.innerHTML = mark(N.sc, 0, 0);
</script>
