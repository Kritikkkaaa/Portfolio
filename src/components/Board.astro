---
// Hero board (from the "Kritikal Hero Board" artifact): her photo pinned to the page like a print, with five red pen lines
// that grow out of it one at a time (a new one every 2.6s, 13s loop), each landing on a handwritten note.
// The print hangs from its tack: it sways a little, can be dragged and swung, tilts toward the mouse and pushes in on hover.
// Notes use the site's Kalam tokens (--h-note, --h-hint on narrow boards). Reduced motion shows all five notes, still.
const notes = [
  { c: 'bd-n1', t: '3+ years of experience with b2b products' },
  { c: 'bd-n2', t: 'loves talking to customers' },
  { c: 'bd-n3', t: 'friends with founders 👀' },
  { c: 'bd-n4', t: 'functions on coffee' },
  { c: 'bd-n5', t: 'writes personal <em>essays</em>' }
];
---
