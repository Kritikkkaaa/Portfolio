<div class="bd-pin" id="bd-pin"><span class="bd-tack" aria-hidden="true"></span><div class="bd-print" id="bd-print" tabindex="0" role="img" aria-label="Kritika speaking into a mic under a tree of pink flowers, pinned to the page. Press enter to swing it."><div class="bd-ph"><img src="/kritika-board.jpg" alt="" width="1100" height="733" draggable="false" decoding="async" /><span class="bd-glare" aria-hidden="true"></span></div></div></div>
{notes.map((n, i) => <p class={`bd-nt ${n.c}`} style={`--i:${i}`} set:html={n.t} />)}
</div>

<script>
  const pin = document.getElementById('bd-pin') as HTMLElement;
  const print = document.getElementById('bd-print') as HTMLElement;
  const board = document.getElementById('bd') as HTMLElement;
  const tack = pin.querySelector('.bd-tack') as HTMLElement;
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!RM) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    // The print hangs from the tack: a spring pendulum that follows a slow idle sway and settles after a swing.
    let th = -1.6, w = 0, last = 0, dragging = false, touched = false, onscreen = true, zoomOn = false;
    const K = 36, C = 3.1, MAXA = 38;
    const rest = (t: number) => -1.25 + 0.65 * Math.sin((t / 1000) * 2 * Math.PI / 8);
    const frame = (now: number) => {
      if (!last) last = now;
      const dt = Math.min(0.033, (now - last) / 1000); last = now;
      if (onscreen && !document.hidden) {
        if (!dragging) { const a = -K * (th - rest(now)) - C * w; w += a * dt; th += w * dt; }
        th = Math.max(-MAXA, Math.min(MAXA, th));
        pin.style.transform = `rotate(${th.toFixed(3)}deg)`;
        board.classList.toggle('swing', Math.abs(th - rest(now)) > 3.2);
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
    new IntersectionObserver((e) => { onscreen = e[0].isIntersecting; last = 0; }).observe(board);
    const kick = (v: number) => { w += v; touched = true; };
    // One small nudge so people see it moves, only if nobody has touched it yet.
    setTimeout(() => { if (!touched) w += 15; }, 4200);

    // Drag: grab it anywhere and swing it around the tack.
    let pivot = { x: 0, y: 0 }, ang0 = 0, th0 = 0, px0 = 0, py0 = 0, t0 = 0, lastTh = 0, lastT = 0, moved = 0;
    const angle = (e: PointerEvent) => Math.atan2(e.clientY - pivot.y, e.clientX - pivot.x) * 180 / Math.PI;
    print.addEventListener('pointerdown', (e) => {
      if (e.button > 0) return;
      const r = tack.getBoundingClientRect(); pivot = { x: r.left + r.width / 2, y: r.top + r.height / 2 };
      dragging = true; moved = 0; touched = true; ang0 = angle(e); th0 = th; px0 = e.clientX; py0 = e.clientY; t0 = lastT = performance.now(); lastTh = th; w = 0;
      print.classList.add('grab'); pin.classList.add('pressed'); print.style.setProperty('--rx', '0deg'); print.style.setProperty('--ry', '0deg');
      try { print.setPointerCapture(e.pointerId); } catch { /* capture is optional */ }
    });
    print.addEventListener('pointermove', (e) => {
      if (dragging) {
        moved = Math.max(moved, Math.hypot(e.clientX - px0, e.clientY - py0));
        let d = angle(e) - ang0; d = ((d + 540) % 360) - 180;
        const nt = Math.max(-MAXA, Math.min(MAXA, th0 + d)), now = performance.now(), dt = Math.max(0.008, (now - lastT) / 1000);
        w = w * 0.6 + ((nt - lastTh) / dt) * 0.4; lastTh = nt; lastT = now; th = nt;
      } else if (fine && e.pointerType === 'mouse') {
        // Hover: the print tilts toward the pointer, a soft shine follows it, and the picture pushes in.
        const r = print.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        print.style.setProperty('--ry', ((x - 0.5) * 9).toFixed(2) + 'deg'); print.style.setProperty('--rx', ((0.5 - y) * 7).toFixed(2) + 'deg');
        print.style.setProperty('--gx', (x * 100).toFixed(1) + '%'); print.style.setProperty('--gy', (y * 100).toFixed(1) + '%');
      }
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false; print.classList.remove('grab'); pin.classList.remove('pressed');
      w = Math.max(-420, Math.min(420, w));
      if (moved < 6 && performance.now() - t0 < 320) { // a tap or click gives it a push away from where it was hit
        const r = print.getBoundingClientRect(); kick((e.clientX < r.left + r.width / 2 ? 1 : -1) * 13);
        if (e.pointerType !== 'mouse') { zoomOn = !zoomOn; print.style.setProperty('--z', zoomOn ? '1.3' : '1'); }
      }
    };
    print.addEventListener('pointerup', end); print.addEventListener('pointercancel', end);
    print.addEventListener('pointerenter', (e) => { if (fine && e.pointerType === 'mouse') { print.classList.add('hot'); print.style.setProperty('--z', '1.3'); } });
    print.addEventListener('pointerleave', () => { print.classList.remove('hot'); print.style.setProperty('--rx', '0deg'); print.style.setProperty('--ry', '0deg'); if (fine) print.style.setProperty('--z', '1'); });
    print.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); kick(16); } });
    print.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>
