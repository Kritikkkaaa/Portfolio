---
import Board from './Board.astro';
// First fold: a typed greeting, a short intro and the pinned photo board (Board.astro).
const greeting = 'Hello! I am Kritika!';
---
<section id="top" aria-labelledby="hello" style="display: flex; flex-wrap: wrap; gap: 48px 56px; align-items: center; align-content: center; box-sizing: border-box; min-height: calc(100svh - 24px); padding-bottom: 24px">
<div style="flex: 6 1 0; min-width: min(100%, 420px); display: flex; flex-direction: column; gap: 36px">
<h1 id="hello" class="rise" aria-label={greeting} style="animation-delay: 0.3s; margin: 0; font-family: 'Commissioner', system-ui, sans-serif; font-weight: 500; font-size: var(--t-display); line-height: 1; letter-spacing: -0.02em"><span class="tp" aria-hidden="true"><span class="tp-ghost">{greeting}</span><span class="tp-live"><span id="tp-text">{greeting}</span><span class="tp-caret" id="tp-caret"></span></span></span></h1>
<div class="rise" style="animation-delay: 0.42s; display: flex; flex-direction: column; gap: 18px">
<p style="margin: 0; max-width: 560px; font-size: var(--t-lead); font-weight: 300; line-height: 1.75; color: #C9CDD5; text-wrap: pretty">After 3 years in Product startups, I have found my sweet spot. It sits at the intersection of creativity, storytelling and empathy! I believe that the best of marketing is people making a simple choice of <em style="font-family: 'Kalam', cursive; font-style: normal; font-size: 1.1em; color: #D8C9A3">"Let's get this!"</em></p>
<p style="margin: 0; max-width: 560px; font-size: var(--t-lead); font-weight: 300; line-height: 1.75; color: #C9CDD5; text-wrap: pretty">In my free time, I read under the sun, watch culturally relevant shows and make inappropriate jokes on my opposite gender.</p>
</div>
<div class="hd-cta-row">
<a class="ft-primary rise" href="/work" style="animation-delay: 0.66s; align-self: flex-start">See my work<span aria-hidden="true">→</span></a>
<span class="hd-note"><span style="font-size: 20px" aria-hidden="true">←</span> start here</span>
</div>
</div>

<div class="fade" style="animation-delay: 0.4s; flex: 4 1 0; min-width: 300px; display: flex; justify-content: center">
<div style="width: 100%; max-width: 500px">
<Board />
</div>
</div>
{/* The crystal orb used to live here. It now sits in the footer (Footer.astro); its markup is kept below for reference.
<div class="fade" style="animation-delay: 0.4s; flex: 3 1 0; min-width: 240px; display: flex; flex-direction: column; align-items: center; gap: 14px">
<button class="orb" id="orb" type="button" aria-label="Crystal ball. Touch it to know your future" aria-pressed="false">
<span id="ripples"></span>
<span class="orb-ball">
<span class="mist m1"></span><span class="mist m2"></span>
<span id="om-slot" style="display: contents"></span>
<span class="gloss"></span>
</span>
</button>
