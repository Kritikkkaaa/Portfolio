*/}
</section>

<script>
  // Role words: letters drop in from a soft blur, the old word lifts away.
  const words = ['content marketer', 'storyteller', 'product manager', 'growth marketer'];
  const wIn = document.getElementById('w-in') as HTMLElement;
  const wOut = document.getElementById('w-out') as HTMLElement;
  const build = (host: HTMLElement, word: string, n: number, kind: 'i' | 'o') => {
    host.textContent = '';
    const cls = 'lt ' + kind + (n % 2 ? 'b' : 'a');
    const step = kind === 'i' ? 0.05 : 0.025;
    const lead = kind === 'i' ? 0.35 : 0;
    word.split('').forEach((ch, i) => {
      const s = document.createElement('span');
      s.className = cls;
      s.style.animationDelay = (lead + i * step).toFixed(3) + 's';
      s.textContent = ch === ' ' ? ' ' : ch;
      host.appendChild(s);
    });
  };
  let ri = 0;
  setInterval(() => {
    const prev = words[ri];
    ri = (ri + 1) % words.length;
    build(wOut, prev, ri, 'o');
    build(wIn, words[ri], ri, 'i');
  }, 8000);

</script>
