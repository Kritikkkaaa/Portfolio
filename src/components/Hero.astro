<p class="omen" id="omen" hidden style="margin: 0; font-family: 'Kalam', cursive; font-style: normal; font-size: 19px; line-height: 1.4; color: #E8EBF0">You have found the one you are looking for... <span style="color: #D8C9A3">Hire her!</span></p>
<div id="orb-hint" style="font-family: 'Commissioner', system-ui, sans-serif; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8D96">touch to know your future</div>
</div>
</div>
*/}
</section>

<script>
  // Typed greeting: types out, holds, deletes, starts over. Reduced motion keeps it still.
  const text = 'Hello! I am Kritika!';
  const out = document.getElementById('tp-text') as HTMLElement;
  const caret = document.getElementById('tp-caret') as HTMLElement;
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const run = async () => {
      out.textContent = '';
      await sleep(900);
      for (;;) {
        caret.classList.add('typing');
        for (let i = 1; i <= text.length; i++) { out.textContent = text.slice(0, i); await sleep(80 + Math.random() * 55); }
        caret.classList.remove('typing');
        await sleep(2400);
        caret.classList.add('typing');
        for (let i = text.length - 1; i >= 0; i--) { out.textContent = text.slice(0, i); await sleep(38); }
        caret.classList.remove('typing');
        await sleep(600);
      }
    };
    run();
  } else {
    caret.style.display = 'none';
  }
</script>
