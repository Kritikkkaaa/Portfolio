---
// The case study page: one template for every project. Data lives in src/data/cases/<slug>.ts.
// Desktop: an exact 50/50 magazine spread that fills the window. The left half stays put (Back, the title, the TL;DR and the
//  main call to action); the ivory right half is the story and scrolls on its own, starting with one wide picture.
// Entry: "Read" on the work page. The title panel unrolls, then the paper and the story fade up. "Back to work" and "See other work"
//  go back through browser history when the reader came from the work page, so their folder and scroll position come back.
// Below 768px: one normal scrolling page, overview first, story underneath.
import Analytics from './Analytics.astro';
import CaseBlocks from './CaseBlocks.astro';
import type { CaseStudy } from '../data/cases/types';
interface Props { c: CaseStudy }
const { c } = Astro.props as Props;
const WORK = '/work-redo';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{c.title} · Kritika Upadhyay</title>
<meta name="description" content={c.tldr[0].p}>
<link rel="stylesheet" href="/buttons.css">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&amp;family=Marcellus&amp;family=Courier+Prime:wght@400;700&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#f6f1e8;color:#3d2430;font-family:'Courier Prime',ui-monospace,monospace}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:2px solid #5B3FD9;outline-offset:3px}
.sp{display:grid;grid-template-columns:1fr 1fr;height:100vh;overflow:hidden}
.lf{display:flex;flex-direction:column;height:100vh;min-width:0}
.top{flex:0 0 40%;min-height:0;box-sizing:border-box;background:#5a1626;color:#f6f1e8;padding:clamp(20px,4vh,40px) clamp(24px,4.2vw,64px) clamp(20px,4.5vh,44px);display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}
.back{align-self:flex-start;font-family:Marcellus,Georgia,serif;font-size:clamp(14px,1.15vw,17px);color:rgba(246,241,232,.8);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px;transition:color .2s}
.back:hover,.back:focus-visible{color:#f6f1e8}
h1{margin:0;font-family:Marcellus,Georgia,serif;font-weight:400;font-size:clamp(26px,min(3.8vw,6vh),58px);line-height:1.08;color:#f6f1e8}
.bot{flex:1;min-height:0;box-sizing:border-box;padding:clamp(16px,3.4vh,40px) clamp(24px,4.2vw,64px) clamp(14px,3vh,32px);background:linear-gradient(180deg,#f9f5ed 0%,#f3ede2 100%);display:flex;flex-direction:column;overflow-y:auto}
.tl{margin:0 0 clamp(8px,1.8vh,16px);font-family:Cinzel,serif;font-weight:500;font-size:clamp(18px,1.6vw,24px);letter-spacing:.2em;color:#5a1626}
.cta{align-self:center;margin-top:auto;flex:none}
.acc{margin-bottom:clamp(14px,3vh,26px)}
.ar{border-top:1px solid rgba(90,22,38,.3)}
.ar:last-child{border-bottom:1px solid rgba(90,22,38,.3)}
.ah{margin:0}
.ab{display:flex;align-items:center;gap:16px;width:100%;box-sizing:border-box;padding:clamp(10px,2vh,18px) 6px;background:none;border:0;cursor:pointer;text-align:left;color:#5a1626;font:inherit;transition:background .2s}
.ab:hover,.ab:focus-visible{background:rgba(90,22,38,.06)}
.ab .t{flex:1;font-family:Marcellus,Georgia,serif;font-size:clamp(21px,1.9vw,29px);line-height:1.15;transition:transform .25s ease}
.ab:hover .t,.ab:focus-visible .t{transform:translateX(6px)}
.ic{position:relative;flex:none;width:28px;height:28px;border-radius:50%;background:#5a1626;transition:background .25s,box-shadow .25s}
.ic::before,.ic::after{content:"";position:absolute;left:50%;top:50%;width:12px;height:1.5px;margin:-.75px 0 0 -6px;background:#f6f1e8;transition:transform .3s ease,background .25s}
.ic::after{transform:rotate(90deg)}
.ar.open .ic{background:transparent;box-shadow:inset 0 0 0 1px #5a1626}
.ar.open .ic::before,.ar.open .ic::after{background:#5a1626}
.ar.open .ic::after{transform:rotate(0)}
.ap{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s ease}
.ar.open .ap{grid-template-rows:1fr}
.ap>div{overflow:hidden}
.ap p{margin:0;padding:0 48px 16px 6px;font-family:Marcellus,Georgia,serif;font-size:clamp(16px,1.3vw,19px);line-height:1.6;color:#3d2430}
/* the invitation: closed headings pulse softly until the reader opens one */
.acc:not(.seen) .ar:not(.open) .ic{animation:ping 2.8s ease-out infinite}
.acc:not(.seen) .ar:nth-child(3):not(.open) .ic{animation-delay:.5s}
@keyframes ping{0%{box-shadow:0 0 0 0 rgba(90,22,38,.4)}60%,100%{box-shadow:0 0 0 12px rgba(90,22,38,0)}}

/* the story */
.rt{height:100vh;overflow-y:scroll;background:linear-gradient(180deg,#f9f5ed 0%,#f3ede2 100%);box-shadow:inset 1px 0 0 rgba(90,22,38,.16)}
@supports not selector(::-webkit-scrollbar){.rt{scrollbar-width:thin;scrollbar-color:#5a1626 rgba(90,22,38,.12)}}
.rt::-webkit-scrollbar{width:9px}.rt::-webkit-scrollbar-thumb{background:#5a1626}.rt::-webkit-scrollbar-track{background:rgba(90,22,38,.1)}
.art{max-width:680px;margin:0 auto;box-sizing:border-box;padding:clamp(28px,7vh,76px) clamp(24px,4.6vw,72px) clamp(14px,3vh,32px)}
.art p,.art li{font-family:Marcellus,Georgia,serif;font-size:clamp(17px,1.35vw,20px);line-height:1.7;color:#3d2430}
.art p{margin:0 0 18px}
.lead p{font-size:clamp(18px,1.5vw,22px)}
.hero{margin:0 0 clamp(28px,5vh,48px)}
.hero img{display:block;width:100%;height:auto;border:1px solid rgba(90,22,38,.18)}
.art section{margin:clamp(44px,8vh,84px) 0 0}
h3{margin:0 0 16px;font-family:Marcellus,Georgia,serif;font-weight:700;font-size:clamp(25px,2.3vw,34px);line-height:1.2;color:#5a1626}
.figs{display:grid;gap:16px;margin:30px 0 0}
.figs.two{grid-template-columns:1fr 1fr}
.figs figure{margin:0}
.figs img{display:block;width:100%;height:auto;border:1px solid rgba(90,22,38,.18);background:#fff}
.figs figcaption,.hero figcaption,.vid figcaption,.chart>figcaption{margin:0 0 8px;font-size:14px;line-height:1.45;color:#6b5a5a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nl{margin:0 0 8px;padding:0;list-style:none;counter-reset:n}
.nl li{position:relative;margin:0 0 20px;padding-left:44px;counter-increment:n}
.nl li::before{content:counter(n);position:absolute;left:0;top:2px;font-family:Cinzel,serif;font-weight:600;font-size:22px;color:#5a1626}
.bl{margin:0 0 18px;padding:0 0 0 22px}
.bl li{margin:0 0 10px}
.cb-label{margin:30px 0 10px !important;font-family:Cinzel,serif !important;font-weight:600;font-size:14px !important;letter-spacing:.16em;text-transform:uppercase;color:#5a1626 !important;line-height:1.4 !important}
.cb-fact{margin:26px 0 !important;padding:4px 0 4px 22px;border-left:3px solid #5a1626;font-size:clamp(22px,1.9vw,28px) !important;line-height:1.35 !important;color:#5a1626 !important}
.ql{list-style:none;margin:0 0 18px;padding:0}
.ql li{display:flex;gap:14px;align-items:flex-start;margin:0 0 12px}
.qm{flex:none;display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;margin-top:3px;border:1px solid #5a1626;border-radius:50%;font-family:Cinzel,serif;font-weight:600;font-size:14px;line-height:1;color:#5a1626}
/* video: plays quietly while it is on screen */
.vid{margin:30px 0 0}
.vid video{display:block;width:100%;height:auto;border:1px solid rgba(90,22,38,.18);background:#fff}
/* numbers */
.chart{margin:30px 0 0}
.chart-in{display:flex;align-items:center;gap:28px;flex-wrap:wrap}
.donut,.pie{flex:none;width:190px;height:190px}
.donut{transform:rotate(-90deg)}
.dseg{fill:none;stroke-width:26}
.dn,.dl{transform:rotate(90deg);transform-origin:110px 110px;text-anchor:middle;fill:#5a1626}
.dn{font:600 30px Cinzel,serif}
.dl{font:400 15px 'Courier Prime',monospace;fill:#6b5a5a}
.legend{list-style:none;margin:0;padding:0;flex:1;min-width:200px}
.legend li{display:flex;align-items:center;gap:12px;margin:0 0 10px;font-family:Marcellus,Georgia,serif;font-size:clamp(17px,1.35vw,20px);color:#3d2430}
.legend i{flex:none;width:14px;height:14px;border-radius:50%}
.legend span{flex:1}
.legend b{font:700 15px 'Courier Prime',monospace;color:#5a1626}
.chart-note{margin:12px 0 0 !important;font-size:14px !important;color:#6b5a5a !important}
/* comparison columns */
.cmp-set{margin:26px 0 0}
.cmp{margin:0 0 44px !important;padding:0 0 28px;border-bottom:1px solid rgba(90,22,38,.25)}
.cmp:last-child{border-bottom:0}
.cmp h4{margin:0 0 14px;font-family:Marcellus,Georgia,serif;font-weight:700;font-size:clamp(23px,2vw,28px);color:#5a1626}
.cmp-cols{display:grid;grid-template-columns:1fr 1fr;gap:12px 28px;margin:0 0 6px}
.cmp-k{margin:0 0 8px !important;font-family:Cinzel,serif !important;font-weight:600;font-size:12.5px !important;letter-spacing:.16em;text-transform:uppercase;color:#6b5a5a !important;line-height:1.4 !important}
.cmp ol{margin:0;padding:0 0 0 20px}
.cmp li{margin:0 0 10px;font-size:clamp(16px,1.2vw,18px) !important;line-height:1.55 !important}
.cmp .now li{color:#3d2430}
.cmp-cols>div:first-child li{color:#6b5a5a}
.cmp-mh{margin:0 0 6px !important;font-weight:700;font-size:clamp(20px,1.7vw,24px) !important;color:#5a1626 !important;line-height:1.3 !important}
.cmp-m{margin:0 !important}
/* interview */
.qa{margin:26px 0 0}
.qa>div{padding:16px 0;border-top:1px solid rgba(90,22,38,.25)}
.qa>div:last-child{border-bottom:1px solid rgba(90,22,38,.25)}
.qa dt{margin:0 0 6px;font:400 14.5px/1.45 'Courier Prime',monospace;color:#6b5a5a}
.qa dd{margin:0;font-family:Marcellus,Georgia,serif;font-size:clamp(19px,1.6vw,23px);line-height:1.4;color:#5a1626}
/* before and after */
.shift{margin:26px 0 0}
.shift .from{margin:0 0 4px !important;color:#6b5a5a !important;text-decoration:line-through;text-decoration-thickness:1px}
.shift .arrow{margin:6px 0 4px !important;font-size:26px !important;color:#5a1626 !important;line-height:1 !important}
.shift .to{margin:0 !important;font-size:clamp(22px,1.9vw,28px) !important;line-height:1.35 !important;color:#5a1626 !important}
.shift .cb-label{margin:0 0 6px !important}
.learnt{margin:34px 0 0;padding:20px 24px 8px;background:#f2e3de;border:1px solid rgba(90,22,38,.2)}
.learnt .cb-label{margin:0 0 8px !important}
.learnt p:last-child{font-size:clamp(20px,1.7vw,25px) !important;line-height:1.45 !important;color:#5a1626 !important}
.closing{margin:clamp(40px,7vh,72px) 0 0 !important;padding-top:26px;border-top:1px solid rgba(90,22,38,.25);font-size:clamp(20px,1.7vw,25px) !important;line-height:1.5 !important;color:#5a1626 !important}
.end{display:flex;justify-content:center;margin-top:clamp(52px,9vh,96px)}

@media (min-width: 768px) and (max-height: 720px){.ab{padding-top:8px;padding-bottom:8px}.ab .t{font-size:20px}.ap p{font-size:15px;padding-bottom:10px}.cta{min-height:42px;padding-top:8px;padding-bottom:8px}}

/* the entry: the title panel unrolls, then the paper and the story fade up (skipped for reduced motion) */
@media (prefers-reduced-motion: no-preference){
  .top{animation:unroll .6s cubic-bezier(.6,.05,.25,1) both}
  .bot{animation:rise .45s ease .2s both}
  .rt{animation:rise .45s ease .3s both}
  .ar{animation:rise .45s ease both;animation-delay:calc(.45s + var(--i) * .12s)}
  @keyframes unroll{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0)}}
  @keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
}

/* phones and narrow windows: one normal page */
@media (max-width: 767px){
  html,body{height:auto}
  .sp{display:block;height:auto;overflow:visible}
  .lf{height:auto}
  .top{flex:none;padding:max(18px,env(safe-area-inset-top)) 20px 28px;gap:36px}
  h1{font-size:30px}
  .bot{flex:none;padding:24px 20px 28px;overflow:visible}
  .ap p{padding:0 8px 16px 6px}
  .rt{height:auto;overflow:visible;box-shadow:inset 0 1px 0 rgba(90,22,38,.16)}
  .art{padding:32px 20px 64px}
  .art p,.art li{font-size:17px}
  .figs.two{grid-template-columns:1fr}
  .figs figcaption,.hero figcaption,.vid figcaption,.chart>figcaption{font-size:11.5px}
  .cmp-cols{grid-template-columns:1fr}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<main class="sp">
<div class="lf">
<header class="top">
<a class="back" id="back" href={WORK}>← Back to work</a>
<h1>{c.title}</h1>
</header>
<div class="bot">
<h2 class="tl">TL;DR</h2>
<div class="acc" id="acc">
{c.tldr.map((t, i) => (
  <div class={`ar${i === 0 ? ' open' : ''}`} style={`--i:${i}`}>
    <h3 class="ah"><button class="ab" type="button" id={`ab${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`ap${i}`}><span class="t">{t.h}</span><span class="ic" aria-hidden="true"></span></button></h3>
    <div class="ap" id={`ap${i}`} role="region" aria-labelledby={`ab${i}`}><div><p>{t.p}</p></div></div>
  </div>
))}
</div>
<a class="kbtn kbtn-primary cta" href="/lets-talk">Let's work together →</a>
</div>
</div>

<article class="rt" id="rt" tabindex="0" aria-label="The full story">
<div class="art">
<figure class="hero"><figcaption>{c.hero.cap}</figcaption><img src={c.hero.src} alt={c.hero.alt}></figure>
<div class="lead"><CaseBlocks blocks={c.lead} /></div>
{c.sections.map((s) => (
  <section>
    <h3>{s.h}</h3>
    <CaseBlocks blocks={s.blocks} />
  </section>
))}
{c.closing && <p class="closing">{c.closing}</p>}
<div class="end"><a class="kbtn" id="back2" href={WORK}>See other work</a></div>
</div>
</article>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// "Back to work" and "See other work" go back through history when the reader came from the work page, so the folder and its scroll position return
['back','back2'].forEach(function(id){
  var a=document.getElementById(id);if(!a)return;
  a.addEventListener('click',function(e){
    if(document.referrer.indexOf('/work-redo')>-1&&history.length>1&&!e.metaKey&&!e.ctrlKey&&!e.shiftKey){e.preventDefault();history.back();}
  });
});
var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
// TL;DR: Context unfurls by itself on arrival; clicking a heading opens it and closes the others
(function(){
  var acc=document.getElementById('acc');if(!acc)return;
  var rows=[].slice.call(acc.querySelectorAll('.ar'));
  function set(r,on){r.classList.toggle('open',on);r.querySelector('.ab').setAttribute('aria-expanded',on?'true':'false');}
  rows.forEach(function(r){r.querySelector('.ab').addEventListener('click',function(){
    var was=r.classList.contains('open');acc.classList.add('seen');
    rows.forEach(function(o){set(o,false)});if(!was)set(r,true);
  });});
  if(!reduce){set(rows[0],false);setTimeout(function(){if(!acc.classList.contains('seen'))set(rows[0],true)},650);}
})();
// videos play quietly (muted, looping) only while they are on screen; with reduced motion they wait for a press
(function(){
  var vs=[].slice.call(document.querySelectorAll('.vid video'));if(!vs.length)return;
  if(reduce||!('IntersectionObserver' in window)){vs.forEach(function(v){v.controls=true});return;}
  var root=document.getElementById('rt');
  var io=new IntersectionObserver(function(es){es.forEach(function(e){var v=e.target;if(e.isIntersecting){var p=v.play();if(p&&p.catch)p.catch(function(){});}else v.pause();});},{root:matchMedia('(min-width: 768px)').matches?root:null,threshold:.4});
  vs.forEach(function(v){io.observe(v)});
})();
// the story always starts at the top
var rt=document.getElementById('rt');if(rt)rt.scrollTop=0;
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
</html>
