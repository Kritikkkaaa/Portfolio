---
// Footer, "the ask" (from the "kritikal marks" sheet): headline with margin notes, two pills, two hand-drawn circles
// that slide together into one red disc which writes "Hire your unfair advantage!", a list on each side, and a base row.
// The animation is a slow 17.2s loop that only runs while the footer is on screen; reduced motion shows it still.
const LINKEDIN = 'https://www.linkedin.com/in/kritika-upadhyay-2001/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const RESUME = '/resume.pdf';
const INSTAGRAM = 'https://www.instagram.com/verykritikal/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const TWITTER = 'https://x.com/verykritikal?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const SUBSTACK = 'https://substack.com/@verykritikal/posts?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const left = ['crunch numbers', 'brainstorm new direction', 'argue over the specifics', 'execute together'];
const right = ['Ownership', 'Taste and eye for detail', 'E-t-E execution', 'Results'];
---
<footer class="fx" id="coffee">
<div class="fx-ask">
<p class="fx-note a">you bring me problems</p>
<h2>Let's work together!</h2>
<p class="fx-note b">i will work on the solution</p>
</div>

<div class="fx-ctas">
<a class="fx-cta p" href="/work">See my work <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
<a class="fx-cta s" href={RESUME} download="kritika_upadhyay_resume.pdf">Download résumé <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v10M4 8.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
</div>

<div class="fx-duo">
<div class="fx-lst l">
<h3>what i am looking for</h3>
<ul>{left.map((t) => <li>{t}</li>)}<li class="hw">Make an Impact!</li></ul>
</div>
<svg class="fx-svg" id="fx-svg" viewBox="0 0 520 290" role="img" aria-label="Two circles, what i am looking for and what you need, slide together and merge into one red disc that says: Hire your unfair advantage!"></svg>
<div class="fx-lst r">
<h3>what you need</h3>
<ul>{right.map((t) => <li>{t}</li>)}<li class="hw">Silly jokes are complimentary</li></ul>
</div>
</div>
<p class="fx-rm" id="fx-rm" hidden>Hire your unfair advantage!</p>

<div class="fx-base">
<span class="loc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/></svg>Bengaluru, India</span>
<nav class="fx-soc" aria-label="Elsewhere">
<a href={INSTAGRAM} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/></svg></a>
<a href={TWITTER} target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M5 5L19 19M19 5L5 19"/></svg></a>
<a href={SUBSTACK} target="_blank" rel="noopener" aria-label="Substack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14M5 7.5h14M5 11h14v10l-7-4.5L5 21z"/></svg></a>
<a href={LINKEDIN} target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6.8" cy="7" r="1.1" fill="currentColor"/><path d="M6.8 10.5V18M11 18v-7.5M11 14c0-2 1.4-3.5 3.4-3.5 2 0 3 1.3 3 3.5V18"/></svg></a>
</nav>
<span class="cred">Designed by a human, executed by AI. <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C12.8 8 16 11.2 22 12C16 12.8 12.8 16 12 22C11.2 16 8 12.8 2 12C8 11.2 11.2 8 12 2Z" fill="#d8c9a3"/></svg></span>
</div>
</footer>

<script>
  const C = { fg: '#efefee', red: '#d2453f', gold: '#d8c9a3', cool: '#c9cdd5' };
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const f = (n: number) => Math.round(n * 100) / 100;
  const svg = document.getElementById('fx-svg') as unknown as SVGSVGElement;
  const FR = 112, FD0 = 258, FCX = 260, FCY = 140, T = 17.2, SWEEP = 372 * Math.PI / 180;
  const FL = ['Hire your', 'unfair', 'advantage!'];
  const lensD = (r: number, d: number) => {
    const h = Math.sqrt(Math.max(r * r - (d / 2) * (d / 2), 0));
    return `M0 ${f(-h)}A${f(r)} ${f(r)} 0 0 1 0 ${f(h)}A${f(r)} ${f(r)} 0 0 1 0 ${f(-h)}Z`;
  };
  // A hand-drawn circle: starts at the top, goes clockwise, overshoots a little and wobbles by about 1%.
  const wob = (seed: number, u: number) => {
    const th = -Math.PI / 2 + u * SWEEP;
    const rr = FR * (1 + 0.011 * Math.sin(3 * th + seed) + 0.007 * Math.sin(5 * th + seed * 2.3) + 0.01 * (u - 0.5));
    return [rr * Math.cos(th), rr * Math.sin(th)];
  };
  const path = (seed: number) => {
    let s = '';
    for (let i = 0; i <= 140; i++) { const p = wob(seed, i / 140); s += (i ? 'L' : 'M') + f(p[0]) + ' ' + f(p[1]); }
    return s;
  };
  const ring = `fill="none" stroke="${C.cool}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"`;
  svg.innerHTML = '<defs>' + FL.map((_, j) => `<clipPath id="fx-cl${j}"><rect id="fx-cr${j}" x="${FCX - 130}" y="${114 + 34 * j - 30}" width="0" height="46"/></clipPath>`).join('') + '</defs>' +
    `<g id="fx-gl"><circle r="${FR}" fill="rgba(201,205,213,0.06)"/></g><g id="fx-gr"><circle r="${FR}" fill="rgba(201,205,213,0.06)"/></g>` +
    `<path id="fx-lens" fill="${C.red}" transform="translate(${FCX} ${FCY})"/>` +
    `<g id="fx-ol"><path d="${path(0.6)}" ${ring}/></g><g id="fx-or"><path d="${path(2.1)}" ${ring}/></g>` +
    `<circle id="fx-pen" r="3.4" fill="${C.gold}" opacity="0"/>` +
    FL.map((s, j) => `<g clip-path="url(#fx-cl${j})"><text id="fx-ct${j}" x="${FCX}" y="${114 + 34 * j}" text-anchor="middle" font-family="Kalam, cursive" font-weight="300" font-size="28" letter-spacing=".5" fill="${C.fg}" opacity="0">${s}</text></g>`).join('') +
    `<path id="fx-ul" d="M204 197C222 191 244 201 262 196S302 193 318 197" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" fill="none" stroke="${C.fg}" stroke-width="1.6" stroke-linecap="round" opacity="0"/>`;
  const g = (id: string) => document.getElementById(id) as unknown as SVGElement;
  const E = {
    gl: g('fx-gl'), gr: g('fx-gr'), lens: g('fx-lens'), ol: g('fx-ol'), or: g('fx-or'), pen: g('fx-pen'), ul: g('fx-ul'),
    t: [g('fx-ct0'), g('fx-ct1'), g('fx-ct2')], c: [g('fx-cr0'), g('fx-cr1'), g('fx-cr2')]
  };
  const pl = E.ol.firstChild as SVGPathElement, pr = E.or.firstChild as SVGPathElement;
  const sm = (a: number, b: number, x: number) => { const t = Math.min(Math.max((x - a) / (b - a), 0), 1); return t * t * (3 - 2 * t); };
  const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const set = (el: Element, k: string, v: string | number) => el.setAttribute(k, String(v));

  const draw = (t: number, still: boolean) => {
    let d: number, pulse = 0, d1 = 1, d2 = 1, fa = 1, ao = 1, tf = 1;
    if (still) d = FR * 1.1;
    else {
      d1 = sm(0.3, 2.0, t); d2 = sm(1.1, 2.8, t);
      fa = sm(2.4, 3.2, t); ao = 1 - sm(16.0, 16.8, t); fa *= ao;
      if (t < 5.4) d = FD0 - 14 * sm(3.6, 5.4, t);
      else if (t < 8.0) d = (FD0 - 14) * (1 - ease((t - 5.4) / 2.6));
      else if (t < 14.2) d = 0;
      else if (t < 16.4) d = FD0 * ease((t - 14.2) / 2.2);
      else d = FD0;
      pulse = 0.07 * Math.sin(Math.PI * Math.min(Math.max((t - 7.9) / 0.7, 0), 1));
      tf = 1 - sm(14.0, 14.6, t);
    }
    const dd = Math.max(d, 0.01), s = 1 + pulse, r = FR * s, so = Math.min(d / (0.35 * FR), 1) * ao;
    const xl = FCX - dd / 2, xr = FCX + dd / 2;
    set(E.gl, 'transform', `translate(${f(xl)} ${FCY}) scale(${f(s)})`);
    set(E.gr, 'transform', `translate(${f(xr)} ${FCY}) scale(${f(s)})`);
    set(E.ol, 'transform', `translate(${f(xl)} ${FCY}) scale(${f(s)})`);
    set(E.or, 'transform', `translate(${f(xr)} ${FCY}) scale(${f(s)})`);
    set(E.gl.firstChild as Element, 'fill-opacity', f(fa)); set(E.gr.firstChild as Element, 'fill-opacity', f(fa));
    set(pl, 'stroke-dashoffset', f(1 - d1)); set(pr, 'stroke-dashoffset', f(1 - d2));
    set(pl, 'stroke-opacity', d1 > 0.004 ? f(0.75 * so) : 0); set(pr, 'stroke-opacity', d2 > 0.004 ? f(0.75 * so) : 0);
    set(E.lens, 'd', dd < 2 * r ? lensD(r, dd) : '');
    let pu = 0, px = xl, seed = 0.6;
    if (!still && d1 > 0.004 && d1 < 0.998) pu = d1;
    else if (!still && d2 > 0.004 && d2 < 0.998) { pu = d2; px = xr; seed = 2.1; }
    if (pu > 0) { const pp = wob(seed, pu); set(E.pen, 'cx', f(px + pp[0])); set(E.pen, 'cy', f(FCY + pp[1])); set(E.pen, 'opacity', 1); }
    else set(E.pen, 'opacity', 0);
    for (let j = 0; j < 3; j++) {
      const p = still ? 0 : sm(8.2 + 0.7 * j, 9.0 + 0.7 * j, t);
      set(E.c[j], 'width', f(260 * p)); set(E.t[j], 'opacity', p > 0 ? f(tf) : 0);
    }
    const up = still ? 0 : sm(10.2, 10.9, t);
    set(E.ul, 'stroke-dashoffset', f(1 - up)); set(E.ul, 'opacity', up > 0.004 ? f(tf) : 0);
  };

  if (RM) {
    draw(0, true);
    (document.getElementById('fx-rm') as HTMLElement).hidden = false;
  } else {
    draw(0, false);
    let acc = 0, last = 0, raf = 0, vis = false;
    const frame = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05); last = now;
      acc += dt;
      draw(acc % T, false);
      raf = vis ? requestAnimationFrame(frame) : 0;
    };
    new IntersectionObserver((es) => {
      const v = es[0].isIntersecting;
      if (v && !vis) { acc = 0; last = performance.now(); vis = true; if (!raf) raf = requestAnimationFrame(frame); }
      else if (!v) vis = false;
    }, { threshold: 0.25 }).observe(svg);
  }
</script>
