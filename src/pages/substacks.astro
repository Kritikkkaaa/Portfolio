---
// /substacks, "i write on Substack." — opened from 3 on the desk (/home-redo).
// Desktop: two magazine spreads (1512x982 each, scaled to fill the window), like /jobs.
//  Spread 1, the column's front page: a terracotta masthead panel (bio, numbers, subscribe), the heading and note,
//  a contents list grouped by section, and one lead story with a pull quote.
//  Spread 2, the posts, each section set its own way: postcards that flip, a three-column heart spread,
//  the work story with a note to /jobs, the at-home banner, and the op-ed in a plain dark box.
// Below 768px: one column.
// Posts are pulled from Substack's public archive at build time, so titles, covers, dates and word counts stay current.
// Each post's section and pull quote are set by hand in `posts` below. A new post that isn't listed there
// shows up under "just in" in the contents (and on phones) until it gets a section.
import Analytics from '../components/Analytics.astro';

const PUB = 'https://verykritikal.substack.com';
const UTM = 'utm_source=Portfolio&utm_medium=Substacks+page&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const SUBSCRIBE = `${PUB}/subscribe?${UTM}`;
const BIO = 'swinging between intensity and moderation. want to be all Whimsy!';
const NOTE = 'i write about the things i’m still figuring out. love, living alone, work, and the places that change me a little.';
const PERSONAL = 'some of these get personal. that’s the point.';
const LEAD = 'love-is-usually-just-around-the-corner';

const sections = [
  { id: 'postcards', name: 'postcards' },
  { id: 'heart', name: 'matters of the heart' },
  { id: 'home', name: 'at home, alone' },
  { id: 'work', name: 'at work' },
  { id: 'loud', name: 'said out loud' }
];

// her posts. `sec` and `quote` (her own words) are set by hand; the rest is the fallback if Substack can't be reached.
const posts = [
  { slug: 'to-monish-aastha-tanay-krishna-and', sec: 'postcards', place: 'pondicherry', quote: 'if you are meant to meet them, you will meet them', title: 'to Monish, Aastha, Tanay, Krishna and others', sub: 'a postcard from Pondicherry 💌', date: '2025-09-01T08:39:02.886Z', words: 1509, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/f22b8cdd-bec9-4e95-a8ec-6ff0ab7f0a4f_3912x2373.jpeg' },
  { slug: 'a-house-by-the-beach-someday', sec: 'postcards', place: 'goa', quote: 'It’s hard to feel like the main character next to the sea.', title: 'A house by the beach, someday', sub: 'a post card from Goa', date: '2026-10-20T09:20:23.602Z', words: 821, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/22851840-4fb3-40a3-8e5c-47cdf4798ccb_736x736.jpeg' },
  { slug: 'gunshot-diary', sec: 'heart', quote: 'someone who didn’t just see your outfit, they saw your blueprints.', title: 'Gunshot diary', sub: 'A story about an elongated sleepover with a stranger', date: '2026-03-27T11:40:06.497Z', words: 1474, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/ebc3dc39-5c4d-46f8-afe2-ad528a0a3e18_1170x892.png' },
  { slug: 'was-he-a-fckboy', sec: 'heart', quote: 'Because you are so much in it!', title: 'Was he a F*ckboy?', sub: 'On charm, damage, and the art of finally seeing them clearly', date: '2026-05-28T12:41:35.055Z', words: 862, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/4775d1f2-7a05-47ce-b211-73d7730dc316_1602x1190.jpeg' },
  { slug: 'love-is-usually-just-around-the-corner', sec: 'heart', quote: 'love is reachable, not graspable.', title: 'love is usually just around the corner', sub: 'but are you someone who won’t scare it away?', date: '2026-08-15T10:07:58.364Z', words: 731, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/5d2fa710-31d8-4d0c-91de-b5783773b674_736x538.jpeg' },
  { slug: 'unthought-known', sec: 'home', quote: 'What if things were never lost. Just unseen.', title: 'Unthought known', sub: 'Some things are known before they are ever thought. This is one of those stories.', date: '2026-07-02T14:50:30.012Z', words: 1075, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/bb1646bf-5cdd-4839-8308-b33d54c4d672_1584x396.png' },
  { slug: 'data-vs-instincts', sec: 'work', quote: 'I defended first and answered after.', title: 'Data vs Instincts', sub: 'And why what you can see is not enough!', date: '2026-06-15T10:31:17.888Z', words: 1329, cover: '' },
  { slug: 'on-being-watched-being-warned-and', sec: 'loud', quote: 'keeping women safe by keeping them in.', title: 'On being watched, being warned, and never being asked', sub: 'Small rules, quiet costs, and one uncomfortable morning', date: '2026-10-10T10:59:03.893Z', words: 1274, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/43338fa9-9fb3-43a1-bb64-4c89ad6477cb_1080x1349.jpeg' }
];

// pull the live archive; if it fails, the fallback above is used
let live: any[] = [];
try {
  const r = await fetch(`${PUB}/api/v1/archive?sort=new&limit=50`, { signal: AbortSignal.timeout(8000) });
  if (r.ok) live = await r.json();
} catch {}
const bySlug = new Map(live.filter((p) => p && p.slug && p.type !== 'podcast').map((p) => [p.slug, p]));
const merge = (p: any) => {
  const l = bySlug.get(p.slug);
  return l ? { ...p, title: l.title || p.title, sub: l.subtitle || p.sub, date: l.post_date || p.date, words: l.wordcount || p.words, cover: l.cover_image || p.cover } : p;
};
const known = new Set(posts.map((p) => p.slug));
const all = posts.map(merge);
const fresh = live
  .filter((l) => l && l.slug && !known.has(l.slug) && l.type !== 'podcast')
  .map((l) => ({ slug: l.slug, sec: 'new', quote: '', title: l.title, sub: l.subtitle || '', date: l.post_date, words: l.wordcount || 0, cover: l.cover_image || '' }));

// covers come through Substack's image CDN at the size they're shown, not full size
const img = (url: string, w = 800) => !url ? '' : url.includes('substackcdn.com/image/fetch') ? url : `https://substackcdn.com/image/fetch/w_${w},c_limit,f_auto,q_auto:good,fl_progressive:steep/${encodeURIComponent(url)}`;
const href = (slug: string) => `${PUB}/p/${slug}?${UTM}`;
const mins = (w: number) => Math.max(1, Math.round(w / 215));
const day = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }).toLowerCase();
const meta = (p: any) => `${day(p.date)} · ${mins(p.words)} min read`;
const get = (slug: string) => all.find((p) => p.slug === slug)!;
const inSec = (id: string) => all.filter((p) => p.sec === id);

// masthead numbers
const everything = [...all, ...fresh];
const essays = everything.length;
const words = everything.reduce((n, p) => n + (p.words || 0), 0);
const since = new Date(Math.min(...everything.map((p) => +new Date(p.date)))).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }).toLowerCase();

// contents, numbered in the order they appear
const contents = [
  ...(fresh.length ? [{ name: 'just in', items: fresh }] : []),
  ...sections.map((s) => ({ name: s.name, items: inSec(s.id) }))
];
let k = 0;
const numbered = contents.map((c) => ({ ...c, items: c.items.map((p: any) => ({ ...p, n: String(++k).padStart(2, '0') })) }));

const lead = get(LEAD);
const [pondi, goa] = inSec('postcards');
const hearts = inSec('heart');
const home = inSec('home')[0];
const work = inSec('work')[0];
const loud = inSec('loud')[0];
const postmark = (p: any) => `${p.place} · ${day(p.date)}`;
