<p class="bio">{BIO}</p>
<ul class="stats">
<li><b>{essays}</b><span>essays</span></li>
<li><b>{words.toLocaleString('en-IN')}</b><span>words</span></li>
<li><b>{since}</b><span>writing since</span></li>
</ul>
<p class="personal">{PERSONAL}</p>
<a class="sub-btn" href={SUBSCRIBE} target="_blank" rel="noopener">subscribe, it’s free</a>
</aside>
<div class="grain" aria-hidden="true"></div>
<h1 id="title">i write on Substack.</h1>
<p class="note">{NOTE}</p>
<nav class="toc" aria-label="contents">
{numbered.map((c) => (
<div class="grp">
<h2>{c.name}</h2>
{c.items.map((p: any) => (
<a href={href(p.slug)} target="_blank" rel="noopener"><span class="n">{p.n}</span><span class="t">{p.title}</span><span class="s">{p.sub}</span></a>
))}
</div>
))}
</nav>
<a class="lead" href={href(lead.slug)} target="_blank" rel="noopener">
<p class="lab">the lead · most loved</p>
<span class="pic"><img src={img(lead.cover, 1000)} alt="" loading="lazy"></span>
<span class="q">“{lead.quote}”</span>
<span class="t">{lead.title}</span>
<span class="s">{lead.sub}</span>
<span class="mt">{meta(lead)}</span>
<span class="go">read on Substack</span>
</a>
<p class="hint" aria-hidden="true">the posts, over the page ↓</p>
</div>
</section>

<section class="fold fold2" aria-label="the posts">
<div class="stage">
<div class="pageL" aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 756px; height: 982px"></div>
<div class="pageR" aria-hidden="true" style="position: absolute; left: 756px; top: 0; width: 756px; height: 982px"></div>
<div class="sheen" aria-hidden="true" style="position: absolute; inset: 0; opacity: .6"></div>
<div class="grain" aria-hidden="true"></div>
<p class="lab" style="position: absolute; left: 72px; top: 64px">the posts</p>

<p class="sl" style="left: 72px; top: 108px">postcards</p>
{[[pondi, 72, 140, -2.5], [goa, 96, 410, 2]].map(([p, x, y, r]: any) => (
<a class="pc" href={href(p.slug)} target="_blank" rel="noopener" aria-label={`${p.title}, ${p.sub}`} style={`left: ${x}px; top: ${y}px; width: 360px; height: 232px; transform: rotate(${r}deg)`}>
<span class="in">
<span class="face front"><img src={img(p.cover)} alt="" loading="lazy"><span class="stamp" aria-hidden="true"><i>VK</i></span><span class="pm" aria-hidden="true">{postmark(p)}</span></span>
<span class="face back2" aria-hidden="true"><span><span class="q">“{p.quote}”</span><span class="t">{p.title}</span></span><span class="line"></span><span class="rt"><span>{p.place}</span><span>{mins(p.words)} min read</span><span class="go">read on Substack</span></span></span>
</span>
</a>
))}

<p class="sl" style="left: 500px; top: 108px">at work</p>
<a class="wk" href={href(work.slug)} target="_blank" rel="noopener" style="left: 500px; top: 144px; width: 210px">
<span class="t">{work.title}</span>
<span class="s">{work.sub}</span>
<span class="q">“{work.quote}”</span>
<span class="mt">{meta(work)}</span>
<span class="go">read on Substack</span>
</a>
<a class="margin" href="/jobs" style="left: 500px; top: 560px; width: 200px">the work side of this story → work i have done.</a>

<p class="sl" style="left: 72px; top: 700px">at home, alone</p>
<a class="hm" href={href(home.slug)} target="_blank" rel="noopener" style="left: 72px; top: 732px; width: 628px">
<span class="pic" style="width: 400px; height: 100px"><img src={img(home.cover)} alt="" loading="lazy"></span>
<span style="position: absolute; left: 0; top: 114px; width: 400px"><span class="t">{home.title}</span><span class="s">{home.sub}</span><span class="mt" style="display: block; margin-top: 6px">{meta(home)}</span></span>
<span class="q" style="position: absolute; left: 428px; top: 0; width: 200px; font-size: 22px; line-height: 1.2">“{home.quote}”</span>
<span class="go" style="position: absolute; left: 428px; top: 120px">read on Substack</span>
</a>

<p class="sl" style="left: 812px; top: 108px">matters of the heart</p>
{hearts.map((p, i) => (
<a class="ht" href={href(p.slug)} target="_blank" rel="noopener" style={`left: ${812 + i * 220}px; top: 140px; width: 200px`}>
<span class="cap"><b>[fig. 0{i + 1}]</b><span>{day(p.date)}</span></span>
<span class="pic"><img src={img(p.cover, 500)} alt="" loading="lazy"></span>
<span class="q">“{p.quote}”</span>
<span class="t">{p.title}</span>
<span class="s">{p.sub}</span>
<span class="mt">{mins(p.words)} min read</span>
</a>
))}

<a class="ld" href={href(loud.slug)} target="_blank" rel="noopener" style="left: 812px; top: 636px; width: 640px; height: 236px">
<p class="lab">said out loud</p>
<span class="q">“{loud.quote}”</span>
<span class="t">{loud.title}</span>
<span class="s">{loud.sub}</span>
<span class="mt">{meta(loud)}</span>
<span class="go">read on Substack</span>
</a>
<p class="more" style="left: 812px; top: 898px; width: 640px">new letters every few weeks. this page keeps growing.{fresh.length > 0 && <> just in: {fresh.slice(0, 2).map((p, i) => <>{i > 0 && ', '}<a href={href(p.slug)} target="_blank" rel="noopener">{p.title}</a></>)}</>}</p>
</div>
</section>

<main class="m">
<a class="back" href="/home-redo#desk">Back</a>
<h1>i write on Substack.</h1>
<p class="note">{NOTE}</p>
<section class="mpanel" aria-label="the masthead">
<p class="lab">the masthead</p>
<p class="mast">VeryKritikal</p>
<p class="bio">{BIO}</p>
<ul class="stats">
<li><b>{essays}</b><span>essays</span></li>
<li><b>{words.toLocaleString('en-IN')}</b><span>words</span></li>
<li><b>{since}</b><span>since</span></li>
</ul>
<p class="personal">{PERSONAL}</p>
<a class="sub-btn" href={SUBSCRIBE} target="_blank" rel="noopener">subscribe, it’s free</a>
</section>
{[...(fresh.length ? [{ id: 'new', name: 'just in' }] : []), ...sections].map((s) => {
  const list = s.id === 'new' ? fresh : inSec(s.id);
  return (
  <section class="msec" aria-label={s.name}>
  <h2>{s.name}</h2>
  {list.map((p: any) => (
  <>
  <a class={`mp${s.id === 'loud' ? ' dark' : ''}`} href={href(p.slug)} target="_blank" rel="noopener">
  {p.cover && s.id !== 'loud' && <span class="pic"><img src={img(p.cover)} alt="" loading="lazy"></span>}
  {p.quote && <span class="q">“{p.quote}”</span>}
  <span class="t">{p.title}</span>
  <span class="s">{p.sub}</span>
  <span class="mt">{meta(p)}</span>
  </a>
  {s.id === 'work' && <a class="mnote" href="/jobs">the work side of this story → work i have done.</a>}
  </>
  ))}
  </section>
  );
})}
<p class="more">new letters every few weeks. this page keeps growing.</p>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// each spread is zoomed to cover the window, like the desk (stops at 18% trimmed on unusual window shapes)
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82);document.querySelectorAll('.stage').forEach(function(st){st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';});}
addEventListener('resize',fit);fit();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
</html>
