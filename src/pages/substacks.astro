---
// /substacks, "i write on Substack." — opened from the desk (/home-revamp).
// Desktop: one magazine spread (1512x982, scaled to fill the window), like /jobs.
//  Left page, after an Observer Magazine page: three pictures from her posts set close together across the top,
//  then a giant initial with the story of how she started writing on Substack beside it.
//  Right page: every post in three columns of tall pictures, uneven heights, each with a short description.
// Below 768px: one column.
// Posts are pulled from Substack's public archive at build time, so titles, covers and dates stay current.
// Descriptions are set by hand in `posts` below (`desc`); a new post that isn't listed there uses its Substack subtitle.
import Analytics from '../components/Analytics.astro';

const PUB = 'https://verykritikal.substack.com';
const UTM = 'utm_source=Portfolio&utm_medium=Substacks+page&utm_campaign=Portfolio+launch&utm_id=kritikal-work';

// the story of how she started (100–120 words). DRAFT — to be replaced with her own words.
const STORY = 'Substack started as a postcard. In September 2025 I came back from a long weekend in Pondicherry with more to say than a caption could hold, so I wrote it down instead. Then I kept going. Since then I have written about the things I am still figuring out: love, living alone, work, and the places that change me a little. Some of it is funny, some of it is hard to read, and most of it began as a conversation I could not stop thinking about. Eight letters in, this is the most honest version of me on the internet.';

// the three pictures across the top of the left page
const TOP = ['gunshot-diary', 'was-he-a-fckboy', 'love-is-usually-just-around-the-corner'];

// her posts, newest first. `desc` is the description under each picture (her Substack subtitles for now).
// title/date/cover are the fallback if Substack can't be reached. `quote` stands in for a missing cover.
const posts = [
  { slug: 'a-house-by-the-beach-someday', desc: 'a post card from Goa', title: 'A house by the beach, someday', date: '2026-10-20T09:20:23.602Z', words: 821, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/22851840-4fb3-40a3-8e5c-47cdf4798ccb_736x736.jpeg' },
  { slug: 'on-being-watched-being-warned-and', desc: 'Small rules, quiet costs, and one uncomfortable morning', title: 'On being watched, being warned, and never being asked', date: '2026-10-10T10:59:03.893Z', words: 1274, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/43338fa9-9fb3-43a1-bb64-4c89ad6477cb_1080x1349.jpeg' },
  { slug: 'love-is-usually-just-around-the-corner', desc: 'but are you someone who won’t scare it away?', title: 'love is usually just around the corner', date: '2026-08-15T10:07:58.364Z', words: 731, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/5d2fa710-31d8-4d0c-91de-b5783773b674_736x538.jpeg' },
  { slug: 'unthought-known', desc: 'Some things are known before they are ever thought. This is one of those stories.', title: 'Unthought known', date: '2026-07-02T14:50:30.012Z', words: 1075, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/bb1646bf-5cdd-4839-8308-b33d54c4d672_1584x396.png' },
  { slug: 'data-vs-instincts', desc: 'And why what you can see is not enough!', title: 'Data vs Instincts', date: '2026-06-15T10:31:17.888Z', words: 1329, cover: '', quote: 'I defended first and answered after.' },
  { slug: 'was-he-a-fckboy', desc: 'On charm, damage, and the art of finally seeing them clearly', title: 'Was he a F*ckboy?', date: '2026-05-28T12:41:35.055Z', words: 862, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/4775d1f2-7a05-47ce-b211-73d7730dc316_1602x1190.jpeg' },
  { slug: 'gunshot-diary', desc: 'A story about an elongated sleepover with a stranger', title: 'Gunshot diary', date: '2026-03-27T11:40:06.497Z', words: 1474, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/ebc3dc39-5c4d-46f8-afe2-ad528a0a3e18_1170x892.png' },
  { slug: 'to-monish-aastha-tanay-krishna-and', desc: 'a postcard from Pondicherry 💌', title: 'to Monish, Aastha, Tanay, Krishna and others', date: '2025-09-01T08:39:02.886Z', words: 1509, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/f22b8cdd-bec9-4e95-a8ec-6ff0ab7f0a4f_3912x2373.jpeg' }
];

// pull the live archive; if it fails, the list above is used
let live: any[] = [];
try {
  const r = await fetch(`${PUB}/api/v1/archive?sort=new&limit=50`, { signal: AbortSignal.timeout(8000) });
  if (r.ok) live = await r.json();
} catch {}
live = live.filter((l) => l && l.slug && l.type !== 'podcast');
const mine = new Map(posts.map((p) => [p.slug, p]));
const all: any[] = live.length
  ? live.map((l) => {
      const p: any = mine.get(l.slug) || {};
      return { ...p, slug: l.slug, title: l.title || p.title, desc: p.desc || l.subtitle || '', date: l.post_date || p.date, words: l.wordcount || p.words, cover: l.cover_image || p.cover || '' };
    })
  : posts;

// covers come through Substack's image CDN at the size they're shown, not full size
const img = (url: string, w = 600) => !url ? '' : url.includes('substackcdn.com/image/fetch') ? url : `https://substackcdn.com/image/fetch/w_${w},c_limit,f_auto,q_auto:good,fl_progressive:steep/${encodeURIComponent(url)}`;
const href = (slug: string) => `${PUB}/p/${slug}?${UTM}`;
const mins = (w: number) => Math.max(1, Math.round(w / 215));
const day = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }).toLowerCase();

const top = TOP.map((s) => all.find((p) => p.slug === s)).filter(Boolean);

// three columns, filled top to bottom, newest first. pictures get uneven heights (weights) so the columns don't line up.
const per = Math.ceil(all.length / 3);
const weights = [[1.35, 0.9, 1.1], [0.85, 1.4, 1], [1.2, 1, 0.9]];
const cols = [0, 1, 2].map((c) => all.slice(c * per, c * per + per).map((p, i) => ({ ...p, w: weights[c][i % 3] })));
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · i write on Substack.</title>
<meta name="description" content="Kritika's Substack, VeryKritikal: essays on love, living alone, work, and the places that change her a little.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&amp;family=Hanken+Grotesk:wght@400;500&amp;family=EB+Garamond:ital,wght@0,400;0,500;1,400&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#fff;color:#1C1B1F;font-family:'Hanken Grotesk',sans-serif}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.fold{position:relative;height:100vh;overflow:hidden}
.stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}
.pageL{background:linear-gradient(100deg,#ffffff 0%,#fbfbf9 38%,#ffffff 52%,#f6f6f3 78%,#e9e8e4 96%,#d9d7d2 100%)}
.pageR{background:linear-gradient(80deg,#d6d4cf 0%,#e8e7e3 4%,#f7f7f4 20%,#ffffff 46%,#fafaf8 70%,#ffffff 100%)}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.75) 42%,rgba(255,255,255,0) 54%)}
.grain{position:absolute;inset:0;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.14;pointer-events:none}
.back{position:absolute;left:64px;top:40px;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}

/* left page: three pictures set close together */
.trio{position:absolute;left:64px;top:96px;width:636px;height:420px;display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
.trio a{display:block;overflow:hidden;background:#efece6}
.trio img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
.trio a:hover img,.trio a:focus-visible img{transform:scale(1.04)}
/* the giant initial, bleeding off the left edge, and the story beside it */
.cap{position:absolute;left:-40px;top:516px;margin:0;font-family:Geist,sans-serif;font-weight:600;font-size:500px;line-height:1;letter-spacing:-.04em;color:#1C1B1F;pointer-events:none}
.story{position:absolute;left:372px;top:574px;width:328px;margin:0;font-family:'EB Garamond',serif;font-size:17.5px;line-height:1.36;color:#1C1B1F;text-align:justify;hyphens:auto}

/* right page: three columns, tall pictures of uneven height */
.cols{position:absolute;left:812px;top:56px;width:640px;height:880px;display:grid;grid-template-columns:repeat(3,1fr);gap:0 14px}
.col{display:flex;flex-direction:column;gap:20px;min-height:0}
.en{display:flex;flex-direction:column;min-height:0}
.en .pic{flex:1 1 0;min-height:60px;overflow:hidden;background:#efece6}
.en .pic img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
.en .pic.none{display:flex;align-items:center;padding:16px;box-sizing:border-box;background:#F3E4DC;font-family:'EB Garamond',serif;font-style:italic;font-size:22px;line-height:1.2;color:#A9452A}
.en:hover .pic img,.en:focus-visible .pic img{transform:scale(1.04)}
.en .t{display:block;margin-top:9px;font-family:Geist,sans-serif;font-weight:500;font-size:14.5px;line-height:1.25;color:#1C1B1F;transition:color .25s}
.en:hover .t,.en:focus-visible .t{color:#A9452A}
.en .d{display:block;margin-top:3px;font-size:12.5px;line-height:1.38;color:#6f6862}
.en .mt{display:block;margin-top:5px;font-size:10px;letter-spacing:.18em;color:#8a837d}
@media (prefers-reduced-motion: reduce){.trio img,.en .pic img{transition:none}}

/* phones: one column */
.m{display:none}
@media (max-width: 767px){
  .fold{display:none}
  body{background:#fbfaf7}
  .m{display:block;padding:48px 16px 40px;box-sizing:border-box}
  .m .back{position:static;display:inline-block;min-height:32px}
  .m .trio{position:static;width:auto;height:240px;margin-top:12px;gap:4px}
  .m .mstory{position:relative;margin-top:22px;font-family:'EB Garamond',serif;font-size:18px;line-height:1.42;color:#1C1B1F}
  .m .mstory .big{float:left;margin:-2px 10px 0 -4px;font-family:Geist,sans-serif;font-weight:600;font-size:118px;line-height:.78;letter-spacing:-.04em}
  .m .list{display:grid;gap:30px;margin-top:40px}
  .m .en .pic{flex:none;aspect-ratio:4/5}
  .m .en .pic.none{aspect-ratio:auto;min-height:160px}
  .m .en .t{font-size:18px}
  .m .en .d{font-size:15px}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold" aria-label="i write on Substack">
<div class="stage">
<div class="pageL" aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 756px; height: 982px"></div>
<div class="pageR" aria-hidden="true" style="position: absolute; left: 756px; top: 0; width: 756px; height: 982px"></div>
<div class="sheen" aria-hidden="true" style="position: absolute; inset: 0; opacity: .6"></div>
<div class="grain" aria-hidden="true"></div>
<a class="back" href="/home-revamp">Back</a>
<h1 class="sr">i write on Substack.</h1>

<div class="trio">
{top.map((p) => <a href={href(p.slug)} target="_blank" rel="noopener" aria-label={p.title}><img src={img(p.cover)} alt="" loading="lazy"></a>)}
</div>
<p class="cap" aria-hidden="true">{STORY[0]}</p>
<p class="story"><span class="sr">{STORY[0]}</span>{STORY.slice(1)}</p>

<div class="cols">
{cols.map((col) => (
<div class="col">
{col.map((p) => (
<a class="en" href={href(p.slug)} target="_blank" rel="noopener" style={`flex: ${p.w} 1 0`}>
{p.cover
  ? <span class="pic"><img src={img(p.cover)} alt="" loading="lazy"></span>
  : <span class="pic none">“{p.quote || p.title}”</span>}
<span class="t">{p.title}</span>
<span class="d">{p.desc}</span>
<span class="mt">{day(p.date)} · {mins(p.words)} min read</span>
</a>
))}
</div>
))}
</div>
</div>
</section>

<main class="m">
<a class="back" href="/home-revamp">Back</a>
<h1 class="sr">i write on Substack.</h1>
<div class="trio">
{top.map((p) => <a href={href(p.slug)} target="_blank" rel="noopener" aria-label={p.title}><img src={img(p.cover)} alt="" loading="lazy"></a>)}
</div>
<p class="mstory"><span class="big" aria-hidden="true">{STORY[0]}</span><span class="sr">{STORY[0]}</span>{STORY.slice(1)}</p>
<div class="list">
{all.map((p) => (
<a class="en" href={href(p.slug)} target="_blank" rel="noopener">
{p.cover
  ? <span class="pic"><img src={img(p.cover)} alt="" loading="lazy"></span>
  : <span class="pic none">“{p.quote || p.title}”</span>}
<span class="t">{p.title}</span>
<span class="d">{p.desc}</span>
<span class="mt">{day(p.date)} · {mins(p.words)} min read</span>
</a>
))}
</div>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// the spread is zoomed to cover the window, like the desk (stops at 18% trimmed on unusual window shapes)
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82);document.querySelectorAll('.stage').forEach(function(st){st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';});}
addEventListener('resize',fit);fit();
</script>
</body>
</html>
