---
// Nexus case study (dummy draft): a black grid canvas with one route the reader follows, week by week.
import Base from '../layouts/Base.astro';

// The number at the top of each weekly email. Null = no email that week.
// Weeks 0–14 count activated merchants; weeks 15–21 are a percentage (seller step reached).
const weeks = ['22 apr','27 apr','4 may','11 may','18 may','25 may','1 jun','8 jun','15 jun','22 jun','29 jun','6 jul','13 jul','20 jul','27 jul','3 aug','10 aug','17 aug','24 aug','31 aug','7 sep','14 sep'];
const counts: (number | null)[] = [0,0,0,0,0,0,6,0,null,1,1,null,1,0,0];
const rates: (number | null)[] = [44.4,50,37.8,66.7,54.2,58.3,100];

const W = 1000, H = 260, PAD = 34, colW = (W - PAD * 2) / (weeks.length - 1);
const x = (i: number) => PAD + i * colW;
const yCount = (v: number) => H - 30 - (v / 6) * (H - 70);
const yRate = (v: number) => H - 30 - (v / 100) * (H - 70);
const line = (pts: [number, number | null][], y: (v: number) => number) => {
  let d = '', pen = false;
  for (const [i, v] of pts) {
    if (v === null) { pen = false; continue; }
    d += (pen ? ' L' : ' M') + x(i).toFixed(1) + ' ' + y(v).toFixed(1);
    pen = true;
  }
  return d.trim();
};
const countPts = counts.map((v, i) => [i, v] as [number, number | null]);
const ratePts = rates.map((v, i) => [i + 15, v] as [number, number | null]);
const markers = [
  { i: 0, n: 1, label: 'activated users' },
  { i: 7, n: 2, label: 'first order fulfilled' },
  { i: 15, n: 3, label: 'funnel steps' },
  { i: 16, n: 4, label: 'seller activation' }
];

const stops = [
  {
    num: '01', when: '22 apr – 29 may', big: '0', title: 'the launch',
    lines: [
      'Nexus went live on Shopify. five straight weeks of zero activated merchants.',
      'i set up the onboarding funnels in week one, before anyone asked for them. i wrote the product copy for taxes and payouts, and mapped every onboarding edge case.',
      'we shipped. the first installs trickled in: 6 one week, 7 the next. then the first Shopify review, and the first lead from the website.'
    ],
    chips: ['0', '0', '0', '0', '0', '0']
  },
  {
    num: '02', when: '1 – 5 jun', big: '6', title: 'the first milestone',
    lines: ['six merchants activated in a single week. the funnel worked.'],
    chips: ['6']
  },
  {
    num: '03', when: '8 jun – 31 jul', big: '0', title: 'zero, again',
    lines: [
      'i raised the bar. a merchant only counts once they fulfil a real order, because an install is not value.',
      'the number fell to zero and stayed there. seven weeks of zeroes and ones, sent every friday, while we fixed the order flows that blocked fulfilment.'
    ],
    chips: ['0', '1', '1', '1', '0', '0']
  },
  {
    num: '04', when: '4 aug', big: '↺', title: 'the note',
    lines: [
      'the founder wrote back: the target never moves, and your tasks don’t aim at it.',
      'by the next morning i had rebuilt the week around steps a merchant actually takes. baseline from session recordings: product sync 60%, seller sync 44%.'
    ],
    chips: []
  },
  {
    num: '05', when: '5 aug – 18 sep', big: '100%', title: 'the climb',
    lines: [
      'recordings showed merchants hitting a dead end after entering a seller’s email. no next step. i wrote the fix.',
      'i published order docs and demo videos, and onboarded one small, keen merchant by hand. we shipped billing, so merchants could subscribe from inside Nexus.',
      'seller sync went from 44% to 100%. installs went from 6 a week to 30. by mid-september, every store with products had activated its sellers: 10 out of 10.'
    ],
    chips: ['44%', '50%', '38%', '67%', '54%', '58%', '100%']
  }
];
---
<Base title="Nexus · the metric that wouldn't move · Kritika Upadhyay" description="Draft case study: 25 weeks of weekly emails, four tries at the right metric.">
<div class="cs">

<header class="cs-top">
<a class="cs-back" href="/">← home</a>
<span class="cs-tag">case study 01 · draft, dummy layout</span>
</header>

<section class="cs-hero">
<dl class="cs-facts">
<div><dt>role</dt><dd>[your title on Nexus]</dd></div>
<div><dt>product</dt><dd>Nexus, a Shopify app for multi-vendor marketplaces</dd></div>
<div><dt>stage</dt><dd>0 → 1, small team</dd></div>
<div><dt>span</dt><dd>25 weeks, one email every monday and friday</dd></div>
</dl>

<h1 class="cs-title">0 → 6 → 0 → <span class="cs-gold">100%</span></h1>
<p class="cs-sub">the metric that wouldn’t move</p>

<figure class="cs-chart">
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The number at the top of each weekly email: activated merchants from April to July, then seller activation rate from August to September, with four markers where the metric changed.">
<line x1={x(15) - colW / 2} y1="14" x2={x(15) - colW / 2} y2={H - 30} class="ch-split"></line>
<text x={PAD} y="20" class="ch-axis">activated merchants / week</text>
<text x={x(15)} y="20" class="ch-axis">% reaching the seller step</text>
{markers.map((m) => (
<g>
<line x1={x(m.i)} y1="34" x2={x(m.i)} y2={H - 30} class="ch-mark"></line>
<circle cx={x(m.i)} cy="40" r="9" class="ch-mark-dot"></circle>
<text x={x(m.i)} y="44" class="ch-mark-n">{m.n}</text>
</g>
))}
<path d={line(countPts, yCount)} class="ch-line"></path>
<path d={line(ratePts, yRate)} class="ch-line"></path>
{countPts.filter(([, v]) => v !== null).map(([i, v]) => <circle cx={x(i)} cy={yCount(v as number)} r="3.2" class="ch-dot"></circle>)}
{ratePts.map(([i, v]) => <circle cx={x(i)} cy={yRate(v as number)} r="3.2" class="ch-dot"></circle>)}
{weeks.map((w, i) => (i % 3 === 0 || i === weeks.length - 1) && <text x={x(i)} y={H - 8} class="ch-week">{w}</text>)}
</svg>
<figcaption class="cs-legend">
{markers.map((m) => <span><b>{m.n}</b>{m.label}</span>)}
</figcaption>
</figure>

<p class="cs-insight">the number you track decides the work you do. <em>it took me four tries to find the right one.</em></p>

<div class="cs-stats">
<div><span class="cs-stat">44% → 100%</span><span class="cs-stat-l">seller sync, in six weeks</span></div>
<div><span class="cs-stat">6 → 30</span><span class="cs-stat-l">installs a week</span></div>
<div><span class="cs-stat">10 / 10</span><span class="cs-stat-l">stores activating sellers, mid-september</span></div>
</div>
<p class="cs-follow">follow the line ↓</p>
</section>

<section class="cs-route" id="route">
<svg class="cs-path" aria-hidden="true"><path id="route-path"></path></svg>
{stops.map((s, k) => (
<article class={`cs-stop ${k % 2 ? 'right' : 'left'}`}>
<span class="cs-node" aria-hidden="true"></span>
<div class="cs-card">
<div class="cs-meta"><span>{s.num}</span><span>{s.when}</span></div>
<div class="cs-big">{s.big}</div>
<h2 class="cs-h">{s.title}</h2>
{s.lines.map((l) => <p>{l}</p>)}
{s.chips.length > 0 && <div class="cs-chips" aria-label="weekly numbers">{s.chips.map((c) => <span>{c}</span>)}</div>}
</div>
</article>
))}
</section>

<section class="cs-end">
<span class="cs-node end" aria-hidden="true"></span>
<p class="cs-then">and then, a new obstacle.</p>
<p class="cs-churn">churn.</p>
<a class="cs-back" href="/">← back to all work</a>
</section>

</div>
</Base>

<style is:global>
.sky,.sky a,.sky button{cursor:auto}
</style>

<style>
.cs{position:relative;min-height:100vh;color:#EFEFEE;background-color:#080808;background-image:linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:120px 120px,120px 120px,24px 24px,24px 24px;background-position:-1px -1px}
.cs-top{display:flex;justify-content:space-between;align-items:center;gap:16px;max-width:1200px;margin:0 auto;padding:24px}
.cs-back{color:#A9AFB9;font-size:13px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none}
.cs-back:hover{color:#EFEFEE}
.cs-tag{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#848484}
.cs-hero{max-width:1200px;margin:0 auto;padding:48px 24px 72px}
.cs-facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin:0 0 72px;border-top:1px solid #2A2A2A;border-left:1px solid #2A2A2A}
.cs-facts div{padding:14px 16px;border-right:1px solid #2A2A2A;border-bottom:1px solid #2A2A2A;background:rgba(8,8,8,.7)}
.cs-facts dt{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#848484;margin-bottom:6px}
.cs-facts dd{margin:0;font-size:15px;line-height:1.4}
.cs-title{margin:0;font-weight:500;font-size:clamp(48px,9vw,128px);line-height:1;letter-spacing:-.03em}
.cs-gold{color:#D8C9A3}
.cs-sub{margin:12px 0 56px;font-family:'Newsreader',serif;font-style:italic;font-size:clamp(24px,3vw,36px);color:#A9AFB9}
.cs-chart{margin:0;padding:20px;border:1px solid #2A2A2A;background:rgba(8,8,8,.75)}
.cs-chart svg{display:block;width:100%;height:auto;overflow:visible}
.ch-split{stroke:#3A3A3A;stroke-dasharray:4 4}
.ch-axis{fill:#848484;font-size:11px;letter-spacing:.08em}
.ch-mark{stroke:rgba(216,201,163,.35);stroke-width:1}
.ch-mark-dot{fill:#080808;stroke:#D8C9A3;stroke-width:1.2}
.ch-mark-n{fill:#D8C9A3;font-size:11px;text-anchor:middle}
.ch-line{fill:none;stroke:#EFEFEE;stroke-width:2;stroke-linejoin:round}
.ch-dot{fill:#EFEFEE}
.ch-week{fill:#848484;font-size:11px;text-anchor:middle}
.cs-legend{display:flex;flex-wrap:wrap;gap:8px 24px;margin-top:14px;font-size:13px;color:#A9AFB9}
.cs-legend b{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;margin-right:8px;border:1px solid #D8C9A3;border-radius:50%;font-size:11px;font-weight:500;color:#D8C9A3}
.cs-insight{max-width:820px;margin:56px 0 40px;font-size:clamp(22px,2.6vw,32px);line-height:1.3;letter-spacing:-.01em}
.cs-insight em{font-family:'Newsreader',serif;color:#D8C9A3}
.cs-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));border-top:1px solid #2A2A2A;border-left:1px solid #2A2A2A}
.cs-stats div{display:flex;flex-direction:column;gap:6px;padding:20px;border-right:1px solid #2A2A2A;border-bottom:1px solid #2A2A2A;background:rgba(8,8,8,.7)}
.cs-stat{font-size:clamp(28px,3.4vw,44px);font-weight:500;letter-spacing:-.02em}
.cs-stat-l{font-size:13px;color:#848484}
.cs-follow{margin:56px 0 0;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#848484;text-align:center}
.cs-route{position:relative;max-width:1200px;margin:0 auto;padding:40px 24px 80px;display:flex;flex-direction:column;gap:160px}
.cs-path{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
.cs-path path{fill:none;stroke:#D8C9A3;stroke-width:1.5;stroke-linecap:round}
.cs-stop{position:relative;display:flex}
.cs-stop.left{justify-content:flex-start}
.cs-stop.right{justify-content:flex-end}
.cs-node{position:absolute;top:28px;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:#080808;border:1.5px solid #3A3A3A;transition:border-color .4s ease,background-color .4s ease,box-shadow .4s ease}
.cs-stop.left .cs-node{left:calc(58% + 40px)}
.cs-stop.right .cs-node{left:calc(42% - 40px)}
.cs-node.on{border-color:#D8C9A3;background:#D8C9A3;box-shadow:0 0 0 6px rgba(216,201,163,.12)}
.cs-card{width:min(58%,640px);box-sizing:border-box;padding:28px;border:1px solid #2A2A2A;background:rgba(8,8,8,.88);opacity:.35;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease,border-color .6s ease}
.cs-stop.on .cs-card{opacity:1;transform:none;border-color:#3A3A3A}
.cs-meta{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#848484}
.cs-big{margin:18px 0 4px;font-size:clamp(64px,9vw,120px);font-weight:500;line-height:1;letter-spacing:-.04em}
.cs-h{margin:0 0 16px;font-family:'Newsreader',serif;font-style:italic;font-weight:400;font-size:28px;color:#D8C9A3}
.cs-card p{margin:0 0 12px;font-size:16px;line-height:1.65;color:#C9CDD5}
.cs-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:18px}
.cs-chips span{min-width:36px;padding:4px 8px;border:1px solid #2A2A2A;font-size:12px;text-align:center;color:#A9AFB9}
.cs-end{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;padding:40px 24px 160px;text-align:center}
.cs-node.end{position:relative;top:auto;left:auto;margin:0 0 24px}
.cs-then{margin:0;font-size:clamp(20px,2.4vw,28px);color:#A9AFB9}
.cs-churn{margin:0 0 64px;font-family:'Newsreader',serif;font-style:italic;font-size:clamp(72px,12vw,160px);line-height:1;color:#EFEFEE}
@media (max-width:760px){
.cs-route{gap:96px}
.cs-stop.left,.cs-stop.right{justify-content:flex-end}
.cs-stop.left .cs-node,.cs-stop.right .cs-node{left:8px}
.cs-card{width:calc(100% - 32px)}
}
@media (prefers-reduced-motion:reduce){.cs-card,.cs-node{transition:none}.cs-card{opacity:1;transform:none}}
</style>

<script>
  // Draw one route through every stop and reveal it as the reader scrolls.
  const route = document.getElementById('route');
  const path = document.getElementById('route-path') as SVGPathElement | null;
  const stops = Array.from(document.querySelectorAll<HTMLElement>('.cs-stop'));
  const endNode = document.querySelector<HTMLElement>('.cs-node.end');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let len = 0;

  const build = () => {
    if (!route || !path) return;
    const box = route.getBoundingClientRect();
    const pts = stops.map((s) => {
      const n = s.querySelector<HTMLElement>('.cs-node')!.getBoundingClientRect();
      return { x: n.left + n.width / 2 - box.left, y: n.top + n.height / 2 - box.top };
    });
    if (endNode) {
      const n = endNode.getBoundingClientRect();
      pts.push({ x: n.left + n.width / 2 - box.left, y: n.top + n.height / 2 - box.top });
    }
    let d = `M ${pts[0].x} 0 L ${pts[0].x} ${pts[0].y}`;
    for (let i = 1; i < pts.length; i++) {
      const a = pts[i - 1], b = pts[i], my = (a.y + b.y) / 2;
      d += ` C ${a.x} ${my}, ${b.x} ${my}, ${b.x} ${b.y}`;
    }
    path.setAttribute('d', d);
    len = path.getTotalLength();
    path.style.strokeDasharray = `${len}`;
    draw();
  };

  const draw = () => {
    if (!route || !path || !len) return;
    const box = route.getBoundingClientRect();
    const reach = window.innerHeight * 0.65 - box.top;
    const total = route.scrollHeight + (endNode ? 160 : 0);
    const p = calm ? 1 : Math.max(0, Math.min(1, reach / total));
    path.style.strokeDashoffset = `${len * (1 - p)}`;
    stops.forEach((s) => {
      const on = calm || s.getBoundingClientRect().top < window.innerHeight * 0.65;
      s.classList.toggle('on', on);
      s.querySelector('.cs-node')?.classList.toggle('on', on);
    });
    if (endNode) endNode.classList.toggle('on', calm || endNode.getBoundingClientRect().top < window.innerHeight * 0.75);
  };

  let queued = false;
  window.addEventListener('scroll', () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; draw(); });
  }, { passive: true });
  window.addEventListener('resize', build);
  window.addEventListener('load', build);
  build();
</script>
