---
// /lets-talk, "Let's talk!" — opened from 6 on the desk (/home-redo), the rotary phone.
// Desktop: one magazine spread (1512x982, scaled to fill the window), after a magazine "REVIEWS" contents page.
//  Both pages are a 3x3 grid of tiles in greens, so the spread reads as one 6x3 page:
//  left page = where to find her (H E Y, "i can be found on...", and the five channels as pictures),
//  right page = FAQs (F A Q and six questions). Hovering or tapping a tile zooms it; a question shows its answer.
// Below 768px: one column (channel cards, then the questions).
import Analytics from '../components/Analytics.astro';

const UTM = 'utm_source=Portfolio&utm_medium=Lets+talk&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const INK = '#2F4A35';
const icon = (inner: string, extra = '') => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${INK}" stroke-width="1.8" ${extra}>${inner}</svg>`;

// the channels. `pos` is where the picture is anchored inside its tile.
const ch = {
  linkedin: { name: 'LinkedIn', href: `https://www.linkedin.com/in/kritika-upadhyay-2001/?${UTM}`, img: '/lets-talk/linkedin.png', pos: '50% 38%', svg: icon('<rect x="3.5" y="3.5" width="17" height="17" rx="3"></rect><path d="M8 10.5v6M8 7.5v.1M12 16.5v-6M12 13c0-1.6 1-2.6 2.3-2.6S16.5 11.3 16.5 13v3.5"></path>', 'stroke-linecap="round"') },
  x: { name: 'X', href: `https://x.com/verykritikal?${UTM}`, img: '/lets-talk/x.webp', pos: '50% 50%', svg: icon('<path d="M4 4l16 16M20 4L4 20"></path>', 'stroke-linecap="round"') },
  instagram: { name: 'Instagram', href: `https://www.instagram.com/verykritikal/?${UTM}`, img: '/lets-talk/instagram.webp', pos: '45% 60%', svg: icon(`<rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".8" fill="${INK}"></circle>`) },
  email: { name: 'Email', href: 'mailto:kritikaupadhyay2001@gmail.com', img: '/lets-talk/email.webp', pos: '35% 40%', svg: icon('<rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path>', 'stroke-linejoin="round"') },
  whatsapp: { name: 'WhatsApp', href: 'https://wa.me/919109079518', img: '/lets-talk/whatsapp.webp', pos: '35% 45%', svg: icon('<path d="M4 20l1.4-4.2A8 8 0 1 1 8.4 19z"></path><path d="M9.2 9.2c.3 2.4 2.2 4.4 4.6 4.9l1-1.1 1.6.8" stroke-linecap="round"></path>', 'stroke-linejoin="round"') }
};
const channels = [ch.linkedin, ch.x, ch.instagram, ch.email, ch.whatsapp];

// the FAQs. DRAFT questions and answers — to be replaced with her own.
const faqs = [
  { n: '01', cat: 'work', q: 'what do you actually do?', a: 'i’m a product marketer. i figure out who a product is for, what to say to them and where, then i build the pages, launches and campaigns that say it.' },
  { n: '02', cat: 'projects', q: 'can i hire you for a project?', a: 'tell me what you’re building on any of the channels on the left. i’ll tell you honestly if i’m the right person for it.' },
  { n: '03', cat: 'writing', q: 'will you write something for me?', a: 'if it’s a story worth telling, yes. landing pages, launch posts, release notes, or one very long letter.' },
  { n: '04', cat: 'tools', q: 'what’s in your toolkit?', a: 'PostHog, Mixpanel, GA4 and Plausible for the numbers, Intercom for talking to people, and Claude for thinking out loud.' },
  { n: '05', cat: 'sundays', q: 'where do i find you on a sunday?', a: 'at Beanlore in Koramangala, reading in the sun. or at home, cooking enough rajma for a small wedding.' },
  { n: '06', cat: 'replies', q: 'how fast do you reply?', a: 'fastest on WhatsApp, a little slower on email. either way, you’ll hear back.' }
];

// the spread, row by row: 6 tiles across (3 per page), 3 rows. bg is the tile's green.
type Tile = { letter?: string; head?: boolean; ch?: typeof ch.x; faq?: number; bg: string };
const G1 = '#E6ECDD', G2 = '#D5E1CB', G3 = '#C6D6BB', DEEP = '#3E5A43';
const tiles: Tile[] = [
  { letter: 'H', bg: G1 }, { ch: ch.linkedin, bg: G2 }, { letter: 'E', bg: G1 },        { letter: 'F', bg: G1 }, { faq: 0, bg: G2 }, { letter: 'A', bg: G1 },
  { ch: ch.x, bg: G2 }, { head: true, bg: DEEP }, { letter: 'Y', bg: G1 },              { faq: 1, bg: G3 }, { letter: 'Q', bg: G1 }, { faq: 2, bg: G2 },
  { ch: ch.instagram, bg: G2 }, { ch: ch.email, bg: G3 }, { ch: ch.whatsapp, bg: G2 }, { faq: 3, bg: G2 }, { faq: 4, bg: G1 }, { faq: 5, bg: G3 }
];
// zoom grows inward from the tile's place on its page
const origin = (i: number) => `${['left', 'center', 'right'][i % 3]} ${['top', 'center', 'bottom'][Math.floor(i / 6)]}`;
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · Let's talk!</title>
<meta name="description" content="Where to find Kritika (LinkedIn, X, Instagram, email and WhatsApp), and a few FAQs.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Hanken+Grotesk:wght@400;500&amp;family=EB+Garamond:ital,wght@1,400&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#E6ECDD;color:#2F4A35;font-family:'Hanken Grotesk',sans-serif}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:2px solid #2F4A35;outline-offset:-4px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.fold{position:relative;height:100vh;overflow:hidden;background:#E6ECDD}
.stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}

/* the spread: 6 x 3 tiles, 3 per page */
.grid{position:absolute;inset:0;display:grid;grid-template-columns:repeat(6,1fr);grid-template-rows:repeat(3,1fr)}
.tl{position:relative;box-shadow:inset -1px -1px 0 rgba(47,74,53,.14)}
.tl.lt{display:flex;align-items:center;justify-content:center;font-family:Geist,sans-serif;font-weight:600;font-size:220px;line-height:1;letter-spacing:-.04em;color:#2F4A35}
.tl.hd{display:flex;flex-direction:column;justify-content:flex-end;padding:30px 28px;box-sizing:border-box;color:#E6ECDD}
.tl.hd p{margin:0;font-family:'EB Garamond',serif;font-style:italic;font-size:40px;line-height:1.05}
.tl.hd span{display:block;margin-top:14px;font-family:Geist,sans-serif;font-weight:600;font-size:11px;letter-spacing:.2em;text-transform:uppercase;opacity:.8}
/* every interactive tile zooms in place */
.z{position:absolute;inset:0;display:flex;flex-direction:column;box-sizing:border-box;border:0;margin:0;padding:0;font:inherit;color:inherit;text-align:left;cursor:pointer;z-index:1;transition:transform .5s cubic-bezier(.2,.7,.2,1),box-shadow .4s ease}
.z:hover,.z:focus-visible,.z.open{transform:scale(1.5);z-index:5;box-shadow:0 18px 40px rgba(30,50,35,.28)}
/* channel tiles: a picture with the platform on a band at the bottom */
.chn .pic{position:relative;flex:1 1 auto;overflow:hidden}
.chn .pic img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.chn .tag{display:flex;align-items:center;gap:9px;height:50px;flex:none;padding:0 18px;font-family:Geist,sans-serif;font-weight:600;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#2F4A35}
/* question tiles */
.qa{padding:28px 24px}
.qa .n{display:block;font-family:Geist,sans-serif;font-weight:600;font-size:50px;line-height:1;letter-spacing:-.03em}
.qa .c{display:block;margin-top:10px;font-family:Geist,sans-serif;font-weight:600;font-size:11px;letter-spacing:.18em;text-transform:uppercase}
.qa .q{display:block;margin-top:8px;font-family:'EB Garamond',serif;font-style:italic;font-size:21px;line-height:1.2;color:#22382A}
.qa .a{display:block;margin-top:10px;font-size:11px;line-height:1.5;color:#3d4a40;opacity:0;transition:opacity .3s ease}
.qa:hover .a,.qa:focus-visible .a,.qa.open .a{opacity:1;transition-delay:.12s}
@media (prefers-reduced-motion: reduce){.z,.qa .a{transition:none}}
/* paper: the fold down the middle, a soft sheen and grain over the whole spread */
.spine{position:absolute;left:716px;top:0;width:80px;height:982px;pointer-events:none;z-index:6;background:linear-gradient(90deg,rgba(0,0,0,0) 0%,rgba(30,45,32,.08) 42%,rgba(30,45,32,.16) 50%,rgba(255,255,255,.10) 54%,rgba(0,0,0,0) 100%)}
.sheen{position:absolute;inset:0;pointer-events:none;z-index:6;background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.22) 42%,rgba(255,255,255,0) 54%)}
.grain{position:absolute;inset:0;pointer-events:none;z-index:6;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.16}
.back{position:absolute;left:30px;top:26px;z-index:7;padding:6px 0;font-size:15px;color:#2F4A35;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}

/* phones: one column */
.m{display:none}
@media (max-width: 767px){
  .fold{display:none}
  .m{display:block;padding:48px 16px 40px;box-sizing:border-box}
  .m .back{position:static;display:inline-block;min-height:32px}
  .m h2{margin:22px 0 14px;font-family:'EB Garamond',serif;font-style:italic;font-weight:400;font-size:30px}
  .m .list{display:grid;gap:14px}
  .m .z{position:relative;inset:auto}
  .m .z:hover,.m .z:focus-visible,.m .z.open{transform:none;box-shadow:none}
  .m .chn{height:220px}
  .m .qa{padding:20px 18px}
  .m .qa .n{font-size:40px}
  .m .qa .a{display:none;font-size:15px;opacity:1}
  .m .qa.open .a{display:block}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold" aria-label="Let's talk!">
<div class="stage">
<h1 class="sr">Let's talk!</h1>
<div class="grid">
{tiles.map((t, i) => {
  const o = `transform-origin: ${origin(i)}; background: ${t.bg}`;
  if (t.letter) return <div class="tl lt" aria-hidden="true" style={`background: ${t.bg}`}>{t.letter}</div>;
  if (t.head) return <div class="tl hd" style={`background: ${t.bg}`}><p>i can be found on...</p><span>pick one, darling</span></div>;
  if (t.ch) return <div class="tl"><a class="z chn" href={t.ch.href} aria-label={t.ch.name} style={o} {...ext(t.ch.href)}><span class="pic"><img src={t.ch.img} alt="" loading="lazy" style={`object-position: ${t.ch.pos}`}></span><span class="tag"><Fragment set:html={t.ch.svg} /><span>{t.ch.name}</span></span></a></div>;
  const f = faqs[t.faq!];
  return <div class="tl"><button class="z qa" type="button" aria-expanded="false" style={o}><span class="n">{f.n}</span><span class="c">{f.cat}</span><span class="q">{f.q}</span><span class="a">{f.a}</span></button></div>;
})}
</div>
<div class="spine" aria-hidden="true"></div>
<div class="sheen" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>
<a class="back" href="/home-redo#desk">Back</a>
</div>
</section>

<main class="m">
<a class="back" href="/home-redo#desk">Back</a>
<h1 class="sr">Let's talk!</h1>
<h2>i can be found on...</h2>
<div class="list">
{channels.map((c, i) => <a class="z chn" href={c.href} aria-label={c.name} style={`background: ${[G2, G1, G2, G3, G2][i]}`} {...ext(c.href)}><span class="pic"><img src={c.img} alt="" loading="lazy" style={`object-position: ${c.pos}`}></span><span class="tag"><Fragment set:html={c.svg} /><span>{c.name}</span></span></a>)}
</div>
<h2>FAQs</h2>
<div class="list">
{faqs.map((f, i) => <button class="z qa" type="button" aria-expanded="false" style={`background: ${[G2, G3, G2, G1, G2, G3][i]}`}><span class="n">{f.n}</span><span class="c">{f.cat}</span><span class="q">{f.q}</span><span class="a">{f.a}</span></button>)}
</div>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// tap (or click) a question to keep it open; opening another closes the last one
document.querySelectorAll('.qa').forEach(function(b){b.addEventListener('click',function(){var was=b.classList.contains('open');document.querySelectorAll('.qa.open').forEach(function(o){o.classList.remove('open');o.setAttribute('aria-expanded','false')});if(!was){b.classList.add('open');b.setAttribute('aria-expanded','true')}})});
// the spread is zoomed to cover the window, like the desk (stops at 18% trimmed on unusual window shapes)
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82);document.querySelectorAll('.stage').forEach(function(st){st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';});}
addEventListener('resize',fit);fit();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
</html>
