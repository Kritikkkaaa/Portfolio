---
// /lets-talk, "Let's talk!" — opened from 6 on the desk (/home-redo), the rotary phone.
// Desktop: one magazine spread (1512x982, scaled to fill the window), after a magazine "REVIEWS" contents page.
//  Both pages are a 3x3 grid of tiles on white: a TALK band, a FAQs band, terracotta question tiles and pictures, one 6x3 page:
//  left page = where to find her (H E Y, "i can be found on...", and the five channels as pictures),
//  right page = FAQs (F A Q and six questions). Hovering or tapping a tile zooms it; a question shows its answer.
// Below 768px: one column (channel cards, then the questions).
import Analytics from '../components/Analytics.astro';

const UTM = 'utm_source=Portfolio&utm_medium=Lets+talk&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const INK = '#9C4A31';
const icon = (inner: string, extra = '') => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${INK}" stroke-width="1.8" ${extra}>${inner}</svg>`;

// the channels. `pos` is where the picture is anchored inside its tile; `msg`/`btn` show on hover.
const ch = {
  linkedin: { msg: 'i feel like a mis-fit here but we roll!', btn: 'me too!', name: 'LinkedIn', href: `https://www.linkedin.com/in/kritika-upadhyay-2001/?${UTM}`, img: '/lets-talk/linkedin.png', pos: '50% 38%', svg: icon('<rect x="3.5" y="3.5" width="17" height="17" rx="3"></rect><path d="M8 10.5v6M8 7.5v.1M12 16.5v-6M12 13c0-1.6 1-2.6 2.3-2.6S16.5 11.3 16.5 13v3.5"></path>', 'stroke-linecap="round"') },
  x: { msg: 'are you sure you are ready for this personality?', btn: 'yes', name: 'X', href: `https://x.com/verykritikal?${UTM}`, img: '/lets-talk/x.webp', pos: '50% 50%', svg: icon('<path d="M4 4l16 16M20 4L4 20"></path>', 'stroke-linecap="round"') },
  instagram: { msg: 'a whole lot of mirror selfies and questionable reposts!', btn: 'ooooh! interesting.', name: 'Instagram', href: `https://www.instagram.com/verykritikal/?${UTM}`, img: '/lets-talk/instagram.webp', pos: '45% 60%', svg: icon(`<rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".8" fill="${INK}"></circle>`) },
  email: { msg: 'you want to schedule an interview!', btn: 'Yes.', name: 'Email', href: 'mailto:kritikaupadhyay2001@gmail.com', img: '/lets-talk/email.webp', pos: '35% 40%', svg: icon('<rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path>', 'stroke-linejoin="round"') },
  whatsapp: { msg: 'voice notes only!', btn: 'I am not a weirdo!', name: 'Send a voice note', href: 'https://wa.me/919109079518', img: '/lets-talk/whatsapp.webp', pos: '35% 45%', svg: icon('<rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"></path>', 'stroke-linecap="round"') }
};
const channels = [ch.linkedin, ch.x, ch.instagram, ch.email, ch.whatsapp];

// the FAQs, in her words.
const faqs = [
  { n: '01', cat: 'work', q: 'what do you actually do?', a: 'i am a marketer and a creative. i was a product manager. and i want to create more. stories, short films, culture, your next campaign!\n\nfor you, i can be a hardworking individual who will be in your corner for life.' },
  { n: '02', cat: 'next', q: 'is this your best work?', a: 'no. that one’s still coming. with you, ideally.' },
  { n: '03', cat: 'writing', q: 'what can you write? what’s your medium?', a: 'everything. creatively.\n\ni have also done landing pages, blogs, grown Twitter and built a product. formally. at different jobs.' },
  { n: '04', cat: 'proof', q: 'how do i know you are good?', a: 'you don’t. you trust your judgement instead, after checking out this website, and give me a call.' },
  { n: '05', cat: 'friends', q: 'i want us to be friends.', a: 'are you sure? i read books, talk back, cancel plans, cook weird recipes, watch shows and keep playing on Claude.' },
  { n: '06', cat: 'joining', q: 'when can you join us?', a: 'the moment you say “welcome aboard!” i will already be thinking about your brand on my way home.' }
];

// the spread: 6 tiles across (3 per page), 3 rows. A band (TALK, FAQs) spans its page's 3 tiles and doesn't zoom.
// `col`/`row` place each tile so the zoom grows inward from its spot on the page.
type Tile = { band?: string; pitch?: boolean; ch?: typeof ch.x; faq?: number; bg: string; col: number; row: number };
const W = '#FFFFFF', T = '#9C4A31', G1 = W, G2 = W, G3 = W;
// the creator's note on the right page.
const PITCH = 'if you are still checking this out, thank you! means a lot. but what would mean more, is if you picked up your phone and gave me a call.';
const tiles: Tile[] = [
  { band: 'TALK', bg: W, col: 0, row: 0 },                                                                  { ch: ch.email, bg: W, col: 3, row: 0 }, { faq: 3, bg: T, col: 4, row: 0 }, { ch: ch.whatsapp, bg: W, col: 5, row: 0 },
  { ch: ch.x, bg: W, col: 0, row: 1 }, { faq: 0, bg: T, col: 1, row: 1 }, { ch: ch.linkedin, bg: W, col: 2, row: 1 }, { faq: 4, bg: T, col: 3, row: 1 }, { pitch: true, bg: W, col: 4, row: 1 }, { faq: 5, bg: T, col: 5, row: 1 },
  { faq: 1, bg: T, col: 0, row: 2 }, { ch: ch.instagram, bg: W, col: 1, row: 2 }, { faq: 2, bg: T, col: 2, row: 2 }, { band: 'FAQs', bg: W, col: 3, row: 2 }
];
const origin = (t: Tile) => `${['left', 'center', 'right'][t.col % 3]} ${['top', 'center', 'bottom'][t.row]}`;
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · Let's talk!</title>
<meta name="description" content="Where to find Kritika (LinkedIn, X, Instagram, email and WhatsApp), and a few FAQs.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Hanken+Grotesk:wght@400;500&amp;family=EB+Garamond:ital,wght@1,400&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#FFFFFF;color:#9C4A31;font-family:'Hanken Grotesk',sans-serif}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:2px solid #9C4A31;outline-offset:-4px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.fold{position:relative;height:100vh;overflow:hidden;background:#FFFFFF}
.stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}

/* the spread: 6 x 3 tiles, 3 per page */
.grid{position:absolute;inset:0;display:grid;grid-template-columns:repeat(6,1fr);grid-template-rows:repeat(3,1fr)}
.tl{position:relative;box-shadow:inset -1px -1px 0 rgba(120,60,40,.12)}
.tl.bd{grid-column:span 3;display:flex;align-items:center;justify-content:center;font-family:Geist,sans-serif;font-weight:600;font-size:220px;line-height:1;letter-spacing:-.04em;color:#9C4A31;align-items:center;justify-content:center}
/* TALK carries a magazine kicker and a cover line */
.talk .cover{position:absolute;right:96px;bottom:44px;margin:0;font-family:'EB Garamond',serif;font-style:italic;font-weight:400;font-size:24px;line-height:1;letter-spacing:0;opacity:.55;transform:rotate(-3deg)}
.talk .cover svg{display:block;width:100%;height:8px;margin-top:3px}
/* the note on the right page */
.tl.pt{box-shadow:none;display:flex;flex-direction:column;justify-content:space-between;padding:28px 26px;box-sizing:border-box;color:#9C4A31}
.tl.pt .lb{font-family:Geist,sans-serif;font-weight:600;font-size:11px;letter-spacing:.18em;text-transform:uppercase;opacity:.8}
.tl.pt p{margin:0;font-family:'Hanken Grotesk',sans-serif;font-weight:500;font-size:18px;line-height:1.4}
/* every interactive tile zooms in place */
.z{position:absolute;inset:0;display:flex;flex-direction:column;box-sizing:border-box;border:0;margin:0;padding:0;font:inherit;color:inherit;text-align:left;cursor:pointer;z-index:1;transition:transform .5s cubic-bezier(.2,.7,.2,1),box-shadow .4s ease}
.z:hover,.z:focus-visible,.z.open{transform:scale(1.5);z-index:5;box-shadow:0 18px 40px rgba(80,35,20,.28)}
/* channel tiles: a picture with the platform on a band at the bottom. No zoom: hovering shows a note and a button. */
.chn{position:absolute;inset:0;display:flex;flex-direction:column;cursor:pointer}
.chn .ov{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;gap:18px;padding:28px 26px;box-sizing:border-box;background:rgba(124,52,32,.9);color:#FBEFE6;opacity:0;transition:opacity .25s ease}
.chn:hover .ov,.chn:focus-visible .ov{opacity:1}
.chn .msg{font-family:'Hanken Grotesk',sans-serif;font-weight:500;font-size:22px;line-height:1.25;color:#FFFFFF}
.chn .btn{display:inline-flex;align-items:center;min-height:38px;padding:0 18px;border-radius:999px;background:#FBEFE6;color:#9C4A31;font-family:Geist,sans-serif;font-weight:600;font-size:12px;letter-spacing:.06em}
.chn .btn::after{content:'\2192';margin-left:8px}
.chn .pic{position:relative;flex:1 1 auto;overflow:hidden}
.chn .pic img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.chn .tag{display:flex;align-items:center;gap:9px;height:50px;flex:none;padding:0 18px;font-family:Geist,sans-serif;font-weight:600;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#9C4A31}
/* question tiles */
.qa{padding:28px 24px;color:#FBEFE6}
.qa:focus-visible{outline-color:#FBEFE6}
.qa .n{display:block;font-family:Geist,sans-serif;font-weight:600;font-size:50px;line-height:1;letter-spacing:-.03em}
.qa .c{display:block;margin-top:10px;font-family:Geist,sans-serif;font-weight:600;font-size:11px;letter-spacing:.18em;text-transform:uppercase}
.qa .q{display:block;margin-top:10px;font-family:'Hanken Grotesk',sans-serif;font-weight:500;font-size:19px;line-height:1.3;color:#FFFFFF}
.qa .a{display:block;white-space:pre-line;margin-top:12px;font-size:12px;line-height:1.5;color:#FFFFFF;opacity:0;transition:opacity .3s ease}
.qa:hover .a,.qa:focus-visible .a,.qa.open .a{opacity:1;transition-delay:.12s}
@media (prefers-reduced-motion: reduce){.z,.qa .a,.chn .ov{transition:none}}
/* paper: the fold down the middle, a soft sheen and grain over the whole spread */
.spine{position:absolute;left:calc(50% - 40px);top:0;width:80px;height:100%;pointer-events:none;z-index:6;background:linear-gradient(90deg,rgba(0,0,0,0) 0%,rgba(60,30,20,.06) 42%,rgba(60,30,20,.13) 50%,rgba(255,255,255,.10) 54%,rgba(0,0,0,0) 100%)}
.sheen{position:absolute;inset:0;pointer-events:none;z-index:6;background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.22) 42%,rgba(255,255,255,0) 54%)}
.grain{position:absolute;inset:0;pointer-events:none;z-index:6;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.16}
.back{position:absolute;left:30px;top:26px;z-index:7;padding:6px 0;font-size:15px;color:#9C4A31;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}

/* phones: one column */
.m{display:none}
@media (max-width: 767px){
  .fold{display:none}
  .m{display:block;padding:48px 16px 40px;box-sizing:border-box}
  .m .back{position:static;display:inline-block;min-height:32px}
  .m h2{margin:22px 0 14px;font-family:'EB Garamond',serif;font-style:italic;font-weight:400;font-size:30px}
  .m .list{display:grid;gap:14px}
  .m .z{position:relative;inset:auto}
  .m .z:hover,.m .z:focus-visible,.m .z.open{transform:none;box-shadow:none}
  .m .chn{position:relative;inset:auto;height:220px}
  .m .chn .ov{display:none}
  .m .qa{padding:20px 18px}
  .m .qa .n{font-size:40px}
  .m .qa .a{display:none;font-size:15px;opacity:1}
  .m .qa.open .a{display:block}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold" aria-label="Let's talk!">
<div class="stage">
<h1 class="sr">Let's talk!</h1>
<div class="grid">
{tiles.map((t) => {
  const o = `transform-origin: ${origin(t)}; background: ${t.bg}`;
  if (t.band === 'TALK') return <div class="tl bd talk"><span aria-hidden="true">TALK</span><p class="cover">pick your stage, darling!<svg viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9c60-6 140-8 296-3" fill="none" stroke="#9C4A31" stroke-width="2.4" stroke-linecap="round"/></svg></p></div>;
  if (t.band) return <div class="tl bd" aria-hidden="true">{t.band}</div>;
  if (t.pitch) return <div class="tl pt" style={`background: ${t.bg}`}><span class="lb">creator’s note.</span><p>{PITCH}</p></div>;
  if (t.ch) return <div class="tl"><a class="chn" href={t.ch.href} aria-label={`${t.ch.name}: ${t.ch.btn}`} style={`background: ${t.bg}`} {...ext(t.ch.href)}><span class="pic"><img src={t.ch.img} alt="" loading="lazy" style={`object-position: ${t.ch.pos}`}></span><span class="tag"><Fragment set:html={t.ch.svg} /><span>{t.ch.name}</span></span><span class="ov" aria-hidden="true"><span class="msg">{t.ch.msg}</span><span class="btn">{t.ch.btn}</span></span></a></div>;
  const f = faqs[t.faq!];
  return <div class="tl"><button class="z qa" type="button" aria-expanded="false" style={o}><span class="n">{f.n}</span><span class="c">{f.cat}</span><span class="q">{f.q}</span><span class="a">{f.a}</span></button></div>;
})}
</div>
<div class="spine" aria-hidden="true"></div>
<div class="sheen" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>
<a class="back" href="/home-redo#desk">Back</a>
</div>
</section>

<main class="m">
<a class="back" href="/home-redo#desk">Back</a>
<h1 class="sr">Let's talk!</h1>
<h2>i can be found on...</h2>
<div class="list">
{channels.map((c, i) => <a class="z chn" href={c.href} aria-label={c.name} style={`background: ${[G2, G1, G2, G3, G2][i]}`} {...ext(c.href)}><span class="pic"><img src={c.img} alt="" loading="lazy" style={`object-position: ${c.pos}`}></span><span class="tag"><Fragment set:html={c.svg} /><span>{c.name}</span></span></a>)}
</div>
<h2>FAQs</h2>
<div class="list">
{faqs.map((f, i) => <button class="z qa" type="button" aria-expanded="false" style={`background: ${T}`}><span class="n">{f.n}</span><span class="c">{f.cat}</span><span class="q">{f.q}</span><span class="a">{f.a}</span></button>)}
</div>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// tap (or click) a question to keep it open; opening another closes the last one
document.querySelectorAll('.qa').forEach(function(b){b.addEventListener('click',function(){var was=b.classList.contains('open');document.querySelectorAll('.qa.open').forEach(function(o){o.classList.remove('open');o.setAttribute('aria-expanded','false')});if(!was){b.classList.add('open');b.setAttribute('aria-expanded','true')}})});
// the spread fills the window exactly: scaled to fit, then the grid stretches to the window's shape, so no row is ever cut off
function fit(){var s=Math.min(innerWidth/1512,innerHeight/982);document.querySelectorAll('.stage').forEach(function(st){st.style.transform='scale('+s+')';st.style.width=(innerWidth/s)+'px';st.style.height=(innerHeight/s)+'px';});}
addEventListener('resize',fit);fit();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
</html>
