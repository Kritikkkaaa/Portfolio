<style is:inline>
html,body{margin:0;height:100%;overflow:hidden;background:#efe7d6}
#stage{position:absolute;left:0;top:0;transform-origin:0 0}
a{color:#A9452A;text-decoration:none}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}

/* the whole spread: damask printed on glossy magazine stock, held back so it only reads as texture */
.spread{position:relative;width:1512px;height:982px;overflow:hidden;font-family:'Hanken Grotesk',sans-serif;color:#1C1B1F;
  background:url(/desk/damask.jpg) 0 0/360px auto repeat}
.wash{position:absolute;inset:0;background:rgba(250,246,238,.68)}
.gloss{position:absolute;inset:0;background:linear-gradient(118deg,rgba(255,255,255,0) 22%,rgba(255,255,255,.55) 36%,rgba(255,255,255,0) 50%),linear-gradient(118deg,rgba(255,255,255,0) 62%,rgba(255,255,255,.25) 70%,rgba(255,255,255,0) 78%)}
.spine{position:absolute;left:0;top:0;width:1512px;height:982px;background:linear-gradient(90deg,rgba(0,0,0,0) 44%,rgba(70,50,30,.10) 49.2%,rgba(70,50,30,.22) 50%,rgba(70,50,30,.08) 50.8%,rgba(0,0,0,0) 56%),linear-gradient(90deg,rgba(70,50,30,.10) 0%,rgba(0,0,0,0) 4%,rgba(0,0,0,0) 96%,rgba(70,50,30,.10) 100%)}

/* left page: the lotus print on glossy stock, held back so it stays a background */
.lotus{position:absolute;left:0;top:0;width:756px;height:982px;overflow:hidden}
.lotus .img{position:absolute;inset:0;background:url(/desk/lotus-wall.jpg) left center/cover no-repeat;filter:saturate(.82) brightness(.88) contrast(.96)}
.lotus .dim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(40,8,14,.18) 0%,rgba(40,8,14,.30) 60%,rgba(30,6,10,.42) 100%)}
.lotus .shine{position:absolute;inset:0;background:linear-gradient(118deg,rgba(255,255,255,0) 18%,rgba(255,255,255,.16) 32%,rgba(255,255,255,0) 46%),linear-gradient(118deg,rgba(255,255,255,0) 60%,rgba(255,255,255,.07) 68%,rgba(255,255,255,0) 76%)}
.back{position:absolute;left:72px;top:40px;padding:6px 0;font-size:15px;color:#f1e6dc;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px;z-index:2}

/* the postcard: perforated stamp edge and a thin red inner rule; the photo on top, the note written in below,
   and the lotus stamp (with its postmark) at the bottom right */
.card-wrap{position:absolute;left:120px;top:91px;width:516px;height:800px;transform:scale(.84);transform-origin:50% 50%;filter:drop-shadow(0 16px 26px rgba(20,4,8,.42))}
.card{position:absolute;inset:0;box-sizing:border-box;background:#f4f0e9;
  -webkit-mask:radial-gradient(circle 5px at 50% 50%,transparent 98%,#000) -5px -5px/14px 14px,linear-gradient(#000,#000) 7px 7px/calc(100% - 14px) calc(100% - 14px) no-repeat;
  mask:radial-gradient(circle 5px at 50% 50%,transparent 98%,#000) -5px -5px/14px 14px,linear-gradient(#000,#000) 7px 7px/calc(100% - 14px) calc(100% - 14px) no-repeat}
.card .rule{position:absolute;inset:16px;border:1px solid rgba(169,69,42,.45);border-radius:10px;pointer-events:none}
.photo{position:absolute;left:44px;right:44px;top:44px;height:214px;margin:0;overflow:hidden;border-radius:2px;box-shadow:0 0 0 1px rgba(60,20,20,.12)}
.photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 30%}
.note{position:absolute;left:44px;right:44px;top:286px;margin:0;font-family:'Courier Prime',ui-monospace,monospace;font-size:17px;line-height:1.6;color:#5a2a26}
.note{white-space:pre-line}
.note .hello{display:inline-block;font-size:1.45em;line-height:1.3}
.note a{white-space:nowrap;font-weight:700;color:inherit;text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
.note a:hover,.note a:focus-visible{text-decoration-thickness:2px}
.stamp{position:absolute;right:40px;bottom:40px;width:84px;height:100px}
.stamp .pic{position:absolute;inset:0;padding:5px;background:#fbf8f2;
  -webkit-mask:radial-gradient(circle 3px at 50% 50%,transparent 98%,#000) -3px -3px/8px 8px,linear-gradient(#000,#000) 4px 4px/calc(100% - 8px) calc(100% - 8px) no-repeat;
  mask:radial-gradient(circle 3px at 50% 50%,transparent 98%,#000) -3px -3px/8px 8px,linear-gradient(#000,#000) 4px 4px/calc(100% - 8px) calc(100% - 8px) no-repeat}
.stamp .pic span{display:block;width:100%;height:100%;box-sizing:border-box;background:url(/desk/lotus-stamp.jpg) center/cover}
.stamp .val{position:absolute;right:9px;bottom:8px;font:600 9px Geist,sans-serif;color:#fbf8f2;letter-spacing:.04em}
.postmark{position:absolute;right:76px;bottom:70px;width:120px;height:70px;transform:rotate(-12deg);opacity:.75}
.postmark circle,.postmark path{fill:none;stroke:#a33a3a;stroke-width:1.2}
.postmark text{font:600 7.5px Geist,sans-serif;fill:#a33a3a;letter-spacing:.08em}

/* right page: lotus endpaper. blush paper with thin vertical pinstripes (a pale line with a faint maroon shadow, like a pressed rule),
   the same gloss as the left page, and a soft maroon shadow at the fold so the two pages share the spine */
.rpage{position:absolute;left:756px;top:0;width:756px;height:982px;overflow:hidden;background:#f2e3de}
.rpage .pat{position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,0) 0 108px,rgba(255,255,255,.75) 108px 111px,rgba(110,30,43,.13) 111px 112.5px,rgba(255,255,255,0) 112.5px 116px)}
.rpage .blush{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 55%,rgba(246,236,232,.55) 0%,rgba(246,236,232,0) 70%)}
.rpage .shine{position:absolute;inset:0;background:linear-gradient(118deg,rgba(255,255,255,0) 18%,rgba(255,255,255,.35) 32%,rgba(255,255,255,0) 46%),linear-gradient(118deg,rgba(255,255,255,0) 60%,rgba(255,255,255,.15) 68%,rgba(255,255,255,0) 76%)}
.rpage .fold{position:absolute;left:0;top:0;width:90px;height:100%;background:linear-gradient(90deg,rgba(90,20,30,.26) 0%,rgba(90,20,30,.08) 40%,rgba(90,20,30,0) 100%)}
/* hover: each of the six swings out a paper tag on a string (where it goes, and its number), like a price tag on an antique */
.tag{position:absolute;left:150px;top:26px;width:0;height:0;transform-origin:0 0;opacity:0;transform:rotate(-38deg);pointer-events:none;filter:drop-shadow(0 6px 6px rgba(70,30,30,.22));transition:opacity .2s ease}
.tag .str{position:absolute;left:0;top:0;width:1px;height:46px;background:#7a5a46;transform-origin:0 0}
.tag .tcard{position:absolute;left:-58px;top:44px;width:116px;box-sizing:border-box;padding:22px 10px 10px;background:#f6efe2;border-radius:3px;
  clip-path:polygon(22% 0,78% 0,100% 16%,100% 100%,0 100%,0 16%);text-align:center}
.tag .hole{position:absolute;left:50%;top:7px;width:7px;height:7px;margin-left:-3.5px;border-radius:50%;background:#e9d8cf;box-shadow:inset 0 1px 1px rgba(0,0,0,.25)}
.tag b{display:block;font:600 15px Geist,sans-serif;color:#B8577A;line-height:1}
.tag .t{display:block;margin-top:5px;font-family:'EB Garamond',serif;font-style:italic;font-size:15px;line-height:1.15;color:#6E1E2B}
.cut:hover .tag,.cut.is-focus .tag,.cut:focus-visible .tag{opacity:1;animation:swing 1.3s cubic-bezier(.3,.6,.4,1) forwards}
@keyframes swing{0%{transform:rotate(-38deg)}30%{transform:rotate(14deg)}52%{transform:rotate(-7deg)}72%{transform:rotate(3deg)}88%{transform:rotate(-1deg)}100%{transform:rotate(0)}}

@media (prefers-reduced-motion: reduce){.cut:hover .tag,.cut.is-focus .tag{animation:none;transform:none}}
/* left page: a regular mouse, no viewfinder (the cursor script's own rules are beaten by the extra class) */
html.kc-on.kc-plain .kc-box{opacity:0 !important}
html.kc-on.kc-plain,html.kc-on.kc-plain *{cursor:auto !important}
html.kc-on.kc-plain a,html.kc-on.kc-plain a *{cursor:pointer !important}
/* 3: holds still until hovered, then the thread starts unwinding */
/* right page: the title sits in the middle of the oval, the six in three rows (1 2 / 3 / 4 5 6), every tile the same 180x180 */
.tile{width:180px;height:180px}
.lbl{position:absolute;left:50%;top:100%;transform:translateX(-50%);margin-top:6px;white-space:nowrap;font-family:Cinzel,serif;font-weight:600;font-size:15px;letter-spacing:.18em;text-transform:uppercase;color:#6E1E2B;pointer-events:none;transition:opacity .2s ease}
.cut:hover .lbl,.cut.is-focus .lbl,.cut:focus-visible .lbl{opacity:0}
@media (hover: none){.lbl{display:none}}
/* the crossword: paper cells ruled in red, solid red blocks, small clue numbers */
.xw{width:180px;height:auto;display:block;filter:drop-shadow(0 8px 10px rgba(70,50,35,.22));transform:rotate(-2deg)}
.xw .xc{fill:#f6f1ea;stroke:#C2453A;stroke-width:1}
.xw .xb,.xw .xk{fill:#C2453A;stroke:#C2453A;stroke-width:1}
.xw .xh{fill:#f6f1ea}
.xw .xl{font:600 15px Geist,sans-serif;fill:#C2453A;text-anchor:middle;letter-spacing:.02em}
.xw .xn{font:500 6.5px Geist,sans-serif;fill:#C2453A}
.tile .box img{max-width:180px;max-height:180px}
.cut{position:absolute;display:block}
.cut .box{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;transition:transform .5s cubic-bezier(.3,1.4,.5,1)}
.cut img{filter:saturate(1.1) contrast(1.04) drop-shadow(0 8px 10px rgba(70,50,35,.24))}
.cut:hover .box,.cut.is-focus .box{transform:translateY(-8px)}
.no{position:absolute;font-family:Geist,sans-serif;font-weight:600;font-size:16px;color:#B8577A}
.brn{position:relative;display:block;width:330px;height:250px;transform:scale(.56);flex:none}
.brn img{position:absolute;display:block;height:auto}
.brn .bc{left:0;top:6px;width:150px;transform:rotate(-8deg)}
.brn .bb{left:128px;top:56px;width:176px}
.brn .bk{left:148px;top:-4px;width:62px;transform:rotate(6deg)}
.brn .bs{left:84px;top:160px;width:34px;transform:rotate(22deg)}
.pola{position:relative;display:block;width:180px;box-sizing:border-box;padding:9px 9px 0;background:#fbf9f3;box-shadow:0 10px 18px rgba(70,50,35,.24);transform:rotate(-3deg)}
.pola .ph{display:block;height:92px;overflow:hidden}
.pola .ph img{width:100%;height:100%;object-fit:cover;filter:none}
.pola .cap{display:block;height:38px;line-height:40px;text-align:center;font-family:Caveat,cursive;font-size:23px;color:#2a2724}

/* focus: one thing at a time */
.cut{transition:opacity .35s ease}
.spread.focusing .cut:not(.is-focus){opacity:.14}

@media (prefers-reduced-motion: reduce){*{transition:none !important}}

/* ---------- Phones (under 768px): one column. The lotus page and its postcard first, then Contents as cards. ---------- */
.ph{display:none}
@media (max-width: 767px){
  html,body{height:auto;overflow:auto;-webkit-text-size-adjust:100%;background:#f2e3de}
  #stage{display:none}
  .ph{display:block;font-family:'Hanken Grotesk',sans-serif;color:#1C1B1F}
  .ph a{-webkit-tap-highlight-color:transparent}
  /* the lotus page */
  .ph-l{position:relative;min-height:100svh;box-sizing:border-box;padding:max(24px,env(safe-area-inset-top)) 16px 76px;display:flex;flex-direction:column;overflow:hidden;background:#3a0f16}
  .ph-l .bg{position:absolute;inset:0;background:url(/desk/lotus-wall.jpg) left top/auto 100% no-repeat;filter:saturate(.82) brightness(.88) contrast(.96)}
  .ph-l .dim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(40,8,14,.30) 0%,rgba(40,8,14,.45) 100%)}
  .ph-l .shine{position:absolute;inset:0;background:linear-gradient(118deg,rgba(255,255,255,0) 18%,rgba(255,255,255,.14) 32%,rgba(255,255,255,0) 46%)}
  .ph-back{position:relative;align-self:flex-start;display:inline-flex;align-items:center;min-height:44px;font-size:15px;color:#f1e6dc;text-decoration:underline;text-underline-offset:3px}
  .ph-post{position:relative;margin:auto;width:100%;max-width:420px;filter:drop-shadow(0 14px 22px rgba(20,4,8,.42))}
  .ph-post .card{position:relative;inset:auto;padding:30px 28px 26px}
  .ph-post .rule{inset:14px}
  .ph-post .photo{position:relative;left:auto;right:auto;top:auto;height:auto;aspect-ratio:2/1}
  .ph-post .note{position:relative;left:auto;right:auto;top:auto;margin:18px 0 0;font-size:15px;line-height:1.6}
  .ph-post .foot{position:relative;height:96px;margin-top:6px}
  .ph-post .stamp{right:0;bottom:0;width:72px;height:86px}
  .ph-post .postmark{right:32px;bottom:22px;width:104px;height:60px}
  .ph-next{position:absolute;left:0;right:0;bottom:max(14px,env(safe-area-inset-bottom));justify-content:center;margin:0;padding:0;display:inline-flex;align-items:center;gap:8px;min-height:44px;font-family:'EB Garamond',serif;font-style:italic;font-size:18px;color:#f1e6dc}
  .ph-next span{display:inline-block;animation:nudge 1.8s ease-in-out infinite}
  @keyframes nudge{0%,100%{transform:translateY(0)}50%{transform:translateY(4px)}}
  /* Contents */
  .ph-r{position:relative;padding:40px 16px max(40px,env(safe-area-inset-bottom));background:#f2e3de;overflow:hidden}
  .ph-r::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,0) 0 64px,rgba(255,255,255,.75) 64px 66px,rgba(110,30,43,.12) 66px 67px,rgba(255,255,255,0) 67px 70px);pointer-events:none}
  .ph-r::after{content:"";position:absolute;left:0;right:0;top:0;height:28px;background:linear-gradient(180deg,rgba(90,20,30,.20),rgba(90,20,30,0));pointer-events:none}
  .ph-r h2{position:relative;margin:0 0 22px;text-align:center;font-family:Cinzel,serif;font-weight:500;font-size:30px;letter-spacing:.14em;text-transform:uppercase;color:#6E1E2B}
  .ph-grid{position:relative;list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .ph-item{display:flex;flex-direction:column;align-items:center;height:100%;box-sizing:border-box;padding:18px 10px 16px;border-radius:16px;background:rgba(251,246,243,.94);box-shadow:0 1px 0 rgba(110,30,43,.06),0 8px 18px rgba(110,30,43,.08);transition:transform .15s ease}
  .ph-item:active{transform:scale(.97)}
  .ph-art{display:flex;align-items:center;justify-content:center;height:128px;width:100%}
  .ph-art img{max-width:124px;max-height:124px;filter:drop-shadow(0 7px 9px rgba(70,50,35,.22))}
  .ph-art .xw{width:138px;filter:drop-shadow(0 6px 8px rgba(70,50,35,.2))}
  /* the tag, always showing on phones; it swings once when its card first scrolls into view */
  .ph-tag{position:relative;margin-top:20px;width:min(100%,132px);box-sizing:border-box;padding:20px 8px 9px;background:#f6efe2;border-radius:3px;text-align:center;
    clip-path:polygon(22% 0,78% 0,100% 16%,100% 100%,0 100%,0 16%);transform-origin:50% -18px;filter:drop-shadow(0 4px 4px rgba(70,30,30,.18))}
  .ph-tagwrap{position:relative;display:flex;flex-direction:column;align-items:center;transform-origin:50% 0}
  .ph-tagwrap::before{content:"";position:absolute;left:50%;top:0;width:1px;height:26px;background:#7a5a46}
  .ph-tag .hole{position:absolute;left:50%;top:6px;width:6px;height:6px;margin-left:-3px;border-radius:50%;background:#e9d8cf;box-shadow:inset 0 1px 1px rgba(0,0,0,.25)}
  .ph-tag b{display:block;font:600 14px Geist,sans-serif;color:#B8577A;line-height:1}
  .ph-tag .t{display:block;margin-top:4px;font-family:'EB Garamond',serif;font-style:italic;font-size:16px;line-height:1.15;color:#6E1E2B}
  .ph-item.inview .ph-tagwrap{animation:swing 1.3s cubic-bezier(.3,.6,.4,1) both}
}
@media (max-width: 767px) and (prefers-reduced-motion: reduce){.ph-item.inview .ph-tagwrap,.ph-next span{animation:none}}
/* ---------- carried over from the old desk: the intro and its page turn ---------- */
/* a bending page: thin strips, each turning a little more than the one before (built by Bend() in the script) */
.bend{position:absolute;top:0;transform-style:preserve-3d;pointer-events:none}
.bs{position:absolute;top:0;height:100%;transform-origin:0 50%;transform-style:preserve-3d}
.bf{position:absolute;top:0;left:0;width:calc(100% + 1px);height:100%;overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.bf.bb{transform:rotateY(180deg)}
.bc{position:absolute;top:0;height:100%}
.bl{position:absolute;inset:0}
/* Intro, "let yourself be": a dark spread whose right page turns over onto the desk.
   JS sets --p (0 closed, 1 turned) and --lift (sin of the turn) on #intro / #m-intro; .anim adds the eased turn. */
.black{background-color:#242826;background-image:url(/desk/black-paper.jpg);background-size:700px auto}
.matte{position:absolute;inset:0;background:linear-gradient(118deg,rgba(255,255,255,0) 28%,rgba(255,255,255,.045) 42%,rgba(255,255,255,0) 56%)}
.intro,.m-intro{display:none}
.intro-on .intro{display:block}
.intro{position:absolute;inset:0;z-index:20;perspective:2600px;--p:0;--lift:0}
.i-left{position:absolute;left:0;top:0;width:756px;height:982px}
.i-under{position:absolute;left:756px;top:0;width:756px;height:982px;pointer-events:none;background:linear-gradient(90deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,.1) 60%);opacity:calc(1 - var(--p))}
.i-leftShade{position:absolute;inset:0;pointer-events:none;background:rgba(0,0,0,.5);opacity:calc(var(--p) * .8)}
.i-leaf{position:absolute;left:756px;top:0;width:756px;height:982px;transform-origin:left center;transform-style:preserve-3d;transform:rotateY(calc(var(--p) * -180deg))}
.i-face{position:absolute;inset:0;overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.i-front{box-shadow:calc(var(--lift) * -30px) 0 40px rgba(0,0,0,calc(var(--lift) * .45))}
.i-back{transform:rotateY(180deg);background:#fff}
.i-faceShade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(0,0,0,0) 40%,rgba(0,0,0,.6) 100%);opacity:calc(var(--lift) * .9)}
.i-backShade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(270deg,rgba(0,0,0,0) 40%,rgba(0,0,0,.35) 100%);opacity:var(--lift)}
.intro .i-leaf,.intro .i-front{transition:transform .06s linear,box-shadow .06s linear}
.intro .i-under,.intro .i-leftShade,.intro .i-faceShade,.intro .i-backShade{transition:opacity .06s linear}
.intro.anim .i-leaf,.intro.anim .i-front{transition:transform 1.15s cubic-bezier(.62,.04,.22,1),box-shadow 1.15s cubic-bezier(.62,.04,.22,1)}
.intro.anim .i-under,.intro.anim .i-leftShade,.intro.anim .i-faceShade,.intro.anim .i-backShade{transition:opacity 1.15s cubic-bezier(.62,.04,.22,1)}
.turn{font-family:'EB Garamond',serif;font-style:italic;font-size:18px;color:#a9aba6;background:none;border:0;padding:12px 4px;cursor:pointer;transition:color .3s}
.turn:hover{color:#e4e3dd}
.turn:focus-visible{outline:1px solid #a9aba6;outline-offset:4px}
.m-intro{position:fixed;inset:0;z-index:30;perspective:1400px;touch-action:none;--p:0}
/* phones: the black page slides off to the left (no page turn) */
.m-leaf{position:absolute;inset:0;transform:translateX(calc(var(--p) * -100%));box-shadow:20px 0 40px rgba(0,0,0,calc(var(--lift) * .25));transition:transform .06s linear,box-shadow .06s linear}
.m-intro.anim .m-leaf{transition:transform .8s cubic-bezier(.65,0,.35,1),box-shadow .8s cubic-bezier(.65,0,.35,1)}
.m-leaf.black{background-size:600px auto}
.m-leaf .matte{background:linear-gradient(118deg,rgba(255,255,255,0) 28%,rgba(255,255,255,.05) 44%,rgba(255,255,255,0) 60%)}
.nextbtn{font-family:'EB Garamond',serif;font-style:italic;font-size:17px;color:#a9aba6;background:none;border:0;padding:12px 20px;min-height:44px;cursor:pointer;-webkit-tap-highlight-color:transparent}
.nextbtn:focus-visible{outline:1px solid #a9aba6;outline-offset:4px}
.nextbtn:focus-visible{outline:2px solid #e4e3dd;outline-offset:4px}
@media (prefers-reduced-motion: reduce){.intro *,.m-leaf{transition:none !important}}
.endnote{position:absolute;left:834px;top:912px;width:600px;margin:0;text-align:center;font-family:'Hanken Grotesk',sans-serif;font-size:15px;color:#8a837d;opacity:0;transform:translateY(6px);transition:opacity .4s,transform .4s;pointer-events:none}
.endnote.on{opacity:1;transform:none}
/* Desktop: the space around the scaled spread continues it instead of showing grey bands:
   white (the spread's outer edges are white), with the intro's black paper over it until the page is turned. */
@media (min-width: 768px){
  html::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background-color:#242826;background-image:url(/desk/black-paper.jpg);background-size:calc(700px * var(--s, 1)) auto;opacity:0;transition:opacity .6s ease}
  html.intro-on::before{opacity:1}
  html.intro-on body{background:transparent}
}
/* the bands beside the spread on wide windows: maroon on the left, blush on the right, black paper during the intro */
#edge{position:fixed;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,#3a0f16 50%,#f2e3de 50%);display:none}
#edge::before{content:"";position:absolute;inset:0;background-color:#242826;background-image:url(/desk/black-paper.jpg);background-size:calc(700px * var(--s, 1)) auto;opacity:0;transition:opacity .6s ease}
html.intro-on #edge::before{opacity:1}
@media (max-width: 767px){#edge{display:none !important}}
/* the viewfinder cursor turns light on the dark intro so it stays visible */
html.intro-on .kc-b{border-color:#e4e3dd !important}
html.intro-on .kc-dot{background:#e4e3dd !important}
html.intro-on .kc-lab{color:#e4e3dd !important}
/* scrolling on the spread: the six and the heading nudge up together and settle back */
.spread .cut,.spread .rtitle{translate:0 var(--nudge,0px);transition:translate .55s cubic-bezier(.3,1.5,.5,1),opacity .35s ease}
.spread.nudging .cut,.spread.nudging .rtitle{transition:translate .18s ease-out,opacity .35s ease}
@media (prefers-reduced-motion: reduce){.spread .cut,.spread .rtitle{transition:none}}
.back{border:0;background:none;cursor:pointer;font-family:'Hanken Grotesk',sans-serif}
/* phones: the intro covers the page until it is turned */
@media (max-width: 767px){.intro-on .m-intro{display:block}.intro-on,.intro-on body{overflow:hidden}.ph-back{border:0;background:none;padding:0;cursor:pointer;font-family:inherit}}
.nextbtn{font-family:'EB Garamond',serif;font-style:italic;font-size:17px;color:#a9aba6;background:none;border:0;padding:12px 20px;min-height:44px;cursor:pointer;-webkit-tap-highlight-color:transparent}
.nextbtn:focus-visible{outline:1px solid #a9aba6;outline-offset:4px}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}

/* scrolling the spread pulses the five cutouts one by one (see nudge() in the script) */
.cut.pulse .box{animation:pulse 1s ease-in-out}
.cut.pulse .tag{opacity:1;animation:swing 1s cubic-bezier(.3,.6,.4,1) forwards}
.cut.pulse .lbl{opacity:0}
@keyframes pulse{0%,100%{scale:1}35%{scale:1.14}}
.cut.pulse img{filter:saturate(1.1) contrast(1.04) drop-shadow(0 0 16px rgba(255,214,150,.95)) drop-shadow(0 8px 10px rgba(70,50,35,.24))}
@media (prefers-reduced-motion: reduce){.cut.pulse .box{animation:none}.cut.pulse .tag{animation:none;transform:none}}
#stage{transition:translate .5s cubic-bezier(.3,1.5,.5,1)}
#stage.nudging{transition:translate .15s ease-out}
@media (prefers-reduced-motion: reduce){#stage{transition:none;animation:none}}
/* touch screens with the spread (iPad held sideways): no hover, so the tags simply hang there */
@media (hover: none){.cut .tag{opacity:1 !important;transform:none !important;animation:none !important}}
/* iPad held upright (pages stacked by /stack.js): the phone intro, which slides away on a tap */
@media (min-width: 768px) and (orientation: portrait){
  .intro-on .intro{display:none !important}
  .intro-on .m-intro{display:block}
  .intro-on,.intro-on body{overflow:hidden}
}
</style>
