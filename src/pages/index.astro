---
// / (the home page): the new home. A black intro page ("oh, you came!") turns over onto a spread: the lotus page with
// Kritika's postcard on the left, Contents on the right (six cutouts in an oval, each swinging a paper tag on hover).
// Desktop is a fixed 1512x982 spread scaled to the window; under 768px it is one column (postcard, then cards).
import Analytics from '../components/Analytics.astro';
const PROJECTS = '/work'; // the new work page
const JOURNEY = '/roadmap', COFFEE = '/recommendations', COVER = '/substack', PLAYGROUND = '/playground', LETSTALK = '/contact';
const LINKEDIN = 'https://www.linkedin.com/in/kritika-upadhyay-2001/';
const SUBSTACK = 'https://substack.com/@verykritikal/posts';
const INSTAGRAM = 'https://www.instagram.com/verykritikal/';
const EMAIL = 'mailto:kritikaupadhyay2001@gmail.com';
const WHATSAPP = 'https://wa.me/919109079518';

// Tile 1: a little crossword in the style of a red-and-paper puzzle poster. 1 across SEE, 2 down MY, 3 across JOURNEY
// (MY's Y is JOURNEY's last letter; M sits on its own row so SEE and M don't read as one word). Cells: letter | '' (empty white) | '#' (red block) | null (no cell).
const XW = [
  [null, '',  'S', 'E', 'E', null, null],
  [null, '#', '#', '#', '#', null, 'M'],
  ['J',  'O', 'U', 'R', 'N', 'E',  'Y'],
  [null, '#', '',  '',  null,'#',  '']
];
const XN: Record<string, number> = { '0,2': 1, '1,6': 2, '2,0': 3 }; // clue numbers by row,col
const XS = 30;
const crossword = (() => {
  let cells = '', marks = '';
  XW.forEach((row, r) => row.forEach((v, c) => {
    if (v === null) return;
    const x = c * XS + 8, y = r * XS + 8;
    cells += `<rect x="${x}" y="${y}" width="${XS}" height="${XS}" class="${v === '#' ? 'xb' : 'xc'}"/>`;
    if (v && v !== '#') marks += `<text x="${x + XS / 2}" y="${y + XS / 2 + 5.5}" class="xl">${v}</text>`;
    const n = XN[r + ',' + c]; if (n) marks += `<text x="${x + 3}" y="${y + 8}" class="xn">${n}</text>`;
  }));
  // puzzle-piece knobs on a few red blocks
  const knobs = `<circle cx="${1 * XS + 8 + XS / 2}" cy="${4 * XS + 8}" r="4.5" class="xk"/><circle cx="${XS + 8}" cy="${XS + 8 + XS / 2}" r="4.5" class="xk"/>` +
    `<circle cx="${5 * XS + 8 + XS / 2}" cy="${4 * XS + 8}" r="4.5" class="xk"/><circle cx="${6 * XS + 8}" cy="${3 * XS + 8 + XS / 2}" r="4.5" class="xh"/>`;
  return `<svg class="xw" viewBox="0 0 ${7 * XS + 16} ${4 * XS + 16}" role="img" aria-label="crossword: see my journey">${cells}${knobs}${marks}</svg>`;
})();

// Placeholder note for the postcard (about 55 words) until Kritika writes hers.
// Phone: the six as cards, in number order (same art, labels and links as the desktop oval).
const phoneItems = [
  { n: 1, label: 'Recommendations', href: COFFEE, art: '<img src="/desk/fries.webp" alt="black-and-white collage hands holding a paper bag of golden fries">' },
  { n: 2, label: 'Work', href: PROJECTS, art: '<img src="/desk/work-illustration.webp" alt="an illustrated laptop with colour swatches, sticky notes and a mug that says Well Cast">' },
  { n: 3, label: 'Substack', href: COVER, art: '<img src="/desk/typewriter.webp" alt="a green typewriter with torn pages of Hamlet in its roller">' },
  { n: 4, label: 'Playground', href: PLAYGROUND, art: '<img src="/desk/traffic-pole.webp" alt="a New York street-sign pole with traffic lights, a stop sign and two pigeons fighting over a slice of pizza">' },
  { n: 5, label: 'Contact', href: LETSTALK, art: '<img src="/desk/rotary-phone.webp" alt="a black vintage rotary phone">' }
];
const NOTE_HELLO = "hello, i am Kritika.\na creative marketer and a writer.";
const NOTE_TOP = "\n\nyou probably have too many tabs open too. same-pinch!\ni connect small ideas into something meaningful and get people talking. when i log off, i write it all down and try to create more than i consume.\n\nclick whatever calls to you, or ";
const NOTE_CTA = "start with my work \u2192";
const NOTE_END = "\nlove, K";
const NOTE = NOTE_HELLO + NOTE_TOP + NOTE_CTA + NOTE_END;

