---
import Base from '../layouts/Base.astro';
import Doodles from '../components/Doodles.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import StoryThread from '../components/StoryThread.astro';
import Footer from '../components/Footer.astro';
---
<Base>
<Doodles />
<Nav />
<div class="main" style="position: relative; z-index: 1">
<div style="max-width: 1180px; margin: 0 auto; padding: 24px 24px 0">
<Hero />
<StoryThread />
</div>
<Footer />
</div>
</Base>
