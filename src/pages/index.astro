</div>

<script is:inline>
// scale the 1512x982 spread to fill any desktop window
function fit(){var s=Math.min(innerWidth/1512,innerHeight/982),st=document.getElementById('stage');st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)/2)+'px';}
addEventListener('resize',fit);fit();
// hovering a key item highlights its cutout
document.querySelectorAll('[data-for]').forEach(function(a){var c=document.querySelector('.cut[data-id="'+a.dataset.for+'"]');a.addEventListener('mouseenter',function(){c&&c.classList.add('hl')});a.addEventListener('mouseleave',function(){c&&c.classList.remove('hl')});});

// Intro: scroll (or swipe) to turn the page onto the desk; holding a scroll ~0.7s or the button turns it fully.
// Scrolling back up at the top brings it back.
(function(){
  var root = document.documentElement, D = document.getElementById('intro'), M = document.getElementById('m-intro');
  var phone = matchMedia('(max-width: 767px)'), reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // the back of the turning page shows the desk's left half: a non-interactive copy of the desk
  var desk = D.parentNode, copy = desk.cloneNode(true);
  copy.querySelector('#intro').remove();
  copy.querySelectorAll('[id],[data-id],[data-for]').forEach(function(n){ n.removeAttribute('id'); n.removeAttribute('data-id'); n.removeAttribute('data-for'); });
  copy.style.position = 'absolute'; copy.style.left = '0'; copy.style.top = '0';
  var back = D.querySelector('.i-back'); back.insertBefore(copy, back.firstChild);

  var p = 0, done = false, start = 0, last = 0, snap, fin, ty = null;
  function el(){ return phone.matches ? M : D; }
  function render(anim){
    [D, M].forEach(function(e){
      e.classList.toggle('anim', !!anim && !reduce);
      e.style.setProperty('--p', p);
      e.style.setProperty('--lift', Math.sin(p * Math.PI).toFixed(3));
    });
  }
  function finish(){ done = true; root.classList.remove('intro-on'); }
  function turn(){ p = 1; render(true); clearTimeout(fin); fin = setTimeout(finish, reduce ? 0 : 1150); }
  function push(d){
    if (done) {
      if (d >= 0 || (phone.matches && scrollY > 0)) return;
      done = false; root.classList.add('intro-on'); render(false);
    }
    if (p >= 1 && d >= 0) return;
    clearTimeout(fin);
    var now = Date.now();
    if (d > 0) { if (!start || now - last > 250) start = now; } else start = 0;
    last = now;
    clearTimeout(snap);
    if (d > 0 && start && now - start >= 700) { start = 0; turn(); return; }
    p = Math.max(0, Math.min(1, p + d / (phone.matches ? 1600 : 2200)));
    render(false);
    if (p >= 1) { fin = setTimeout(finish, 150); return; }
    snap = setTimeout(function(){ if (p < 1) { p = 0; render(true); } }, 600);
  }
  addEventListener('wheel', function(e){ push(e.deltaY || 0); }, { passive: true });
  addEventListener('touchstart', function(e){ ty = e.touches[0].clientY; }, { passive: true });
  addEventListener('touchmove', function(e){ if (ty === null) return; var y = e.touches[0].clientY; push((ty - y) * 2); ty = y; }, { passive: true });
  addEventListener('touchend', function(){ ty = null; }, { passive: true });
  addEventListener('keydown', function(e){
    if (!done && /^(ArrowDown|PageDown| |Spacebar)$/.test(e.key) && !(e.target.closest && e.target.closest('button,a'))) { e.preventDefault(); turn(); }
  });
  document.querySelectorAll('[data-turn]').forEach(function(b){ b.addEventListener('click', turn); });
  // Back: lay the turned page down again, then turn it back over to the intro
  function turnBack(){
    clearTimeout(fin); clearTimeout(snap); start = 0;
    if (phone.matches) scrollTo(0, 0);
    done = false; p = 1; root.classList.add('intro-on'); render(false);
    void D.offsetWidth; void M.offsetWidth;
    setTimeout(function(){ p = 0; render(true); }, 30);
    var b = (phone.matches ? M : D).querySelector('[data-turn]'); if (b) b.focus({ preventScroll: true });
  }
  document.querySelectorAll('[data-back]').forEach(function(b){ b.addEventListener('click', turnBack); });
})();

// "last spotted" photo: pops up when the line is hovered, then follows the cursor (with a slight drag);
// once the cursor is more than 15cm from the line, it fades out. Hovering the line again brings it back.
(function(){
  var lines = document.querySelectorAll('#stage p.spotted'), line = lines[lines.length - 1]; // last one is the real desk (the first is the page-turn copy)
  if (!line) return;
  var pic = line.querySelector('.spot-pic');
  var FAR = 15 * 96 / 2.54; // 15cm in CSS pixels (~567px); browsers can't know the true physical size of a screen
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var on = false, tx = 10, ty = 0, x = 10, y = 0, raf = 0;
  function aim(cx, cy){
    var r = line.getBoundingClientRect(), s = r.width / line.offsetWidth || 1; // the desk is scaled to the window
    tx = (cx - r.left) / s + 10; ty = (cy - r.top) / s + 10;
  }
  function tick(){
    var k = reduce ? 1 : 0.3;
    x += (tx - x) * k; y += (ty - y) * k;
    pic.style.left = x.toFixed(1) + 'px'; pic.style.top = y.toFixed(1) + 'px';
    raf = (on && (Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3)) ? requestAnimationFrame(tick) : 0;
  }
  function follow(){ if (!raf) raf = requestAnimationFrame(tick); }
  line.addEventListener('mouseenter', function(e){
    aim(e.clientX, e.clientY);
    if (!on) { x = tx; y = ty; pic.style.left = x + 'px'; pic.style.top = y + 'px'; }
    on = true; line.classList.add('on');
  });
  addEventListener('mousemove', function(e){
    if (!on) return;
    var r = line.getBoundingClientRect();
    var dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right), dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
    if (Math.hypot(dx, dy) > FAR) { on = false; line.classList.remove('on'); return; }
    aim(e.clientX, e.clientY); follow();
  });
})();
</script>
</body>
</html>
