<script is:inline>
// scale the 1512x982 spread to cover the window (2px past it, so no hairline shows on scaled screens); where it stops
// zooming (very wide windows) #edge paints the bands and overlaps the spread's outermost pixel.
function fit(){var W=innerWidth,H=innerHeight,a=(W+2)/1512,b=(H+2)/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82),st=document.getElementById('stage');document.documentElement.style.setProperty('--s',s);st.style.transform='scale('+s+')';var L=(W-1512*s)/2,T=(H-982*s)*0.4,R=L+1512*s,B=T+982*s;st.style.left=L+'px';st.style.top=T+'px';
  var e=document.getElementById('edge');if(!e)return;
  if(L<=0&&T<=0&&R>=W&&B>=H){e.style.display='none';return;}
  var l=Math.max(L,0)+(L>0?1:0),t=Math.max(T,0)+(T>0?1:0),r=Math.min(R,W)-(R<W?1:0),bt=Math.min(B,H)-(B<H?1:0);
  e.style.clipPath='polygon(evenodd,0 0,100% 0,100% 100%,0 100%,0 0,'+l+'px '+t+'px,'+l+'px '+bt+'px,'+r+'px '+bt+'px,'+r+'px '+t+'px,'+l+'px '+t+'px)';e.style.display='block';}
addEventListener('resize',fit);fit();
(function(){
  var sp=document.querySelector('.spread'),T;
  function on(id){clearTimeout(T);sp.classList.add('focusing');sp.querySelectorAll('.is-focus').forEach(function(n){n.classList.remove('is-focus')});sp.querySelectorAll('.cut[data-id="'+id+'"]').forEach(function(n){n.classList.add('is-focus')});}
  function off(){T=setTimeout(function(){sp.classList.remove('focusing');sp.querySelectorAll('.is-focus').forEach(function(n){n.classList.remove('is-focus')});},60);}
  sp.querySelectorAll('.cut[data-id]').forEach(function(c){c.addEventListener('mouseenter',function(){on(c.dataset.id)});c.addEventListener('mouseleave',off);});
})();
// Bend: a page that bends as it turns, like a glossy magazine page rather than a stiff board.
// It is cut into N thin strips, each hinged to the one before; mid-turn the outer strips turn further than the ones
// by the spine, so the page curves. Light is drawn per strip from its angle: darker as it tilts away, with a soft
// sheen sliding across the curve. host: an empty element at the spine (preserve-3d, under a perspective);
// W x H: the page size; front() / back(): make a fresh copy of what each side shows (full page, positioned at 0,0).
// Returns set(p), p from 0 (flat on the right) to 1 (turned over, flat on the left).
function Bend(host, W, H, N, front, back){
  var w = W / N, parts = [], par = host, G = [], gs = 0, i;
  for (i = 0; i < N; i++) { G[i] = Math.pow((i + 1) / N, 1.7); gs += G[i]; }
  for (i = 0; i < N; i++) G[i] /= gs;
  function face(cls, node, off){
    var f = document.createElement('div'), c = document.createElement('div'), l = document.createElement('div');
    f.className = cls; c.className = 'bc'; c.style.left = off + 'px'; c.style.width = W + 'px'; l.className = 'bl';
    c.appendChild(node); f.appendChild(c); f.appendChild(l); return { f: f, l: l };
  }
  host.style.width = W + 'px'; host.style.height = H + 'px'; host.setAttribute('aria-hidden', 'true'); host.inert = true;
  for (i = 0; i < N; i++) {
    var st = document.createElement('div'); st.className = 'bs'; st.style.left = (i ? w : 0) + 'px'; st.style.width = w + 'px';
    var F = face('bf', front(), -i * w), B = face('bf bb', back(), -(W - (i + 1) * w));
    st.appendChild(F.f); st.appendChild(B.f); par.appendChild(st); par = st;
    parts.push({ s: st, f: F.l, b: B.l });
  }
  var R = Math.PI / 180, BEND = 80;
  function lightF(a){ return [0.5 * (1 - Math.cos(a * R)), 0.16 * Math.max(0, 1 - Math.abs(a - 40) / 22)]; }
  function lightB(a){ return [0.42 * (1 + Math.cos(a * R)), 0.14 * Math.max(0, 1 - Math.abs(a - 142) / 22)]; }
  function grad(L0, L1){
    return 'linear-gradient(90deg,rgba(255,255,255,' + L0[1].toFixed(3) + '),rgba(255,255,255,' + L1[1].toFixed(3) + ')),' +
           'linear-gradient(90deg,rgba(0,0,0,' + L0[0].toFixed(3) + '),rgba(0,0,0,' + L1[0].toFixed(3) + '))';
  }
  return function(p){
    var sn = Math.sin(p * Math.PI), a = 180 * p - BEND * sn / 2, A = [];
    for (var k = 0; k < N; k++) { var d = BEND * sn * G[k]; a += d; A.push(a);
      parts[k].s.style.transform = 'rotateY(' + (-(k ? d : a)).toFixed(3) + 'deg)'; }
    for (k = 0; k < N; k++) {
      var e0 = (A[Math.max(k - 1, 0)] + A[k]) / 2, e1 = (A[k] + A[Math.min(k + 1, N - 1)]) / 2;
      parts[k].f.style.backgroundImage = grad(lightF(e0), lightF(e1));
      parts[k].b.style.backgroundImage = grad(lightB(e1), lightB(e0)); // the back face is mirrored
    }
  };
}
// cubic-bezier(.62,.04,.22,1): slow lift, quick turn, soft landing
function turnEase(x){
  var t = x;
  for (var j = 0; j < 6; j++) { var cx = 3 * .62 * t * (1 - t) * (1 - t) + 3 * .22 * t * t * (1 - t) + t * t * t - x,
    dx = 3 * .62 * (1 - t) * (1 - 3 * t) + 3 * .22 * t * (2 - 3 * t) + 3 * t * t; if (Math.abs(dx) < 1e-6) break; t -= cx / dx; }
  t = Math.max(0, Math.min(1, t));
  return 3 * .04 * t * (1 - t) * (1 - t) + 3 * t * t * (1 - t) + t * t * t;
}

// Intro: scroll (or swipe) to turn the page onto the desk; holding a scroll ~0.7s or the button turns it fully.
// Scrolling back up at the top brings it back.
(function(){
  var root = document.documentElement, D = document.getElementById('intro'), M = document.getElementById('m-intro');
  var phone = matchMedia('(max-width: 767px), (min-width: 768px) and (orientation: portrait)'), reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // the back of the turning page shows the desk's left half: a non-interactive copy of the desk
  var desk = D.parentNode, copy = desk.cloneNode(true);
  copy.querySelector('#intro').remove();
  copy.querySelectorAll('[id],[data-id],[data-for],[data-note],[data-back]').forEach(function(n){ ['id','data-id','data-for','data-note','data-back'].forEach(function(k){ n.removeAttribute(k); }); });
  copy.style.position = 'absolute'; copy.style.left = '0'; copy.style.top = '0';
  var back = D.querySelector('.i-back'); back.insertBefore(copy, back.firstChild);

  var p = 0, done = !root.classList.contains('intro-on'), start = 0, last = 0, snap, fin, ty = null;
  // Desktop: the turning page is a Bend (made the first time it is needed); the real page (with its button)
  // shows only while it lies flat. shown eases toward p: a timed turn when anim, else a quick follow of the scroll.
  var leaf = D.querySelector('.i-leaf'), host = null, bend = null, shown = 0, tw = null, raf = 0;
  function ensure(){
    if (bend) return;
    host = document.createElement('div'); host.className = 'bend'; host.style.left = '756px';
    D.appendChild(host);
    var face = D.querySelector('.i-front');
    bend = Bend(host, 756, 982, 16, function(){
      var c = face.cloneNode(true);
      c.querySelectorAll('.i-faceShade').forEach(function(n){ n.remove(); });
      c.querySelectorAll('[data-turn]').forEach(function(n){ n.removeAttribute('data-turn'); });
      c.className = 'black'; c.style.cssText = 'position:absolute;left:0;top:0;width:756px;height:982px'; return c;
    }, function(){ return copy.cloneNode(true); });
  }
  function draw(q){
    shown = q;
    D.style.setProperty('--p', q); D.style.setProperty('--lift', Math.sin(q * Math.PI).toFixed(3));
    if (q > 0 && !phone.matches) { ensure(); bend(q); host.style.visibility = 'visible'; leaf.style.visibility = 'hidden'; }
    else { if (host) host.style.visibility = 'hidden'; leaf.style.visibility = ''; }
  }
  function loop(t){
    if (tw) { var k = Math.min(1, (t - tw.t0) / tw.dur); draw(tw.from + (tw.to - tw.from) * turnEase(k)); if (k >= 1) tw = null; }
    else { var q = shown + (p - shown) * 0.3; draw(Math.abs(p - q) < 0.002 ? p : q); }
    raf = (tw || shown !== p) ? requestAnimationFrame(loop) : 0;
  }
  function render(anim){
    M.classList.toggle('anim', !!anim && anim !== 2 && !reduce);
    M.style.setProperty('--p', p); M.style.setProperty('--lift', Math.sin(p * Math.PI).toFixed(3));
    if (reduce || anim === 2 || document.hidden) { tw = null; draw(p); return; }
    if (anim) tw = { from: shown, to: p, t0: performance.now(), dur: Math.max(450, 1150 * Math.abs(p - shown)) };
    if (!raf) raf = requestAnimationFrame(loop);
  }
  function finish(){ done = true; root.classList.remove('intro-on'); }
  function turn(){ if (done) return; clearTimeout(snap); start = 0; p = 1; render(true); clearTimeout(fin); fin = setTimeout(finish, reduce ? 0 : 1150); }
  // On the spread nothing scrolls: any scroll (or arrow key) pulls attention to the five cutouts instead. Each one
  // pulses for a second, one after another (Work 1, Substack 2, Contact 3, Playground 4, Recommendations 5).
  // Scrolling again while it plays does nothing; once it has finished, the next scroll plays it again.
  var ORDER = ['cover', 'tech', 'phone', 'tarot', 'coffee'], pulsing = false;
  function nudge(){
    if (pulsing) return;
    pulsing = true;
    var cuts = ORDER.map(function(id){ return document.querySelector('.spread .cut[data-id="' + id + '"]'); }).filter(Boolean), i = 0;
    (function step(){
      if (i > 0) cuts[i - 1].classList.remove('pulse');
      if (i >= cuts.length) { pulsing = false; return; }
      cuts[i++].classList.add('pulse');
      setTimeout(step, 1000);
    })();
  }
  function push(d, dx){
    if (done) { if (!phone.matches && (d || dx)) nudge(); return; }
    if (p >= 1 && d >= 0) return;
    clearTimeout(fin);
    var now = Date.now();
    if (d > 0) { if (!start || now - last > 250) start = now; } else start = 0;
    last = now;
    clearTimeout(snap);
    if (d > 0 && start && now - start >= 700) { start = 0; turn(); return; }
    p = Math.max(0, Math.min(1, p + d / (phone.matches ? 1600 : 2200)));
    render(false);
    if (p >= 1) { fin = setTimeout(finish, 150); return; }
    snap = setTimeout(function(){ if (p < 1) { p = 0; render(true); } }, 600);
  }
  var wheelT = 0;
  addEventListener('wheel', function(e){
    if (done) { var now = Date.now(); if (now - wheelT < 450) return; wheelT = now; } // one nudge per flick, not per wheel tick
    push(e.deltaY || 0, e.deltaX || 0);
  }, { passive: true });
  // Phones: a tap anywhere on the intro continues, even if the finger shifts a little while tapping
  var tx0 = 0, ty0 = 0;
  addEventListener('touchstart', function(e){ ty = e.touches[0].clientY; tx0 = e.touches[0].clientX; ty0 = ty; }, { passive: true });
  addEventListener('touchmove', function(e){ if (ty === null) return; var y = e.touches[0].clientY; push((ty - y) * 2); ty = y; }, { passive: true });
  addEventListener('touchend', function(e){
    var t = e.changedTouches && e.changedTouches[0];
    if (!done && phone.matches && t && M.contains(e.target) && Math.abs(t.clientX - tx0) < 24 && Math.abs(t.clientY - ty0) < 24) turn();
    ty = null;
  }, { passive: true });
  M.addEventListener('click', turn);
  addEventListener('keydown', function(e){
    if (!done && /^(ArrowDown|PageDown| |Spacebar)$/.test(e.key) && !(e.target.closest && e.target.closest('button,a'))) { e.preventDefault(); turn(); return; }
    var dirs = { ArrowDown: [0, 1], PageDown: [0, 1], ' ': [0, 1], ArrowUp: [0, -1], PageUp: [0, -1], ArrowLeft: [-1, 0], ArrowRight: [1, 0], Home: [0, -1], End: [0, 1] };
    if (done && !phone.matches && dirs[e.key] && !(e.target.closest && e.target.closest('input,textarea'))) { e.preventDefault(); nudge(); }
  });
  document.querySelectorAll('#intro [data-turn]').forEach(function(b){ b.addEventListener('click', turn); });
  // there is no way back to the intro from the spread; only a refresh shows it again
})();

// Phones: each card's tag swings once as the card scrolls into view (and the illustration starts moving).
(function(){
  var items=document.querySelectorAll('.ph-item');if(!items.length)return;
  if(!('IntersectionObserver' in window)){items.forEach(function(n){n.classList.add('inview')});return;}
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('inview');io.unobserve(e.target);}})},{threshold:.55});
  items.forEach(function(n){io.observe(n)});
})();
// Over the left page the viewfinder steps aside and the regular mouse shows.
(function(){
  var st=document.getElementById('stage'),root=document.documentElement;
  addEventListener('mousemove',function(e){
    var r=st.getBoundingClientRect(),spine=r.left+r.width/2;
    root.classList.toggle('kc-plain',e.clientX<spine&&!root.classList.contains('intro-on'));
  },{passive:true});
})();
</script>
