.nextbtn:focus-visible{outline:2px solid #e4e3dd;outline-offset:4px}
@media (prefers-reduced-motion: reduce){.intro *,.m-leaf{transition:none !important}}

/* Desktop: the space around the scaled spread continues it instead of showing grey bands:
   white (the spread's outer edges are white), with the intro's black paper over it until the page is turned. */
@media (min-width: 768px){
  html,body{background:#ffffff}
  html::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background-color:#242826;background-image:url(/desk/black-paper.jpg);background-size:calc(700px * var(--s, 1)) auto;opacity:0;transition:opacity .6s ease}
