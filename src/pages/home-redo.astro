---
// /home-redo: the new home, the desk spread ("/" is still the old home for now). Desktop is a fixed 1512x982 design
// scaled to fill the window; below 768px it becomes one scrolling column. Images live in public/desk/.
// Its pages: 1 /roadmap, 2 /recommendations, 3 /substacks, 4 /jobs, 5 /graveyard, 6 /playground.
import Analytics from '../components/Analytics.astro';

const WORK = '/work';
const JOURNEY = '/roadmap';
const TWITTER = 'https://x.com/verykritikal?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const SUBSTACK = 'https://substack.com/@verykritikal/posts?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const INSTAGRAM = 'https://www.instagram.com/verykritikal/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const LINKEDIN = 'https://www.linkedin.com/in/kritika-upadhyay-2001/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const EMAIL = 'mailto:kritikaupadhyay2001@gmail.com';
const WHATSAPP = 'https://wa.me/919109079518';
const BEANLORE = 'https://maps.app.goo.gl/cWP7aSNRVM3AXVjH9';
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};

// Placeholders until their pages exist: tedx bitd, the world, she substacks.
const COFFEE = '/recommendations';
const JOBS = '/jobs';
// Routes reserved for pages still being designed; the cutouts link to them once the pages exist.
const SUBSTACKS = '/substacks', GRAVEYARD = '/graveyard', PLAYGROUND = '/playground', LETSTALK = '/lets-talk';
const TEDX = '#tedx', TAROT = '#tarot', COVER = SUBSTACKS;

const planeLogo = `<svg class="logo" width="130" height="81" viewBox="0 0 579 361" role="img" aria-label="Plane logo"><path d="M0 20.6413C0 5.3174 16.1 -4.64793 29.7966 2.20067L147.972 61.3502V200.168C147.972 219.674 158.992 237.527 176.417 246.248L283.068 299.63V340.352C283.068 355.675 266.968 365.641 253.271 358.779L28.4447 246.248C11.0201 237.527 0 219.688 0 200.168V20.6413ZM147.972 20.6413C147.972 5.3174 164.072 -4.64793 177.769 2.21435L295.945 61.3638V200.182C295.945 219.688 306.965 237.541 324.39 246.262L431.041 299.643V340.366C431.041 355.689 414.94 365.654 401.244 358.792L283.068 299.643V160.826C283.068 141.306 272.048 123.466 254.623 114.744L147.972 61.3638V20.6413ZM295.931 20.6413C295.931 5.3174 312.032 -4.64793 325.728 2.21435L550.555 114.744C567.993 123.466 579 141.306 579 160.826V340.366C579 355.689 562.899 365.654 549.203 358.792L431.027 299.643V160.826C431.027 141.306 420.007 123.466 402.582 114.744L295.931 61.3638V20.6413Z" fill="#1C1B1F"></path></svg>`;
// "she substacks": a cutout of a writer at her laptop
const carrie = '<img src="/desk/writer-at-desk.png" alt="a woman at her desk, feet up, writing on her laptop" style="max-width: 150px; max-height: 182px">';
// "Tech jobs and their stories.": a little desk of her work, cut from her own photos: the laptop (showing
// Plane's GitHub star history), the pen cup and the notebook stack. On hover they shift apart a little.
// "work i have done.": a polaroid of her actual desk, captioned in her hand
const workGroup = `<span class="pola"><span class="ph"><img src="/desk/her-desk.jpg" alt="kritika's desk: laptop, glasses, a water bottle, notebooks and the bookshelf"></span><span class="cap">her work.</span></span>`;
// "my coffee reccs!": a brunch, cut piece by piece from her photo: the croissant sandwich, the english breakfast,
// the iced coffee and her shades. On hover they spread a little.
const brunch = `<span class="brn"><img class="bc" src="/desk/brunch-croissant.png" alt="a croissant sandwich on an oval plate"><img class="bb" src="/desk/brunch-breakfast.png" alt="an english breakfast plate with pancakes, beans and hash browns"><img class="bk" src="/desk/brunch-coffee.png" alt="an iced coffee with a straw"><img class="bs" src="/desk/brunch-shades.png" alt="black sunglasses"></span>`;

// Phone column, in number order.
const items = [
  { n: 1, name: "what's her story?", href: JOURNEY, say: true, art: '<img src="/desk/kritika-mirror.png" alt="kritika taking a mirror selfie in a white top and green checked trousers" style="max-width: 240px; max-height: 260px">' },
  { n: 2, name: "places i swear by!", href: COFFEE, art: brunch },
  { n: 3, name: "i write on Substack", href: COVER, art: carrie },
  { n: 4, name: "work i have done.", href: JOBS, art: workGroup },
  { n: 5, name: "things i do for fun", href: PLAYGROUND, art: '<img src="/desk/tarot-reading.png" alt="hands laying out tarot cards on a red velvet mat, with a deck and a rose quartz crystal" style="max-width: 200px; max-height: 213px">' },
  { n: 6, name: "Let's talk!", href: LETSTALK, art: '<img src="/desk/rotary-phone.png" alt="a black vintage rotary phone" style="max-width: 170px">' }
];

const socials = [
  { label: 'Twitter', href: TWITTER, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><path d="M4 4l16 16M20 4L4 20"></path></svg>' },
  { label: 'Substack', href: SUBSTACK, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M5 4h14M5 8h14M5 12h14v9l-7-4-7 4z"></path></svg>' },
  { label: 'Instagram', href: INSTAGRAM, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".8" fill="#A9452A"></circle></svg>' },
  { label: 'LinkedIn', href: LINKEDIN, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><rect x="3.5" y="3.5" width="17" height="17" rx="3"></rect><path d="M8 10.5v6M8 7.5v.1M12 16.5v-6M12 13c0-1.6 1-2.6 2.3-2.6S16.5 11.3 16.5 13v3.5"></path></svg>' },
  { label: 'Email', href: EMAIL, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path></svg>' },
  { label: 'WhatsApp', href: WHATSAPP, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M4 20l1.4-4.2A8 8 0 1 1 8.4 19z"></path><path d="M9.2 9.2c.3 2.4 2.2 4.4 4.6 4.9l1-1.1 1.6.8" stroke-linecap="round"></path></svg>' }
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · darling, have you met Kritika?</title>
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Hanken+Grotesk:ital,wght@0,400;0,500;1,400&amp;family=Archivo+Black&amp;family=Caveat:wght@500&amp;family=EB+Garamond:ital@1&amp;display=swap" rel="stylesheet">
<script is:inline>if (location.hash !== '#desk') document.documentElement.classList.add('intro-on');</script>
<style is:inline>
html,body{margin:0;height:100%;background:#f4f3f0;overflow:hidden}
#stage{position:absolute;left:0;top:0;transform-origin:0 0}
a{color:#B4502F;text-decoration:none}a:hover{color:#8F3C21}
a:focus-visible,button:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
.desk{background-color:#FFEAD3;background-image:url(/desk/paper.jpg);background-size:1000px auto;background-blend-mode:multiply}
.pageL{background:linear-gradient(100deg,#ffffff 0%,#fbfbf9 38%,#ffffff 52%,#f6f6f3 78%,#e9e8e4 96%,#d9d7d2 100%)}
.pageR{background:linear-gradient(80deg,#d6d4cf 0%,#e8e7e3 4%,#f7f7f4 20%,#ffffff 46%,#fafaf8 70%,#ffffff 100%)}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.75) 42%,rgba(255,255,255,0) 54%)}
.cut{position:absolute;display:block;width:170px;height:170px}
.cut .box{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;transition:transform .5s cubic-bezier(.3,1.4,.5,1)}
.cut img,.cut svg.logo{max-width:150px;max-height:150px;filter:drop-shadow(0 7px 9px rgba(70,50,35,.20))}
.cut:hover .box,.cut.hl .box{transform:translateY(-8px) rotate(0deg) !important}
.fig{position:absolute;font-family:Geist,sans-serif;font-weight:500;font-size:15px;color:#B4502F}
/* each cutout's number sits right by its image */
.no{position:absolute;font-family:Geist,sans-serif;font-weight:500;font-size:17px;color:#B4502F;pointer-events:none}
/* Tech jobs: pen cup at the back, laptop beside it, notebooks in front (hiding the cup's trimmed base) */
.brn{position:relative;display:block}
.brn{width:330px;height:250px}
/* work: a polaroid of her desk, off-white card, faded film, slight tilt, handwritten caption */
.pola{position:relative;display:block;width:230px;box-sizing:border-box;padding:10px 10px 0;background:#fbf9f3;box-shadow:0 1px 1px rgba(0,0,0,.06),0 10px 18px rgba(70,50,35,.22);transform:rotate(-3deg);transition:transform .5s cubic-bezier(.3,1.4,.5,1)}
.pola .ph{position:relative;display:block;height:92px;overflow:hidden;background:#ddd}
.pola .ph img{display:block;width:100%;height:100%;max-width:none !important;max-height:none !important;object-fit:cover;filter:contrast(.95) saturate(.88) sepia(.08) brightness(1.03) !important}
.pola .ph::after{content:"";position:absolute;inset:0;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08),inset 0 0 14px rgba(60,40,20,.18)}
.pola .cap{display:block;height:40px;line-height:42px;text-align:center;font-family:Caveat,'Bradley Hand',cursive;font-size:24px;color:#2a2724}
.cut:hover .pola,.cut.hl .pola,.cut:focus-visible .pola{transform:rotate(-1deg) translateY(-4px)}
.brn img{position:absolute;display:block;height:auto !important;max-width:none !important;max-height:none !important;filter:drop-shadow(0 7px 9px rgba(70,50,35,.20));transition:transform .6s cubic-bezier(.3,1.3,.5,1)}
/* work: books and laptop share one baseline (y 228), pens peek from behind the books, the coffee stands between them */
/* brunch: a flat lay */
.brn .bc{left:0;top:6px;width:150px;transform:rotate(-8deg)}
.brn .bb{left:128px;top:56px;width:176px}
.brn .bk{left:148px;top:-4px;width:62px;transform:rotate(6deg)}
.brn .bs{left:84px;top:160px;width:34px;transform:rotate(22deg)}
.cut:hover .brn .bc,.cut.hl .brn .bc,.cut:focus-visible .brn .bc{transform:translate(-8px,-6px) rotate(-11deg)}
.cut:hover .brn .bb,.cut.hl .brn .bb,.cut:focus-visible .brn .bb{transform:translate(6px,6px)}
.cut:hover .brn .bk,.cut.hl .brn .bk,.cut:focus-visible .brn .bk{transform:translate(8px,-6px) rotate(10deg)}
.cut:hover .brn .bs,.cut.hl .brn .bs,.cut:focus-visible .brn .bs{transform:translate(-8px,8px) rotate(30deg)}
.m-item .brn{transform:scale(.9)}
.m-item .pola{transform:rotate(-2deg)}
@media (prefers-reduced-motion: reduce){.brn img,.pola{transition:none}}
/* scrolling on the desk: everything nudges up together and settles back, with a note that this is the whole page */
.desk .cut,.desk .toc{translate:0 var(--nudge,0px);transition:translate .55s cubic-bezier(.3,1.5,.5,1)}
.desk.nudging .cut,.desk.nudging .toc{transition:translate .18s ease-out}
.endnote{position:absolute;left:456px;top:872px;width:600px;margin:0;text-align:center;font-family:'Hanken Grotesk',sans-serif;font-size:15px;color:#8a837d;opacity:0;transform:translateY(6px);transition:opacity .4s,transform .4s;pointer-events:none}
.endnote.on{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){.desk .cut,.desk .toc{transition:none}}
/* contents: one paragraph, numbers in terracotta */
.toc{position:absolute;left:960px;top:722px;width:470px;margin:0;font-family:'Hanken Grotesk',sans-serif;font-size:18px;line-height:1.4;color:#6f6862}
.toc a{white-space:nowrap;margin-right:.55em}
.toc b{font:inherit;font-weight:500;color:#B4502F;margin-right:.3em}
.bubble{opacity:0;transform:scale(.7) translateY(8px);transform-origin:bottom right;transition:opacity .25s,transform .45s cubic-bezier(.3,1.6,.5,1)}
.c-me:hover .bubble,.c-me.hl .bubble,.c-me:focus-visible .bubble,.say .bubble{opacity:1;transform:none}
/* "say hello": an Apple Messages style bubble (sent, blue, tail at the bottom right pointing at her) */
.imsg{position:absolute;box-sizing:border-box;max-width:236px;padding:8px 14px 9px;border-radius:19px;background:#0A84FF;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue',sans-serif;font-size:17px;line-height:1.3;letter-spacing:-.01em;color:#fff;text-align:left;pointer-events:none;z-index:6}
.imsg .tail{position:absolute;right:-5px;bottom:0;width:17px;height:21px;display:block}
/* Going to /journey: the desk's right page turns over the spine like a magazine page; its back, and the page under it,
   are already /journey (same title, Back and socials in the same places), so the new page lands without a jump. */
.mag{position:fixed;inset:0;z-index:60;perspective:2600px;cursor:default}
.mag-under,.mag-leaf,.mag-lshade{position:absolute;top:0;height:100%}
.mag-under{left:50%;width:50%;overflow:hidden;background:#fff}
.mag-lshade{left:0;width:50%;background:#000;opacity:0;pointer-events:none;animation:magL 1.3s cubic-bezier(.62,.04,.22,1) forwards}
.mag-leaf{left:50%;width:50%;transform-origin:left center;transform-style:preserve-3d;animation:magTurn 1.15s cubic-bezier(.62,.04,.22,1) forwards}
.mag-face{position:absolute;inset:0;overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.mag-back{transform:rotateY(180deg);background:#fbfaf7}
.mag-in{position:absolute;top:0;left:0;width:100vw;height:100%}
.mag.phone .mag-under{background:#fbfaf7}
/* a bending page: thin strips, each turning a little more than the one before (built by Bend() in the script) */
.bend{position:absolute;top:0;transform-style:preserve-3d;pointer-events:none}
.bs{position:absolute;top:0;height:100%;transform-origin:0 50%;transform-style:preserve-3d}
.bf{position:absolute;top:0;left:0;width:calc(100% + 1px);height:100%;overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.bf.bb{transform:rotateY(180deg)}
.bc{position:absolute;top:0;height:100%}
.bl{position:absolute;inset:0}
.mag-sp{position:absolute;width:1512px;height:982px;transform-origin:0 0;font-family:'Hanken Grotesk',sans-serif;color:#1C1B1F;text-align:left}
.mag-sp .mb{display:inline-block;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
.mag-sp .mh{font-family:Geist,sans-serif;font-weight:600;font-size:64px;line-height:1.02;letter-spacing:-.02em}
.mag-sp .ms{position:absolute;display:flex;gap:18px;align-items:center}
.mag-sp .ms a{display:flex}
.mag-shade{position:absolute;inset:0;pointer-events:none}
.mag-front .mag-shade{background:linear-gradient(90deg,rgba(0,0,0,0) 35%,rgba(0,0,0,.55) 100%);opacity:0;animation:magF 1.15s cubic-bezier(.62,.04,.22,1) forwards}
.mag-back .mag-shade{background:linear-gradient(270deg,rgba(0,0,0,0) 40%,rgba(0,0,0,.35) 100%);opacity:1;animation:magB 1.15s cubic-bezier(.62,.04,.22,1) forwards}
.mag-under .mag-shade{background:linear-gradient(90deg,rgba(0,0,0,.35) 0%,rgba(0,0,0,0) 60%);animation:magB 1.3s cubic-bezier(.62,.04,.22,1) forwards}
@keyframes magTurn{from{transform:rotateY(0)}to{transform:rotateY(-180deg)}}
@keyframes magF{50%{opacity:.9}100%{opacity:.9}}
@keyframes magB{0%{opacity:1}50%{opacity:1}100%{opacity:0}}
@keyframes magL{0%{opacity:0}90%{opacity:.35}100%{opacity:.35}}
.mag-j{position:absolute;inset:0;box-sizing:border-box;padding:76px 72px 56px;font-family:'Hanken Grotesk',sans-serif;color:#1C1B1F;text-align:left}
.mag-j .mb{display:inline-block;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
.mag-j .mh{margin:6px 0 0;max-width:760px;font-family:Geist,sans-serif;font-weight:600;font-size:64px;line-height:1.02;letter-spacing:-.02em}
.mag-j .ms{position:absolute;left:72px;bottom:56px;display:flex;gap:18px;align-items:center}
.mag-j .ms a{display:flex}
/* phones: the whole screen is the page, turning away to the left */
.mag.phone{perspective:1400px}
.mag.phone .mag-under,.mag.phone .mag-leaf{left:0;width:100%}
.mag.phone .mag-under .mag-in{left:0}
.mag.phone .mag-lshade{display:none}
.mag.phone .mag-leaf{animation:magTurnP 1.05s cubic-bezier(.62,.04,.22,1) forwards;box-shadow:-20px 0 40px rgba(0,0,0,.3)}
.mag.phone .mag-front{background-color:#FFEAD3;background-image:url(/desk/paper.jpg);background-size:cover;background-position:center;background-blend-mode:multiply}
.mag.phone .mag-j{padding:48px 16px 32px}
.mag.phone .mag-j .mb{min-height:32px;box-sizing:border-box}
.mag.phone .mag-j .mh{font-size:44px}
.mag.phone .mag-j .ms{left:4px;bottom:32px;gap:6px}
.mag.phone .mag-j .ms a{width:44px;height:44px;align-items:center;justify-content:center}
@keyframes magTurnP{from{transform:rotateY(0);opacity:1}to{transform:rotateY(-110deg);opacity:.2}}
.navface .open{opacity:0}.navface:hover .open{opacity:1}.navface:hover .shut{opacity:0}
.keyitem{color:#6f6862}.keyitem:hover{color:#1C1B1F}
.spotted a{color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:2px}
.spotted a:hover{color:#8F3C21}
.spot-pic{position:absolute;left:10px;top:calc(100% + 10px);width:120px;height:auto;display:block;border-radius:4px;box-shadow:0 8px 16px rgba(70,50,35,.22);opacity:0;transform:scale(.85) translateY(-6px);transform-origin:top left;transition:opacity .2s,transform .4s cubic-bezier(.3,1.6,.5,1);pointer-events:none;z-index:5}
/* the photo shows on hover (class .on, set by JS), then follows the cursor until it is 15cm from the line */
.spotted.on .spot-pic,.spotted:focus-within .spot-pic{opacity:1;transform:none}
.back{position:absolute;left:72px;top:76px;margin:0;padding:6px 0;border:0;background:none;cursor:pointer;font-family:'Hanken Grotesk',sans-serif;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
.back:hover{color:#8F3C21}
@media (prefers-reduced-motion: reduce){.cut .box,.bubble,.spot-pic{transition:none}}

/* Intro, "let yourself be": a dark spread whose right page turns over onto the desk.
   JS sets --p (0 closed, 1 turned) and --lift (sin of the turn) on #intro / #m-intro; .anim adds the eased turn. */
.black{background-color:#242826;background-image:url(/desk/black-paper.jpg);background-size:700px auto}
.matte{position:absolute;inset:0;background:linear-gradient(118deg,rgba(255,255,255,0) 28%,rgba(255,255,255,.045) 42%,rgba(255,255,255,0) 56%)}
.intro,.m-intro{display:none}
.intro-on .intro{display:block}
.intro{position:absolute;inset:0;z-index:20;perspective:2600px;--p:0;--lift:0}
.i-left{position:absolute;left:0;top:0;width:756px;height:982px}
.i-under{position:absolute;left:756px;top:0;width:756px;height:982px;pointer-events:none;background:linear-gradient(90deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,.1) 60%);opacity:calc(1 - var(--p))}
.i-leftShade{position:absolute;inset:0;pointer-events:none;background:rgba(0,0,0,.5);opacity:calc(var(--p) * .8)}
.i-leaf{position:absolute;left:756px;top:0;width:756px;height:982px;transform-origin:left center;transform-style:preserve-3d;transform:rotateY(calc(var(--p) * -180deg))}
.i-face{position:absolute;inset:0;overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.i-front{box-shadow:calc(var(--lift) * -30px) 0 40px rgba(0,0,0,calc(var(--lift) * .45))}
.i-back{transform:rotateY(180deg);background:#fff}
.i-faceShade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(0,0,0,0) 40%,rgba(0,0,0,.6) 100%);opacity:calc(var(--lift) * .9)}
.i-backShade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(270deg,rgba(0,0,0,0) 40%,rgba(0,0,0,.35) 100%);opacity:var(--lift)}
.intro .i-leaf,.intro .i-front{transition:transform .06s linear,box-shadow .06s linear}
.intro .i-under,.intro .i-leftShade,.intro .i-faceShade,.intro .i-backShade{transition:opacity .06s linear}
.intro.anim .i-leaf,.intro.anim .i-front{transition:transform 1.15s cubic-bezier(.62,.04,.22,1),box-shadow 1.15s cubic-bezier(.62,.04,.22,1)}
.intro.anim .i-under,.intro.anim .i-leftShade,.intro.anim .i-faceShade,.intro.anim .i-backShade{transition:opacity 1.15s cubic-bezier(.62,.04,.22,1)}
.turn{font-family:'EB Garamond',serif;font-style:italic;font-size:18px;color:#a9aba6;background:none;border:0;padding:12px 4px;cursor:pointer;transition:color .3s}
.turn:hover{color:#e4e3dd}
.turn:focus-visible{outline:1px solid #a9aba6;outline-offset:4px}
