<script is:inline>
// scale the 1512x982 spread to fill the window
// The spread is zoomed in to cover the whole window, centred, so nothing shows beside it; the overflow is trimmed
// off the sides evenly and a little more from the bottom than the top. On very unusual window shapes it stops zooming at 18% trimmed, so Back and the socials stay in view.
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82),st=document.getElementById('stage');document.documentElement.style.setProperty('--s',s);st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';}
addEventListener('resize',fit);fit();
// hovering a key item highlights its cutout
document.querySelectorAll('[data-for]').forEach(function(a){var c=document.querySelector('.cut[data-id="'+a.dataset.for+'"]');a.addEventListener('mouseenter',function(){c&&c.classList.add('hl')});a.addEventListener('mouseleave',function(){c&&c.classList.remove('hl')});});

// Bend: a page that bends as it turns, like a glossy magazine page rather than a stiff board.
// It is cut into N thin strips, each hinged to the one before; mid-turn the outer strips turn further than the ones
// by the spine, so the page curves. Light is drawn per strip from its angle: darker as it tilts away, with a soft
// sheen sliding across the curve. host: an empty element at the spine (preserve-3d, under a perspective);
// W x H: the page size; front() / back(): make a fresh copy of what each side shows (full page, positioned at 0,0).
// Returns set(p), p from 0 (flat on the right) to 1 (turned over, flat on the left).
function Bend(host, W, H, N, front, back){
  var w = W / N, parts = [], par = host, G = [], gs = 0, i;
  for (i = 0; i < N; i++) { G[i] = Math.pow((i + 1) / N, 1.7); gs += G[i]; }
  for (i = 0; i < N; i++) G[i] /= gs;
  function face(cls, node, off){
    var f = document.createElement('div'), c = document.createElement('div'), l = document.createElement('div');
    f.className = cls; c.className = 'bc'; c.style.left = off + 'px'; c.style.width = W + 'px'; l.className = 'bl';
    c.appendChild(node); f.appendChild(c); f.appendChild(l); return { f: f, l: l };
  }
  host.style.width = W + 'px'; host.style.height = H + 'px'; host.setAttribute('aria-hidden', 'true'); host.inert = true;
  for (i = 0; i < N; i++) {
    var st = document.createElement('div'); st.className = 'bs'; st.style.left = (i ? w : 0) + 'px'; st.style.width = w + 'px';
    var F = face('bf', front(), -i * w), B = face('bf bb', back(), -(W - (i + 1) * w));
    st.appendChild(F.f); st.appendChild(B.f); par.appendChild(st); par = st;
    parts.push({ s: st, f: F.l, b: B.l });
  }
  var R = Math.PI / 180, BEND = 80;
  function lightF(a){ return [0.5 * (1 - Math.cos(a * R)), 0.16 * Math.max(0, 1 - Math.abs(a - 40) / 22)]; }
  function lightB(a){ return [0.42 * (1 + Math.cos(a * R)), 0.14 * Math.max(0, 1 - Math.abs(a - 142) / 22)]; }
  function grad(L0, L1){
    return 'linear-gradient(90deg,rgba(255,255,255,' + L0[1].toFixed(3) + '),rgba(255,255,255,' + L1[1].toFixed(3) + ')),' +
           'linear-gradient(90deg,rgba(0,0,0,' + L0[0].toFixed(3) + '),rgba(0,0,0,' + L1[0].toFixed(3) + '))';
  }
  return function(p){
    var sn = Math.sin(p * Math.PI), a = 180 * p - BEND * sn / 2, A = [];
    for (var k = 0; k < N; k++) { var d = BEND * sn * G[k]; a += d; A.push(a);
      parts[k].s.style.transform = 'rotateY(' + (-(k ? d : a)).toFixed(3) + 'deg)'; }
    for (k = 0; k < N; k++) {
      var e0 = (A[Math.max(k - 1, 0)] + A[k]) / 2, e1 = (A[k] + A[Math.min(k + 1, N - 1)]) / 2;
      parts[k].f.style.backgroundImage = grad(lightF(e0), lightF(e1));
      parts[k].b.style.backgroundImage = grad(lightB(e1), lightB(e0)); // the back face is mirrored
    }
  };
}
// cubic-bezier(.62,.04,.22,1): slow lift, quick turn, soft landing
function turnEase(x){
  var t = x;
  for (var j = 0; j < 6; j++) { var cx = 3 * .62 * t * (1 - t) * (1 - t) + 3 * .22 * t * t * (1 - t) + t * t * t - x,
    dx = 3 * .62 * (1 - t) * (1 - 3 * t) + 3 * .22 * t * (2 - 3 * t) + 3 * t * t; if (Math.abs(dx) < 1e-6) break; t -= cx / dx; }
  t = Math.max(0, Math.min(1, t));
  return 3 * .04 * t * (1 - t) * (1 - t) + 3 * t * t * (1 - t) + t * t * t;
}

// Intro: scroll (or swipe) to turn the page onto the desk; holding a scroll ~0.7s or the button turns it fully.
// Scrolling back up at the top brings it back.
(function(){
  var root = document.documentElement, D = document.getElementById('intro'), M = document.getElementById('m-intro');
  var phone = matchMedia('(max-width: 767px)'), reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // the back of the turning page shows the desk's left half: a non-interactive copy of the desk
  var desk = D.parentNode, copy = desk.cloneNode(true);
  copy.querySelector('#intro').remove();
  copy.querySelectorAll('[id],[data-id],[data-for]').forEach(function(n){ n.removeAttribute('id'); n.removeAttribute('data-id'); n.removeAttribute('data-for'); });
  copy.style.position = 'absolute'; copy.style.left = '0'; copy.style.top = '0';
  var back = D.querySelector('.i-back'); back.insertBefore(copy, back.firstChild);

  var p = 0, done = !root.classList.contains('intro-on'), start = 0, last = 0, snap, fin, ty = null;
  // Desktop: the turning page is a Bend (made the first time it is needed); the real page (with its button)
  // shows only while it lies flat. shown eases toward p: a timed turn when anim, else a quick follow of the scroll.
  var leaf = D.querySelector('.i-leaf'), host = null, bend = null, shown = 0, tw = null, raf = 0;
  function ensure(){
    if (bend) return;
    host = document.createElement('div'); host.className = 'bend'; host.style.left = '756px';
    D.appendChild(host);
    var face = D.querySelector('.i-front');
    bend = Bend(host, 756, 982, 16, function(){
      var c = face.cloneNode(true);
      c.querySelectorAll('.i-faceShade').forEach(function(n){ n.remove(); });
      c.querySelectorAll('[data-turn]').forEach(function(n){ n.removeAttribute('data-turn'); });
      c.className = 'black'; c.style.cssText = 'position:absolute;left:0;top:0;width:756px;height:982px'; return c;
    }, function(){ return copy.cloneNode(true); });
  }
  function draw(q){
    shown = q;
    D.style.setProperty('--p', q); D.style.setProperty('--lift', Math.sin(q * Math.PI).toFixed(3));
    if (q > 0 && !phone.matches) { ensure(); bend(q); host.style.visibility = 'visible'; leaf.style.visibility = 'hidden'; }
    else { if (host) host.style.visibility = 'hidden'; leaf.style.visibility = ''; }
  }
  function loop(t){
    if (tw) { var k = Math.min(1, (t - tw.t0) / tw.dur); draw(tw.from + (tw.to - tw.from) * turnEase(k)); if (k >= 1) tw = null; }
    else { var q = shown + (p - shown) * 0.3; draw(Math.abs(p - q) < 0.002 ? p : q); }
    raf = (tw || shown !== p) ? requestAnimationFrame(loop) : 0;
  }
  function render(anim){
    M.classList.toggle('anim', !!anim && anim !== 2 && !reduce);
    M.style.setProperty('--p', p); M.style.setProperty('--lift', Math.sin(p * Math.PI).toFixed(3));
    if (reduce || anim === 2 || document.hidden) { tw = null; draw(p); return; }
    if (anim) tw = { from: shown, to: p, t0: performance.now(), dur: Math.max(450, 1150 * Math.abs(p - shown)) };
    if (!raf) raf = requestAnimationFrame(loop);
  }
  function finish(){ done = true; root.classList.remove('intro-on'); }
  function turn(){ p = 1; render(true); clearTimeout(fin); fin = setTimeout(finish, reduce ? 0 : 1150); }
  // On the desk (laptops), scrolling down can't go anywhere: everything nudges up together and settles back,
  // and a note says this is the whole page. Each scroll gives the same little bounce.
  var deskEl = D.parentNode, note = deskEl.querySelector('.endnote'), nudgeT, noteT;
  function nudge(){
    if (reduce) { note.classList.add('on'); clearTimeout(noteT); noteT = setTimeout(function(){ note.classList.remove('on'); }, 2200); return; }
    deskEl.classList.add('nudging'); deskEl.style.setProperty('--nudge', '-22px');
    clearTimeout(nudgeT); nudgeT = setTimeout(function(){ deskEl.classList.remove('nudging'); deskEl.style.setProperty('--nudge', '0px'); }, 140);
    note.classList.add('on'); clearTimeout(noteT); noteT = setTimeout(function(){ note.classList.remove('on'); }, 2200);
  }
  function push(d){
    if (done) {
      if (d > 0 && !phone.matches) { nudge(); return; }
      if (d >= 0 || (phone.matches && scrollY > 0)) return;
      done = false; root.classList.add('intro-on'); render(2);
    }
    if (p >= 1 && d >= 0) return;
    clearTimeout(fin);
    var now = Date.now();
    if (d > 0) { if (!start || now - last > 250) start = now; } else start = 0;
    last = now;
    clearTimeout(snap);
    if (d > 0 && start && now - start >= 700) { start = 0; turn(); return; }
    p = Math.max(0, Math.min(1, p + d / (phone.matches ? 1600 : 2200)));
    render(false);
    if (p >= 1) { fin = setTimeout(finish, 150); return; }
    snap = setTimeout(function(){ if (p < 1) { p = 0; render(true); } }, 600);
  }
  addEventListener('wheel', function(e){ push(e.deltaY || 0); }, { passive: true });
  addEventListener('touchstart', function(e){ ty = e.touches[0].clientY; }, { passive: true });
  addEventListener('touchmove', function(e){ if (ty === null) return; var y = e.touches[0].clientY; push((ty - y) * 2); ty = y; }, { passive: true });
  addEventListener('touchend', function(){ ty = null; }, { passive: true });
  addEventListener('keydown', function(e){
    if (!done && /^(ArrowDown|PageDown| |Spacebar)$/.test(e.key) && !(e.target.closest && e.target.closest('button,a'))) { e.preventDefault(); turn(); }
  });
  document.querySelectorAll('[data-turn]').forEach(function(b){ b.addEventListener('click', turn); });
  // Back: lay the turned page down again, then turn it back over to the intro
  function turnBack(){
    clearTimeout(fin); clearTimeout(snap); start = 0;
    if (phone.matches) scrollTo(0, 0);
    done = false; p = 1; root.classList.add('intro-on'); render(2);
    void D.offsetWidth; void M.offsetWidth;
    setTimeout(function(){ p = 0; render(true); }, 30);
    var b = (phone.matches ? M : D).querySelector('[data-turn]'); if (b) b.focus({ preventScroll: true });
  }
  document.querySelectorAll('[data-back]').forEach(function(b){ b.addEventListener('click', turnBack); });
})();

// "say hello" (the centre photo): on a laptop, hovering or clicking shows the message bubble, and a click
// turns the page over to /journey about 2 seconds later. On touch screens, the first tap shows the bubble and the
// second tap turns the page.
(function(){
  var canHover = matchMedia('(hover: hover) and (pointer: fine)'), phone = matchMedia('(max-width: 767px)');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches, going = false;
  function hush(){ document.querySelectorAll('.say').forEach(function(n){ n.classList.remove('say'); }); }
  function strip(n){ n.querySelectorAll('[id],[data-id],[data-for],[data-say],[data-back],[data-turn]').forEach(function(e){ ['id','data-id','data-for','data-say','data-back','data-turn'].forEach(function(k){ e.removeAttribute(k); }); }); n.removeAttribute('id'); return n; }
  // the top of /journey, drawn here so the turning page can carry it
  // On a laptop it is the journey spread (same pages as the desk), placed and scaled like #stage; dx shifts it for a
  // layer that starts at the middle of the window. On a phone it is the top of the one-column page.
  function journey(dx){
    if (phone.matches) return '<div class="mag-j"><span class="mb">Back</span><p class="mh">i prefer the scenic route.</p></div>';
    var st = document.getElementById('stage');
    return '<div class="mag-sp" style="left:' + (parseFloat(st.style.left) - dx) + 'px;top:' + st.style.top + ';transform:' + st.style.transform + '">' +
      '<div class="pageL" style="position:absolute;left:0;top:0;width:756px;height:982px"></div>' +
      '<div class="pageR" style="position:absolute;left:756px;top:0;width:756px;height:982px"></div>' +
      '<div class="sheen" style="position:absolute;left:0;top:0;width:1512px;height:982px;opacity:.6"></div>' +
      '<span class="mb" style="position:absolute;left:72px;top:76px">Back</span>' +
      '<p class="mh" style="position:absolute;left:72px;top:118px;width:600px;margin:0">i prefer the scenic route.</p>' +
      '</div>';
  }
  function fold(href){
    if (going) return; going = true;
    if (reduce) { location.href = href; return; }
    var m = document.createElement('div'), P = phone.matches;
    m.className = 'mag' + (P ? ' phone' : ''); m.setAttribute('aria-hidden', 'true'); m.inert = true;
    if (P) { // phones: the whole screen turns away to the left
      m.innerHTML = '<div class="mag-under"><div class="mag-in">' + journey(0) + '</div><div class="mag-shade"></div></div>' +
        '<div class="mag-leaf"><div class="mag-face mag-front"></div></div>';
      var c = strip(document.querySelector('main.m').cloneNode(true));
      c.style.cssText = 'position:absolute;left:0;right:0;top:' + (-scrollY) + 'px;background:none';
      m.querySelector('.mag-front').appendChild(c);
      document.body.appendChild(m);
      setTimeout(function(){ location.href = href; }, 1000);
      return;
    }
    // laptops: the desk's right page bends over the spine; its back, and the page under it, are /journey
    var W = innerWidth / 2, H = innerHeight, st = document.getElementById('stage');
    m.innerHTML = '<div class="mag-under"><div class="mag-in">' + journey(W) + '</div><div class="mag-shade"></div></div><div class="mag-lshade"></div>';
    var host = document.createElement('div'); host.className = 'bend'; host.style.left = W + 'px'; m.appendChild(host);
    var set = Bend(host, W, H, 16, function(){
      var d = strip(st.cloneNode(true)), i = d.querySelector('.intro'); if (i) i.remove();
      d.style.position = 'absolute'; d.style.transformOrigin = '0 0'; d.style.top = st.style.top; d.style.left = (parseFloat(st.style.left) - W) + 'px';
      return d;
    }, function(){
      var b = document.createElement('div'); b.className = 'mag-in'; b.style.background = '#fff'; b.innerHTML = journey(0); return b;
    });
    set(0); document.body.appendChild(m);
    var t0 = performance.now(), DUR = 1300;
    (function step(t){
      var k = Math.min(1, (t - t0) / DUR); set(turnEase(k));
      if (k < 1) requestAnimationFrame(step); else location.href = href;
    })(t0);
    setTimeout(function(){ location.href = href; }, DUR + 400); // in case the tab is in the background
  }
  addEventListener('pageshow', function(){ going = false; document.querySelectorAll('.mag').forEach(function(n){ n.remove(); }); });
  document.querySelectorAll('[data-say]').forEach(function(a){
    var t;
    a.addEventListener('click', function(e){
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // opening in a new tab: let it
      if (canHover.matches) {
        e.preventDefault(); a.classList.add('say');
        clearTimeout(t); t = setTimeout(function(){ fold(a.href); }, 900);
      } else if (!a.classList.contains('say')) {
        e.preventDefault(); hush(); a.classList.add('say');
      } else { e.preventDefault(); fold(a.href); }
    });
  });
  document.addEventListener('click', function(e){ if (!(e.target.closest && e.target.closest('[data-say]'))) hush(); });
  addEventListener('pageshow', hush); // coming back with the browser's back button
})();

// "last spotted" photo: shows only while the cursor is on the line, sitting 5px right of and above the cursor (the line is at the foot of the page)
// (with a slight drag). Leaving the line hides it.
(function(){
  var lines = document.querySelectorAll('#stage p.spotted'), line = lines[lines.length - 1]; // last one is the real desk (the first is the page-turn copy)
  if (!line) return;
  var pic = line.querySelector('.spot-pic');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var on = false, tx = 5, ty = 0, x = 5, y = 0, raf = 0;
  function aim(cx, cy){
    var r = line.getBoundingClientRect(), s = r.width / line.offsetWidth || 1; // the desk is scaled to the window
    tx = (cx - r.left) / s + 5; ty = (cy - r.top) / s - 5 - (pic.offsetHeight || 160);
  }
  function tick(){
    var k = reduce ? 1 : 0.35;
    x += (tx - x) * k; y += (ty - y) * k;
    pic.style.left = x.toFixed(1) + 'px'; pic.style.top = y.toFixed(1) + 'px';
    raf = (on && (Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3)) ? requestAnimationFrame(tick) : 0;
  }
  line.addEventListener('mouseenter', function(e){
    aim(e.clientX, e.clientY); x = tx; y = ty; pic.style.left = x + 'px'; pic.style.top = y + 'px';
    on = true; line.classList.add('on');
  });
  line.addEventListener('mousemove', function(e){ aim(e.clientX, e.clientY); if (!raf) raf = requestAnimationFrame(tick); });
  line.addEventListener('mouseleave', function(){ on = false; line.classList.remove('on'); });
})();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
