<script is:inline define:vars={{ L }}>
// the map dots and their hover cards, as in the design
var open=null,t=null,shown=null,pinsEl=document.getElementById('pins'),slot=document.getElementById('card-slot'),pinEls={};
function close(){clearTimeout(t);t=setTimeout(function(){open=null;render();},260);}
// the dots are made once, so their pulse never restarts when a card opens or closes
L.forEach(function(p,i){
  var a=document.createElement('a'); a.className='pin'; a.href=p.href; a.target='_blank'; a.rel='noopener'; a.setAttribute('data-cur','pin'); a.setAttribute('aria-label',p.name+', '+p.area);
  a.style.left=(p.x-8)+'px'; a.style.top=(p.y-8)+'px';
  var r=document.createElement('span'); r.className='ring'; r.style.animationDelay=(-(i*0.37)%2.6).toFixed(2)+'s';
  var d=document.createElement('span'); d.className='dot';
  a.appendChild(r); a.appendChild(d);
  a.addEventListener('mouseenter',function(){clearTimeout(t);if(open!==p.id){open=p.id;render();}});
  a.addEventListener('focus',function(){clearTimeout(t);if(open!==p.id){open=p.id;render();}});
  a.addEventListener('mouseleave',close);
  pinsEl.appendChild(a); pinEls[p.id]=a;
});
function render(){
  pinsEl.classList.toggle('has-open',!!open);
  L.forEach(function(p){var a=pinEls[p.id];a.classList.toggle('on',open===p.id);a.style.zIndex=open===p.id?5:1;});
  var o=null; for(var i=0;i<L.length;i++){if(L[i].id===open)o=L[i];}
  if(!o){slot.innerHTML='';shown=null;return;}
  if(shown===o.id)return; shown=o.id;
  var media=o.kind==='video'?'<video src="'+o.media+'" autoplay muted loop playsinline aria-label="'+o.alt+'" style="display:block;width:300px;height:170px;object-fit:cover"></video>':
    (o.kind==='img'?'<img src="'+o.media+'" alt="'+o.alt+'" style="display:block;width:300px;height:170px;object-fit:cover">':'');
  slot.innerHTML='<div style="position:absolute;left:'+o.mx+'px;top:'+o.my+'px;width:300px;height:420px;background:#f6f1e8;box-shadow:0 18px 40px rgba(30,6,12,.35),0 2px 6px rgba(30,6,12,.15);overflow:hidden;animation:pop .3s cubic-bezier(.3,1.5,.5,1);z-index:10">'+
   '<div style="height:170px;background:#e7d9d3;overflow:hidden">'+media+'</div><div style="padding:16px 18px 18px">'+
   '<p style="margin:0;font-family:Cinzel,serif;font-weight:600;font-size:20px;color:#6E1E2B">'+o.name+'</p>'+
   '<p style="margin:4px 0 0;font-family:\'Courier Prime\',monospace;font-size:12px;letter-spacing:.04em;color:#7a5558">'+o.area+'</p>'+
   '<p style="margin:10px 0 0;font-family:\'EB Garamond\',serif;font-style:italic;font-size:19px;line-height:1.35;color:#3a1c20">'+o.line+'</p>'+
   '<a href="'+o.href+'" target="_blank" rel="noopener" style="display:inline-block;margin-top:12px;font-family:\'Courier Prime\',monospace;font-size:13px;text-decoration:underline;text-underline-offset:3px;opacity:0;animation:late .4s ease 1s forwards">see on maps</a></div></div>';
  var v=slot.querySelector('video'); if(v){v.muted=true;v.play&&v.play().catch(function(){});} // iPhone: muted + playsinline
  var c=slot.firstChild; c.addEventListener('mouseenter',function(){clearTimeout(t);}); c.addEventListener('mouseleave',close);
}
render();
// The spread is zoomed in to cover the whole window (same as the desk), trimming a little off the edges;
// on very unusual window shapes it stops at 18% trimmed.
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),k=Math.min(Math.max(a,b),lo/0.82),st=document.getElementById('stage');st.style.transform='scale('+k+')';st.style.left=((innerWidth-1512*k)/2)+'px';st.style.top=((innerHeight-982*k)*0.4)+'px';}
addEventListener('resize',fit);fit();
</script>
