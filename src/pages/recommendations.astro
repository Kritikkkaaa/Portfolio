---
// /recommendations (was /coffee), "Genuine reccos." — layout and copy from Kritika's coffee design, in the home desk's look:
// a floral border on the left page, light cream on the right, maroon ink, Cinzel / EB Garamond / Courier Prime. Desktop: a fixed 1512x982 spread scaled to fill the window, with a hand-drawn map; every dot pulses softly, and hovering a
// dot opens a card. Below 768px: heading and the article in one column, with links to the places list (/recommendations/list).
// Photos and the video live in public/coffee/.
import Analytics from '../components/Analytics.astro';

import { L } from '../data/places';
---
