<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&amp;family=Marcellus&amp;family=Courier+Prime:wght@400;700&amp;family=EB+Garamond:ital,wght@0,400;0,500;1,400&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;height:100%;background:#f6f1e8;overflow:hidden}
#stage{position:absolute;left:0;top:0;transform-origin:0 0}
a{color:#6E1E2B;text-decoration:none}a:hover{color:#4a1220}
a:focus-visible{outline:2px solid #6E1E2B;outline-offset:4px}
/* left page: a floral border. right page: light cream. Text on the left page sits on a cream box, like the map. */
.pageL{overflow:hidden;background:#d3b99d}
.pageL .img{position:absolute;inset:0;background:url(/desk/recs-floral.webp) left top/cover no-repeat}
.pageR{background:linear-gradient(80deg,#e6dccd 0%,#eee6d9 4%,#f6f1e8 20%,#f8f4ec 46%,#f6f1e8 100%)}
.pageR::after{content:'';position:absolute;inset:0;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.18;pointer-events:none}
.pins,#card-slot{pointer-events:auto}
.chip{background:#f6f1e8;border:1.4px solid rgba(90,22,38,.55);box-shadow:0 10px 24px rgba(30,6,12,.3);box-sizing:border-box}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.28) 42%,rgba(255,255,255,0) 54%)}
.spine{background:linear-gradient(90deg,rgba(0,0,0,0) 0%,rgba(60,30,20,.10) 42%,rgba(60,30,20,.20) 50%,rgba(255,255,255,.10) 54%,rgba(0,0,0,0) 100%)}
.entry{display:grid;grid-template-columns:28px 1fr;column-gap:10px;padding:2px 0;color:#3a1c20}
.entry:hover .nm{color:#6E1E2B}
.city{transition:opacity .3s}
@keyframes late{to{opacity:1}}
@keyframes pop{from{opacity:0;transform:translateY(8px) scale(.96)}to{opacity:1;transform:none}}
/* the map dots: a soft ring grows out of each one and fades, each a little out of step with the next */
.pin{position:absolute;display:block;width:16px;height:16px}
.pin .dot{position:absolute;left:2.5px;top:2.5px;width:11px;height:11px;border-radius:50%;background:#6E1E2B;transition:transform .25s ease,opacity .25s ease,box-shadow .25s ease}
.pin .ring{position:absolute;left:2.5px;top:2.5px;width:11px;height:11px;border-radius:50%;background:#6E1E2B;opacity:0;pointer-events:none;animation:ping 2.6s ease-out infinite}
.pin.on .dot{transform:scale(1.45);box-shadow:0 0 0 5px rgba(110,30,43,.16)}
.pin.on .ring{animation:none;opacity:0}
.pins.has-open .pin:not(.on){opacity:.3}
.pin{transition:opacity .25s ease}
@keyframes ping{0%{transform:scale(1);opacity:.5}70%,100%{transform:scale(3.4);opacity:0}}
@media (prefers-reduced-motion: reduce){.pin .ring{animation:none;opacity:.2;transform:scale(2.2)}}

/* Phones (under 768px): one column, no map */
.m{display:none}
@media (max-width: 767px){
  html,body{height:auto;overflow:auto}
  #stage{display:none}
  .m{display:block;box-sizing:border-box;padding:40px 16px 40px;font-family:'EB Garamond',serif;background:#f6f1e8;min-height:100vh;color:#3a1c20}
  .m-home{display:inline-flex;align-items:center;min-height:44px;font-family:'EB Garamond',serif;font-size:19px;color:#6E1E2B;text-decoration:underline;text-underline-offset:3px}
  .m h1{margin:4px 0 24px;font-family:Cinzel,serif;font-weight:500;font-size:40px;line-height:1.05;letter-spacing:.01em;color:#6E1E2B}
  .m article{font-family:'EB Garamond',serif;font-size:18px;line-height:1.5;color:#3a1c20}
  .m article img{display:block;width:100%;height:auto;aspect-ratio:628/240;object-fit:cover;object-position:center 40%}
  .m article h2{margin:20px 0 14px;font-family:'EB Garamond',serif;font-style:italic;font-weight:400;font-size:28px;line-height:1.1;color:#3a1c20}
  .m article p{margin:0 0 12px}
  .m article .pull{margin:0 0 12px;font-style:italic;color:#6E1E2B}
  .m-list{display:inline-flex;align-items:center;min-height:44px;margin:-14px 0 14px;font-family:'Courier Prime',monospace;font-size:14px;color:#6E1E2B;text-decoration:underline;text-underline-offset:3px}
  .m-list-end{display:flex;justify-content:center;margin:28px 0 0;font-family:Cinzel,serif;font-weight:500;font-size:20px;letter-spacing:.02em;text-decoration:none}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
