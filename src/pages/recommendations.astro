<script is:inline define:vars={{ L }}>
// the map dots and their hover cards, as in the design
var open=null,t=null,shown=null,pinsEl=document.getElementById('pins'),slot=document.getElementById('card-slot');
function close(){clearTimeout(t);t=setTimeout(function(){open=null;render();},260);}
function render(){
  pinsEl.innerHTML='';
  L.forEach(function(p){
    var on=open===p.id, op=on?1:(open?0.25:0.55), sz=on?16:11;
    var a=document.createElement('a'); a.href=p.href; a.target='_blank'; a.setAttribute('data-cur','pin'); a.setAttribute('aria-label',p.name+', '+p.area);
    a.style.cssText='position:absolute;left:'+(p.x-8)+'px;top:'+(p.y-8)+'px;width:16px;height:16px;display:block;z-index:'+(on?5:1);
    var d=document.createElement('span'); d.style.cssText='position:absolute;left:'+(8-sz/2)+'px;top:'+(8-sz/2)+'px;width:'+sz+'px;height:'+sz+'px;border-radius:50%;background:rgba(169,69,42,'+op+');box-shadow:0 0 0 '+(on?5:0)+'px rgba(169,69,42,.16);transition:all .25s ease';
    a.appendChild(d);
    a.addEventListener('mouseenter',function(){clearTimeout(t);if(open!==p.id){open=p.id;render();}});
    a.addEventListener('focus',function(){clearTimeout(t);if(open!==p.id){open=p.id;render();}});
    a.addEventListener('mouseleave',close);
    pinsEl.appendChild(a);
  });
  var o=null; for(var i=0;i<L.length;i++){if(L[i].id===open)o=L[i];}
  if(!o){slot.innerHTML='';shown=null;return;}
  if(shown===o.id)return; shown=o.id;
  var media=o.kind==='video'?'<video src="'+o.media+'" autoplay muted loop playsinline aria-label="'+o.alt+'" style="display:block;width:300px;height:170px;object-fit:cover"></video>':
    (o.kind==='img'?'<img src="'+o.media+'" alt="'+o.alt+'" style="display:block;width:300px;height:170px;object-fit:cover">':'');
  slot.innerHTML='<div style="position:absolute;left:'+o.mx+'px;top:'+o.my+'px;width:300px;height:420px;background:#fff;box-shadow:0 18px 40px rgba(70,50,35,.22),0 2px 6px rgba(70,50,35,.1);overflow:hidden;animation:pop .3s cubic-bezier(.3,1.5,.5,1);z-index:10">'+
   '<div style="height:170px;background:#efece6;overflow:hidden">'+media+'</div><div style="padding:16px 18px 18px">'+
   '<p style="margin:0;font-family:Geist,sans-serif;font-weight:600;font-size:20px;color:#A9452A">'+o.name+'</p>'+
   '<p style="margin:2px 0 0;font-size:13px;color:#6f6862">'+o.area+'</p>'+
   '<p style="margin:10px 0 0;font-family:\'EB Garamond\',serif;font-style:italic;font-size:18px;line-height:1.35;color:#2a2724">'+o.line+'</p>'+
   '<a href="'+o.href+'" target="_blank" style="display:inline-block;margin-top:12px;font-size:14px;text-decoration:underline;text-underline-offset:3px;opacity:0;animation:late .4s ease 1s forwards">see on maps</a></div></div>';
  var v=slot.querySelector('video'); if(v){v.muted=true;v.play&&v.play().catch(function(){});} // iPhone: muted + playsinline
  var c=slot.firstChild; c.addEventListener('mouseenter',function(){clearTimeout(t);}); c.addEventListener('mouseleave',close);
}
render();
// The spread is zoomed in to cover the whole window (same as the desk), trimming a little off the edges;
// on very unusual window shapes it stops at 18% trimmed.
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),k=Math.min(Math.max(a,b),lo/0.82),st=document.getElementById('stage');st.style.transform='scale('+k+')';st.style.left=((innerWidth-1512*k)/2)+'px';st.style.top=((innerHeight-982*k)*0.4)+'px';}
addEventListener('resize',fit);fit();
</script>
