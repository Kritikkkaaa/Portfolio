---
// /work, "Proof of work." Draft of the work page, one fold like the rest of the site.
// Desktop: one magazine spread (1512x982, scaled to fit the window).
//  Left page (plum): the heading, and a stack of three file folders that filter the work (the open one is raised).
//   Under them: View resume (opens in a new tab) and Let's talk.
//  Right page (ivory): the work for the chosen folder as film-strip cards, three to a screen; more scroll inside the page.
// Below 768px: one column. Folders on top, the chosen folder's work underneath.
// To add a piece: add it to CASES, then list its key under the folders it belongs to in FOLDERS.
import Analytics from '../components/Analytics.astro';

// 'paper' and 'ai' are not listed in any folder for now. Add their keys to a folder's `cases` when they are ready.
const CASES: Record<string, { title: string; line: string; img: string; href?: string; mins?: number; soon?: boolean }> = {
  twitter: { title: 'Growing Plane’s Twitter', line: '2.5k followers in 6 months. 500+ posts and 20+ release notes.', img: '/jobs/twitter-network.webp', href: '/work/grow-planes-twitter', mins: 3 },
  pricing: { title: 'Plane One launch', line: 'Launching Plane One on Twitter: the tease, the reveal and the letter.', img: '/jobs/pricing-invoice.webp', href: '/work/plane-one-campaign', mins: 3 },
  nexus: { title: 'Who Nexus is for', line: 'How I shaped Nexus’s ICP and positioning.', img: '/jobs/chess-linocut.png', href: '/work/who-nexus-is-for', mins: 3 },
  paper: { title: 'Paper’s onboarding emails', line: 'A teardown of what the first emails say, what they should, and why.', img: '/jobs/paper-envelope.png', soon: true },
  ai: { title: 'AI in market research', line: 'The prompts, checks and workflow I use to understand a market fast.', img: '/jobs/ai-scribble.webp', soon: true }
};

// the three folders, top to bottom.
const FOLDERS = [
  { id: 'launch', label: 'Launch and GTM', dek: 'Taking a product to market.', cases: ['pricing'] },
  { id: 'audience', label: 'Audience and content', dek: 'An audience built from zero.', cases: ['twitter'] },
  { id: 'positioning', label: 'Positioning and messaging', dek: 'Who it’s for and how we say it.', cases: ['nexus'] }
];
const RESUME = { label: 'View resume', href: 'https://drive.google.com/file/d/1N3Y5Ox7I9qyHALM9LQUa7119Z-LBgCR6/view?usp=sharing&utm_source=portfolio&utm_medium=website&utm_campaign=hunt-2026&utm_id=kritikal-work-resume' };

const plural = (n: number) => `${n} piece${n === 1 ? '' : 's'}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · proof of work</title>
<meta name="description" content="Kritika's work: product launches, audience and content, positioning and messaging. Pick a folder to see the case studies.">
<link rel="stylesheet" href="/buttons.css">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&amp;family=Marcellus&amp;family=Courier+Prime:wght@400;700&amp;display=swap" rel="stylesheet">
<style is:inline>
html{margin:0;background:linear-gradient(90deg,#5a1626 50%,#f6f1e8 50%)}
body{margin:0;color:#3d2430;font-family:'Courier Prime',ui-monospace,monospace}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:2px solid #5B3FD9;outline-offset:3px}
.fold{position:relative;height:100vh;overflow:hidden}
.stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* left page: plum wall, heading, folders */
.L{position:absolute;left:0;top:0;width:756px;height:982px;background:#5a1626}
.back{position:absolute;left:56px;top:44px;z-index:30;font-family:Marcellus,Georgia,serif;font-size:16px;color:rgba(246,241,232,.78);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px;transition:color .2s}
.back:hover,.back:focus-visible{color:#f6f1e8}
h1{position:absolute;left:56px;top:150px;width:644px;margin:0;font-family:Cinzel,serif;font-weight:500;font-size:54px;line-height:1.1;letter-spacing:.12em;text-transform:uppercase;color:#f6f1e8}
/* the open folder's dot breathes until the reader has used a folder, so it is clear the others can be opened */
@keyframes dotring{0%{box-shadow:0 0 0 0 var(--ring)}70%,100%{box-shadow:0 0 0 9px rgba(0,0,0,0)}}
@media (prefers-reduced-motion: no-preference){
  body:not(.learned) .fd[aria-selected="true"] .tb::before,body:not(.learned) .mf[aria-selected="true"]::after{animation:dotring 2.6s ease-out infinite}
}
.fd{position:absolute;left:-600px;width:1356px;bottom:-60px;transition:transform .25s cubic-bezier(.3,1.2,.5,1);display:block;box-sizing:border-box;border:0;padding:0;margin:0;border-radius:20px 20px 0 0;background:var(--c);cursor:pointer;font:inherit;text-align:left}
.tb{position:absolute;top:-53px;height:54px;padding:0 30px;display:flex;align-items:center;gap:10px;box-sizing:border-box;border-radius:16px 16px 0 0;background:var(--c);font-family:Cinzel,serif;font-weight:600;font-size:18px;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;color:var(--t,#3d1520)}
.fd::before{content:"";position:absolute;inset:0;border-radius:inherit;background-image:var(--deco);background-repeat:no-repeat;opacity:.6;pointer-events:none}
.f1::before{background-size:820px auto;background-position:right -10px top -170px}
.f2::before{background-image:url(/work-decor/lotus.png),url(/work-decor/motif.png);background-size:330px auto,470px auto;background-position:right 90px top -190px,left 620px top -110px}
.f3::before{background-size:420px auto;background-position:left 0 top 0;transform:scaleX(-1)}
.fd[aria-selected="true"]{transform:translateY(-18px);box-shadow:0 -8px 18px rgba(30,6,12,.28)}
.fd[aria-selected="true"] .tb::before{content:"";width:9px;height:9px;border-radius:50%;background:currentColor}
.cvt{display:none;margin-left:6px;padding-left:14px;border-left:1px solid currentColor;font-family:'Courier Prime',ui-monospace,monospace;font-weight:400;font-size:12px;letter-spacing:.02em;text-transform:none;opacity:.72}
.fd[aria-selected="true"] .cvt,.mf[aria-selected="true"] .cvt{display:inline}
.fd:not([aria-selected="true"]):hover,.fd:not([aria-selected="true"]):focus-visible{transform:translateY(-6px)}
.f1{--c:#d9cfc0;--ring:rgba(61,21,32,.4);--deco:url(/work-decor/vine.png);top:460px;z-index:1}.f1 .tb{left:656px}
.f2{--c:#4a7568;--t:#f6f1e8;--ring:rgba(246,241,232,.45);--deco:url(/work-decor/lotus.png);top:580px;z-index:2}.f2 .tb{left:820px}
.f3{--c:#2a2724;--t:#f6f1e8;--ring:rgba(246,241,232,.45);--deco:url(/work-decor/lace.png);top:700px;z-index:3}.f3 .tb{left:710px}
.ask{position:absolute;left:56px;top:228px;margin:0;z-index:30;font-family:'Courier Prime',ui-monospace,monospace;font-size:18px;color:rgba(246,241,232,.9)}
.ctas{position:absolute;left:56px;top:272px;z-index:30;display:flex;gap:14px;white-space:nowrap}
/* on the maroon wall the buttons swap colours: Let's talk is the ivory one, View resume an outline */
.ctas .kbtn-primary{background:#f6f1e8;color:#5a1626;border-color:#f6f1e8}
.ctas .kbtn-primary:hover,.ctas .kbtn-primary:focus-visible{background:#fffdf8;color:#5a1626}
.ctas .kbtn-soft{background:transparent;color:#f6f1e8;border-color:rgba(246,241,232,.7)}
.ctas .kbtn-soft:hover,.ctas .kbtn-soft:focus-visible{background:rgba(246,241,232,.1);color:#f6f1e8}

/* right page: ivory, the work */
.R{position:absolute;left:756px;top:0;width:756px;height:982px;background:linear-gradient(180deg,#f9f5ed 0%,#f3ede2 100%);border-left:1px solid rgba(90,22,38,.16)}
.pn[hidden]{display:none}
.ph{position:absolute;left:56px;top:76px;width:644px}
h2{margin:0;font-family:Cinzel,serif;font-weight:500;font-size:34px;letter-spacing:.12em;text-transform:uppercase;color:#5a1626;line-height:1.1}
.dek{margin:12px 0 0;font-size:16px;color:#6b5a5a}
.cnt{position:absolute;right:0;bottom:2px;font-size:14px;color:#6b5a5a}
.sc{position:absolute;left:56px;top:196px;width:644px;height:726px;overflow-y:auto;overflow-x:hidden;scroll-snap-type:y mandatory;scrollbar-width:thin;scrollbar-color:#5a1626 rgba(90,22,38,.14);outline-offset:4px}
.sc.more{-webkit-mask-image:linear-gradient(180deg,#000 97%,transparent 100%);mask-image:linear-gradient(180deg,#000 97%,transparent 100%)}
.sc::-webkit-scrollbar{width:6px}.sc::-webkit-scrollbar-thumb{background:#5a1626}.sc::-webkit-scrollbar-track{background:rgba(90,22,38,.14)}
.row{display:grid;grid-template-columns:190px 1fr;column-gap:34px;height:242px;scroll-snap-align:start}
.fs{position:relative;display:block;padding:14px 24px;box-sizing:border-box;background:radial-gradient(circle at 9px 11px,#f6f1e8 3.5px,transparent 4px) 0 0/18px 22px repeat-y,radial-gradient(circle at 9px 11px,#f6f1e8 3.5px,transparent 4px) 100% 0/18px 22px repeat-y,#2a2724}
.fs img{display:block;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.05);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.fs span{display:block;width:100%;height:100%;overflow:hidden}
a.fs:hover img{transform:scale(1.05)}
.row.soon .fs img{opacity:.38}
.fs b{position:absolute;left:24px;right:24px;top:50%;transform:translateY(-50%);z-index:2;text-align:center;font-family:Cinzel,serif;font-weight:600;font-size:15px;line-height:1.35;letter-spacing:.14em;text-transform:uppercase;color:#f6f1e8}
.row.soon .fs span{position:relative}
.row.soon.none .fs span{border:1px dashed #f6f1e8;box-sizing:border-box}
.cd{align-self:center;height:214px;box-sizing:border-box;padding:22px 26px 20px;display:flex;flex-direction:column;background:#fffaf0;border:1px solid rgba(90,22,38,.22)}
.row.soon .cd{background:transparent;border:1px dashed #5a1626}
.cd{position:relative;transition:transform .25s cubic-bezier(.3,1.2,.5,1),border-color .2s,box-shadow .25s}
.cd .kbtn::after{content:"";position:absolute;inset:0}
.ct{background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size .3s ease;width:fit-content}
.row:not(.soon):hover .cd,.row:not(.soon):focus-within .cd{transform:translateY(-4px);border-color:#5a1626;box-shadow:0 12px 26px rgba(90,22,38,.16)}
.row:not(.soon):hover .ct,.row:not(.soon):focus-within .ct{background-size:100% 1px}
.row:not(.soon):hover .cb .kbtn,.row:not(.soon):focus-within .cb .kbtn{background:#fffdf8}
.row:not(.soon):hover .fs img{transform:scale(1.06);filter:grayscale(0) contrast(1.05)}
.ct{font-family:Marcellus,Georgia,serif;font-size:26px;line-height:1.15;color:#3d2430}
.cl{margin-top:8px;font-size:15px;line-height:1.45;color:#5f4d4d}
.cb{margin-top:auto;display:flex;align-items:center;justify-content:space-between}
.cb .kbtn{min-height:42px;padding:8px 20px;font-size:17px}
.mn{font-size:14px;color:#6b5a5a}
.sm{position:absolute;left:0;right:0;bottom:30px;z-index:5;display:none;width:max-content;margin:0 auto;padding:6px 4px;border:0;background:none;color:#5a1626;font-family:Marcellus,Georgia,serif;font-size:17px;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px;cursor:pointer;animation:bob 1.7s ease-in-out infinite}
.sm.on{display:block}
.sm:hover,.sm:focus-visible{color:#3f0f1a}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(7px)}}

/* phones: one column */
.m{display:none}
@media (max-width: 767px){
  html{background:#f6f1e8}
  .fold{display:none}
  .m{display:block}
  .mh{position:relative;background:#5a1626;padding:max(16px,env(safe-area-inset-top)) 20px 0;overflow:hidden}
  .mh .back{position:static;display:inline-block;padding:10px 0}
  .mh h1{position:static;width:auto;margin:30px 0 0;font-size:36px;letter-spacing:.1em}
  .mh .ask{position:static;margin:18px 0 0;font-size:16px}
  .mh .ctas{position:static;flex-wrap:wrap;margin:12px 0 54px}
  .mh .ctas .kbtn{min-height:44px;padding:10px 20px;font-size:16px}
  .mf{position:relative;display:block;width:calc(100% + 40px);margin:-15px -20px 0;padding:22px 20px 0;height:78px;border-radius:18px 18px 0 0;box-sizing:border-box;font-family:Cinzel,serif;font-weight:600;font-size:15px;letter-spacing:.08em;text-transform:uppercase;color:var(--t,#3d1520);background:var(--c);text-align:left;cursor:pointer;border:0}
  .mf:first-of-type{margin-top:0}
  .mf[aria-selected="true"]::after{content:"";display:inline-block;width:8px;height:8px;margin:0 0 0 9px;border-radius:50%;background:currentColor;vertical-align:1px}
  .mf .cvt{font-size:11px;padding-left:10px;margin-left:8px}
  .mf.g1{z-index:1;--ring:rgba(61,21,32,.4);--deco:url(/work-decor/vine.png)}.mf.g2{z-index:2;--ring:rgba(246,241,232,.45);--deco:url(/work-decor/lotus.png)}.mf.g3{z-index:3;--ring:rgba(246,241,232,.45);--deco:url(/work-decor/lace.png)}
  .mf{overflow:hidden;isolation:isolate}
  .mf::before{content:"";position:absolute;inset:0;z-index:-1;background-image:var(--deco);background-repeat:no-repeat;opacity:.6;pointer-events:none}
  .mf.g1::before{background-size:430px auto;background-position:right -10px top -90px}
  .mf.g2::before{background-image:url(/work-decor/lotus.png),url(/work-decor/motif.png);background-size:190px auto,260px auto;background-position:right 40px top -110px,left 10px top -60px}
  .mf.g3::before{background-size:230px auto;background-position:left 0 top 0;transform:scaleX(-1)}
  .mp{padding:30px 20px 12px;background:linear-gradient(180deg,#f9f5ed 0%,#f3ede2 100%)}
  .mp h2{font-size:26px}
  .mp .dek{margin:8px 0 6px;font-size:14px}
  .mp .mc{margin:0 0 18px;font-size:13px;color:#6b5a5a}
  .mp .row{grid-template-columns:84px 1fr;column-gap:14px;height:176px}
  .mp .fs{padding:14px 16px}
  .mp .fs{background:radial-gradient(circle at 6px 11px,#f6f1e8 2.6px,transparent 3px) 0 0/12px 22px repeat-y,radial-gradient(circle at 6px 11px,#f6f1e8 2.6px,transparent 3px) 100% 0/12px 22px repeat-y,#2a2724}
  .mp .fs b{left:8px;right:8px;font-size:10px;letter-spacing:.1em}
  .mp .cd{height:148px;padding:12px 14px 12px}
  .mp .ct{font-size:17px}
  .mp .cl{margin-top:5px;font-size:12.5px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .mp .cb .kbtn{min-height:36px;padding:6px 14px;font-size:15px}
  .mp .mn{font-size:12px}
  .mp .cb .more{display:none}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
@media (prefers-reduced-motion: reduce){.fd,.fs img,.cd,.ct{transition:none}.sm{animation:none}}
</style>
<Analytics />
</head>
<body>
<section class="fold" aria-label="Proof of work">
<div class="stage" id="stage">
<div class="L">
<a class="back" href="/home">← Back</a>
<h1>Proof of work</h1>
<p class="ask">Are you looking for a marketer?</p>
<div class="ctas">
<a class="kbtn kbtn-soft" href={RESUME.href} target="_blank" rel="noopener">{RESUME.label}</a>
<a class="kbtn kbtn-primary" href="/contact">Let’s talk →</a>
</div>
<div role="tablist" aria-label="Kinds of work" aria-orientation="vertical">
{FOLDERS.map((f, i) => (
  <button class={`fd f${i + 1}`} type="button" role="tab" id={`t-${f.id}`} data-tab={f.id} aria-controls={`p-${f.id}`} aria-selected={i === 0 ? 'true' : 'false'}><span class="tb">{f.label}<span class="cvt">Currently viewing</span></span></button>
))}
</div>
</div>

<div class="R">
{FOLDERS.map((f, i) => (
  <div class="pn" id={`p-${f.id}`} data-panel={f.id} role="tabpanel" aria-labelledby={`t-${f.id}`} hidden={i !== 0}>
    <div class="ph">
      <h2>{f.label}</h2>
      <p class="dek">{f.dek}</p>
      {f.cases.length > 0 && <span class="cnt">{plural(f.cases.length)}</span>}
    </div>
    <div class="sc" tabindex="0" aria-label={`${f.label}: ${plural(f.cases.length)}`}>
      {f.cases.length === 0 && (
        <div class="row soon none"><span class="fs" aria-hidden="true"><span></span><b>Coming soon</b></span><div class="cd"><span class="ct">What the Fork by Marmeto</span><span class="cl">Write-up coming soon.</span></div></div>
      )}
      {f.cases.map((k) => { const c = CASES[k]; return (
        <div class={`row${c.soon ? ' soon' : ''}`}>
          {c.soon
            ? <span class="fs" aria-hidden="true"><span><img src={c.img} alt="" loading="lazy"></span><b>Coming soon</b></span>
            : <a class="fs" href={c.href} tabindex="-1" aria-hidden="true"><span><img src={c.img} alt="" loading="lazy"></span></a>}
          <div class="cd">
            <span class="ct">{c.title}</span>
            <span class="cl">{c.line}</span>
            {!c.soon && <div class="cb"><a class="kbtn" href={c.href} aria-label={`Read: ${c.title}`}>See how<span class="more"> it worked</span> →</a><span class="mn">{c.mins} min read</span></div>}
          </div>
        </div>
      ); })}
    </div>
  </div>
))}
<button class="sm" id="sm" type="button" aria-label="Scroll down for more work">Scroll for more ↓</button>
</div>
</div>
</section>

<main class="m">
<div class="mh">
<a class="back" href="/home">← Back</a>
<h1>Proof of work</h1>
<p class="ask">Are you looking for a marketer?</p>
<div class="ctas">
<a class="kbtn kbtn-soft" href={RESUME.href} target="_blank" rel="noopener">{RESUME.label}</a>
<a class="kbtn kbtn-primary" href="/contact">Let’s talk →</a>
</div>
<div role="tablist" aria-label="Kinds of work">
{FOLDERS.map((f, i) => (
  <button class={`mf g${i + 1}`} type="button" role="tab" data-tab={f.id} aria-selected={i === 0 ? 'true' : 'false'} style={`--c:${['#d9cfc0', '#4a7568', '#2a2724'][i]};--t:${['#3d1520', '#f6f1e8', '#f6f1e8'][i]}`}>{f.label}<span class="cvt">Currently viewing</span></button>
))}
</div>
</div>
<div class="mp" id="mp">
{FOLDERS.map((f, i) => (
  <div data-panel={f.id} id={`m-${f.id}`} hidden={i !== 0}>
    <h2>{f.label}</h2>
    <p class="dek">{f.dek}</p>
    {f.cases.length > 0 && <p class="mc">{plural(f.cases.length)}</p>}
    {f.cases.length === 0 && (
      <div class="row soon none"><span class="fs" aria-hidden="true"><span></span><b>Coming soon</b></span><div class="cd"><span class="ct">What the Fork by Marmeto</span><span class="cl">Write-up coming soon.</span></div></div>
    )}
    {f.cases.map((k) => { const c = CASES[k]; return (
      <div class={`row${c.soon ? ' soon' : ''}`}>
        <span class="fs" aria-hidden="true"><span><img src={c.img} alt="" loading="lazy"></span>{c.soon && <b>Coming soon</b>}</span>
        <div class="cd">
          <span class="ct">{c.title}</span>
          <span class="cl">{c.line}</span>
          {!c.soon && <div class="cb"><a class="kbtn" href={c.href} aria-label={`Read: ${c.title}`}>See how<span class="more"> it worked</span> →</a><span class="mn">{c.mins} min read</span></div>}
        </div>
      </div>
    ); })}
  </div>
))}
</div>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// the spread is scaled to fit the window; the page's own colours carry on past its edges, and it sits on the bottom edge
function fit(){var s=Math.min(innerWidth/1512,innerHeight/982);var st=document.getElementById('stage');if(!st)return;st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=(innerHeight-982*s)+'px';}
addEventListener('resize',fit);fit();
// folders: choosing one swaps the work on the right (and under the folders on phones)
(function(){
  var tabs=[].slice.call(document.querySelectorAll('[data-tab]')),panels=[].slice.call(document.querySelectorAll('[data-panel]'));
  var ids=tabs.map(function(t){return t.dataset.tab}).filter(function(v,i,a){return a.indexOf(v)===i});
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sm=document.getElementById('sm');
  function more(){var any=false;document.querySelectorAll('.sc').forEach(function(sc){var m=sc.scrollHeight-sc.clientHeight>4&&sc.scrollTop+sc.clientHeight<sc.scrollHeight-4;sc.classList.toggle('more',m);if(m&&!sc.closest('.pn').hidden)any=true;});if(sm)sm.classList.toggle('on',any);}
  if(sm)sm.addEventListener('click',function(){var sc=document.querySelector('.pn:not([hidden]) .sc');if(sc)sc.scrollBy({top:sc.clientHeight,behavior:reduce?'auto':'smooth'});});
  function select(id,fromUser){
    tabs.forEach(function(t){t.setAttribute('aria-selected',t.dataset.tab===id?'true':'false');});
    if(fromUser)document.body.classList.add('learned');
    panels.forEach(function(p){p.hidden=p.dataset.panel!==id;});
    var sc=document.querySelector('.pn:not([hidden]) .sc');if(sc)sc.scrollTop=0;
    more();
    try{history.replaceState(null,'','#'+id)}catch(e){}
    if(fromUser&&matchMedia('(max-width: 767px)').matches){var t=document.getElementById('m-'+id);if(t)t.scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});}
  }
  tabs.forEach(function(t){t.addEventListener('click',function(){select(t.dataset.tab,true)});});
  document.querySelectorAll('[role="tablist"]').forEach(function(list){
    list.addEventListener('keydown',function(e){
      var own=[].slice.call(list.querySelectorAll('[data-tab]'));var i=own.indexOf(document.activeElement);if(i<0)return;
      var d=e.key==='ArrowDown'||e.key==='ArrowRight'?1:e.key==='ArrowUp'||e.key==='ArrowLeft'?-1:0;if(!d)return;
      e.preventDefault();var n=own[(i+d+own.length)%own.length];n.focus();select(n.dataset.tab,true);
    });
  });
  document.querySelectorAll('.sc').forEach(function(sc){sc.addEventListener('scroll',more,{passive:true});});
  addEventListener('pagehide',function(){var sc=document.querySelector('.pn:not([hidden]) .sc');try{sessionStorage.setItem('wr-scroll',JSON.stringify({id:location.hash.slice(1),top:sc?sc.scrollTop:0}))}catch(e){}});
  addEventListener('resize',more);
  var h=location.hash.slice(1);select(ids.indexOf(h)>=0?h:ids[0],false);
  addEventListener('hashchange',function(){var g=location.hash.slice(1);if(ids.indexOf(g)>=0)select(g,false);});
  try{var sv=JSON.parse(sessionStorage.getItem('wr-scroll')||'null');if(sv&&sv.id===(location.hash.slice(1)||ids[0])){var sc0=document.querySelector('.pn:not([hidden]) .sc');if(sc0)sc0.scrollTop=sv.top;}}catch(e){}
  addEventListener('load',more);
})();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
<script is:inline src="/stack.js?v=2" defer></script>
</body>
