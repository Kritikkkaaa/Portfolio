---
// ICP-Nexus case study (draft, dummy content): a first fold with the whole picture, then one board the reader is guided across.
// Every section follows the same five steps: context, what i did, the number i found, what i did next, and the question
// that leads to the next section. The red string runs from each question to the next section.
// Desktop: scrolling moves a camera across the board and pins each piece up in order; readers can also drag and zoom.
// Phones: the board opens zoomed out; tap a section to zoom in, then pinch and drag.
import Base from '../layouts/Base.astro';

const description = 'knowing who uses your product doesn’t tell you who to target. how i brought a product manager’s understanding of users into defining nexus’s ideal customer profile and messaging.';

const skills = [
  { id: 'research', label: 'customer and audience research' },
  { id: 'positioning', label: 'positioning and messaging' },
  { id: 'collab', label: 'cross-functional collaboration' }
];

// The three sections are stacked down the board, and the ending sits at the bottom, so zoomed out the whole case fits on one screen.
const SEC_W = 1600, GAP = 300, S2Y = 1000 + GAP, S3Y = S2Y + 1100 + GAP, END_Y = S3Y + 1360 + 140, WORLD_W = SEC_W, WORLD_H = END_Y + 380;
const sections = [
  { n: '01', title: 'users, but no clear audience', short: 'unclear', x: 0, y: 0, h: 1000 },
  { n: '02', title: 'choosing who to target', short: 'learned', x: 0, y: S2Y, h: 1100 },
  { n: '03', title: 'turning customer value into messaging', short: 'changed', x: 0, y: S3Y, h: 1360 }
];

// The same five slots in every section, in reading order. Section-local positions:
// the number sits top-left on a white page, everything in my words runs down the right.
const slots = {
  ctx: { x: 760, y: 110, w: 390, h: 330, r: -1.2 },
  did: { x: 1190, y: 100, w: 370, h: 360, r: 1.2 },
  data: { x: 60, y: 140, w: 600, h: 400, r: -0.5 },
  next: { x: 760, y: 580, w: 390, h: 300, r: 0.8 },
  ask: { x: 1200, y: 560, w: 340, h: 240, r: -1.6 }
} as const;
type Slot = keyof typeof slots;
const ORDER: Slot[] = ['ctx', 'did', 'data', 'next', 'ask'];

// A checklist can carry its own title, and mark its items as open questions (?) instead of done (✓).
// It can also carry a circled handwritten aim written on the board just above it.
// A note can be tinted green instead of its usual colour.
// A section can skip a slot, and move a slot with `at`. A note can add a smaller handwritten line under its text.
// Note text can hold paragraphs (separated by a blank line). A checklist can open with an intro line.
// A slot can be a pinned screenshot instead of a card.
type Step = { text?: string; intro?: string; img?: { src: string; iw: number; ih: number; alt: string; caption: string }; sub?: string; items?: string[]; title?: string; mark?: 'q'; aim?: string; tint?: 'green'; at?: { x?: number; y?: number; h?: number }; skills: string[] };
const story: Partial<Record<Slot, Step>>[] = [
  {
    ctx: { skills: ['research', 'collab'], at: { h: 220 }, text: 'the co-founder asked for a nexus marketing one-pager. i knew how people used the product.\n\ni needed to decide who to target and what to say.' },
    did: { skills: ['research'], title: 'open questions', mark: 'q', items: ['who installs nexus today, and who pays?', 'who did the founders originally build it for?', 'what do those customers need nexus to handle?', 'which customers should our messaging target first?'] },
    data: { skills: ['research'], at: { h: 340 } },
    next: { skills: ['research', 'collab'], at: { x: 760, y: 420 }, items: ['collated all existing user information', 'reviewed the one-pager with the co-founder'] },
    ask: { skills: ['research'], at: { x: 1200, y: 540 }, text: 'who should nexus be for?' }
  },
  {
    did: { skills: ['research', 'collab'], at: { x: 760, y: 110 }, aim: 'the aim: find who gets the most value from nexus.', items: ['defined who to target with the co-founder', 'checked why merchants uninstalled', 'checked what merchants needed in intercom'] },
    data: { skills: ['research'], at: { h: 340 } },
    next: { skills: ['research', 'positioning'], at: { x: 760, y: 560 }, items: ['defined the primary ICP', 'defined guardrails and where they hang out'] },
    ask: { skills: ['positioning'], at: { x: 1200, y: 110 }, text: 'what value does our primary ICP get?', sub: 'aka positioning' }
  },
  {
    ctx: { skills: ['positioning', 'collab'], at: { h: 220 }, text: 'i knew who to target.\n\ni spoke with shashwat to align the message with his vision for nexus.' },
    did: { skills: ['research', 'collab'], mark: 'q', intro: 'interviewed the co-founder using the mom test.', items: ['what should merchants say about nexus after a year?', 'which merchants would you turn away?', 'if we showed one thing, what would it be?'] },
    data: { skills: ['positioning'], at: { h: 360 } },
    next: { skills: ['positioning'], at: { x: 60, y: 540, w: 560 }, img: { src: '/case/icp-nexus/value-prop.png', iw: 734, ih: 972, caption: 'messaging from the one-pager', alt: 'Value Proposition section of the Nexus marketing one-pager: positioning, the old way, and with Nexus. Simple to use: sellers sign up through your branded link and land on their own dashboard. Simple to grow with: sellers manage their own products, and Nexus calculates each commission. Simple to migrate: install from the Shopify App Store, try it for 14 days and start on your existing store.' } },
    ask: { skills: ['positioning'], tint: 'green', at: { x: 760, y: 420 }, text: 'nexus is simple.\n\nsimple to start, manage and grow!' }
  }
];

const pieces = story.flatMap((sec, i) => ORDER.filter((slot) => sec[slot]).map((slot, k) => {
  const pos = { ...slots[slot], ...sec[slot]!.at };
  return { id: `s${i + 1}-${slot}`, sec: i, slot, step: k + 1, ...pos, ...sec[slot]!, ax: sections[i].x + pos.x, ay: sections[i].y + pos.y };
}));

// Documents pinned to a card, revealed with it and joined to it by a dotted thread. Section-local positions.
// An attachment is either an image, or (until its screenshot arrives) a typed excerpt with its lines listed.
type Attachment = { id: string; sec: number; with: string; x: number; y: number; w: number; r: number; src?: string; iw: number; ih: number; lines?: [string, string][]; alt: string; caption: string; skills: string[]; from: [number, number]; color: string };
const attachments: Attachment[] = [
  { id: 's1-shot', sec: 0, with: 's1-next', x: 60, y: 540, w: 600, r: -1.2, src: '/case/icp-nexus/one-pager.png', iw: 1732, ih: 720,
    alt: 'Part of the Nexus marketing one-pager: the minimum data needed, from business goal to desired action, and how to get each.',
    caption: 'part of the one-pager', skills: ['research', 'collab'], from: [770, 480], color: '#8FB3DA' },
  { id: 's2-icp', sec: 1, with: 's2-next', x: 40, y: 600, w: 640, r: -1, src: '/case/icp-nexus/icp-table.png', iw: 1084, ih: 660,
    alt: 'The Nexus ideal customer profile: business, Shopify plan, region, trigger moment and job to be done, each with its evidence.',
    caption: 'final ICP!', skills: ['research', 'positioning'], from: [790, 815], color: '#BCE5CF' },
  { id: 's2-notfor', sec: 1, with: 's2-next', x: 1170, y: 470, w: 400, r: 1.2, src: '/case/icp-nexus/not-for.png', iw: 1106, ih: 488,
    alt: 'Who Nexus is not for: stores syncing to Etsy, Amazon or Walmart, vendors looking to join a marketplace, agencies testing on dev stores, and large enterprises needing a custom build.',
    caption: 'guardrails aka, who we do not serve', skills: ['positioning'], from: [1150, 650], color: '#BCE5CF' },
  { id: 's2-where', sec: 1, with: 's2-next', x: 1180, y: 745, w: 400, r: -1, src: '/case/icp-nexus/where-they-gather.png', iw: 896, ih: 252,
    alt: 'Where they gather: Shopify App Store search, about 48% of discovery; Google, about 11%; AI assistants and the listicles they cite; other platforms such as Product Hunt and G2.',
    caption: 'where they hang out', skills: ['research', 'positioning'], from: [1370, 712], color: '#BCE5CF' }
];
const attachAt = (a: Attachment) => ({ x: sections[a.sec].x + a.x, y: sections[a.sec].y + a.y, w: a.w, h: Math.round(a.w * a.ih / a.iw) + 60 });
const ties = attachments.map((a) => {
  const s = sections[a.sec], [fx, fy] = [s.x + a.from[0], s.y + a.from[1]];
  const tx = s.x + a.x + a.w / 2, ty = s.y + a.y + 4, my = (fy + ty) / 2;
  return { for: a.id, color: a.color, d: `M ${fx} ${fy} C ${fx} ${my}, ${tx} ${my}, ${tx} ${ty}` };
});

// Where the camera looks, and which pieces get pinned up. cam: -1 = the whole board, 0–3 = a section,
// or an exact area. Section 02 is read in two halves: its cards first, then its document cluster.
// The first frame is the snapshot: every piece on the board at once.
type Area = { x: number; y: number; w: number; h: number };
const s2View: Area = { x: sections[1].x, y: sections[1].y - 80, w: SEC_W, h: 1180 };
// Section 03 is read the same way: cards first, then the value proposition pinned under its chart.
const s3Top: Area = { x: sections[2].x, y: sections[2].y - 40, w: SEC_W, h: 1040 };
const s3Low: Area = { x: sections[2].x, y: sections[2].y + 380, w: SEC_W, h: 1000 };
const s3Shot: Area = { x: sections[2].x + 40, y: sections[2].y + 510, w: 600, h: 830 };
// The last stop: section 03's closing note, the string running down, and the ending under it.
const endView: Area = { x: 0, y: sections[2].y + 380, w: SEC_W, h: END_Y + 380 - (sections[2].y + 380) };
const frames: { cam: number | Area; sec: number; show: string[] }[] = [{ cam: -1, sec: -1, show: [...pieces.map((p) => p.id), ...attachments.map((a) => a.id)] }];
story.forEach((sec, i) => ORDER.filter((slot) => sec[slot]).forEach((slot) => {
  const id = `s${i + 1}-${slot}`;
  const low = slot === 'next' || slot === 'ask';
  const cam = i === 1 ? s2View : i === 2 ? (slot === 'next' ? s3Shot : low ? s3Low : s3Top) : i;
  frames.push({ cam, sec: i, show: [id, ...attachments.filter((a) => a.with === id).map((a) => a.id)] });
}));
frames.push({ cam: endView, sec: 2, show: [] });

// A pin beside each heading; the string leaves from each section's question and lands on the next heading pin,
// travelling through the gutters so it never crosses a piece.
const pins = sections.map((s) => [s.x + 40, s.y + 44]);
const askPin = (i: number) => { const q = pieces.find((p) => p.id === `s${i + 1}-ask`)!; return [q.ax + q.w - 22, q.ay + 10]; };
const [a1, a2, a3] = [askPin(0), askPin(1), askPin(2)];
// Each question's string runs out to the right of its section, down past it, and back across the gap to the next heading.
const bridge = ([x, y]: number[], bottom: number, [tx, ty]: number[]) =>
  ` M ${x} ${y} C 1700 ${y}, 1700 ${y + 130}, 1700 ${bottom} C 1700 ${bottom + 200}, ${tx} ${ty - 220}, ${tx} ${ty}`;
const bottomOf = (i: number) => sections[i].y + sections[i].h;
const stringPath = bridge(a1, bottomOf(0), pins[1]) + bridge(a2, bottomOf(1), pins[2]) + bridge(a3, bottomOf(2), [SEC_W / 2, END_Y]);
const knots = [a1, a2, a3];

const rects = { ...Object.fromEntries(pieces.map((p) => [p.id, { x: p.ax, y: p.ay, w: p.w, h: p.h }])), ...Object.fromEntries(attachments.map((a) => [a.id, attachAt(a)])) };
const secRects = sections.map((s) => ({ x: s.x, y: s.y, w: SEC_W, h: s.h }));
const skillCount = (id: string) => pieces.filter((p) => p.skills.includes(id)).length;
// Stamped when the site is built, i.e. when a change to this page is pushed and deployed.
const published = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Kolkata' }).format(new Date()).toLowerCase().replace(',', ' ·') + ' ist';
// The cover: three black-and-white scenes from a marketplace operator's week, on the accent colour.
const personas = [
  { id: 'yard', caption: 'ships for forty vendors', r: -3 },
  { id: 'chart', caption: 'reports growth on monday', r: 2 },
  { id: 'bank', caption: 'settles every vendor payout', r: -1.5 }
];
const checkTitle: Record<string, string> = { did: 'what i did', next: 'what i did next' };
// Section 1's number: store status across the 240 classified stores (growth and launch plans counted together as paying).
const DONUT_C = 2 * Math.PI * 84;
const donutRaw = [
  { label: 'trial expired', stores: 211, share: '87.9%', color: '#B9B9C0' },
  { label: 'paying', stores: 19, share: '7.9%', color: '#E08A4C' },
  { label: 'on trial', stores: 10, share: '4.2%', color: '#8FB3DA' }
];
// Section 2's number: the share of current installs that match the primary ICP, as a pie with that slice pulled out.
const PIE = { cx: 110, cy: 110, r: 100, share: 0.18 };
const pieStart = -Math.PI / 2, pieEnd = pieStart + PIE.share * 2 * Math.PI, pieMid = (pieStart + pieEnd) / 2;
const pieOff = [Math.cos(pieMid) * 10, Math.sin(pieMid) * 10];
const pt = (a: number, dx = 0, dy = 0) => `${(PIE.cx + dx + PIE.r * Math.cos(a)).toFixed(2)} ${(PIE.cy + dy + PIE.r * Math.sin(a)).toFixed(2)}`;
const pieSlice = `M ${PIE.cx + pieOff[0]} ${PIE.cy + pieOff[1]} L ${pt(pieStart, pieOff[0], pieOff[1])} A ${PIE.r} ${PIE.r} 0 0 1 ${pt(pieEnd, pieOff[0], pieOff[1])} Z`;
const pieRest = `M ${PIE.cx} ${PIE.cy} L ${pt(pieEnd)} A ${PIE.r} ${PIE.r} 0 1 1 ${pt(pieStart)} Z`;
let donutAt = 0;
const donut = donutRaw.map((d) => { const len = (d.stores / 240) * DONUT_C; const seg = { ...d, len: Math.max(len - 3, 1), off: donutAt }; donutAt += len; return seg; });
---
<Base title="ICP-Nexus · from user stories to identifying ICP, positioning and messaging · Kritika Upadhyay" description={description}>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap">
<div class="ic">

<figure class="ic-cover" aria-label="Three scenes from a marketplace operator’s week: a shipping yard, a chart in a meeting, a visit to the bank.">
<a class="ic-return ic-home" href="/">← return</a>
<div class="cv-row">
{personas.map((pp) => (
<div class="cv-cut" style={`--r:${pp.r}deg`}>
<svg viewBox="0 0 300 220" aria-hidden="true">
<defs><pattern id={`dots-${pp.id}`} width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1.3" fill="#111"></circle></pattern></defs>
<rect width="300" height="220" fill="#F2F1EC"></rect>
{pp.id === 'yard' && <g>
<rect x="0" y="176" width="300" height="44" fill={`url(#dots-${pp.id})`}></rect>
<path d="M190 20 V176 M190 30 H292 M262 30 V70" stroke="#111" stroke-width="5" fill="none"></path>
<rect x="246" y="70" width="34" height="18" fill="#111"></rect>
<g fill="#111"><rect x="150" y="128" width="96" height="48"></rect><rect x="160" y="84" width="80" height="44" fill={`url(#dots-${pp.id})`} stroke="#111" stroke-width="3"></rect></g>
<g stroke="#F2F1EC" stroke-width="3"><path d="M166 132 V172 M182 132 V172 M198 132 V172 M214 132 V172 M230 132 V172"></path></g>
<circle cx="78" cy="88" r="17" fill="#111"></circle>
<path d="M58 84 Q78 58 98 84 Z" fill="#F2F1EC" stroke="#111" stroke-width="4"></path>
<path d="M56 176 V122 Q56 106 78 106 Q100 106 100 122 V176 Z" fill="#111"></path>
<rect x="96" y="120" width="30" height="38" fill="#F2F1EC" stroke="#111" stroke-width="4" transform="rotate(8 111 139)"></rect>
<path d="M102 130 H120 M102 138 H120 M102 146 H114" stroke="#111" stroke-width="2.5" transform="rotate(8 111 139)"></path>
</g>}
{pp.id === 'chart' && <g>
<rect x="120" y="26" width="160" height="116" fill="#F2F1EC" stroke="#111" stroke-width="5"></rect>
<path d="M140 120 L172 98 L200 108 L232 70 L262 46" stroke="#111" stroke-width="6" fill="none" stroke-linejoin="round"></path>
<path d="M140 132 H264" stroke="#111" stroke-width="3"></path>
<path d="M170 142 L150 206 M230 142 L250 206" stroke="#111" stroke-width="5"></path>
<circle cx="66" cy="74" r="18" fill="#111"></circle>
<path d="M40 206 V118 Q40 98 66 98 Q92 98 92 118 V206 Z" fill={`url(#dots-${pp.id})`} stroke="#111" stroke-width="4"></path>
<path d="M88 116 L150 82" stroke="#111" stroke-width="9" stroke-linecap="round"></path>
<path d="M150 82 L196 70" stroke="#111" stroke-width="3" stroke-dasharray="6 5"></path>
</g>}
{pp.id === 'bank' && <g>
<path d="M120 62 L200 24 L280 62 Z" fill="#111"></path>
<rect x="124" y="62" width="152" height="12" fill="#111"></rect>
<g fill={`url(#dots-${pp.id})`} stroke="#111" stroke-width="3"><rect x="134" y="80" width="18" height="96"></rect><rect x="168" y="80" width="18" height="96"></rect><rect x="214" y="80" width="18" height="96"></rect><rect x="248" y="80" width="18" height="96"></rect></g>
<rect x="118" y="176" width="164" height="14" fill="#111"></rect>
<rect x="110" y="190" width="180" height="14" fill="#111"></rect>
<circle cx="62" cy="96" r="16" fill="#111"></circle>
<path d="M42 204 V138 Q42 118 62 118 Q82 118 82 138 V204 Z" fill="#111"></path>
<rect x="78" y="146" width="34" height="26" fill="#F2F1EC" stroke="#111" stroke-width="4"></rect>
<path d="M84 154 H106 M84 162 H100" stroke="#111" stroke-width="2.5"></path>
</g>}
</svg>
<p class="cv-cap">{pp.caption}</p>
</div>
))}
</div>
</figure>

<section class="ic-fold">
<h1 class="ic-title">from user stories to identifying ICP, positioning and messaging</h1>
<div class="ic-intro">
<p class="ic-desc">{description}</p>
<p class="ic-date">published {published}</p>
</div>
<div class="ic-skillbox">
<p class="ic-skills-h">skills</p>
<ul class="ic-skills" aria-label="Skills shown in this case study. Choose one to see it on the board.">
{skills.map((sk, i) => (
<li><button class="ic-skill" type="button" data-skill={sk.id} aria-pressed="false"><span class="sk-n">0{i + 1}</span><span class="sk-l">{sk.label}</span><span class="sk-more">{skillCount(sk.id)} on the board →</span></button></li>
))}
</ul>
</div>
</section>

<section class="ic-board" id="board" data-frames={JSON.stringify(frames)} data-rects={JSON.stringify(rects)} data-secs={JSON.stringify(secRects)} data-world={JSON.stringify({ w: WORLD_W, h: WORLD_H })}>
<div class="ic-view" id="view">
<div class="ic-world" id="world" style={`width:${WORLD_W}px;height:${WORLD_H}px`}>
<svg class="ic-lines" width={WORLD_W} height={WORLD_H} aria-hidden="true">
<path d={stringPath} class="ic-string" id="string"></path>
{pins.map(([x, y]) => <circle cx={x} cy={y} r="11" class="ic-pin"></circle>)}
{knots.map(([x, y]) => <circle cx={x} cy={y} r="7" class="ic-pin"></circle>)}
{ties.map((t) => <path d={t.d} class="ic-tie" data-for={t.for} stroke={t.color}></path>)}
</svg>

{sections.map((s, i) => (
<h2 class="ic-sec-h" style={`left:${s.x + 80}px;top:${s.y + 8}px`} data-sec={i}><span>{s.n}</span>{s.title}</h2>
))}

{pieces.map((p) => (
<div class={`pc pc-${p.img ? 'shot' : p.slot === 'did' || p.slot === 'next' ? 'check' : p.slot === 'data' ? 'page' : 'note'} slot-${p.slot}${p.tint ? ' tint-' + p.tint : ''}`} id={p.id} data-skills={p.skills.join(' ')}
  style={`left:${p.ax}px;top:${p.ay}px;width:${p.w}px;${p.slot === 'data' ? `height:${p.h}px;` : p.img ? '' : `min-height:${p.h - 40}px;`}--r:${p.r}deg`}>
<span class="pc-step" aria-hidden="true">{p.step}</span>
{p.slot === 'ask' && <span class="pin" aria-hidden="true"></span>}
{(p.slot === 'ctx' || p.slot === 'ask') && <div class="note-b">{p.text!.split('\n\n').map((t) => <p class="note-t">{t}</p>)}{p.sub && <p class="note-sub">{p.sub}</p>}</div>}
{p.img && <><span class="pin" aria-hidden="true"></span><img src={p.img.src} alt={p.img.alt} width={p.img.iw} height={p.img.ih}><p class="shot-cap-h">{p.img.caption}</p></>}
{(p.slot === 'did' || p.slot === 'next') && !p.img && <>
{p.aim && <p class="ck-aim"><svg class="ck-aim-ring" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true"><path d="M30 64 C 30 18, 180 6, 290 14 C 380 22, 392 74, 340 98 C 270 124, 80 120, 36 92 C 8 74, 30 40, 96 26"></path></svg><span>{p.aim}</span></p>}
<p class="ck-t">{p.title ?? checkTitle[p.slot]}</p>
{p.intro && <p class="ck-intro">{p.intro}</p>}
<ul class="ck-list">
{p.items!.map((it) => <li>{p.mark === 'q'
  ? <span class="ck-q" aria-hidden="true">?</span>
  : <svg class="ck-box" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3"></rect><path d="M6 12.5 L10.5 17 L19 6.5"></path></svg>}<span>{it}</span></li>)}
</ul>
</>}

{p.id === 's1-data' && <>
<p class="pg-k">current segmentation of users</p>
<div class="dn">
<svg class="dn-chart" viewBox="0 0 220 220" role="img" aria-label="Current segmentation of users: trial expired 87.9%, paying 7.9%, on trial 4.2%.">
{donut.map((d) => <circle cx="110" cy="110" r="84" class="dn-seg" stroke={d.color} stroke-dasharray={`${d.len} ${DONUT_C - d.len}`} stroke-dashoffset={-d.off}></circle>)}
<text x="110" y="108" class="dn-n">7.9%</text>
<text x="110" y="134" class="dn-l">paying</text>
</svg>
<ul class="dn-legend">
{donut.map((d) => <li><i style={`background:${d.color}`}></i><span>{d.label}</span><b>{d.share}</b></li>)}
</ul>
</div>
</>}

{p.id === 's2-data' && <>
<p class="pg-k">current installs with primary ICP</p>
<div class="dn">
<svg class="pie" viewBox="-10 -10 240 240" role="img" aria-label="18% of current installs match the primary ICP; 82% are other installs.">
<path d={pieRest} fill="#C9C9CF"></path>
<path d={pieSlice} fill="#E08A4C"></path>
</svg>
<ul class="dn-legend">
<li><i style="background:#E08A4C"></i><span>primary ICP</span><b>18%</b></li>
<li class="muted"><i style="background:#C9C9CF"></i><span>other installs</span><b>82%</b></li>
</ul>
</div>
</>}

{p.id === 's3-data' && <>
<div class="pos">
<p class="pos-k">previous positioning</p>
<p class="pos-old">pricing and free trials</p>
<p class="pos-ar" aria-hidden="true">↓</p>
<p class="pos-k">current positioning</p>
<p class="pos-new">simple to start, manage and grow a marketplace</p>
</div>
</>}
</div>
))}
{attachments.map((a, k) => (
