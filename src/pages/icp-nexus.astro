<script>
  const root = document.querySelector<HTMLElement>('.ic')!;
  const board = document.getElementById('board')!;
  const view = document.getElementById('view')!;
  const world = document.getElementById('world')!;
  const string = document.getElementById('string');
  const hint = document.getElementById('hint')!;
  const ctrls = document.getElementById('ctrls')!;
  const zoomBtn = document.getElementById('zoom') as HTMLButtonElement;
  const closeBtn = document.getElementById('close') as HTMLButtonElement;
  const chip = document.getElementById('chip') as HTMLButtonElement;
  const steps = Array.from(document.querySelectorAll<HTMLButtonElement>('.ic-step'));
  const fills = steps.map((b) => b.querySelector<HTMLElement>('.st-fill')!);
  type Area = { x: number; y: number; w: number; h: number };
  const frames: { cam: number | Area; sec: number; show: string[] }[] = JSON.parse(board.dataset.frames!);
  const rects: Record<string, { x: number; y: number; w: number; h: number }> = JSON.parse(board.dataset.rects!);
  const secs: { x: number; y: number; w: number; h: number }[] = JSON.parse(board.dataset.secs!);
  const W = JSON.parse(board.dataset.world!);
  const pieces = Array.from(world.querySelectorAll<HTMLElement>('.pc'));
  const ties = Array.from(world.querySelectorAll<SVGPathElement>('.ic-tie'));
  const touch = window.matchMedia('(max-width: 760px), (pointer: coarse)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (touch) root.classList.add('touch');

  type Cam = { tx: number; ty: number; s: number };
  const BAR = 96;
  const all = { x: -60, y: -60, w: W.w + 240, h: W.h + 100 };
  const rectFor = (cam: number | Area) => typeof cam === 'object' ? cam : cam < 0 ? all : secs[cam];
  const fit = (r: { x: number; y: number; w: number; h: number }): Cam => {
    const vw = view.clientWidth, vh = view.clientHeight - BAR;
    const s = Math.min(vw / (r.w * 1.08), vh / (r.h * 1.08));
    return { tx: vw / 2 - (r.x + r.w / 2) * s, ty: vh / 2 - (r.y + r.h / 2) * s, s };
  };
  const put = (c: Cam, animate = false) => {
    world.classList.toggle('anim', animate && !calm);
    world.style.transform = `translate(${c.tx.toFixed(1)}px, ${c.ty.toFixed(1)}px) scale(${c.s.toFixed(4)})`;
  };
  const ease = (t: number) => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  const firstFrameOf = (sec: number) => frames.findIndex((f) => f.sec === sec);
  const lastFrameOf = (sec: number) => frames.length - 1 - [...frames].reverse().findIndex((f) => f.sec === sec);

  // Frame 0 is the snapshot with every piece up. After that, pieces go up one by one as the story reaches them.
  const show = (upTo: number) => {
    const on = new Set<string>();
    if (upTo <= 0) frames[0].show.forEach((id) => on.add(id));
    else frames.forEach((f, k) => { if (k > 0 && k <= upTo) f.show.forEach((id) => on.add(id)); });
    pieces.forEach((p) => p.classList.toggle('on', on.has(p.id)));
    ties.forEach((t) => t.classList.toggle('on', on.has(t.dataset.for!)));
  };
  // The progress bar: the current section is marked, and each track fills as its pieces go up.
  const progress = (sec: number, reach: number) => {
    steps.forEach((b, i) => b.classList.toggle('on', i === sec));
    fills.forEach((f, i) => {
      const a = firstFrameOf(i), z = lastFrameOf(i);
      f.style.width = `${Math.max(0, Math.min(1, (reach - a + 1) / (z - a + 1))) * 100}%`;
    });
  };
  // Zoom has two states: reading a section, or seeing all four. The icon shows the one it will switch to.
  const setOut = (out: boolean) => {
    world.classList.toggle('inside', !out);
    zoomBtn.classList.toggle('in', !out);
    zoomBtn.setAttribute('aria-label', out ? 'Zoom in to read a section' : 'Zoom out to see all four sections');
  };

  let exploring = touch;
  let cam: Cam = fit(all);
  let current = -1;
  let out = true;

  // Guided mode (desktop): the scroll position inside the tall board section drives the camera.
  const frameLen = () => window.innerHeight * 0.55;
  const boardTop = () => board.getBoundingClientRect().top + window.scrollY;
  const size = () => { if (!touch) board.style.height = `${(frames.length - 1) * frameLen() + window.innerHeight}px`; };
  const guided = () => {
    const s = Math.max(0, Math.min(frames.length - 1, (window.scrollY - boardTop()) / frameLen()));
    const i = Math.floor(s), f = s - i;
    const a = fit(rectFor(frames[i].cam)), b = fit(rectFor(frames[Math.min(i + 1, frames.length - 1)].cam));
    const t = ease(Math.min(1, f / 0.55));
    cam = { tx: a.tx + (b.tx - a.tx) * t, ty: a.ty + (b.ty - a.ty) * t, s: a.s + (b.s - a.s) * t };
    put(cam);
    const reach = Math.floor(s + 0.45);
    show(reach);
    current = frames[Math.round(s)].sec;
    progress(current, reach);
    out = s < 0.5;
    setOut(out);
  };
  const draw = () => { if (!exploring) guided(); };

  const explore = (on: boolean) => {
    if (touch) return;
    exploring = on;
    hint.hidden = !on;
    if (on) { show(0); progress(current, frames.length); } else draw();
  };

  // Moving between sections: on desktop, by scrolling the story there; on touch, by zooming the camera.
  const touchGo = (sec: number) => {
    current = sec;
    view.classList.toggle('zoomed', sec >= 0);
    cam = fit(sec >= 0 ? secs[sec] : all);
    put(cam, true);
    progress(sec, frames.length);
    out = sec < 0;
    setOut(out);
  };
  const goSection = (sec: number) => {
    if (touch) return touchGo(sec);
    explore(false);
    window.scrollTo({ top: boardTop() + firstFrameOf(sec) * frameLen() + 2, behavior: calm ? 'auto' : 'smooth' });
  };
  const zoomOut = () => {
    if (touch) return touchGo(-1);
    explore(true);
    out = true;
    setOut(true);
    cam = fit(all);
    put(cam, true);
  };
  const zoomIn = () => {
    if (touch) return touchGo(Math.max(0, current));
    const s = (window.scrollY - boardTop()) / frameLen();
    if (exploring && s >= 0.5) return explore(false);
    goSection(Math.max(0, current));
  };
  const zoomAt = (px: number, py: number, k: number) => {
    const s = Math.max(fit(all).s * 0.8, Math.min(1.6, cam.s * k));
    cam = { tx: px - (px - cam.tx) * (s / cam.s), ty: py - (py - cam.ty) * (s / cam.s), s };
    put(cam);
  };

  steps.forEach((b) => b.addEventListener('click', () => goSection(Number(b.dataset.sec))));
  zoomBtn.addEventListener('click', () => out ? zoomIn() : zoomOut());
  // Close: back to the home page.
  closeBtn.addEventListener('click', () => { window.location.href = '/'; });

  // Start over: back to the top of the case study.
  document.getElementById('restart')?.addEventListener('click', () => {
    filter('');
    if (!touch) explore(false); else touchGo(-1);
    window.scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
  });

  // The control bar stays fixed to the bottom of the screen while the board is on screen.
  const bar = () => {
    const r = board.getBoundingClientRect();
    ctrls.classList.toggle('show', r.top < window.innerHeight * 0.75 && r.bottom > window.innerHeight * 0.3);
  };

  // Dragging pans the board; pinching (or ctrl + wheel on a trackpad) zooms around the fingers or pointer.
  // A click or tap on a section from the whole board zooms into it.
  const ptrs = new Map<number, { x: number; y: number }>();
  let moved = 0, pinch = 0;
  view.addEventListener('pointerdown', (e) => {
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    moved = 0;
    if (ptrs.size === 2) { const [a, b] = [...ptrs.values()]; pinch = Math.hypot(a.x - b.x, a.y - b.y); }
  });
  view.addEventListener('pointermove', (e) => {
    const p = ptrs.get(e.pointerId);
    if (!p) return;
    if (touch && !view.classList.contains('zoomed')) return;
    const dx = e.clientX - p.x, dy = e.clientY - p.y;
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    moved += Math.abs(dx) + Math.abs(dy);
    if (ptrs.size === 2) {
      const [a, b] = [...ptrs.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y), box = view.getBoundingClientRect();
      if (pinch) zoomAt((a.x + b.x) / 2 - box.left, (a.y + b.y) / 2 - box.top, d / pinch);
      pinch = d;
      return;
    }
    if (moved < 6) return;
    if (!exploring) explore(true);
    view.setPointerCapture(e.pointerId);
    cam = { ...cam, tx: cam.tx + dx, ty: cam.ty + dy };
    put(cam);
  });
  view.addEventListener('pointerup', (e) => {
    const wasTap = ptrs.has(e.pointerId) && ptrs.size === 1 && moved < 6;
    ptrs.delete(e.pointerId);
    if (ptrs.size < 2) pinch = 0;
    if (!wasTap || !out) return;
    const box = view.getBoundingClientRect();
    const wx = (e.clientX - box.left - cam.tx) / cam.s, wy = (e.clientY - box.top - cam.ty) / cam.s;
    const hit = secs.findIndex((r) => wx >= r.x && wx <= r.x + r.w && wy >= r.y && wy <= r.y + r.h);
    if (hit >= 0) goSection(hit);
  });
  view.addEventListener('pointercancel', (e) => { ptrs.delete(e.pointerId); pinch = 0; });
  view.addEventListener('wheel', (e) => {
    if (e.ctrlKey) {
      e.preventDefault();
      if (!exploring) explore(true);
      const box = view.getBoundingClientRect();
      zoomAt(e.clientX - box.left, e.clientY - box.top, Math.exp(-e.deltaY * 0.01));
    } else if (exploring && !touch) {
      explore(false);
    }
  }, { passive: false });

  // The red string is always there; it glows along its whole length while the cursor moves.
  let glowT: number | undefined;
  window.addEventListener('mousemove', () => {
    string?.classList.add('glow');
    clearTimeout(glowT);
    glowT = window.setTimeout(() => string?.classList.remove('glow'), 650);
  }, { passive: true });

  // Skill tags: light up every piece that shows the skill, and take the reader to the first one.
  const tags = Array.from(document.querySelectorAll<HTMLButtonElement>('.ic-skill'));
  let active = '';
  const filter = (skill: string) => {
    active = skill;
    tags.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.skill === skill)));
    world.classList.toggle('filtering', !!skill);
    pieces.forEach((p) => p.classList.toggle('hl', !!skill && p.dataset.skills!.split(' ').includes(skill)));
    const tag = tags.find((t) => t.dataset.skill === skill);
    chip.hidden = !skill;
    chip.textContent = skill ? `showing: ${tag?.querySelector('.sk-l')?.textContent} ×` : '';
  };
  tags.forEach((t) => t.addEventListener('click', () => {
    const skill = t.dataset.skill!;
    if (active === skill) return filter('');
    filter(skill);
    const first = frames.findIndex((f, k) => k > 0 && f.show.some((id) => document.getElementById(id)?.classList.contains('hl')));
    if (touch) {
      view.scrollIntoView({ behavior: calm ? 'auto' : 'smooth' });
      touchGo(frames[first].sec);
    } else {
      explore(false);
      window.scrollTo({ top: boardTop() + first * frameLen() + 2, behavior: calm ? 'auto' : 'smooth' });
    }
  }));
  chip.addEventListener('click', () => filter(''));
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && active) filter(''); });

  let queued = false;
  window.addEventListener('scroll', () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; draw(); bar(); });
  }, { passive: true });
  window.addEventListener('resize', () => { size(); if (touch) touchGo(current); else draw(); bar(); });

  size();
  if (touch) { show(0); touchGo(-1); } else draw();
  bar();
</script>
