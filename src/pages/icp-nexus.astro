---
// ICP-Nexus case study (draft, dummy content): a first fold with the whole picture, then one board the reader is guided across.
// Desktop: scrolling moves a camera across the board and pins each piece up in reading order; readers can also drag and zoom freely.
// Phones: the board opens zoomed out; tap a section to zoom in, then pinch and drag.
import Base from '../layouts/Base.astro';

const description = 'how a trickle of unsegmented installs became one sentence about marketplace operators, and how the message moved from price to purpose.';

const skills = [
  { id: 'research', label: 'customer and audience research' },
  { id: 'positioning', label: 'positioning and messaging' },
  { id: 'collab', label: 'cross-functional collaboration' }
];

const SEC_W = 1600, SEC_H = 1000, WORLD_W = 3500, WORLD_H = 2400;
const sections = [
  { n: '01', title: 'what was unclear', short: 'unclear', x: 0, y: 0 },
  { n: '02', title: 'what i learned', short: 'learned', x: 1900, y: 0 },
  { n: '03', title: 'what i chose', short: 'chose', x: 1900, y: 1400 },
  { n: '04', title: 'how the message changed', short: 'changed', x: 0, y: 1400 }
];

type Piece = { id: string; sec: number; kind: 'page' | 'shot' | 'note'; tone?: 'story' | 'quote' | 'insight' | 'decision' | 'small'; x: number; y: number; w: number; h: number; r: number; skills: string[]; text?: string; who?: string; pick?: boolean };
const pieces: Piece[] = [
  { id: 's1-data', sec: 0, kind: 'page', x: 60, y: 150, w: 600, h: 400, r: -0.6, skills: ['research'] },
  { id: 's1-story', sec: 0, kind: 'note', tone: 'story', x: 800, y: 120, w: 460, h: 420, r: -1.4, skills: ['research'],
    text: 'we had nothing to position. a steady trickle of organic installs, a couple of active users nobody had segmented yet, and an ICP that existed only as a blank line in a doc. every conversation about messaging stalled on the same question: messaging to whom? before i could write a single headline, i had to admit we didn’t know who we were talking to.' },
  { id: 's1-q', sec: 0, kind: 'note', tone: 'small', x: 1180, y: 600, w: 340, h: 230, r: 2.2, skills: ['research'],
    text: 'who installs? who stays? who would pay? we couldn’t answer any of the three.' },

  { id: 's2-data', sec: 1, kind: 'page', x: 60, y: 150, w: 600, h: 400, r: 0.5, skills: ['positioning'] },
  { id: 's2-story', sec: 1, kind: 'note', tone: 'story', x: 770, y: 110, w: 430, h: 380, r: -1, skills: ['research', 'collab'],
    text: 'so i stopped writing and started listening. i went back through founder calls and support chats with the team, looking for the merchants who were already living the problem Nexus solves, not the ones who installed out of curiosity.' },
  { id: 's2-q1', sec: 1, kind: 'note', tone: 'quote', x: 1240, y: 120, w: 330, h: 300, r: 2.2, skills: ['research'],
    text: '“we already run our marketplace on spreadsheets. i don’t need cheaper, i need fewer tabs.”', who: 'founder, home décor marketplace' },
  { id: 's2-q2', sec: 1, kind: 'note', tone: 'quote', x: 1230, y: 500, w: 330, h: 300, r: -2, skills: ['research'],
    text: '“the free trial didn’t matter. i needed to know it won’t break my vendor payouts.”', who: 'founder, fashion marketplace' },
  { id: 's2-insight', sec: 1, kind: 'note', tone: 'insight', x: 770, y: 560, w: 420, h: 340, r: 1.2, skills: ['research', 'positioning'],
    text: 'positioning has nothing to do with the product’s feature list. it starts a step earlier, in discovery: finding the people you’re looking for. that’s what an ICP is for.' },

  { id: 's3-data', sec: 2, kind: 'page', x: 60, y: 150, w: 600, h: 400, r: -0.4, skills: ['research'] },
  { id: 's3-story', sec: 2, kind: 'note', tone: 'story', x: 1170, y: 100, w: 390, h: 420, r: 1.6, skills: ['positioning', 'collab'],
    text: 'with the founders, i picked one identifier and started there. we weren’t out to chase competitors, but we did want to own the word marketplace. so i took that one sentence and pulled it in every direction i could think of, until one version sounded like what founders had been telling us all along.' },
  { id: 's3-decision', sec: 2, kind: 'note', tone: 'decision', x: 760, y: 130, w: 360, h: 280, r: -2, skills: ['positioning', 'collab'],
    text: 'start with one identifier: merchants who are already running a marketplace.' },
  { id: 's3-v1', sec: 2, kind: 'note', tone: 'small', x: 720, y: 520, w: 250, h: 130, r: -2, skills: ['positioning'], text: 'for marketplaces that outgrew spreadsheets' },
  { id: 's3-v2', sec: 2, kind: 'note', tone: 'small', x: 1000, y: 470, w: 250, h: 130, r: 1.5, skills: ['positioning'], text: 'run your vendors like you run your store' },
  { id: 's3-v3', sec: 2, kind: 'note', tone: 'small', x: 1280, y: 580, w: 250, h: 130, r: -1, skills: ['positioning'], text: 'many vendors, one dashboard' },
  { id: 's3-v4', sec: 2, kind: 'note', tone: 'small', x: 760, y: 740, w: 250, h: 130, r: 2, skills: ['positioning'], text: 'your marketplace on Shopify, minus the duct tape' },
  { id: 's3-v5', sec: 2, kind: 'note', tone: 'small', x: 1080, y: 760, w: 300, h: 140, r: -1.2, skills: ['positioning'], text: 'simple to start, operate and grow a marketplace', pick: true },

  { id: 's4-data', sec: 3, kind: 'page', x: 60, y: 140, w: 600, h: 400, r: 0.6, skills: ['positioning'] },
  { id: 's4-shot', sec: 3, kind: 'shot', x: 60, y: 600, w: 600, h: 330, r: -0.8, skills: ['positioning'] },
  { id: 's4-story', sec: 3, kind: 'note', tone: 'story', x: 780, y: 110, w: 450, h: 430, r: -1, skills: ['positioning'],
    text: 'until then i’d leaned on pricing and free trials, because that’s what our early traction seemed to reward. but the founders we wanted weren’t shopping on price. they wanted it to be simple to start a marketplace, to operate one, and to grow it. the message moved from what Nexus costs to what it makes easy.' },
  { id: 's4-insight', sec: 3, kind: 'note', tone: 'insight', x: 1270, y: 190, w: 300, h: 260, r: 2, skills: ['positioning'],
    text: 'traction tells you who found you. it doesn’t tell you who you’re for.' }
];

// Accent arrows inside a section, revealed with the piece they point to. Section-local coordinates.
const arrows = [
  { sec: 1, from: [1240, 300], to: [1150, 600], color: '#C9E77A', reveal: 's2-insight' },
  { sec: 1, from: [1230, 650], to: [1190, 720], color: '#C9E77A', reveal: 's2-insight' },
  { sec: 2, from: [880, 410], to: [850, 520], color: '#F2C8A2', reveal: 's3-v1' },
  { sec: 2, from: [990, 410], to: [1100, 470], color: '#F2C8A2', reveal: 's3-v1' },
  { sec: 2, from: [1080, 400], to: [1330, 580], color: '#F2C8A2', reveal: 's3-v1' },
  { sec: 2, from: [860, 410], to: [880, 740], color: '#F2C8A2', reveal: 's3-v1' },
  { sec: 2, from: [960, 410], to: [1200, 760], color: '#F2C8A2', reveal: 's3-v1' }
];
const arrowPath = (a: typeof arrows[number]) => {
  const s = sections[a.sec];
  const [x1, y1] = [s.x + a.from[0], s.y + a.from[1]], [x2, y2] = [s.x + a.to[0], s.y + a.to[1]];
  const mx = (x1 + x2) / 2 + (y2 - y1) * 0.15, my = (y1 + y2) / 2 - (x2 - x1) * 0.15;
  return `M ${x1} ${y1} Q ${mx} ${my} ${x2} ${y2}`;
};

// The order the reader is walked through: where the camera looks, and which pieces get pinned up.
// cam: -1 = whole board, 0–3 = a section, a piece id = that piece close up.
const frames: { cam: number | string; show: string[] }[] = [
  { cam: -1, show: [] },
  { cam: 0, show: ['s1-data'] }, { cam: 0, show: ['s1-story'] }, { cam: 0, show: ['s1-q'] },
  { cam: 1, show: ['s2-data'] }, { cam: 1, show: ['s2-story'] }, { cam: 1, show: ['s2-q1'] }, { cam: 1, show: ['s2-q2'] }, { cam: 1, show: ['s2-insight'] },
  { cam: 2, show: ['s3-data'] }, { cam: 2, show: ['s3-decision'] }, { cam: 2, show: ['s3-v1', 's3-v2', 's3-v3', 's3-v4', 's3-v5'] }, { cam: 2, show: ['s3-story'] },
  { cam: 3, show: ['s4-story'] }, { cam: 3, show: ['s4-shot'] }, { cam: 3, show: ['s4-insight'] }, { cam: 's4-data', show: ['s4-data'] }
];

// One pin per section, beside its heading. The string arcs over the top row, curves down the gutter
// between the columns, then swings back through the gap between the rows, so it never crosses a piece.
const pins = sections.map((s) => [s.x + 40, s.y + 44]);
const [p1, p2, p3, p4] = pins;
const stringPath = `M ${p1[0]} ${p1[1]} C ${p1[0]} -320, ${p2[0]} -320, ${p2[0]} ${p2[1]}`
  + ` C ${p2[0] - 260} 380, ${p3[0] - 260} 1060, ${p3[0]} ${p3[1]}`
  + ` C ${p3[0] - 140} 1180, ${p4[0] + 140} 1180, ${p4[0]} ${p4[1]}`;

const rects = Object.fromEntries(pieces.map((p) => [p.id, { x: sections[p.sec].x + p.x, y: sections[p.sec].y + p.y, w: p.w, h: p.h }]));
const secRects = sections.map((s) => ({ x: s.x, y: s.y, w: SEC_W, h: SEC_H }));
const skillCount = (id: string) => pieces.filter((p) => p.skills.includes(id)).length;
// Stamped when the site is built, i.e. when a change to this page is pushed and deployed.
const published = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Kolkata' }).format(new Date()).toLowerCase().replace(',', ' ·') + ' ist';
// The cover: three black-and-white scenes from a marketplace operator's week, on the accent colour.
const personas = [
  { id: 'yard', caption: 'ships for forty vendors', r: -3 },
  { id: 'chart', caption: 'reports growth on monday', r: 2 },
  { id: 'bank', caption: 'settles every vendor payout', r: -1.5 }
];
---
<Base title="ICP-Nexus · finding who Nexus was for · Kritika Upadhyay" description={description}>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap">
<div class="ic">

<figure class="ic-cover" aria-label="Three scenes from a marketplace operator’s week: a shipping yard, a chart in a meeting, a visit to the bank.">
<a class="ic-return ic-home" href="/">← return</a>
<div class="cv-row">
{personas.map((pp) => (
<div class="cv-cut" style={`--r:${pp.r}deg`}>
<svg viewBox="0 0 300 220" aria-hidden="true">
<defs><pattern id={`dots-${pp.id}`} width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1.3" fill="#111"></circle></pattern></defs>
<rect width="300" height="220" fill="#F2F1EC"></rect>
{pp.id === 'yard' && <g>
<rect x="0" y="176" width="300" height="44" fill={`url(#dots-${pp.id})`}></rect>
<path d="M190 20 V176 M190 30 H292 M262 30 V70" stroke="#111" stroke-width="5" fill="none"></path>
<rect x="246" y="70" width="34" height="18" fill="#111"></rect>
<g fill="#111"><rect x="150" y="128" width="96" height="48"></rect><rect x="160" y="84" width="80" height="44" fill={`url(#dots-${pp.id})`} stroke="#111" stroke-width="3"></rect></g>
<g stroke="#F2F1EC" stroke-width="3"><path d="M166 132 V172 M182 132 V172 M198 132 V172 M214 132 V172 M230 132 V172"></path></g>
<circle cx="78" cy="88" r="17" fill="#111"></circle>
<path d="M58 84 Q78 58 98 84 Z" fill="#F2F1EC" stroke="#111" stroke-width="4"></path>
<path d="M56 176 V122 Q56 106 78 106 Q100 106 100 122 V176 Z" fill="#111"></path>
<rect x="96" y="120" width="30" height="38" fill="#F2F1EC" stroke="#111" stroke-width="4" transform="rotate(8 111 139)"></rect>
<path d="M102 130 H120 M102 138 H120 M102 146 H114" stroke="#111" stroke-width="2.5" transform="rotate(8 111 139)"></path>
</g>}
{pp.id === 'chart' && <g>
<rect x="120" y="26" width="160" height="116" fill="#F2F1EC" stroke="#111" stroke-width="5"></rect>
<path d="M140 120 L172 98 L200 108 L232 70 L262 46" stroke="#111" stroke-width="6" fill="none" stroke-linejoin="round"></path>
<path d="M140 132 H264" stroke="#111" stroke-width="3"></path>
<path d="M170 142 L150 206 M230 142 L250 206" stroke="#111" stroke-width="5"></path>
<circle cx="66" cy="74" r="18" fill="#111"></circle>
<path d="M40 206 V118 Q40 98 66 98 Q92 98 92 118 V206 Z" fill={`url(#dots-${pp.id})`} stroke="#111" stroke-width="4"></path>
<path d="M88 116 L150 82" stroke="#111" stroke-width="9" stroke-linecap="round"></path>
<path d="M150 82 L196 70" stroke="#111" stroke-width="3" stroke-dasharray="6 5"></path>
</g>}
{pp.id === 'bank' && <g>
<path d="M120 62 L200 24 L280 62 Z" fill="#111"></path>
<rect x="124" y="62" width="152" height="12" fill="#111"></rect>
<g fill={`url(#dots-${pp.id})`} stroke="#111" stroke-width="3"><rect x="134" y="80" width="18" height="96"></rect><rect x="168" y="80" width="18" height="96"></rect><rect x="214" y="80" width="18" height="96"></rect><rect x="248" y="80" width="18" height="96"></rect></g>
<rect x="118" y="176" width="164" height="14" fill="#111"></rect>
<rect x="110" y="190" width="180" height="14" fill="#111"></rect>
<circle cx="62" cy="96" r="16" fill="#111"></circle>
<path d="M42 204 V138 Q42 118 62 118 Q82 118 82 138 V204 Z" fill="#111"></path>
<rect x="78" y="146" width="34" height="26" fill="#F2F1EC" stroke="#111" stroke-width="4"></rect>
<path d="M84 154 H106 M84 162 H100" stroke="#111" stroke-width="2.5"></path>
</g>}
</svg>
<p class="cv-cap">{pp.caption}</p>
</div>
))}
</div>
</figure>

<section class="ic-fold">
<div class="ic-intro">
<h1 class="ic-title">finding who Nexus was for</h1>
<p class="ic-desc">{description}</p>
<p class="ic-date">published {published}</p>
</div>
<ul class="ic-skills" aria-label="Skills shown in this case study. Choose one to see it on the board.">
{skills.map((sk, i) => (
<li><button class="ic-skill" type="button" data-skill={sk.id} aria-pressed="false"><span class="sk-n">0{i + 1}</span><span class="sk-l">{sk.label}</span><span class="sk-more">{skillCount(sk.id)} on the board →</span></button></li>
))}
</ul>
</section>

<section class="ic-board" id="board" data-frames={JSON.stringify(frames)} data-rects={JSON.stringify(rects)} data-secs={JSON.stringify(secRects)} data-world={JSON.stringify({ w: WORLD_W, h: WORLD_H })}>
<div class="ic-view" id="view">
<div class="ic-world" id="world" style={`width:${WORLD_W}px;height:${WORLD_H}px`}>
<svg class="ic-lines" width={WORLD_W} height={WORLD_H} aria-hidden="true">
<defs>
{['#C9E77A', '#F2C8A2'].map((c, i) => <marker id={`ah${i}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill={c}></path></marker>)}
</defs>
{arrows.map((a) => <path d={arrowPath(a)} class="ic-arrow" data-reveal={a.reveal} stroke={a.color} marker-end={`url(#ah${a.color === '#C9E77A' ? 0 : 1})`}></path>)}
<path d={stringPath} class="ic-string" id="string"></path>
{pins.map(([x, y]) => <circle cx={x} cy={y} r="11" class="ic-pin"></circle>)}
</svg>

{sections.map((s, i) => (
<div class="ic-zone" style={`left:${s.x}px;top:${s.y}px;width:${SEC_W}px;height:${SEC_H}px`} data-sec={i}><span class="ic-zone-tip">click to zoom in</span></div>
<h2 class="ic-sec-h" style={`left:${s.x + 80}px;top:${s.y + 8}px`} data-sec={i}><span>{s.n}</span>{s.title}</h2>
))}

{pieces.map((p) => (
<div class={`pc pc-${p.kind} ${p.tone ? 'tone-' + p.tone : ''} ${p.pick ? 'pick' : ''}`} id={p.id} data-skills={p.skills.join(' ')}
  style={`left:${rects[p.id].x}px;top:${rects[p.id].y}px;width:${p.w}px;${p.kind !== 'note' ? `height:${p.h}px;` : `min-height:${p.tone === 'small' ? 0 : p.h - 60}px;`}--r:${p.r}deg`}>
{p.kind === 'note' && <>
{p.tone === 'decision' && <span class="pin" aria-hidden="true"></span>}
<p class="note-t">{p.text}</p>
{p.who && <p class="note-who">{p.who}</p>}
</>}

{p.id === 's1-data' && <>
<p class="pg-k">who installed?</p>
<div class="pg-bars">
<div class="pg-row"><span>unsegmented</span><i style="width:100%" class="grey"></i><b>142</b></div>
<div class="pg-row"><span>marketplace operators</span><i style="width:100%" class="empty"></i><b>?</b></div>
<div class="pg-row"><span>d2c brands</span><i style="width:100%" class="empty"></i><b>?</b></div>
<div class="pg-row"><span>agencies</span><i style="width:100%" class="empty"></i><b>?</b></div>
</div>
<p class="pg-foot">142 organic installs · 3 active users · 0 segments</p>
</>}

{p.id === 's2-data' && <>
<p class="pg-k">the order of work</p>
<ol class="pg-order" id="order">
<li class="o-pos"><span class="o-n"></span>positioning</li>
<li class="o-icp"><span class="o-n"></span>discovery: who is this for? (ICP)</li>
<li class="o-msg"><span class="o-n"></span>messaging</li>
</ol>
<p class="pg-foot">positioning comes after discovery, not before it</p>
</>}

{p.id === 's3-data' && <>
<p class="pg-k">18 founder conversations</p>
<div class="pg-bars">
<div class="pg-row"><span>spoken to</span><i style="width:100%" class="grey"></i><b>18</b></div>
<div class="pg-row"><span>sell on Shopify</span><i style="width:61%" class="grey"></i><b>11</b></div>
<div class="pg-row"><span>already run a marketplace</span><i style="width:39%" class="peach"></i><b>7</b></div>
<div class="pg-row"><span>identifier chosen</span><i style="width:6%" class="peach"></i><b>1</b></div>
</div>
<p class="pg-foot">the seven had the same problem, said the same way</p>
</>}

{p.id === 's4-data' && <>
<p class="pg-k">after the new message</p>
<div class="pg-res">
<div><span>listing → install</span><b>2.1% → 3.4%</b></div>
<div><span>installs from marketplace operators</span><b>18% → 41%</b></div>
<div><span>demo calls a month</span><b>2 → 9</b></div>
</div>
<p class="pg-foot">first 6 weeks after the listing and homepage changed</p>
</>}

{p.id === 's4-shot' && <>
<div class="shot-in">
<p class="shot-before">multi-vendor marketplace app. 14-day free trial, plans from $19.</p>
<p class="shot-after">start, run and grow your marketplace. simply.</p>
</div>
<p class="shot-cap">app listing headline, before and after</p>
</>}
</div>
))}
</div>

<button type="button" class="ic-round ic-zoom" id="zoom" aria-label="Zoom in">
<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 L20.5 20.5 M10.5 7.5 V13.5 M7.5 10.5 H13.5"></path></svg>
</button>
<nav class="ic-progress" aria-label="Sections of the case study">
<ol>
{sections.map((s, i) => <li><button type="button" class="ic-step" data-sec={i}><span class="st-l"><b>{s.n}</b> {s.short}</span><span class="st-track"><i class="st-fill"></i></span></button></li>)}
</ol>
<button type="button" class="ic-chip" id="chip" hidden></button>
</nav>
<button type="button" class="ic-round ic-close" id="close" aria-label="Back to the whole board">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6 L18 18 M18 6 L6 18"></path></svg>
</button>
<p class="ic-hint" id="hint" hidden>exploring · scroll to pick the story back up</p>
</div>
</section>

<section class="ic-end">
<p>that’s where the numbers stand today.</p>
<a class="ic-return" href="/">← return</a>
</section>

</div>
</Base>

<style is:global>
.sky,.sky a,.sky button{cursor:auto}
</style>

<style>
.ic{position:relative;color:#EFEFEE;background-color:#141416;background-image:linear-gradient(rgba(169,175,185,.075) 1px,transparent 1px),linear-gradient(90deg,rgba(169,175,185,.075) 1px,transparent 1px);background-size:18px 18px;background-position:-1px -1px}
.ic-return{color:#A9AFB9;font-size:13px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none}
.ic-return:hover,.ic-return:focus-visible{color:#EFEFEE}

.ic-cover{position:relative;margin:0;padding:72px 24px 40px;background-color:#D8C9A3;background-image:radial-gradient(rgba(30,30,36,.09) 1px,transparent 1px);background-size:5px 5px;overflow:hidden}
.ic-home{position:absolute;top:22px;left:max(24px,calc((100% - 1200px) / 2 + 24px));color:#1E1E24;font-weight:500}
.ic-home:hover,.ic-home:focus-visible{color:#000}
.cv-row{display:flex;justify-content:center;align-items:flex-end;gap:clamp(16px,4vw,64px);max-width:1200px;margin:0 auto}
.cv-cut{flex:1 1 0;max-width:340px;padding:10px 10px 0;background:#FFFFFF;box-shadow:0 2px 0 rgba(0,0,0,.08),0 18px 30px rgba(60,48,20,.28);transform:rotate(var(--r))}
.cv-cut:nth-child(2){margin-bottom:28px}
.cv-cut svg{display:block;width:100%;height:auto;filter:grayscale(1) contrast(1.05)}
.cv-cap{margin:0;padding:10px 4px 12px;font-family:'Caveat',cursive;font-size:24px;line-height:1.1;color:#1E1E24}
.ic-fold{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,340px);gap:32px 64px;align-items:end;max-width:1200px;margin:0 auto;padding:48px 24px 56px}
.ic-title{margin:0 0 16px;font-weight:500;font-size:clamp(38px,5.6vw,80px);line-height:1;letter-spacing:-.03em}
.ic-desc{max-width:640px;margin:0 0 18px;font-size:18px;line-height:1.6;color:#C9CDD5}
.ic-date{margin:0;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#8A8D96}
