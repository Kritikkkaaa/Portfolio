---
// ICP-Nexus case study (draft, dummy content): a first fold with the whole picture, then one board the reader is guided across.
// Every section follows the same five steps: context, what i did, the number i found, what i did next, and the question
// that leads to the next section. The red string runs from each question to the next section.
// Desktop: scrolling moves a camera across the board and pins each piece up in order; readers can also drag and zoom.
// Phones: the board opens zoomed out; tap a section to zoom in, then pinch and drag.
import Base from '../layouts/Base.astro';

const description = 'how a trickle of unsegmented installs became one sentence about marketplace operators, and how the message moved from price to purpose.';

const skills = [
  { id: 'research', label: 'customer and audience research' },
  { id: 'positioning', label: 'positioning and messaging' },
  { id: 'collab', label: 'cross-functional collaboration' }
];

const SEC_W = 1600, SEC_H = 1000, WORLD_W = 3500, WORLD_H = 2400;
const sections = [
  { n: '01', title: 'what was unclear', short: 'unclear', x: 0, y: 0 },
  { n: '02', title: 'what i learned', short: 'learned', x: 1900, y: 0 },
  { n: '03', title: 'what i chose', short: 'chose', x: 1900, y: 1400 },
  { n: '04', title: 'how the message changed', short: 'changed', x: 0, y: 1400 }
];

// The same five slots in every section, in reading order. Section-local positions:
// the number sits top-left on a white page, everything in my words runs down the right.
const slots = {
  ctx: { x: 760, y: 110, w: 390, h: 330, r: -1.2 },
  did: { x: 1190, y: 100, w: 370, h: 360, r: 1.2 },
  data: { x: 60, y: 140, w: 600, h: 400, r: -0.5 },
  next: { x: 760, y: 500, w: 390, h: 360, r: 0.8 },
  ask: { x: 1200, y: 560, w: 340, h: 240, r: -1.6 }
} as const;
type Slot = keyof typeof slots;
const ORDER: Slot[] = ['ctx', 'did', 'data', 'next', 'ask'];

type Step = { text?: string; items?: string[]; skills: string[] };
const story: Record<Slot, Step>[] = [
  {
    ctx: { skills: ['research'], text: 'we had nothing to position. a trickle of organic installs, a couple of active users nobody had segmented, and an ICP that was a blank line in a doc. every messaging conversation stalled on the same question: messaging to whom?' },
    did: { skills: ['research'], items: ['pulled every install from the partner dashboard', 'tagged active stores by business type', 'split what we knew from what we assumed'] },
    data: { skills: ['research'] },
    next: { skills: ['research', 'collab'], items: ['opened an ICP doc with honest blanks', 'booked calls with every active founder', 'paused all messaging work'] },
    ask: { skills: ['research'], text: 'who is Nexus actually for?' }
  },
  {
    ctx: { skills: ['research', 'positioning'], text: 'i assumed positioning starts with the product. the calls showed me it starts a step earlier, in discovery: finding the people you’re looking for. that’s what an ICP is for.' },
    did: { skills: ['research', 'collab'], items: ['ran 18 founder calls with the team', 'read two months of support chats', 'wrote down their exact words'] },
    data: { skills: ['research'] },
    next: { skills: ['research', 'collab'], items: ['rebuilt the ICP around running a marketplace', 'walked the founders through the findings', 'parked d2c brands and agencies, for now'] },
    ask: { skills: ['positioning'], text: 'of everyone we spoke to, who do we start with?' }
  },
  {
    ctx: { skills: ['positioning'], text: 'we weren’t out to chase competitors, but we did want to own the word marketplace. so i started with one identifier: merchants who are already running a marketplace.' },
    did: { skills: ['positioning'], items: ['wrote the identifier as one plain sentence', 'pulled it in twelve directions', 'tested five versions with founders'] },
    data: { skills: ['positioning'] },
    next: { skills: ['positioning', 'collab'], items: ['picked “simple to start, operate and grow”', 'agreed the line with the founders', 'briefed design on the listing and homepage'] },
    ask: { skills: ['positioning'], text: 'will the new message bring in the right merchants?' }
  },
  {
    ctx: { skills: ['positioning'], text: 'until then i’d leaned on pricing and free trials, because early traction seemed to reward them. the founders we wanted weren’t shopping on price. they wanted it simple to start, run and grow a marketplace.' },
    did: { skills: ['positioning'], items: ['rewrote the app listing headline', 'changed the homepage first fold', 'moved price below the fold'] },
    data: { skills: ['positioning'] },
    next: { skills: ['positioning', 'collab'], items: ['tracked installs by segment every week', 'booked demos with marketplace operators first', 'shared the numbers with the founders monthly'] },
    ask: { skills: ['positioning'], text: 'they’re arriving. now, will they stay?' }
  }
];

const pieces = story.flatMap((sec, i) => ORDER.map((slot, k) => ({
  id: `s${i + 1}-${slot}`, sec: i, slot, step: k + 1, ...slots[slot], ...sec[slot],
  ax: sections[i].x + slots[slot].x, ay: sections[i].y + slots[slot].y
})));

// Where the camera looks, and which pieces get pinned up. -1 = the whole board, 0–3 = a section.
// The first frame is the snapshot: every piece on the board at once.
const frames: { cam: number; show: string[] }[] = [{ cam: -1, show: pieces.map((p) => p.id) }];
story.forEach((_, i) => ORDER.forEach((slot) => frames.push({ cam: i, show: [`s${i + 1}-${slot}`] })));

// A pin beside each heading; the string leaves from each section's question and lands on the next heading pin,
// travelling through the gutters so it never crosses a piece.
const pins = sections.map((s) => [s.x + 40, s.y + 44]);
const askPin = (i: number) => [sections[i].x + slots.ask.x + slots.ask.w - 22, sections[i].y + slots.ask.y + 10];
const [a1, a2, a3] = [askPin(0), askPin(1), askPin(2)];
const stringPath = `M ${a1[0]} ${a1[1]} C ${a1[0] + 240} ${a1[1]}, ${pins[1][0] - 180} ${pins[1][1]}, ${pins[1][0]} ${pins[1][1]}`
  + ` M ${a2[0]} ${a2[1]} C ${a2[0] + 120} 1200, ${pins[2][0]} 1150, ${pins[2][0]} ${pins[2][1]}`
  + ` M ${a3[0]} ${a3[1]} C ${a3[0] + 180} 2620, 1750 2620, 1750 2000 C 1750 1300, 200 1290, ${pins[3][0]} ${pins[3][1]}`;
const knots = [a1, a2, a3];

const rects = Object.fromEntries(pieces.map((p) => [p.id, { x: p.ax, y: p.ay, w: p.w, h: p.h }]));
const secRects = sections.map((s) => ({ x: s.x, y: s.y, w: SEC_W, h: SEC_H }));
const skillCount = (id: string) => pieces.filter((p) => p.skills.includes(id)).length;
// Stamped when the site is built, i.e. when a change to this page is pushed and deployed.
const published = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Kolkata' }).format(new Date()).toLowerCase().replace(',', ' ·') + ' ist';
// The cover: three black-and-white scenes from a marketplace operator's week, on the accent colour.
const personas = [
  { id: 'yard', caption: 'ships for forty vendors', r: -3 },
  { id: 'chart', caption: 'reports growth on monday', r: 2 },
  { id: 'bank', caption: 'settles every vendor payout', r: -1.5 }
];
const checkTitle: Record<string, string> = { did: 'what i did', next: 'what i did next' };
---
<Base title="ICP-Nexus · finding who Nexus was for · Kritika Upadhyay" description={description}>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap">
<div class="ic">

<figure class="ic-cover" aria-label="Three scenes from a marketplace operator’s week: a shipping yard, a chart in a meeting, a visit to the bank.">
<a class="ic-return ic-home" href="/">← return</a>
<div class="cv-row">
{personas.map((pp) => (
<div class="cv-cut" style={`--r:${pp.r}deg`}>
<svg viewBox="0 0 300 220" aria-hidden="true">
<defs><pattern id={`dots-${pp.id}`} width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1.3" fill="#111"></circle></pattern></defs>
<rect width="300" height="220" fill="#F2F1EC"></rect>
{pp.id === 'yard' && <g>
<rect x="0" y="176" width="300" height="44" fill={`url(#dots-${pp.id})`}></rect>
<path d="M190 20 V176 M190 30 H292 M262 30 V70" stroke="#111" stroke-width="5" fill="none"></path>
<rect x="246" y="70" width="34" height="18" fill="#111"></rect>
<g fill="#111"><rect x="150" y="128" width="96" height="48"></rect><rect x="160" y="84" width="80" height="44" fill={`url(#dots-${pp.id})`} stroke="#111" stroke-width="3"></rect></g>
<g stroke="#F2F1EC" stroke-width="3"><path d="M166 132 V172 M182 132 V172 M198 132 V172 M214 132 V172 M230 132 V172"></path></g>
<circle cx="78" cy="88" r="17" fill="#111"></circle>
<path d="M58 84 Q78 58 98 84 Z" fill="#F2F1EC" stroke="#111" stroke-width="4"></path>
<path d="M56 176 V122 Q56 106 78 106 Q100 106 100 122 V176 Z" fill="#111"></path>
<rect x="96" y="120" width="30" height="38" fill="#F2F1EC" stroke="#111" stroke-width="4" transform="rotate(8 111 139)"></rect>
<path d="M102 130 H120 M102 138 H120 M102 146 H114" stroke="#111" stroke-width="2.5" transform="rotate(8 111 139)"></path>
</g>}
{pp.id === 'chart' && <g>
<rect x="120" y="26" width="160" height="116" fill="#F2F1EC" stroke="#111" stroke-width="5"></rect>
<path d="M140 120 L172 98 L200 108 L232 70 L262 46" stroke="#111" stroke-width="6" fill="none" stroke-linejoin="round"></path>
<path d="M140 132 H264" stroke="#111" stroke-width="3"></path>
<path d="M170 142 L150 206 M230 142 L250 206" stroke="#111" stroke-width="5"></path>
<circle cx="66" cy="74" r="18" fill="#111"></circle>
<path d="M40 206 V118 Q40 98 66 98 Q92 98 92 118 V206 Z" fill={`url(#dots-${pp.id})`} stroke="#111" stroke-width="4"></path>
<path d="M88 116 L150 82" stroke="#111" stroke-width="9" stroke-linecap="round"></path>
<path d="M150 82 L196 70" stroke="#111" stroke-width="3" stroke-dasharray="6 5"></path>
</g>}
{pp.id === 'bank' && <g>
<path d="M120 62 L200 24 L280 62 Z" fill="#111"></path>
<rect x="124" y="62" width="152" height="12" fill="#111"></rect>
<g fill={`url(#dots-${pp.id})`} stroke="#111" stroke-width="3"><rect x="134" y="80" width="18" height="96"></rect><rect x="168" y="80" width="18" height="96"></rect><rect x="214" y="80" width="18" height="96"></rect><rect x="248" y="80" width="18" height="96"></rect></g>
<rect x="118" y="176" width="164" height="14" fill="#111"></rect>
<rect x="110" y="190" width="180" height="14" fill="#111"></rect>
<circle cx="62" cy="96" r="16" fill="#111"></circle>
<path d="M42 204 V138 Q42 118 62 118 Q82 118 82 138 V204 Z" fill="#111"></path>
<rect x="78" y="146" width="34" height="26" fill="#F2F1EC" stroke="#111" stroke-width="4"></rect>
<path d="M84 154 H106 M84 162 H100" stroke="#111" stroke-width="2.5"></path>
</g>}
</svg>
<p class="cv-cap">{pp.caption}</p>
</div>
))}
</div>
</figure>

<section class="ic-fold">
<div class="ic-intro">
<h1 class="ic-title">finding who Nexus was for</h1>
<p class="ic-desc">{description}</p>
<p class="ic-date">published {published}</p>
</div>
<ul class="ic-skills" aria-label="Skills shown in this case study. Choose one to see it on the board.">
{skills.map((sk, i) => (
<li><button class="ic-skill" type="button" data-skill={sk.id} aria-pressed="false"><span class="sk-n">0{i + 1}</span><span class="sk-l">{sk.label}</span><span class="sk-more">{skillCount(sk.id)} on the board →</span></button></li>
))}
</ul>
</section>

<section class="ic-board" id="board" data-frames={JSON.stringify(frames)} data-rects={JSON.stringify(rects)} data-secs={JSON.stringify(secRects)} data-world={JSON.stringify({ w: WORLD_W, h: WORLD_H })}>
<div class="ic-view" id="view">
<div class="ic-world" id="world" style={`width:${WORLD_W}px;height:${WORLD_H}px`}>
<svg class="ic-lines" width={WORLD_W} height={WORLD_H} aria-hidden="true">
<path d={stringPath} class="ic-string" id="string"></path>
{pins.map(([x, y]) => <circle cx={x} cy={y} r="11" class="ic-pin"></circle>)}
{knots.map(([x, y]) => <circle cx={x} cy={y} r="7" class="ic-pin"></circle>)}
</svg>

{sections.map((s, i) => (
<h2 class="ic-sec-h" style={`left:${s.x + 80}px;top:${s.y + 8}px`} data-sec={i}><span>{s.n}</span>{s.title}</h2>
))}

{pieces.map((p) => (
<div class={`pc pc-${p.slot === 'did' || p.slot === 'next' ? 'check' : p.slot === 'data' ? 'page' : 'note'} slot-${p.slot}`} id={p.id} data-skills={p.skills.join(' ')}
  style={`left:${p.ax}px;top:${p.ay}px;width:${p.w}px;${p.slot === 'data' ? `height:${p.h}px;` : `min-height:${p.h - 40}px;`}--r:${p.r}deg`}>
<span class="pc-step" aria-hidden="true">{p.step}</span>
{p.slot === 'ask' && <span class="pin" aria-hidden="true"></span>}
{(p.slot === 'ctx' || p.slot === 'ask') && <p class="note-t">{p.text}</p>}
{(p.slot === 'did' || p.slot === 'next') && <>
<p class="ck-t">{checkTitle[p.slot]}</p>
<ul class="ck-list">
{p.items!.map((it) => <li><svg class="ck-box" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3"></rect><path d="M6 12.5 L10.5 17 L19 6.5"></path></svg><span>{it}</span></li>)}
</ul>
</>}

{p.id === 's1-data' && <>
<p class="pg-k">who installed?</p>
<div class="pg-bars">
<div class="pg-row"><span>unsegmented</span><i style="width:100%" class="grey"></i><b>142</b></div>
<div class="pg-row"><span>marketplace operators</span><i style="width:100%" class="empty"></i><b>?</b></div>
<div class="pg-row"><span>d2c brands</span><i style="width:100%" class="empty"></i><b>?</b></div>
<div class="pg-row"><span>agencies</span><i style="width:100%" class="empty"></i><b>?</b></div>
</div>
<p class="pg-foot">142 organic installs · 3 active users · 0 segments</p>
</>}

{p.id === 's2-data' && <>
<p class="pg-k">18 founder conversations</p>
<div class="pg-bars">
<div class="pg-row"><span>spoken to</span><i style="width:100%" class="grey"></i><b>18</b></div>
<div class="pg-row"><span>sell on Shopify</span><i style="width:61%" class="grey"></i><b>11</b></div>
<div class="pg-row"><span>already run a marketplace</span><i style="width:39%" class="peach"></i><b>7</b></div>
<div class="pg-row"><span>same problem, same words</span><i style="width:33%" class="peach"></i><b>6</b></div>
</div>
<p class="pg-foot">six of the seven described it almost word for word</p>
</>}

{p.id === 's3-data' && <>
<p class="pg-k">one sentence, twelve ways</p>
<div class="pg-bars">
<div class="pg-row"><span>versions written</span><i style="width:100%" class="grey"></i><b>12</b></div>
<div class="pg-row"><span>shared with founders</span><i style="width:42%" class="grey"></i><b>5</b></div>
<div class="pg-row"><span>picked</span><i style="width:8%" class="peach"></i><b>1</b></div>
</div>
<p class="pg-foot">“simple to start, operate and grow a marketplace”</p>
</>}

{p.id === 's4-data' && <>
<p class="pg-k">after the new message</p>
<div class="pg-res">
<div><span>listing → install</span><b>2.1% → 3.4%</b></div>
<div><span>installs from marketplace operators</span><b>18% → 41%</b></div>
<div><span>demo calls a month</span><b>2 → 9</b></div>
</div>
<p class="pg-foot">first 6 weeks after the listing and homepage changed</p>
</>}
</div>
))}
</div>
<p class="ic-hint" id="hint" hidden>exploring · scroll to pick the story back up</p>
</div>

<div class="ic-ctrls" id="ctrls">
<button type="button" class="ic-round" id="zoom" aria-label="Zoom in to read a section">
<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 L20.5 20.5 M7.5 10.5 H13.5"></path><path class="zoom-plus" d="M10.5 7.5 V13.5"></path></svg>
</button>
<nav class="ic-progress" aria-label="Sections of the case study">
<ol>
{sections.map((s, i) => <li><button type="button" class="ic-step" data-sec={i}><span class="st-l"><b>{s.n}</b> {s.short}</span><span class="st-track"><i class="st-fill"></i></span></button></li>)}
</ol>
<button type="button" class="ic-chip" id="chip" hidden></button>
</nav>
<button type="button" class="ic-round" id="close" aria-label="Back to the whole board">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6 L18 18 M18 6 L6 18"></path></svg>
</button>
</div>
</section>

<section class="ic-end">
<p>that’s where the numbers stand today.</p>
<a class="ic-return" href="/">← return</a>
</section>

</div>
</Base>

<style is:global>
.sky,.sky a,.sky button{cursor:auto}
</style>

<style>
.ic{position:relative;color:#EFEFEE;background-color:#141416;background-image:linear-gradient(rgba(169,175,185,.075) 1px,transparent 1px),linear-gradient(90deg,rgba(169,175,185,.075) 1px,transparent 1px);background-size:18px 18px;background-position:-1px -1px}
.ic-return{color:#A9AFB9;font-size:13px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none}
.ic-return:hover,.ic-return:focus-visible{color:#EFEFEE}

.ic-cover{position:relative;margin:0;padding:72px 24px 40px;background-color:#D8C9A3;background-image:radial-gradient(rgba(30,30,36,.09) 1px,transparent 1px);background-size:5px 5px;overflow:hidden}
.ic-home{position:absolute;top:22px;left:max(24px,calc((100% - 1200px) / 2 + 24px));color:#1E1E24;font-weight:500}
.ic-home:hover,.ic-home:focus-visible{color:#000}
.cv-row{display:flex;justify-content:center;align-items:flex-end;gap:clamp(16px,4vw,64px);max-width:1200px;margin:0 auto}
.cv-cut{flex:1 1 0;max-width:340px;padding:10px 10px 0;background:#FFFFFF;box-shadow:0 2px 0 rgba(0,0,0,.08),0 18px 30px rgba(60,48,20,.28);transform:rotate(var(--r))}
.cv-cut:nth-child(2){margin-bottom:28px}
.cv-cut svg{display:block;width:100%;height:auto;filter:grayscale(1) contrast(1.05)}
.cv-cap{margin:0;padding:10px 4px 12px;font-family:'Caveat',cursive;font-size:24px;line-height:1.1;color:#1E1E24}
.ic-fold{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,340px);gap:32px 64px;align-items:end;max-width:1200px;margin:0 auto;padding:48px 24px 56px}
.ic-title{margin:0 0 16px;font-weight:500;font-size:clamp(38px,5.6vw,80px);line-height:1;letter-spacing:-.03em}
.ic-desc{max-width:640px;margin:0 0 18px;font-size:18px;line-height:1.6;color:#C9CDD5}
.ic-date{margin:0;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#8A8D96}
.ic-skills{margin:0;padding:0;list-style:none;border-top:1px solid #2E2E34}
.ic-skill{display:grid;grid-template-columns:28px 1fr;align-items:baseline;width:100%;padding:14px 0;border:0;border-bottom:1px solid #2E2E34;background:none;color:#C9CDD5;font:inherit;text-align:left;cursor:pointer}
.sk-n{font-size:11px;letter-spacing:.12em;color:#5E5E66;transition:color .25s ease}
.sk-l{font-size:13px;letter-spacing:.14em;text-transform:uppercase;transition:color .25s ease}
.sk-more{grid-column:2;max-height:0;overflow:hidden;opacity:0;font-family:'Caveat',cursive;font-size:20px;color:#D8C9A3;transition:max-height .3s ease,opacity .3s ease,margin .3s ease}
.ic-skill:hover .sk-l,.ic-skill:focus-visible .sk-l,.ic-skill[aria-pressed="true"] .sk-l{color:#EFEFEE}
.ic-skill:hover .sk-n,.ic-skill:focus-visible .sk-n,.ic-skill[aria-pressed="true"] .sk-n{color:#D8C9A3}
.ic-skill:hover .sk-more,.ic-skill:focus-visible .sk-more,.ic-skill[aria-pressed="true"] .sk-more{max-height:30px;opacity:1;margin-top:4px}
.ic-skill:focus-visible,.ic-step:focus-visible{outline:2px solid #EFEFEE;outline-offset:3px}
@media (max-width:760px){.ic-fold{grid-template-columns:1fr}.cv-row{gap:10px}.cv-cap{font-size:17px}.ic-cover{padding:64px 16px 28px}}

.ic-board{position:relative;height:1200vh}
.ic-view{position:sticky;top:0;height:100vh;overflow:hidden;touch-action:pan-y}
.ic-world{position:absolute;left:0;top:0;transform-origin:0 0;will-change:transform}
.ic-world.anim{transition:transform .7s cubic-bezier(.2,.7,.2,1)}
.ic-world:not(.inside){cursor:zoom-in}
.ic-lines{position:absolute;left:0;top:0;overflow:visible;pointer-events:none}
.ic-string{fill:none;stroke:#B33A35;stroke-width:3.5;stroke-linecap:round;opacity:.75;transition:stroke .4s ease,opacity .4s ease,filter .4s ease}
.ic-string.glow{stroke:#FF5A4E;opacity:1;filter:drop-shadow(0 0 6px rgba(255,90,78,.85)) drop-shadow(0 0 16px rgba(255,90,78,.45))}
.ic-pin{fill:#D2453F;stroke:#141416;stroke-width:3}
.ic-sec-h{position:absolute;margin:0;font-size:60px;font-weight:500;line-height:1.1;letter-spacing:-.02em;color:#EFEFEE;white-space:nowrap}
.ic-sec-h span{margin-right:18px;font-size:22px;letter-spacing:.2em;color:#D2453F;vertical-align:middle}

.pc{position:absolute;box-sizing:border-box;pointer-events:none;transform:translateY(28px) rotate(calc(var(--r) + 2deg)) scale(.96);opacity:0;visibility:hidden;transition:opacity .55s ease,transform .7s cubic-bezier(.2,.7,.2,1),visibility 0s linear .7s,box-shadow .3s ease,filter .3s ease}
.pc.on{opacity:1;visibility:visible;transform:rotate(var(--r));transition:opacity .55s ease,transform .7s cubic-bezier(.2,.7,.2,1),visibility 0s,box-shadow .3s ease,filter .3s ease}
.pc-step{position:absolute;left:-14px;top:-14px;display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:#141416;border:2px solid #4A4A50;color:#C9CDD5;font-size:15px;font-weight:500}

.pc-note{padding:30px 30px 26px;color:#1E1E24;box-shadow:0 2px 0 rgba(0,0,0,.08),0 14px 28px rgba(0,0,0,.45);background-image:linear-gradient(to bottom,rgba(255,255,255,.18),transparent 40%)}
.slot-ctx{background-color:#BFD4EA}
.slot-ask{background-color:#F4B9B2;display:flex;align-items:center}
.note-t{margin:0;font-family:'Caveat',cursive;font-weight:500;font-size:28px;line-height:1.22}
.slot-ask .note-t{font-size:38px;font-weight:600;line-height:1.1}
.pin{position:absolute;right:10px;top:-2px;width:24px;height:24px;border-radius:50%;background:#D2453F;box-shadow:0 4px 8px rgba(0,0,0,.45),inset -3px -3px 0 rgba(0,0,0,.18)}

.pc-check{padding:28px 28px 22px;background:#F4F3EF;color:#1E1E24;box-shadow:0 14px 28px rgba(0,0,0,.45)}
.pc-check::before{content:"";position:absolute;left:50%;top:-12px;width:96px;height:24px;margin-left:-48px;background:rgba(188,229,207,.75);transform:rotate(-2deg)}
.ck-t{margin:0 0 16px;font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#5A5A62}
.ck-list{display:flex;flex-direction:column;gap:14px;margin:0;padding:0;list-style:none}
.ck-list li{display:grid;grid-template-columns:30px 1fr;gap:12px;align-items:start;font-family:'Caveat',cursive;font-size:27px;line-height:1.15}
.ck-box{width:28px;height:28px;margin-top:2px}
.ck-box rect{fill:none;stroke:#1E1E24;stroke-width:2}
.ck-box path{fill:none;stroke:#2F8F5B;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}

.pc-page{padding:30px 34px;background:#FFFFFF;color:#1E1E24;box-shadow:0 14px 28px rgba(0,0,0,.45)}
.pc-page::before,.pc-page::after{content:"";position:absolute;top:10px;width:14px;height:14px;border-radius:50%;background:#9A9AA2;box-shadow:inset -2px -2px 0 rgba(0,0,0,.2)}
.pc-page::before{left:10px}.pc-page::after{right:10px}
.pg-k{margin:0 0 24px;font-size:30px;font-weight:600;letter-spacing:-.01em}
.pg-bars{display:flex;flex-direction:column;gap:16px}
.pg-row{display:grid;grid-template-columns:220px 1fr 50px;align-items:center;gap:14px;font-size:17px}
.pg-row i{display:block;height:22px}
.pg-row i.grey{background:#B9B9C0}
.pg-row i.peach{background:#E08A4C}
.pg-row i.empty{border:2px dashed #B9B9C0;box-sizing:border-box}
.pg-row b{font-size:20px;text-align:right}
.pg-foot{position:absolute;left:34px;right:34px;bottom:26px;margin:0;font-size:15px;color:#5A5A62}
.pg-res{display:flex;flex-direction:column;gap:18px}
.pg-res div{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding-bottom:14px;border-bottom:1px solid #DADAD4;font-size:17px}
.pg-res b{font-size:30px;font-weight:600;letter-spacing:-.01em;white-space:nowrap}

.ic-world.filtering .pc{filter:saturate(.3) brightness(.55)}
.ic-world.filtering .pc.hl{filter:none;box-shadow:0 0 0 4px #D8C9A3,0 0 40px rgba(216,201,163,.55),0 14px 28px rgba(0,0,0,.45)}

/* One control bar, fixed to the bottom of the screen from the moment the board starts. */
.ic-ctrls{position:fixed;left:50%;bottom:18px;z-index:40;display:flex;align-items:center;gap:10px;transform:translate(-50%,16px);opacity:0;pointer-events:none;transition:opacity .35s ease,transform .35s ease}
.ic-ctrls.show{opacity:1;transform:translate(-50%,0);pointer-events:auto}
.ic-round,.ic-progress{border:1px solid #2A2A2E;background:rgba(10,10,12,.88);backdrop-filter:blur(8px)}
.ic-round{display:inline-flex;align-items:center;justify-content:center;flex:none;width:48px;height:48px;padding:0;border-radius:50%;color:#A9AFB9;cursor:pointer;transition:color .2s ease,border-color .2s ease}
.ic-round:hover,.ic-round:focus-visible{color:#EFEFEE;border-color:#4A4A50}
.ic-round:focus-visible,.ic-step:focus-visible{outline:2px solid #EFEFEE;outline-offset:3px}
.ic-round.in .zoom-plus{display:none}
.ic-progress{display:flex;flex-direction:column;align-items:center;gap:6px;padding:10px 18px 12px;border-radius:16px}
.ic-progress ol{display:flex;gap:14px;margin:0;padding:0;list-style:none}
.ic-step{display:flex;flex-direction:column;gap:7px;min-width:84px;padding:0;border:0;background:none;color:#8A8D96;font:inherit;font-size:12px;letter-spacing:.06em;text-align:left;cursor:pointer;transition:color .2s ease}
.st-l b{font-weight:500;color:#5E5E66}
.st-track{display:block;height:3px;border-radius:3px;background:#2A2A2E;overflow:hidden}
.st-fill{display:block;width:0;height:100%;background:#D2453F;transition:width .25s ease}
.ic-step:hover,.ic-step.on{color:#EFEFEE}
.ic-step.on b{color:#D2453F}
.ic-chip{padding:2px 0 0;border:0;background:none;color:#D8C9A3;font:inherit;font-size:12px;cursor:pointer}
.ic-chip[hidden]{display:none}
.ic-hint{position:absolute;left:50%;bottom:100px;z-index:5;margin:0;transform:translateX(-50%);font-size:12px;letter-spacing:.08em;color:#8A8D96;white-space:nowrap}

.ic-end{display:flex;flex-direction:column;align-items:center;gap:20px;padding:120px 24px 160px;text-align:center}
.ic-end p{margin:0;font-size:clamp(20px,2.4vw,28px);color:#C9CDD5}

/* Phones and touch screens: the board is one screen tall, opens zoomed out, and the reader explores it directly. */
.ic.touch .ic-board{height:auto}
.ic.touch .ic-view{position:relative;height:100svh}
.ic.touch .ic-view.zoomed{touch-action:none}
@media (max-width:760px){
.ic-step{min-width:34px}
.st-l{font-size:0}
.st-l b{font-size:12px}
.ic-progress{padding:10px 12px 12px}
.ic-progress ol{gap:8px}
.ic-ctrls{gap:6px}
.ic-round{width:44px;height:44px}
}
@media (prefers-reduced-motion:reduce){.pc,.ic-world.anim,.ic-string,.ic-ctrls{transition:none}}
</style>

<script>
  const root = document.querySelector<HTMLElement>('.ic')!;
  const board = document.getElementById('board')!;
  const view = document.getElementById('view')!;
  const world = document.getElementById('world')!;
  const string = document.getElementById('string');
  const hint = document.getElementById('hint')!;
  const ctrls = document.getElementById('ctrls')!;
  const zoomBtn = document.getElementById('zoom') as HTMLButtonElement;
  const closeBtn = document.getElementById('close') as HTMLButtonElement;
  const chip = document.getElementById('chip') as HTMLButtonElement;
  const steps = Array.from(document.querySelectorAll<HTMLButtonElement>('.ic-step'));
  const fills = steps.map((b) => b.querySelector<HTMLElement>('.st-fill')!);
  const frames: { cam: number; show: string[] }[] = JSON.parse(board.dataset.frames!);
  const rects: Record<string, { x: number; y: number; w: number; h: number }> = JSON.parse(board.dataset.rects!);
  const secs: { x: number; y: number; w: number; h: number }[] = JSON.parse(board.dataset.secs!);
  const W = JSON.parse(board.dataset.world!);
  const pieces = Array.from(world.querySelectorAll<HTMLElement>('.pc'));
  const touch = window.matchMedia('(max-width: 760px), (pointer: coarse)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (touch) root.classList.add('touch');

  type Cam = { tx: number; ty: number; s: number };
  const BAR = 96;
  const all = { x: -60, y: -60, w: W.w + 200, h: W.h + 300 };
  const rectFor = (cam: number) => cam < 0 ? all : secs[cam];
  const fit = (r: { x: number; y: number; w: number; h: number }): Cam => {
    const vw = view.clientWidth, vh = view.clientHeight - BAR;
    const s = Math.min(vw / (r.w * 1.08), vh / (r.h * 1.08));
    return { tx: vw / 2 - (r.x + r.w / 2) * s, ty: vh / 2 - (r.y + r.h / 2) * s, s };
  };
  const put = (c: Cam, animate = false) => {
    world.classList.toggle('anim', animate && !calm);
    world.style.transform = `translate(${c.tx.toFixed(1)}px, ${c.ty.toFixed(1)}px) scale(${c.s.toFixed(4)})`;
  };
  const ease = (t: number) => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  const firstFrameOf = (sec: number) => frames.findIndex((f) => f.cam === sec);
  const lastFrameOf = (sec: number) => frames.length - 1 - [...frames].reverse().findIndex((f) => f.cam === sec);

  // Frame 0 is the snapshot with every piece up. After that, pieces go up one by one as the story reaches them.
  const show = (upTo: number) => {
    const on = new Set<string>();
    if (upTo <= 0) frames[0].show.forEach((id) => on.add(id));
    else frames.forEach((f, k) => { if (k > 0 && k <= upTo) f.show.forEach((id) => on.add(id)); });
    pieces.forEach((p) => p.classList.toggle('on', on.has(p.id)));
  };
  // The progress bar: the current section is marked, and each track fills as its pieces go up.
  const progress = (sec: number, reach: number) => {
    steps.forEach((b, i) => b.classList.toggle('on', i === sec));
    fills.forEach((f, i) => {
      const a = firstFrameOf(i), z = lastFrameOf(i);
      f.style.width = `${Math.max(0, Math.min(1, (reach - a + 1) / (z - a + 1))) * 100}%`;
    });
  };
  // Zoom has two states: reading a section, or seeing all four. The icon shows the one it will switch to.
  const setOut = (out: boolean) => {
    world.classList.toggle('inside', !out);
    zoomBtn.classList.toggle('in', !out);
    zoomBtn.setAttribute('aria-label', out ? 'Zoom in to read a section' : 'Zoom out to see all four sections');
  };

  let exploring = touch;
  let cam: Cam = fit(all);
  let current = -1;
  let out = true;

  // Guided mode (desktop): the scroll position inside the tall board section drives the camera.
  const frameLen = () => window.innerHeight * 0.55;
  const boardTop = () => board.getBoundingClientRect().top + window.scrollY;
  const size = () => { if (!touch) board.style.height = `${(frames.length - 1) * frameLen() + window.innerHeight}px`; };
  const guided = () => {
    const s = Math.max(0, Math.min(frames.length - 1, (window.scrollY - boardTop()) / frameLen()));
    const i = Math.floor(s), f = s - i;
    const a = fit(rectFor(frames[i].cam)), b = fit(rectFor(frames[Math.min(i + 1, frames.length - 1)].cam));
    const t = ease(Math.min(1, f / 0.55));
    cam = { tx: a.tx + (b.tx - a.tx) * t, ty: a.ty + (b.ty - a.ty) * t, s: a.s + (b.s - a.s) * t };
    put(cam);
    const reach = Math.floor(s + 0.45);
    show(reach);
    current = frames[Math.round(s)].cam;
    progress(current, reach);
    out = s < 0.5;
    setOut(out);
  };
  const draw = () => { if (!exploring) guided(); };

  const explore = (on: boolean) => {
    if (touch) return;
    exploring = on;
    hint.hidden = !on;
    if (on) { show(0); progress(current, frames.length); } else draw();
  };

  // Moving between sections: on desktop, by scrolling the story there; on touch, by zooming the camera.
  const touchGo = (sec: number) => {
    current = sec;
    view.classList.toggle('zoomed', sec >= 0);
    cam = fit(sec >= 0 ? secs[sec] : all);
    put(cam, true);
    progress(sec, frames.length);
    out = sec < 0;
    setOut(out);
  };
  const goSection = (sec: number) => {
    if (touch) return touchGo(sec);
    explore(false);
    window.scrollTo({ top: boardTop() + firstFrameOf(sec) * frameLen() + 2, behavior: calm ? 'auto' : 'smooth' });
  };
  const zoomOut = () => {
    if (touch) return touchGo(-1);
    explore(true);
    out = true;
    setOut(true);
    cam = fit(all);
    put(cam, true);
  };
  const zoomIn = () => {
    if (touch) return touchGo(Math.max(0, current));
    const s = (window.scrollY - boardTop()) / frameLen();
    if (exploring && s >= 0.5) return explore(false);
    goSection(Math.max(0, current));
  };
  const zoomAt = (px: number, py: number, k: number) => {
    const s = Math.max(fit(all).s * 0.8, Math.min(1.6, cam.s * k));
    cam = { tx: px - (px - cam.tx) * (s / cam.s), ty: py - (py - cam.ty) * (s / cam.s), s };
    put(cam);
  };

  steps.forEach((b) => b.addEventListener('click', () => goSection(Number(b.dataset.sec))));
  zoomBtn.addEventListener('click', () => out ? zoomIn() : zoomOut());
  closeBtn.addEventListener('click', zoomOut);

  // The control bar stays fixed to the bottom of the screen while the board is on screen.
  const bar = () => {
    const r = board.getBoundingClientRect();
    ctrls.classList.toggle('show', r.top < window.innerHeight * 0.75 && r.bottom > window.innerHeight * 0.3);
  };

  // Dragging pans the board; pinching (or ctrl + wheel on a trackpad) zooms around the fingers or pointer.
  // A click or tap on a section from the whole board zooms into it.
  const ptrs = new Map<number, { x: number; y: number }>();
  let moved = 0, pinch = 0;
  view.addEventListener('pointerdown', (e) => {
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    moved = 0;
    if (ptrs.size === 2) { const [a, b] = [...ptrs.values()]; pinch = Math.hypot(a.x - b.x, a.y - b.y); }
  });
  view.addEventListener('pointermove', (e) => {
    const p = ptrs.get(e.pointerId);
    if (!p) return;
    if (touch && !view.classList.contains('zoomed')) return;
    const dx = e.clientX - p.x, dy = e.clientY - p.y;
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    moved += Math.abs(dx) + Math.abs(dy);
    if (ptrs.size === 2) {
      const [a, b] = [...ptrs.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y), box = view.getBoundingClientRect();
      if (pinch) zoomAt((a.x + b.x) / 2 - box.left, (a.y + b.y) / 2 - box.top, d / pinch);
      pinch = d;
      return;
    }
    if (moved < 6) return;
    if (!exploring) explore(true);
    view.setPointerCapture(e.pointerId);
    cam = { ...cam, tx: cam.tx + dx, ty: cam.ty + dy };
    put(cam);
  });
  view.addEventListener('pointerup', (e) => {
    const wasTap = ptrs.has(e.pointerId) && ptrs.size === 1 && moved < 6;
    ptrs.delete(e.pointerId);
    if (ptrs.size < 2) pinch = 0;
    if (!wasTap || !out) return;
    const box = view.getBoundingClientRect();
    const wx = (e.clientX - box.left - cam.tx) / cam.s, wy = (e.clientY - box.top - cam.ty) / cam.s;
    const hit = secs.findIndex((r) => wx >= r.x && wx <= r.x + r.w && wy >= r.y && wy <= r.y + r.h);
    if (hit >= 0) goSection(hit);
  });
  view.addEventListener('pointercancel', (e) => { ptrs.delete(e.pointerId); pinch = 0; });
  view.addEventListener('wheel', (e) => {
    if (e.ctrlKey) {
      e.preventDefault();
      if (!exploring) explore(true);
      const box = view.getBoundingClientRect();
      zoomAt(e.clientX - box.left, e.clientY - box.top, Math.exp(-e.deltaY * 0.01));
    } else if (exploring && !touch) {
      explore(false);
    }
  }, { passive: false });

  // The red string is always there; it glows along its whole length while the cursor moves.
  let glowT: number | undefined;
  window.addEventListener('mousemove', () => {
    string?.classList.add('glow');
    clearTimeout(glowT);
    glowT = window.setTimeout(() => string?.classList.remove('glow'), 650);
  }, { passive: true });

  // Skill tags: light up every piece that shows the skill, and take the reader to the first one.
  const tags = Array.from(document.querySelectorAll<HTMLButtonElement>('.ic-skill'));
  let active = '';
  const filter = (skill: string) => {
    active = skill;
    tags.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.skill === skill)));
    world.classList.toggle('filtering', !!skill);
    pieces.forEach((p) => p.classList.toggle('hl', !!skill && p.dataset.skills!.split(' ').includes(skill)));
    const tag = tags.find((t) => t.dataset.skill === skill);
    chip.hidden = !skill;
    chip.textContent = skill ? `showing: ${tag?.querySelector('.sk-l')?.textContent} ×` : '';
  };
  tags.forEach((t) => t.addEventListener('click', () => {
    const skill = t.dataset.skill!;
    if (active === skill) return filter('');
    filter(skill);
    const first = frames.findIndex((f, k) => k > 0 && f.show.some((id) => document.getElementById(id)?.classList.contains('hl')));
    if (touch) {
      view.scrollIntoView({ behavior: calm ? 'auto' : 'smooth' });
      touchGo(frames[first].cam);
    } else {
      explore(false);
      window.scrollTo({ top: boardTop() + first * frameLen() + 2, behavior: calm ? 'auto' : 'smooth' });
    }
  }));
  chip.addEventListener('click', () => filter(''));
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && active) filter(''); });

  let queued = false;
  window.addEventListener('scroll', () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; draw(); bar(); });
  }, { passive: true });
  window.addEventListener('resize', () => { size(); if (touch) touchGo(current); else draw(); bar(); });

  size();
  if (touch) { show(0); touchGo(-1); } else draw();
  bar();
</script>
