---
// who nexus is for: the second telling of the ICP-Nexus case study. Built from the board on
// /work/icp-positioning-messaging-nexus (same cover, fold, skills, dark board, pinned notes, number badges,
// handwritten captions, controls and start over), with new copy and five board sections under four chapter chips.
// It is print 01 on the /work wheel.
// Desktop: scrolling moves a camera across the board and pins each piece up in order; readers can also drag and zoom.
// Phones: the board is laid out as one column; it opens zoomed out, tap a section to zoom in, then drag.
// Copy is rendered exactly as written: no text-transform anywhere on this page.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';

const title = 'who nexus is for, and how i got there';
const descParas = [
  "knowing who uses your product doesn't tell you who to target. it tells you even less about what to say to them. that takes research, care and more research.",
  "follow along to see how i brought a product manager's understanding of users into nexus's ideal customer profile and positioning."
];
const description = descParas.join(' ');
const questions = ['who uses nexus?', 'who should we target?', 'what should we say?'];
const coverCaption = 'how we come to this messaging?';
const closing = 'behind every uninstall was someone who hoped nexus would work for them. i still think about them.';

const skills = [
  { id: 'research', label: 'customer and audience research' },
  { id: 'positioning', label: 'positioning and messaging' },
  { id: 'linkedin', label: 'linkedin distribution' }
];
const chips = ['what i knew', 'what they get', 'why nexus', 'what changed'];

// The two LinkedIn posts on the cover, from public/work/who-nexus-is-for/. Their pixel sizes are given so the
// browser reserves the right space before they load and nothing shifts.
const POSTS_DIR = '/work/who-nexus-is-for/';
const posts = [
  { file: 'nexus-linkedin-1-sellers-not-jobs.jpg', iw: 1920, ih: 943, r: -1.6,
    alt: 'nexus linkedin post: "you wanted more sellers. not more jobs." five painters each painting a strip of one wall a different colour.' },
  { file: 'nexus-linkedin-2-messy-to-organised.jpg', iw: 1920, ih: 943, r: 1.2,
    alt: 'nexus linkedin post: a crowded, messy table of people on laptops beside one calm person on an empty bench. "messy. chaotic. disordered." versus "organised. structured. streamlined."' }
].map((p) => ({ ...p, src: POSTS_DIR + p.file, skills: ['linkedin'] }));

// The board. Five sections stacked down it, each read top to bottom, column by column.
// Every item has a desktop position (section-local x, y); on phones the same items stack in reading order.
// Kinds: note (blue sticky), check (list card), page (white sheet with a chart or the positioning),
// place (empty placeholder sheet), learnt (green sticky), shot and qa (documents pinned to a card, tied to it
// by a dotted thread), label (a column heading written on the board).
type Kind = 'note' | 'check' | 'page' | 'place' | 'learnt' | 'shot' | 'qa' | 'label';
type Item = {
  id: string; kind: Kind; x: number; y: number; w: number; h?: number; r?: number; skills?: string[];
  text?: string; label?: string; items?: string[]; chart?: 'donut' | 'pie' | 'pos';
  src?: string; iw?: number; ih?: number; alt?: string; caption?: string; qa?: [string, string][];
  with?: string; color?: string;
};
type Sec = { title: string; chip: number; slug: string; items: Item[] };
const sectionsRaw: Sec[] = [
  { title: 'what i knew, and what i didn\'t', chip: 0, slug: 'what-i-knew', items: [
    { id: 'k-l1', kind: 'label', x: 40, y: 130, w: 520, h: 40, text: 'things i knew' },
    { id: 's1-chart', kind: 'page', chart: 'donut', x: 40, y: 190, w: 520, h: 400, r: -0.5, skills: ['research'] },
    { id: 's1-fact', kind: 'note', x: 40, y: 650, w: 520, h: 140, r: -1.2, skills: ['research'],
      text: '17 stores pay for nexus today. 8 of them run 10+ sellers.' },
    { id: 'k-l2', kind: 'label', x: 640, y: 130, w: 520, h: 40, text: 'open questions' },
    { id: 's1-q', kind: 'check', x: 640, y: 190, w: 520, h: 300, r: 1.2, skills: ['research'],
      items: ['who installs nexus, and who pays?', 'who did the founders build it for?', 'what do those customers need handled?', 'who do we speak to first?'] }
  ] },
  { title: 'who gets the most value?', chip: 0, slug: 'who-gets-the-most-value', items: [
    { id: 's2-ctx', kind: 'note', x: 40, y: 130, w: 480, h: 410, r: -1.2, skills: ['research', 'positioning'],
      items: ['i defined who gets the most value from nexus.', 'i read why merchants uninstalled and what they asked for on intercom.',
        'the answer was specific: established brands with their own catalogue, who need vendors, orders and payouts handled in one place.'] },
    { id: 's2-icp', kind: 'shot', with: 's2-ctx', x: 560, y: 130, w: 520, r: -1, src: '/case/icp-nexus/icp-table.png', iw: 1084, ih: 660,
      alt: 'The Nexus ideal customer profile: business, Shopify plan, region, trigger moment and job to be done, each with its evidence.',
      caption: 'final ICP!', skills: ['research', 'positioning'], color: '#BCE5CF' },
    { id: 's2-notfor', kind: 'shot', with: 's2-ctx', x: 1120, y: 150, w: 440, r: 1.2, src: '/case/icp-nexus/not-for.png', iw: 1106, ih: 488,
      alt: 'Who Nexus is not for: stores syncing to Etsy, Amazon or Walmart, vendors looking to join a marketplace, agencies testing on dev stores, and large enterprises needing a custom build.',
      caption: 'guardrails aka, who we do not serve', skills: ['positioning'], color: '#BCE5CF' },
    { id: 's2-where', kind: 'shot', with: 's2-ctx', x: 1120, y: 440, w: 440, r: -1, src: '/case/icp-nexus/where-they-gather.png', iw: 896, ih: 252,
      alt: 'Where they gather: Shopify App Store search, about 48% of discovery; Google, about 11%; AI assistants and the listicles they cite; other platforms such as Product Hunt and G2.',
      caption: 'where they hang out', skills: ['research', 'positioning'], color: '#BCE5CF' },
    { id: 's2-pie', kind: 'page', chart: 'pie', x: 560, y: 570, w: 520, h: 350, r: -0.5, skills: ['research'] }
  ] },
  { title: 'what value do they get?', chip: 1, slug: 'what-they-get', items: [
    { id: 's3-ctx', kind: 'note', x: 40, y: 130, w: 520, h: 170, r: -1.2, skills: ['positioning'],
      text: 'once i knew who they were, i asked what they actually get from nexus.' },
    { id: 's3-vp', kind: 'place', x: 600, y: 130, w: 520, h: 260, r: 0.8, skills: ['positioning'],
      text: 'value proposition goes here. i will send it. no invented copy.' }
  ] },
  { title: 'why build nexus at all?', chip: 2, slug: 'why-nexus', items: [
    { id: 's4-ctx', kind: 'note', x: 40, y: 130, w: 520, h: 320, r: -1.2, skills: ['research', 'positioning'],
      text: 'then i asked the founder why he built nexus when competitors already exist. another chance to practise the mom test: ask for stories and trade-offs, not opinions on my own ideas. three of his six answers came back to simple or easy.' },
    { id: 's4-qa', kind: 'qa', with: 's4-ctx', x: 600, y: 120, w: 520, r: 0.8, iw: 520, ih: 640, color: '#8FB3DA', skills: ['research'],
      alt: 'Interview questions and answers.',
      qa: [
        ['a year in, what should a brand tell a friend?', 'simple to use, to find users, to configure, to decide.'],
        ['if nexus were a car or a person?', 'powerful, yet so simple to use.'],
        ['which merchant would you turn away?', 'people who don’t respect software, or want a custom build.'],
        ['what should nexus never feel like?', 'unstable or unreliable.'],
        ['which merchant story makes you proudest?', 'erica from art therapy.'],
        ['if we showed one thing, what would it be?', 'how easy nexus is to use.']
      ] }
  ] },
  { title: 'what changed', chip: 3, slug: 'what-changed', items: [
    { id: 's5-ctx', kind: 'note', x: 40, y: 130, w: 520, h: 240, r: -1.2, skills: ['positioning'],
      text: 'free to start became simple to start, manage and grow a marketplace. the promise moved from what it costs to what it takes.' },
    { id: 's5-pos', kind: 'page', chart: 'pos', x: 600, y: 130, w: 520, h: 380, r: -0.5, skills: ['positioning'] },
    { id: 's5-learnt', kind: 'learnt', x: 1160, y: 130, w: 400, h: 240, r: 1.4, skills: ['positioning'],
      label: 'WHAT I LEARNT', text: 'users show you what they do. you decide who you\'re for, and what you\'re best at.' }
  ] }
];

const isDoc = (it: Item) => it.kind === 'shot' || it.kind === 'qa';
const hOf = (it: Item) => isDoc(it) ? Math.round(it.w * it.ih! / it.iw!) + 60 : it.h!;

// Desktop: sections stacked down a 1600 wide board. Phones: a 600 wide column, items stacked in reading order.
const SEC_W = 1600, GAP = 300, MW = 600, MGAP = 220;
let dy = 0, my = 0;
const sections = sectionsRaw.map((s) => {
  const h = Math.max(...s.items.map((it) => it.y + hOf(it))) + 60;
  let at = 210;
  const items = s.items.map((it) => {
    const m = { mx: 40 + (520 - it.w) / 2, my: at };
    at += hOf(it) + (it.kind === 'label' ? 16 : 64);
    return { ...it, ...m };
  });
  const sec = { ...s, items, y: dy, h, my, mh: at };
  dy += h + GAP; my += at + MGAP;
  return sec;
});
const last = sections.length - 1;
const END_Y = sections[last].y + sections[last].h + 140, WORLD_W = SEC_W, WORLD_H = END_Y + 560;
const M_END_Y = sections[last].my + sections[last].mh + 120, M_WORLD_H = M_END_Y + 640;

// Every item in world coordinates for both layouts; cards get story-wide step numbers, documents do not.
let storyStep = 0;
const all = sections.flatMap((s, i) => s.items.map((it) => ({
  ...it, sec: i, ax: it.x, ay: s.y + it.y, amx: it.mx, amy: s.my + it.my, hh: hOf(it), skills: it.skills ?? [],
  step: isDoc(it) || it.kind === 'label' ? 0 : ++storyStep
})));
const labels = all.filter((it) => it.kind === 'label');
const pieces = all.filter((it) => !isDoc(it) && it.kind !== 'label');
const docs = all.filter(isDoc);
const lastIds = sections.map((_, i) => pieces.filter((p) => p.sec === i).at(-1)!.id);

// Dotted threads from a card to the documents pinned with it, in both layouts.
const tie = (fx: number, fy: number, tx: number, ty: number) => { const m = (fy + ty) / 2; return `M ${fx} ${fy} C ${fx} ${m}, ${tx} ${m}, ${tx} ${ty}`; };
const ties = docs.map((a) => {
  const o = all.find((p) => p.id === a.with)!;
  return { for: a.id, color: a.color,
    d: tie(o.ax + o.w - 20, o.ay + 40, a.ax + a.w / 2, a.ay + 4),
    m: tie(o.amx + o.w / 2, o.amy + o.hh - 10, a.amx + a.w / 2, a.amy + 4) };
});

// The camera frames each section on its content: heading, labels, cards and documents, plus a margin.
const view = (i: number) => {
  const boxes = [...all.filter((p) => p.sec === i).map((p) => ({ x: p.ax, y: p.ay, w: p.w, h: p.hh })), { x: 30, y: sections[i].y, w: 900, h: 80 }];
  const x0 = Math.min(...boxes.map((b) => b.x)), y0 = Math.min(...boxes.map((b) => b.y));
  const x1 = Math.max(...boxes.map((b) => b.x + b.w)), y1 = Math.max(...boxes.map((b) => b.y + b.h));
  return { x: x0 - 20, y: y0 - 20, w: x1 - x0 + 40, h: y1 - y0 + 40 };
};
// Where the camera looks, and which pieces get pinned up. The first frame is the snapshot: every piece at once.
// The last stop: the end of the final section, the string running down, and the ending under it.
type Area = { x: number; y: number; w: number; h: number };
const endView: Area = { x: 0, y: sections[last].y + 200, w: SEC_W, h: WORLD_H - (sections[last].y + 200) };
const frames: { cam: number | Area; sec: number; show: string[] }[] = [{ cam: -1, sec: -1, show: [...pieces, ...docs].map((p) => p.id) }];
sections.forEach((_, i) => pieces.filter((p) => p.sec === i).forEach((p) => {
  frames.push({ cam: view(i), sec: i, show: [p.id, ...docs.filter((a) => a.with === p.id).map((a) => a.id)] });
}));
frames.push({ cam: endView, sec: last, show: [] });

// A pin beside each heading; the string leaves from each section's last card and lands on the next heading pin,
// travelling through the gutter to the right of the board so it never crosses a piece.
const bridge = ([x, y]: number[], bottom: number, [tx, ty]: number[], rx: number) =>
  ` M ${x} ${y} C ${rx} ${y}, ${rx} ${y + 130}, ${rx} ${bottom} C ${rx} ${bottom + 200}, ${tx} ${ty - 220}, ${tx} ${ty}`;
const lay = (m: boolean) => {
  const pins = sections.map((s) => [40, (m ? s.my : s.y) + 44]);
  const knots = sections.map((_, i) => { const q = pieces.find((p) => p.id === lastIds[i])!; return m ? [q.amx + q.w - 22, q.amy + 10] : [q.ax + q.w - 22, q.ay + 10]; });
  const segs = knots.map((k, i) => bridge(k, m ? sections[i].my + sections[i].mh : sections[i].y + sections[i].h,
    i < last ? pins[i + 1] : [(m ? MW : SEC_W) / 2, m ? M_END_Y : END_Y], m ? MW + 40 : SEC_W + 100));
  return { pins, knots, segs };
};
const layers = [{ k: 'd', L: lay(false), w: WORLD_W, h: WORLD_H }, { k: 'm', L: lay(true), w: MW, h: M_WORLD_H }];

const secRects = sections.map((s) => ({ x: 0, y: s.y, w: SEC_W, h: s.h }));
const mSecRects = sections.map((s) => ({ x: 0, y: s.my, w: MW, h: s.mh }));
// Skill counts are computed: every card, document and cover post tagged with the skill.
const skillCount = (id: string) => [...pieces, ...docs, ...posts].filter((p) => p.skills.includes(id)).length;
// Read time from the word count of everything written on the page, at 230 words a minute.
const words = [title, description, ...questions, coverCaption, ...sections.map((s) => s.title), closing,
  ...all.flatMap((p) => [p.text ?? '', p.label ?? '', ...(p.items ?? []), ...(p.qa ?? []).flat()]),
  'current segmentation of users', 'current installs with primary ICP', 'previous positioning free to start current positioning simple to start, manage and grow a marketplace'
].join(' ').split(/\s+/).filter(Boolean).length;
const readMins = Math.max(1, Math.round(words / 230));
const published = '14 NOV 2026 · 19:48 IST';

// Section 1's number: store status across the 240 classified stores (growth and launch plans counted together as paying).
const DONUT_C = 2 * Math.PI * 84;
const donutRaw = [
  { label: 'trial expired', stores: 211, share: '87.9%', color: '#B9B9C0' },
  { label: 'paying', stores: 19, share: '7.9%', color: '#E08A4C' },
  { label: 'on trial', stores: 10, share: '4.2%', color: '#8FB3DA' }
];
// Section 2's number: the share of current installs that match the primary ICP, as a pie with that slice pulled out.
const PIE = { cx: 110, cy: 110, r: 100, share: 0.18 };
const pieStart = -Math.PI / 2, pieEnd = pieStart + PIE.share * 2 * Math.PI, pieMid = (pieStart + pieEnd) / 2;
const pieOff = [Math.cos(pieMid) * 10, Math.sin(pieMid) * 10];
const pt = (a: number, dx = 0, dy = 0) => `${(PIE.cx + dx + PIE.r * Math.cos(a)).toFixed(2)} ${(PIE.cy + dy + PIE.r * Math.sin(a)).toFixed(2)}`;
const pieSlice = `M ${PIE.cx + pieOff[0]} ${PIE.cy + pieOff[1]} L ${pt(pieStart, pieOff[0], pieOff[1])} A ${PIE.r} ${PIE.r} 0 0 1 ${pt(pieEnd, pieOff[0], pieOff[1])} Z`;
const pieRest = `M ${PIE.cx} ${PIE.cy} L ${pt(pieEnd)} A ${PIE.r} ${PIE.r} 0 1 1 ${pt(pieStart)} Z`;
let donutAt = 0;
const donut = donutRaw.map((d) => { const len = (d.stores / 240) * DONUT_C; const seg = { ...d, len: Math.max(len - 3, 1), off: donutAt }; donutAt += len; return seg; });

const pos = (p: { ax: number; ay: number; amx: number; amy: number }) => `--x:${p.ax}px;--y:${p.ay}px;--mx:${p.amx}px;--my:${p.amy}px;`;
const cls: Record<string, string> = { note: 'note slot-ctx', learnt: 'note slot-learnt', check: 'check', page: 'page', place: 'page pc-place' };
---
<Base title="who nexus is for, and how i got there · Kritika Upadhyay" description={description}>
<Nav />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kalam:wght@300&family=Commissioner:wght@400;500;600;700&display=swap">
<div class="ic">

<figure class="ic-cover">
<a class="ic-return ic-home" href="/work">← BACK</a>
<ul class="cv-qs">{questions.map((q) => <li>{q}</li>)}</ul>
<div class="cv-row cv-posts">
{posts.map((p, i) => (
<div class={`cv-cut cv-post${i === 1 ? ' cv-mid' : ''}`} data-skills={p.skills.join(' ')} style={`--r:${p.r}deg;--a:${(p.iw / p.ih).toFixed(4)}`}>
<span class="pin" aria-hidden="true"></span>
<img src={p.src} alt={p.alt} width={p.iw} height={p.ih} decoding="async">
</div>
))}
</div>
<figcaption class="cv-cap cv-note">{coverCaption}</figcaption>
</figure>

<section class="ic-fold">
<h1 class="ic-title">{title}</h1>
<div class="ic-intro">
{descParas.map((t) => <p class="ic-desc">{t}</p>)}
<p class="ic-date">PUBLISHED {published} · {readMins} MIN READ</p>
</div>
<div class="ic-skillbox">
<p class="ic-skills-h">SKILLS</p>
<ul class="ic-skills" aria-label="Skills shown in this case study. Choose one to see it on the board.">
{skills.map((sk, i) => (
<li><button class="ic-skill" type="button" data-skill={sk.id} aria-pressed="false"><span class="sk-n">0{i + 1}</span><span class="sk-l">{sk.label}</span><span class="sk-more">{skillCount(sk.id)} on the board →</span></button></li>
))}
</ul>
</div>
</section>

<section class="ic-board" id="board" data-frames={JSON.stringify(frames)} data-secs={JSON.stringify(secRects)} data-msecs={JSON.stringify(mSecRects)}
  data-world={JSON.stringify({ w: WORLD_W, h: WORLD_H })} data-mworld={JSON.stringify({ w: MW, h: M_WORLD_H })}
  data-slugs={JSON.stringify(sections.map((s) => s.slug))} data-chips={JSON.stringify(sections.map((s) => s.chip))}>
<div class="ic-view" id="view">
<div class="ic-world" id="world" style={`--ww:${WORLD_W}px;--wh:${WORLD_H}px;--mww:${MW}px;--mwh:${M_WORLD_H}px`}>
{layers.map(({ k, L, w, h }) => (
<svg class={`ic-lines lay-${k}`} width={w} height={h} aria-hidden="true">
<g class="ic-string"><path d={L.segs.join('')} class="th-base"></path></g>
{L.segs.map((d, i) => <path d={d} class="th-fill" data-seg={i} pathLength="1"></path>)}
{L.pins.map(([x, y]) => <circle cx={x} cy={y} r="11" class="ic-pin"></circle>)}
{L.knots.map(([x, y]) => <circle cx={x} cy={y} r="7" class="ic-pin"></circle>)}
{ties.map((t) => <path d={k === 'd' ? t.d : t.m} class="ic-tie" data-for={t.for} stroke={t.color}></path>)}
</svg>
))}

{sections.map((s, i) => (
<h2 class="ic-sec-h" style={`--x:80px;--y:${s.y + 8}px;--mx:80px;--my:${s.my + 8}px`} data-sec={i}>{s.title}</h2>
))}
{labels.map((l) => <p class="ic-col-k" style={`${pos(l)}width:${l.w}px`}>{l.text}</p>)}

{pieces.map((p) => (
<div class={`pc pc-${cls[p.kind]}`} id={p.id} data-skills={p.skills.join(' ')}
  style={`${pos(p)}width:${p.w}px;${p.kind === 'page' || p.kind === 'place' ? `height:${p.h}px;` : `min-height:${p.h}px;`}--r:${p.r ?? 0}deg`}>
<span class="pc-step" aria-hidden="true">{p.step}</span>
{lastIds.includes(p.id) && <span class="pin" aria-hidden="true"></span>}
{p.kind === 'note' && <div class="note-b">{p.items
  ? <ul class="note-ul">{p.items.map((t) => <li class="note-t">{t}</li>)}</ul>
  : p.text!.split('\n\n').map((t) => <p class="note-t">{t}</p>)}</div>}
{p.kind === 'learnt' && <div class="note-b"><p class="pos-k">{p.label}</p><p class="note-t">{p.text}</p></div>}
{p.kind === 'place' && <p class="vp-hole">{p.text}</p>}
{p.kind === 'check' && <ul class="ck-list">
{p.items!.map((it) => <li><span class="ck-q" aria-hidden="true">?</span><span>{it}</span></li>)}
</ul>}

{p.chart === 'donut' && <>
<p class="pg-k">current segmentation of users</p>
<div class="dn">
<svg class="dn-chart" viewBox="0 0 220 220" role="img" aria-label="Current segmentation of users: trial expired 87.9%, paying 7.9%, on trial 4.2%.">
{donut.map((d) => <circle cx="110" cy="110" r="84" class="dn-seg" stroke={d.color} stroke-dasharray={`${d.len} ${DONUT_C - d.len}`} stroke-dashoffset={-d.off}></circle>)}
<text x="110" y="108" class="dn-n">7.9%</text>
<text x="110" y="134" class="dn-l">paying</text>
</svg>
<ul class="dn-legend">
{donut.map((d) => <li><i style={`background:${d.color}`}></i><span>{d.label}</span><b>{d.share}</b></li>)}
</ul>
</div>
</>}

{p.chart === 'pie' && <>
<p class="pg-k">current installs with primary ICP</p>
<div class="dn">
<svg class="pie" viewBox="-10 -10 240 240" role="img" aria-label="18% of current installs match the primary ICP; 82% are other installs.">
<path d={pieRest} fill="#C9C9CF"></path>
<path d={pieSlice} fill="#E08A4C"></path>
</svg>
<ul class="dn-legend">
<li><i style="background:#E08A4C"></i><span>primary ICP</span><b>18%</b></li>
<li class="muted"><i style="background:#C9C9CF"></i><span>other installs</span><b>82%</b></li>
</ul>
</div>
</>}

{p.chart === 'pos' && <>
<div class="pos">
<p class="pos-k">PREVIOUS POSITIONING</p>
<p class="pos-old">free to start</p>
<p class="pos-ar" aria-hidden="true">↓</p>
<p class="pos-k">CURRENT POSITIONING</p>
<p class="pos-new">simple to start, manage and grow a marketplace</p>
</div>
</>}
</div>
))}
{docs.map((a, k) => (
<figure class="pc pc-shot" id={a.id} data-skills={a.skills.join(' ')} style={`${pos(a)}width:${a.w}px;--r:${a.r}deg;--delay:${(k % 3) * 0.12}s`}>
<span class="pin" aria-hidden="true"></span>
{a.qa
  ? <ol class="qa">{a.qa.map(([q, ans]) => <li><span class="qa-q">{q}</span><span class="qa-a">{ans}</span></li>)}</ol>
  : <img src={a.src} alt={a.alt} width={a.iw} height={a.ih}>}
{a.caption && <figcaption>{a.caption}</figcaption>}
</figure>
))}
