---
// /work: a file cabinet. Left 60%: three filters (work i owned, how i use data, how i work with users) and one plain
// card per case study. Right 40%: an open-shelf cabinet, 2026 on top. Every case study is one file on its year's shelf.
// Hover a card and its file is outlined; the shelf stays the same on every tab. Pick a file (or a card) and it slides off
// the shelf, comes to the front as its cover, opens, and takes you inside. Phones: just the cabinet with readable names.
// Cards are one template on purpose, so a new case study is one line of data.
import Base from '../../layouts/Base.astro';

const ICP = '/work/icp-positioning-messaging-nexus';
const tabs = [
  { id: 'owned', label: 'Work i owned' },
  { id: 'data', label: 'How i use data' },
  { id: 'users', label: 'How i work with users' }
];
// Dummy files from the scenic route for now; only the Nexus ICP one has a page.
type File = { title: string; where: string; year: number; line: string; tags: string[]; href?: string };
const files: File[] = [
  { title: 'From user stories to an ICP, positioning and messaging', where: 'Nexus', year: 2026, line: 'Nexus had installs but no clear audience. Three steps to who it is for and what to say.', tags: ['owned', 'data', 'users'], href: ICP },
  { title: 'Launching Nexus, a multi-vendor app on Shopify', where: 'Nexus', year: 2026, line: 'Owning the product end to end: what to build, in what order, and why.', tags: ['owned', 'users'] },
  { title: 'Marketing and distribution for Nexus', where: 'Nexus', year: 2026, line: 'Building the go-to-market with the cofounder during my notice period.', tags: ['owned', 'data'] },
  { title: 'A product component library', where: 'Marmeto', year: 2025, line: 'Systems, processes, and my first team, with no in-house design team.', tags: ['owned'] },
  { title: 'Project managing a Shopify agency', where: 'Shopify agency', year: 2025, line: 'Learning the world of e-commerce, one client store at a time.', tags: ['owned', 'users'] },
  { title: 'Writing as an executive assistant', where: 'EA work', year: 2025, line: 'Mails, calendars and day to day indulgences. Turns out i write well.', tags: ['users'] },
  { title: 'Website, distribution and community', where: 'Product Marketing Engineer', year: 2024, line: 'Everything from website to distribution to competitive research to community.', tags: ['owned', 'data', 'users'] },
  { title: 'Competitive research', where: 'Product Marketing Engineer', year: 2024, line: 'Reading the market before writing a word about the product.', tags: ['data'] }
];
const years = [2026, 2025, 2024];
const numbered = files.map((f, i) => ({ ...f, id: i, no: String(i + 1).padStart(2, '0') }));
const tagLabel = (t: string) => tabs.find((x) => x.id === t)!.label;
// Small, fixed variety so the stacks don't look stamped out: widths, offsets, tab positions, and the case-study note colours.
const H = [94, 88, 96, 90, 86, 92, 89, 95];
const O = [0, 10, 4, 14, 6, 2, 12, 8];
const T = [6, 14, 4, 12, 8, 16, 5, 10];
const S = ['#A9B9C8', '#D6B79C', '#BFC995', '#A9C6B4', '#D2AAA4', '#D6B79C', '#A9B9C8', '#BFC995'];
---
<Base title="work · Kritika Upadhyay" description="Case studies, filed by year. Filter by the work i owned, how i use data, or how i work with users.">
<div class="wk">
<div class="wk-main">
<a class="wk-back" href="/">← back</a>
<h1>Work</h1>

<div class="wk-tabs" role="tablist" aria-label="Filter the work">
{tabs.map((t, i) => <button type="button" role="tab" class="wk-tab" data-tab={t.id} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>)}
</div>

<ul class="wk-cards" id="wk-cards">
{numbered.map((f) => (
<li class="wk-card" data-file={f.id} data-tags={f.tags.join(' ')} hidden={!f.tags.includes('owned')}>
<a href={f.href ?? '#'} data-file={f.id} class={f.href ? '' : 'soon'}>
<span class="wc-meta">{f.where}</span>
<span class="wc-title">{f.title}</span>
<span class="wc-foot"><b>{f.href ? 'View →' : 'Being written'}</b></span>
</a>
</li>
))}
</ul>
</div>

<aside class="wk-cab" aria-label="The file cabinet">
<p class="wk-phone">The cabinet opens best on a desktop. Here are the files.</p>
<div class="cab">
<svg class="pl pl-money" viewBox="0 0 120 110" overflow="visible" aria-hidden="true">
