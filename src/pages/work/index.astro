<g class="lf" style="--d:-2.1s;--t:6.0s"><use href="#pothos" transform="translate(18 58) rotate(-70) scale(1.1)" fill="#4E8A3E"/></g>
<g class="lf" style="--d:-2.8s;--t:4.2s"><use href="#pothos" transform="translate(70 56) rotate(10) scale(1)" fill="#2F6A2C"/></g>
<path d="M22 74 H98 L92 110 H28 Z" fill="#E6E3DC"/><path d="M22 74 H98 V80 H22 Z" fill="#D4D1C9"/><path d="M80 80 L92 80 L88 110 H76 Z" fill="#CFCBC2"/>
</svg>
