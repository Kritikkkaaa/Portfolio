---
// /work: a file cabinet. Left 60%: three filters (work i owned, how i use data, how i work with users) and one plain
// card per case study. Right 40%: an open-shelf cabinet, 2026 on top. Every case study is one file on its year's shelf.
// Hover a card and its file lifts; the filter dims files that don't match. Pick a file (or a card) and it slides off
// the shelf, comes to the front as its cover, opens, and takes you inside. Phones: just the cabinet with readable names.
// Cards are one template on purpose, so a new case study is one line of data.
import Base from '../../layouts/Base.astro';

const ICP = '/work/icp-positioning-messaging-nexus';
const tabs = [
  { id: 'owned', label: 'Work i owned' },
  { id: 'data', label: 'How i use data' },
  { id: 'users', label: 'How i work with users' }
];
// Dummy files from the scenic route for now; only the Nexus ICP one has a page.
type File = { title: string; where: string; year: number; line: string; tags: string[]; href?: string };
const files: File[] = [
  { title: 'From user stories to an ICP, positioning and messaging', where: 'Nexus', year: 2026, line: 'Nexus had installs but no clear audience. Three steps to who it is for and what to say.', tags: ['owned', 'data', 'users'], href: ICP },
  { title: 'Launching Nexus, a multi-vendor app on Shopify', where: 'Nexus', year: 2026, line: 'Owning the product end to end: what to build, in what order, and why.', tags: ['owned', 'users'] },
  { title: 'Marketing and distribution for Nexus', where: 'Nexus', year: 2026, line: 'Building the go-to-market with the cofounder during my notice period.', tags: ['owned', 'data'] },
  { title: 'A product component library', where: 'Marmeto', year: 2025, line: 'Systems, processes, and my first team, with no in-house design team.', tags: ['owned'] },
  { title: 'Project managing a Shopify agency', where: 'Shopify agency', year: 2025, line: 'Learning the world of e-commerce, one client store at a time.', tags: ['owned', 'users'] },
  { title: 'Writing as an executive assistant', where: 'EA work', year: 2025, line: 'Mails, calendars and day to day indulgences. Turns out i write well.', tags: ['users'] },
  { title: 'Website, distribution and community', where: 'Product Marketing Engineer', year: 2024, line: 'Everything from website to distribution to competitive research to community.', tags: ['owned', 'data', 'users'] },
  { title: 'Competitive research', where: 'Product Marketing Engineer', year: 2024, line: 'Reading the market before writing a word about the product.', tags: ['data'] }
];
const years = [2026, 2025, 2024];
const numbered = files.map((f, i) => ({ ...f, id: i, no: String(i + 1).padStart(2, '0') }));
const tagLabel = (t: string) => tabs.find((x) => x.id === t)!.label;
// Small, fixed variety so the shelves don't look stamped out: heights, tab positions, shades.
const H = [156, 144, 162, 150, 140, 160, 146, 154];
const T = [10, 24, 6, 18, 12, 28, 8, 20];
const S = ['#FFFFFF', '#F4F3EF', '#ECEBE5', '#FAFAF7', '#F0EFEA', '#FFFFFF', '#E8E7E1', '#F6F5F1'];
---
<Base title="work · Kritika Upadhyay" description="Case studies, filed by year. Filter by the work i owned, how i use data, or how i work with users.">
<div class="wk">
<div class="wk-main">
<a class="wk-back" href="/">← back</a>
<h1>Work</h1>

<div class="wk-tabs" role="tablist" aria-label="Filter the work">
{tabs.map((t, i) => <button type="button" role="tab" class="wk-tab" data-tab={t.id} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}<span class="wk-n">{files.filter((f) => f.tags.includes(t.id)).length}</span></button>)}
</div>

<ul class="wk-cards" id="wk-cards">
{numbered.map((f) => (
<li class="wk-card" data-file={f.id} data-tags={f.tags.join(' ')} hidden={!f.tags.includes('owned')}>
<a href={f.href ?? '#'} data-file={f.id} class={f.href ? '' : 'soon'}>
<span class="wc-meta">File {f.no} · {f.where}</span>
<span class="wc-title">{f.title}</span>
<span class="wc-line">{f.line}</span>
<span class="wc-foot"><span class="wc-tags">{f.tags.map((t) => <span>{tagLabel(t)}</span>)}</span><b>{f.href ? 'Open file →' : 'Being written'}</b></span>
</a>
</li>
))}
</ul>
</div>

<aside class="wk-cab" aria-label="The file cabinet">
<p class="wk-phone">The cabinet opens best on a desktop. Here are the files.</p>
<div class="cab">
<span class="cab-top" aria-hidden="true"></span>
{years.map((y) => (
<div class="shelf">
<span class="shelf-y">{y}</span>
<div class="shelf-row">
{numbered.filter((f) => f.year === y).map((f) => (
<a class={`file${f.href ? ' real' : ''}`} href={f.href ?? '#'} data-file={f.id} style={`--h:${H[f.id % 8]}px;--t:${T[f.id % 8]}px;--s:${S[f.id % 8]}`} aria-label={`File ${f.no}: ${f.title}${f.href ? '' : ' (being written)'}`}>
<span class="file-tab" aria-hidden="true"></span>
<span class="file-name">{f.title}</span>
<span class="file-where" aria-hidden="true">{f.where}</span>
</a>
))}
</div>
<span class="shelf-board" aria-hidden="true"></span>
</div>
))}
<span class="cab-foot" aria-hidden="true"></span>
</div>
</aside>
</div>

<div class="fly" id="fly" hidden>
<div class="fly-veil"></div>
<div class="cover" id="cover">
<div class="cv-inside"><p class="cv-soon">This file is still being written.<br><span>Check back soon.</span></p></div>
<div class="cv-front">
<span class="cv-tab" id="cv-tab"></span>
<span class="cv-label">
<span class="cv-meta" id="cv-meta"></span>
<span class="cv-title" id="cv-title"></span>
<span class="cv-tags" id="cv-tags"></span>
</span>
<span class="cv-mark" aria-hidden="true"><i></i><i></i></span>
</div>
</div>
</div>

<script type="application/json" id="wk-data" set:html={JSON.stringify(numbered.map((f) => ({ no: f.no, title: f.title, where: f.where, year: f.year, href: f.href || '', tags: f.tags.map(tagLabel) })))}></script>
</Base>

<style>
.wk{--bg:#141416;--fg:#EFEFEE;--mute:#A9AFB9;--line:rgba(169,175,185,.22);--red:#D2453F;display:grid;grid-template-columns:minmax(0,60fr) minmax(0,40fr);gap:56px;box-sizing:border-box;min-height:100svh;padding:28px max(24px,calc((100% - 1280px) / 2)) 96px;color:var(--fg);font-family:'Commissioner',system-ui,sans-serif;background-color:var(--bg);background-image:linear-gradient(rgba(169,175,185,.075) 1px,transparent 1px),linear-gradient(90deg,rgba(169,175,185,.075) 1px,transparent 1px);background-size:18px 18px;background-position:-1px -1px}
.wk-back{display:inline-block;margin-bottom:48px;color:var(--mute);font-size:var(--t-caps);font-weight:500;letter-spacing:.18em;text-transform:uppercase;text-decoration:none}
.wk-back:hover,.wk-back:focus-visible{color:var(--fg)}
.wk h1{margin:0;font-size:var(--t-display);font-weight:500;letter-spacing:-.02em;line-height:1}

.wk-tabs{display:flex;flex-wrap:wrap;gap:4px;margin:56px 0 0;border-bottom:1px solid var(--line)}
.wk-tab{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 16px;margin-bottom:-1px;border:1px solid transparent;border-radius:8px 8px 0 0;background:none;color:var(--mute);font:inherit;font-size:var(--t-body);cursor:pointer;transition:color .2s ease,background-color .2s ease}
.wk-tab:hover{color:var(--fg)}
.wk-tab[aria-selected="true"]{color:var(--fg);background:var(--bg);border-color:var(--line);border-bottom-color:var(--bg)}
.wk-n{min-width:20px;padding:1px 6px;border-radius:999px;background:rgba(239,239,238,.08);font-size:var(--t-small);text-align:center}
.wk-tab[aria-selected="true"] .wk-n{background:var(--red);color:#fff}
.wk-tab:focus-visible,.wk-card a:focus-visible,.file:focus-visible{outline:2px solid var(--fg);outline-offset:3px}

.wk-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 20px;margin:44px 0 0;padding:0;list-style:none}
.wk-card[hidden]{display:none}
.wk-card a{position:relative;display:flex;flex-direction:column;gap:10px;height:100%;box-sizing:border-box;padding:22px 22px 18px;border:1px solid var(--line);border-radius:6px;background:#18181C;color:var(--fg);text-decoration:none;transition:border-color .2s ease,transform .25s cubic-bezier(.2,.8,.2,1)}
.wk-card a:hover,.wk-card a.on{border-color:rgba(210,69,63,.7);transform:translateY(-3px)}
.wc-meta{font-size:var(--t-caps);font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--mute)}
.wc-title{font-size:var(--t-h3);font-weight:500;line-height:1.25;letter-spacing:-.01em}
.wc-line{font-size:var(--t-body);line-height:1.6;color:#C9CDD5}
.wc-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-top:auto;padding-top:14px;border-top:1px dashed var(--line);font-size:var(--t-small)}
.wc-tags{display:flex;flex-wrap:wrap;gap:6px}
.wc-tags span{padding:2px 8px;border:1px solid var(--line);border-radius:999px;color:var(--mute)}
.wc-foot b{flex:none;font-weight:500;color:var(--fg)}
.wk-card a.soon .wc-foot b{color:var(--mute);font-weight:400}

/* The cabinet */
.wk-cab{position:relative}
.wk-phone{display:none}
/* A plain white bookcase: frame, grey back panel, three shelves, a plinth */
.cab{--wood:#F4F3EF;--edge:#DCDBD5;--back:#E3E2DC;position:sticky;top:72px;margin-top:92px;padding:14px 14px 0;background:var(--wood);border:1px solid var(--edge);border-radius:2px;box-shadow:0 30px 60px rgba(0,0,0,.45)}
.cab-top,.cab-foot{display:none}
.shelf{position:relative;padding:44px 20px 0;background:var(--back);box-shadow:inset 0 14px 18px -10px rgba(0,0,0,.22),inset 10px 0 14px -10px rgba(0,0,0,.12)}
.shelf-y{position:absolute;top:16px;left:20px;font-size:var(--t-caps);font-weight:500;letter-spacing:.18em;color:#8A8D96}
.shelf-row{display:flex;align-items:flex-end;gap:10px;height:166px}
.shelf-board{display:block;height:14px;margin:0 -20px;background:var(--wood);border-top:1px solid var(--edge);border-bottom:1px solid var(--edge)}
.shelf:last-of-type .shelf-board{height:26px;border-bottom:0}

.file{position:relative;flex:0 0 auto;display:flex;flex-direction:column;align-items:center;width:88px;height:var(--h);box-sizing:border-box;padding:16px 0 10px;border:1px solid #CFCEC7;border-bottom:0;border-radius:2px 2px 0 0;background:var(--s);color:#1E1E24;text-decoration:none;box-shadow:2px 0 0 rgba(0,0,0,.05);transition:transform .45s cubic-bezier(.2,.8,.2,1),opacity .3s ease,border-color .2s ease,box-shadow .2s ease}
.file-tab{position:absolute;bottom:100%;left:var(--t);width:24px;height:9px;border:1px solid #CFCEC7;border-bottom:0;border-radius:3px 3px 0 0;background:var(--s)}
.file-name{flex:1;overflow:hidden;writing-mode:vertical-rl;transform:rotate(180deg);font-size:var(--t-small);font-weight:500;line-height:1.15;text-align:left;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}
.file-where{margin-top:8px;writing-mode:vertical-rl;transform:rotate(180deg);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#5A5A62;white-space:nowrap;overflow:hidden;max-height:64px}
.file:hover,.file.on{border-color:var(--red);box-shadow:inset 0 0 0 1px var(--red)}
.file:hover .file-tab,.file.on .file-tab{border-color:var(--red)}
.file.peek{transform:translateY(-44px)}
.file.dim{opacity:.35}
.file.gone{visibility:hidden}

/* File to the front */
.fly{--bg:#141416;--fg:#EFEFEE;--mute:#A9AFB9;--line:rgba(169,175,185,.22);--red:#D2453F;position:fixed;inset:0;z-index:80;font-family:"Commissioner",system-ui,sans-serif;color:var(--fg)}
.fly[hidden]{display:none}
.fly-veil{position:absolute;inset:0;background:rgba(8,8,8,.78);opacity:0}
.cover{position:absolute;perspective:1800px;transform-origin:0 0}
.cv-front,.cv-inside{position:absolute;inset:0;box-sizing:border-box;border-radius:4px 10px 10px 10px}
.cv-inside{display:flex;align-items:center;justify-content:center;background-color:var(--bg);background-image:linear-gradient(rgba(169,175,185,.075) 1px,transparent 1px),linear-gradient(90deg,rgba(169,175,185,.075) 1px,transparent 1px);background-size:18px 18px;border:1px solid rgba(169,175,185,.32)}
.cv-soon{margin:0;padding:0 32px;font-size:var(--t-h3);font-weight:500;line-height:1.4;text-align:center;opacity:0}
.cv-soon span{font-family:'Kalam',cursive;font-weight:300;font-size:var(--h-note);letter-spacing:.5px;color:#C9CDD5}
.cv-front{display:flex;flex-direction:column;padding:30px 28px;background:#F4F3EF;border:1px solid #CFCEC7;transform-origin:0 50%;backface-visibility:hidden;box-shadow:0 30px 60px rgba(0,0,0,.6)}
.cv-tab{position:absolute;bottom:100%;left:-1px;width:120px;height:22px;border:1px solid #CFCEC7;border-bottom:0;border-radius:8px 8px 0 0;background:#F4F3EF}
.cv-label{display:flex;flex-direction:column;gap:14px;margin-top:auto;padding:22px;background:#FFFFFF;color:#1E1E24;border:1px solid #DCDBD5;border-radius:2px;transform:rotate(-1.2deg)}
.cv-meta{font-size:var(--t-caps);font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#5A5A62}
.cv-title{font-size:var(--t-h2);font-weight:500;line-height:1.2;letter-spacing:-.01em}
.cv-tags{display:flex;flex-wrap:wrap;gap:6px;font-size:var(--t-small)}
.cv-tags span{padding:2px 8px;border:1px solid rgba(30,30,36,.25);border-radius:999px;color:#3A3A42}
.cv-mark{position:absolute;top:28px;right:28px;width:44px;height:28px}
.cv-mark i{position:absolute;top:0;width:28px;height:28px;border:1.5px solid #1E1E24;border-radius:50%;box-sizing:border-box}
.cv-mark i:first-child{left:0}
.cv-mark i:last-child{right:0;background:radial-gradient(circle at 0 50%,var(--red) 0 13px,transparent 13.5px)}
.cv-front > *{opacity:0}

@media (max-width:900px){
  .wk{grid-template-columns:1fr;gap:0}
  .wk-tabs,.wk-cards{display:none}
  .wk-phone{display:block;margin:40px 0 0;padding:12px 14px;border:1px dashed var(--line);border-radius:6px;font-size:var(--t-small);color:var(--mute)}
  .cab{position:static;margin-top:28px}
  .shelf{padding:44px 12px 0}
  .shelf-board{margin:0 -12px}
  .shelf-row{flex-direction:column;align-items:stretch;gap:8px;height:auto;padding-bottom:14px}
  .file{flex-direction:row;align-items:center;gap:12px;width:auto;height:auto;padding:12px 14px;border-bottom:1px solid #CFCEC7;border-radius:2px}
  .file-tab{display:none}
  .file-name,.file-where{writing-mode:horizontal-tb;transform:none;-webkit-line-clamp:3}
  .file-where{margin:0 0 0 auto;max-height:none;white-space:normal;text-align:right;max-width:30%}
  .file.peek{transform:none}
  .file.dim{opacity:1}
}
@media (prefers-reduced-motion:reduce){.file,.wk-card a{transition:none}}
</style>

<script>
  type F = { no: string; title: string; where: string; year: number; href: string; tags: string[] };
  const data: F[] = JSON.parse(document.getElementById('wk-data')!.textContent || '[]');
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const narrow = () => matchMedia('(max-width: 900px)').matches;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.wk-tab'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.wk-card'));
  const files = Array.from(document.querySelectorAll<HTMLAnchorElement>('.file'));
  const fileOf = (id: string) => files.find((f) => f.dataset.file === id)!;
  const cardOf = (id: string) => document.querySelector<HTMLAnchorElement>(`.wk-card a[data-file="${id}"]`);

  // Filters: show matching cards, dim the files that don't match.
  const pick = (t: HTMLButtonElement) => {
    const id = t.dataset.tab!;
    tabs.forEach((b) => b.setAttribute('aria-selected', String(b === t)));
    cards.forEach((c) => { c.hidden = !c.dataset.tags!.split(' ').includes(id); });
    files.forEach((f) => f.classList.toggle('dim', !cards.find((c) => c.dataset.file === f.dataset.file)!.dataset.tags!.split(' ').includes(id)));
  };
  tabs.forEach((t) => t.addEventListener('click', () => pick(t)));
  pick(tabs[0]);

  // Card and file light each other up.
  const peekId = files[0].dataset.file!;
  const hover = (id: string, on: boolean) => {
    fileOf(id).classList.toggle('on', on);
    cardOf(id)?.classList.toggle('on', on);
  };
  [...files, ...document.querySelectorAll<HTMLAnchorElement>('.wk-card a')].forEach((el) => {
    const id = el.dataset.file!;
    el.addEventListener('pointerenter', () => hover(id, true));
    el.addEventListener('pointerleave', () => hover(id, false));
    el.addEventListener('focus', () => hover(id, true));
    el.addEventListener('blur', () => hover(id, false));
    el.addEventListener('click', (e) => { if (narrow() && data[+id].href) return; e.preventDefault(); open(id); });
  });

  // The newest file sits half-pulled, an invitation.
  setTimeout(() => fileOf(peekId).classList.add('peek'), RM ? 0 : 900);

  // File to the front: slide up off the shelf, fly to the middle as its cover, open, go inside.
  const fly = document.getElementById('fly')!;
  const veil = fly.querySelector<HTMLElement>('.fly-veil')!;
  const cover = document.getElementById('cover')!;
  const front = cover.querySelector<HTMLElement>('.cv-front')!;
  const soon = cover.querySelector<HTMLElement>('.cv-soon')!;
  let opening = false, shut: (() => void) | null = null;
  const run = (el: Element, k: Keyframe[], o: KeyframeAnimationOptions) => el.animate(k, { fill: 'forwards', ...o }).finished;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function open(id: string) {
    if (opening) return;
    opening = true;
    const d = data[+id], file = fileOf(id);
    
    document.getElementById('cv-meta')!.textContent = `${d.where} · ${d.year}`;
    document.getElementById('cv-title')!.textContent = d.title;
    document.getElementById('cv-tags')!.innerHTML = d.tags.map((t) => `<span>${t}</span>`).join('');
    cover.classList.toggle('real', !!d.href);
    const W = Math.min(460, innerWidth * 0.8), Hh = Math.min(W * 1.32, innerHeight * 0.78);
    const x = (innerWidth - W) / 2, y = (innerHeight - Hh) / 2 + 12;
    Object.assign(cover.style, { left: x + 'px', top: y + 'px', width: W + 'px', height: Hh + 'px' });
    fly.hidden = false;

    if (RM) {
      front.querySelectorAll<HTMLElement>(':scope > *').forEach((c) => (c.style.opacity = '1'));
      await run(fly, [{ opacity: 0 }, { opacity: 1 }], { duration: 1 });
      veil.style.opacity = '1';
    } else {
      // 1. lift off the shelf
      file.classList.remove('peek', 'on');
      await run(file, [{ transform: 'translateY(-90px)' }], { duration: 260, easing: 'cubic-bezier(.3,0,.2,1)' });
      const r = file.getBoundingClientRect();
      file.classList.add('gone');
      // 2. fly to the front, growing into the cover
      const from = `translate(${r.left - x}px, ${r.top - y}px) scale(${r.width / W}, ${r.height / Hh})`;
      run(veil, [{ opacity: 0 }, { opacity: 1 }], { duration: 520 });
      await run(cover, [{ transform: from }, { transform: 'translate(0,0) scale(1) rotate(-1.5deg)', offset: 0.8 }, { transform: 'none' }], { duration: 640, easing: 'cubic-bezier(.2,.8,.2,1)' });
      // 3. the cover reads
      await Promise.all(Array.from(front.children).map((c, i) => run(c, [{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 260, delay: i * 70 })));
    }
    await wait(RM ? 600 : 520);
    // 4. it opens
    if (!RM) await run(front, [{ transform: 'rotateY(0)' }, { transform: 'rotateY(-165deg)' }], { duration: 620, easing: 'cubic-bezier(.5,0,.2,1)' });
    else front.style.visibility = 'hidden';
    if (d.href) {
      // 5. the inside fills the screen and you're in
      const k = Math.max(innerWidth / W, innerHeight / Hh) * 1.1;
      front.style.visibility = 'hidden';
      await run(cover, [{ transform: 'none' }, { transform: `translate(${innerWidth / 2 - x - W / 2}px, ${innerHeight / 2 - y - Hh / 2}px) scale(${k})` }], { duration: RM ? 1 : 420, easing: 'cubic-bezier(.5,0,.3,1)', });
      location.href = d.href;
      return;
    }
    run(soon, [{ opacity: 0 }, { opacity: 1 }], { duration: 300 });
    shut = () => close(file);
  }

  async function close(file: HTMLElement) {
    shut = null;
    await run(fly, [{ opacity: 1 }, { opacity: 0 }], { duration: RM ? 1 : 260 });
    reset();
    file.getAnimations().forEach((a) => a.cancel());
    file.classList.remove('gone');
  }
  function reset() {
    fly.hidden = true;
    [fly, veil, cover, front, soon, ...Array.from(front.children)].forEach((el) => { el.getAnimations().forEach((a) => a.cancel()); (el as HTMLElement).style.opacity = ''; (el as HTMLElement).style.visibility = ''; });
    veil.style.opacity = '';
    opening = false;
  }
  fly.addEventListener('click', () => shut?.());
  addEventListener('keydown', (e) => { if (e.key === 'Escape') shut?.(); });
  // Coming back with the browser's back button: put the cabinet back as it was.
  addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    reset();
    files.forEach((f) => { f.getAnimations().forEach((a) => a.cancel()); f.classList.remove('gone'); });
    fileOf(peekId).classList.add('peek');
  });
</script>
