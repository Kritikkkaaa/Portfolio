---
// /work: a wheel of case-study prints. Scroll, swipe or use the arrow keys and the wheel turns; the print in the
// middle is the one you're on and its title sits above it. Items repeat round the ring, so one case study loops.
// A new case study is one line in ITEMS (in the script below).
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
---
<Base title="work · Kritika Upadhyay" description="Case studies by Kritika Upadhyay. Turn the wheel to pick one.">
<Nav />
<div class="ww" id="ww">
<header class="ww-top">
<a class="ww-caps" id="ww-back" href="/">← Back</a>
<h1 id="ww-h1">Work</h1>
</header>

<div class="ww-rows" id="ww-rows"></div>
<div class="ww-wheel" id="ww-wheel"></div>

<div class="ww-bottom">
<div class="ww-ticks" id="ww-ticks" role="group" aria-label="Case studies"></div>
<span class="ww-caps" aria-hidden="true">Scroll</span>
</div>
<p class="ww-sr" aria-live="polite" id="ww-live"></p>
</div>
</Base>

<style is:global>
  html:has(#ww), html:has(#ww) body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  html:has(#ww) body { touch-action: none; }
  .ww {
    --ww-grid: rgba(169, 175, 185, 0.075);
    --ww-muted: #A9AFB9;
    --ww-ink: #1E1E24;
    --ww-cream: #F1EEE6;
    --ww-red: #D2453F;
    --ww-pad: 24px;
    --ww-title: clamp(24px, 3.1vw, 44px);
    --ww-print: min(clamp(150px, 17vw, 250px), 30vh);
    position: fixed; inset: 0;
    background-color: #141416;
    background-image: linear-gradient(var(--ww-grid) 1px, transparent 1px), linear-gradient(90deg, var(--ww-grid) 1px, transparent 1px);
    background-size: 18px 18px, 18px 18px;
    overflow: hidden;
    color: #EFEFEE;
  }
  .ww a { color: inherit; }
  .ww-caps { font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ww-muted); text-decoration: none; line-height: 1.7; }
  .ww-top { position: absolute; top: 0; left: 0; z-index: 5; padding: 22px var(--ww-pad) 0; }
  .ww-top a { display: inline-block; }
  .ww-top a:hover, .ww-top a:focus-visible { color: #EFEFEE; }
  .ww-top h1 { margin: 20px 0 0; font-size: var(--t-display); font-weight: 500; line-height: 1; letter-spacing: -0.02em; }
  .ww-bottom {
    position: absolute; bottom: 0; left: 0; right: 0; z-index: 5;
    display: flex; justify-content: center; align-items: center; gap: 18px;
    padding: 20px var(--ww-pad); pointer-events: none;
  }
  .ww-ticks { display: flex; gap: 6px; pointer-events: auto; }
  .ww-ticks:has(button:only-child) { display: none; }
  .ww-ticks button { width: 22px; height: 22px; padding: 0; background: none; border: 0; cursor: pointer; display: grid; place-items: center; }
  .ww-ticks button::before { content: ""; width: 100%; height: 2px; background: var(--ww-muted); opacity: .35; transition: opacity .25s, background-color .25s; }
  .ww-ticks button[aria-current="true"]::before { background: var(--ww-red); opacity: 1; }
  .ww-ticks button:focus-visible { outline: 1px solid var(--ww-muted); outline-offset: 2px; }

  .ww-rows { position: absolute; inset: 0; z-index: 1; }
  .ww-row {
    position: absolute; left: 0; right: 0; top: 0;
    display: grid; grid-template-columns: 26% minmax(0, 52%); align-items: start;
    padding: 0 var(--ww-pad); will-change: transform, opacity;
  }
  .ww-row .ww-num, .ww-row .ww-title { margin: 0; font-size: var(--ww-title); font-weight: 500; line-height: 1.08; letter-spacing: -0.02em; }
  .ww-row .ww-num { font-variant-numeric: tabular-nums; }
  .ww-row .ww-title { text-wrap: balance; }

  .ww-wheel { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .ww-print {
    position: absolute; left: 0; top: 0;
    width: var(--ww-print); margin: 0 0 0 calc(var(--ww-print) / -2);
    background: var(--ww-cream);
    padding: calc(var(--ww-print) * 0.055) calc(var(--ww-print) * 0.055) 0;
    border-radius: 2px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45), 0 1px 0 rgba(255,255,255,.5) inset;
    color: var(--ww-ink); text-decoration: none;
    cursor: pointer; pointer-events: auto; will-change: transform; transform-origin: 50% 50%;
    display: block; border: 0; font: inherit; text-align: left;
  }
  .ww .ww-print { color: var(--ww-ink); }
  .ww-print svg { display: block; width: 100%; height: auto; border-radius: 1px; }
  .ww-print .ww-foot { display: block; padding: calc(var(--ww-print) * 0.045) 0 calc(var(--ww-print) * 0.055); }
  .ww-print .ww-read, .ww-print .ww-soon {
    display: block; text-align: center; border-radius: 6px;
    font-size: clamp(11px, calc(var(--ww-print) * 0.056), 14px); line-height: 1;
    padding: calc(var(--ww-print) * 0.042) 0; border: 1px solid var(--ww-ink);
  }
  .ww-print .ww-read { background: var(--ww-ink); color: var(--ww-cream); font-weight: 600; transition: background-color .2s, border-color .2s; }
  a.ww-print:hover .ww-read, a.ww-print:focus-visible .ww-read { background: var(--ww-red); border-color: var(--ww-red); }
  .ww-print .ww-soon { color: rgba(30, 30, 36, .6); font-weight: 500; border: 1px dashed rgba(30, 30, 36, .35); }
  .ww-print:focus-visible { outline: 2px solid var(--ww-red); outline-offset: 4px; }
  .ww-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); margin: 0; }

  @media (max-width: 720px) {
    .ww { --ww-pad: 18px; --ww-title: clamp(22px, 6.4vw, 30px); --ww-print: min(42vw, 26vh); }
    .ww-row { grid-template-columns: 1fr; row-gap: 6px; }
    .ww-row .ww-num { font-size: 15px; letter-spacing: 0.08em; color: var(--ww-muted); }
  }
</style>

<script>
  type Item = { title: string; href: string | null; cover: 'icp' | 'onboarding' | 'twitter'; paper: string };
  // One line per case study. href: null shows "Being written".
  const ITEMS: Item[] = [
    { title: 'From user stories to an ICP, positioning and messaging', href: '/work/icp-positioning-messaging-nexus', cover: 'icp', paper: '#A9B9C8' },
    { title: "What I learnt building Plane's Twitter from scratch!", href: '/work/grow-planes-twitter', cover: 'twitter', paper: '#D6B79C' }
  ];

  /* covers, drawn in the site's own shelf colours */
  const INK = '#1E1E24', CREAM = '#F1EEE6', RED = '#D2453F';
  const gridLines = () => {
    let s = '';
    for (let x = 20; x < 200; x += 20) s += `<path d="M${x} 0V250"/>`;
    for (let y = 20; y < 250; y += 20) s += `<path d="M0 ${y}H200"/>`;
    return `<g stroke="${INK}" stroke-opacity=".09" stroke-width="1">${s}</g>`;
  };
  const note = (x: number, y: number, r: number) => `
    <g transform="translate(${x} ${y}) rotate(${r})">
      <rect x="-17" y="-13" width="34" height="26" rx="1.5" fill="${CREAM}" stroke="${INK}" stroke-width="1.4"/>
      <path d="M-11 -4H11M-11 3H5" stroke="${INK}" stroke-width="1.4" stroke-linecap="round"/>
    </g>`;
  const COVERS = {
    icp(paper: string) {
      const notes: [number, number, number][] = [[34, 40, -8], [100, 30, 4], [166, 44, 9], [30, 208, 6], [100, 220, -5], [168, 206, -10]];
      const threads = notes.map(([x, y]) => `<path d="M${x} ${y}L100 125"/>`).join('');
      return `<svg viewBox="0 0 200 250" aria-hidden="true">
        <rect width="200" height="250" fill="${paper}"/>${gridLines()}
        <g stroke="${INK}" stroke-width="1.2" stroke-dasharray="3 4" fill="none">${threads}</g>
        <circle cx="100" cy="125" r="46" fill="${paper}" stroke="${INK}" stroke-width="1.6"/>
        <circle cx="100" cy="125" r="29" fill="none" stroke="${INK}" stroke-width="1.6"/>
        <circle cx="100" cy="125" r="10" fill="${RED}"/>
        ${notes.map((n) => note(...n)).join('')}
      </svg>`;
    },
    // the megaphone from the Plane Twitter case study's own cover
    twitter(paper: string) {
      return `<svg viewBox="0 0 200 250" aria-hidden="true">
        <rect width="200" height="250" fill="${paper}"/>${gridLines()}
        <g transform="translate(-4 52) scale(0.86)">
          <g fill="none" stroke="${INK}" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
            <path d="M52 78v22l22 4 54 26V48L74 74z" fill="${INK}"/>
            <path d="M74 104l8 30h14l-6-26"/>
            <path d="M142 70c8 6 8 32 0 38M154 58c16 12 16 50 0 62"/>
            <rect x="172" y="34" width="46" height="58" rx="3" fill="${CREAM}"/>
            <path d="M181 48h28M181 60h28M181 72h18"/>
          </g>
          <circle cx="212" cy="38" r="7" fill="${RED}"/>
        </g>
      </svg>`;
    },
    onboarding(paper: string) {
      const bars = [[26, 150], [60, 132], [94, 62], [128, 52], [162, 44]];
      const base = 206;
      return `<svg viewBox="0 0 200 250" aria-hidden="true">
        <rect width="200" height="250" fill="${paper}"/>${gridLines()}
        <rect x="94" y="${base - 118}" width="24" height="118" fill="none" stroke="${RED}" stroke-width="1.6" stroke-dasharray="4 4"/>
        ${bars.map(([x, h]) => `<rect x="${x}" y="${base - h}" width="24" height="${h}" fill="${CREAM}" stroke="${INK}" stroke-width="1.5"/>`).join('')}
        <path d="M16 ${base}H192" stroke="${INK}" stroke-width="1.6" stroke-linecap="round"/>
        <path d="M106 ${base - 70}V${base - 106}M99 ${base - 98}l7 -9l7 9" fill="none" stroke="${RED}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="106" cy="112" r="36" fill="none" stroke="${INK}" stroke-width="3"/>
        <path d="M132 138L160 168" stroke="${INK}" stroke-width="6" stroke-linecap="round"/>
      </svg>`;
    }
  };

  const N = ITEMS.length;
  const STEP = 22.5;            // degrees between prints
  const SLOTS = 360 / STEP;     // 16 prints fill the ring, items repeat
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const rowsEl = $('ww-rows'), wheelEl = $('ww-wheel'), ticksEl = $('ww-ticks'), live = $('ww-live'), h1 = $('ww-h1');

  // Back retraces the visitor's steps when they came from this site; Home is the fallback for a direct visit.
  $('ww-back').addEventListener('click', (e) => {
    let fromSite = false;
    try { fromSite = !!document.referrer && new URL(document.referrer).hostname === location.hostname; } catch {}
    if (fromSite && history.length > 1) { e.preventDefault(); history.back(); }
  });
  const pad2 = (n: number) => String(n).padStart(2, '0');
  function wrap(d: number, n: number) { d = ((d % n) + n) % n; return d > n / 2 ? d - n : d; }

  let pos = 0, target = 0, active = -1, idle = 0;

  // Titles repeat like the prints do (at least four in the loop), so the next one always peeks out behind the card.
  const RN = N * Math.ceil(4 / N);
  const rows = Array.from({ length: RN }, (_, j) => {
    const i = j % N, it = ITEMS[i];
    const el = document.createElement('div');
    el.className = 'ww-row';
    el.innerHTML = `<span class="ww-num">${pad2(i + 1)}</span><h2 class="ww-title">${it.title}</h2>`;
    rowsEl.appendChild(el);
    return el;
  });

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canTilt = !reduce && matchMedia('(hover: hover) and (pointer: fine)').matches;
  const prints: HTMLElement[] = [];
  const tilts: { x: number; y: number; tx: number; ty: number }[] = [];
  for (let k = 0; k < SLOTS; k++) {
    const it = ITEMS[k % N];
    const el = document.createElement(it.href ? 'a' : 'button');
    el.className = 'ww-print';
    if (it.href) (el as HTMLAnchorElement).href = it.href;
    else (el as HTMLButtonElement).type = 'button';
    el.setAttribute('aria-label', `${pad2((k % N) + 1)}. ${it.title}${it.href ? '' : ' (being written)'}`);
    el.innerHTML = COVERS[it.cover](it.paper) + `<span class="ww-foot">${it.href
      ? '<span class="ww-read">Read →</span>' : '<span class="ww-soon">Being written</span>'}</span>`;
    const tilt = { x: 0, y: 0, tx: 0, ty: 0 };
    tilts.push(tilt);
    if (canTilt) {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        tilt.ty = ((e.clientX - (r.left + r.width / 2)) / (r.width / 2)) * 9;
        tilt.tx = -((e.clientY - (r.top + r.height / 2)) / (r.height / 2)) * 9;
      });
      el.addEventListener('pointerleave', () => { tilt.tx = 0; tilt.ty = 0; });
    }
    // A side print turns the wheel to itself first; only the centre one opens.
    el.addEventListener('click', (e) => {
      const off = wrap(k - pos, SLOTS);
      if (Math.abs(off) > 0.3) { e.preventDefault(); target = Math.round(pos + off); }
      else if (!it.href) e.preventDefault();
    });
    wheelEl.appendChild(el);
    prints.push(el);
  }

  const ticks = ITEMS.map((it, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.setAttribute('aria-label', `Go to ${pad2(i + 1)}. ${it.title}`);
    b.addEventListener('click', () => { target = Math.round(pos + wrap(i - pos, N)); });
    ticksEl.appendChild(b);
    return b;
  });

  function render() {
    const W = innerWidth, H = innerHeight;
    const rowH = H * 0.5;
    const R = Math.max(W * 1.18, 620);
    const cx = W / 2;
    const printH = prints[0].offsetHeight;
    // the centre print fills the space between the title and the bottom bar
    const rowTop = h1.getBoundingClientRect().bottom + Math.max(22, H * 0.04);
    const titleH = Math.max(...rows.map((r) => r.offsetHeight));
    const free0 = rowTop + titleH + 22, free1 = H - 56;
    // 0.86: the centre print sits a little smaller than the free space, with room around it
    const sC = Math.max(0.7, Math.min(1.34, (free1 - free0) / printH) * 0.86);
    const sSide = Math.min(sC, 1) * 0.96;
    const cy = (free0 + free1) / 2 + R;

    rows.forEach((el, i) => {
      const d = wrap(i - pos, RN);
      const near = Math.min(1, Math.abs(d));
      el.style.transform = `translate3d(0, ${rowTop + d * rowH}px, 0)`;
      el.style.opacity = (1 - near * 0.8).toFixed(3);
      el.setAttribute('aria-hidden', Math.abs(d) < 0.5 ? 'false' : 'true');
    });

    prints.forEach((el, k) => {
      const a = wrap(k - pos, SLOTS) * STEP;
      if (Math.abs(a) > 62) { el.style.visibility = 'hidden'; return; }
      el.style.visibility = 'visible';
      const rad = a * Math.PI / 180;
      const x = cx + R * Math.sin(rad);
      const y = cy - R * Math.cos(rad) - printH / 2;
      const near = Math.min(1, Math.abs(a) / STEP);
      const s = sSide + (sC - sSide) * (1 - near);
      const t = tilts[k];
      t.x += (t.tx - t.x) * 0.14; t.y += (t.ty - t.y) * 0.14;
      el.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${a}deg) scale(${s}) perspective(900px) rotateX(${t.x.toFixed(2)}deg) rotateY(${t.y.toFixed(2)}deg)`;
      el.style.zIndex = String(100 - Math.round(Math.abs(a)));
      el.tabIndex = Math.abs(a) < STEP * 1.5 ? 0 : -1;
    });

    const now = ((Math.round(pos) % N) + N) % N;
    if (now !== active) {
      active = now;
      ticks.forEach((t, i) => t.setAttribute('aria-current', i === now ? 'true' : 'false'));
      live.textContent = `${pad2(now + 1)} of ${pad2(N)}. ${ITEMS[now].title}`;
    }
  }

  function frame() {
    const diff = target - pos;
    if (reduce) pos = target;
    else pos += Math.abs(diff) < 0.0005 ? diff : diff * 0.11;
    render();
    requestAnimationFrame(frame);
  }

  function nudge(delta: number) {
    target += delta;
    clearTimeout(idle);
    idle = window.setTimeout(() => { target = Math.round(target); }, 160);
  }

  addEventListener('wheel', (e) => {
    e.preventDefault();
    const unit = e.deltaMode === 1 ? 32 : 1;
    const d = (Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX) * unit;
    nudge(Math.max(-1, Math.min(1, d / 300)));
  }, { passive: false });

  let touchY: number | null = null;
  addEventListener('touchstart', (e) => { touchY = e.touches[0].clientY; }, { passive: true });
  addEventListener('touchmove', (e) => {
    if (touchY == null) return;
    const y = e.touches[0].clientY;
    nudge((touchY - y) / 200);
    touchY = y;
  }, { passive: true });
  addEventListener('touchend', () => { touchY = null; });

  addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.altKey || e.metaKey || e.ctrlKey) return;
    if (['ArrowDown', 'ArrowRight', 'PageDown'].includes(e.key)) { e.preventDefault(); target = Math.round(target) + 1; }
    if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); target = Math.round(target) - 1; }
  });

  requestAnimationFrame(frame);
</script>
