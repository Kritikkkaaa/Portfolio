<g class="lf" style="--d:-1.2s;--t:5.2s"><g transform="translate(52 38) rotate(-14) scale(1)"><path d="M0 0 C-17 -6 -21 -30 -4 -48 C3 -41 19 -31 15 -12 C13 -4 6 0 0 0Z" fill="#F6F5EF"/><path d="M-1 -2 C-8 -14 -8 -30 -4 -42" stroke="#DCD9CC" stroke-width="1" fill="none"/><path d="M1 -5 C3 -13 4 -21 3 -29" stroke="#E6D486" stroke-width="5" stroke-linecap="round" fill="none"/></g></g>
<g class="lf" style="--d:-3.1s;--t:5.8s"><g transform="translate(98 50) rotate(16) scale(0.9)"><path d="M0 0 C-17 -6 -21 -30 -4 -48 C3 -41 19 -31 15 -12 C13 -4 6 0 0 0Z" fill="#F6F5EF"/><path d="M-1 -2 C-8 -14 -8 -30 -4 -42" stroke="#DCD9CC" stroke-width="1" fill="none"/><path d="M1 -5 C3 -13 4 -21 3 -29" stroke="#E6D486" stroke-width="5" stroke-linecap="round" fill="none"/></g></g>
<g class="lf" style="--d:-2.2s;--t:4.9s"><g transform="translate(76 26) rotate(2) scale(1.05)"><path d="M0 0 C-17 -6 -21 -30 -4 -48 C3 -41 19 -31 15 -12 C13 -4 6 0 0 0Z" fill="#F6F5EF"/><path d="M-1 -2 C-8 -14 -8 -30 -4 -42" stroke="#DCD9CC" stroke-width="1" fill="none"/><path d="M1 -5 C3 -13 4 -21 3 -29" stroke="#E6D486" stroke-width="5" stroke-linecap="round" fill="none"/></g></g>
<g class="lf" style="--d:-3.5s;--t:4.8s"><use href="#lily" transform="translate(70 134) rotate(-58) scale(.9)" fill="#2C5A2E"/></g>
