---
// /journey, "i could never do things straight!" — reached by clicking the centre photo (say hello) on the desk.
// Desktop: like the desk, a fixed 1512x982 two-page spread (split down the middle) scaled to fit the window.
// The idea: what she wanted to do vs what she ended up doing. A long straight black line (the plan, with a line or
// two about it) and, leaving from the same point, the wavy terracotta line (what happened), which carries the stops
// of the journey; its loops are the detours. Below 768px it is one column.
// The page turn from the desk (in index.astro, "fold") draws this page's Back, title and socials in the same places.
import Analytics from '../components/Analytics.astro';

const TWITTER = 'https://x.com/verykritikal?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const SUBSTACK = 'https://substack.com/@verykritikal/posts?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const INSTAGRAM = 'https://www.instagram.com/verykritikal/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const LINKEDIN = 'https://www.linkedin.com/in/kritika-upadhyay-2001/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const EMAIL = 'mailto:kritikaupadhyay2001@gmail.com';
const WHATSAPP = 'https://wa.me/919109079518';
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};

const socials = [
  { label: 'Twitter', href: TWITTER, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><path d="M4 4l16 16M20 4L4 20"></path></svg>' },
  { label: 'Substack', href: SUBSTACK, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M5 4h14M5 8h14M5 12h14v9l-7-4-7 4z"></path></svg>' },
  { label: 'Instagram', href: INSTAGRAM, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".8" fill="#A9452A"></circle></svg>' },
  { label: 'LinkedIn', href: LINKEDIN, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><rect x="3.5" y="3.5" width="17" height="17" rx="3"></rect><path d="M8 10.5v6M8 7.5v.1M12 16.5v-6M12 13c0-1.6 1-2.6 2.3-2.6S16.5 11.3 16.5 13v3.5"></path></svg>' },
  { label: 'Email', href: EMAIL, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path></svg>' },
  { label: 'WhatsApp', href: WHATSAPP, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M4 20l1.4-4.2A8 8 0 1 1 8.4 19z"></path><path d="M9.2 9.2c.3 2.4 2.2 4.4 4.6 4.9l1-1.1 1.6.8" stroke-linecap="round"></path></svg>' }
];

// The lines, on a 1512 x 600 canvas placed at y = LINES_Y on the spread.
const LINES_Y = 300;
// what she wanted to do: one straight line, all the way across
const plan = 'M-20 60 L1540 60';
const PLAN = 'the plan was simple. one degree, one job, one straight line up.'; // a draft, for her to rewrite
// what she ended up doing: leaves the straight line at the start, then wanders, with two loops on its way across
const red = 'M-20 60 C90 60 110 330 200 365 C290 400 340 420 420 380 C520 320 560 220 640 250 C720 280 690 380 620 360 C540 340 600 200 740 230 C900 265 950 430 1100 400 C1200 380 1230 290 1300 300 C1370 310 1360 390 1300 385 C1240 380 1280 280 1400 290 C1460 295 1500 320 1540 330';

// Stops on the terracotta line (x, y on the line canvas); the label hangs above or below on a dotted leader.
// `at` is when the dot appears, roughly when the drawing line reaches it.
// `learnt` is what each stop taught her (from the old home's timeline); it shows in the caption on hover.
const stops = [
  { n: '01', date: 'jul 2021', name: 'TEDx', x: 200, y: 365, side: 'down', at: 0.55, learnt: 'Curated a 6 hour long TEDx event. 120 attendees, 9 speakers, 5.5 lacs in sponsorships and 10k steps daily.' },
  { n: '02', date: 'may 2022', name: 'GTM intern', x: 458, y: 354, side: 'down', at: 0.85, learnt: 'Making cold calls. Found out that I am very good at understanding what people want and how to give it to them.' },
  { n: '03', date: 'mar → jul 2023', name: 'Plane', x: 631, y: 245, side: 'up', at: 1.1, learnt: 'First real job! What is product? What is first principles thinking, and why does any of it matter?' },
  { n: '04', date: 'aug 2023 → may 2024', name: 'Product Marketing Engineer', x: 994, y: 387, side: 'down', at: 1.55, learnt: 'Everything from landing pages, documents, community management. I did my best work at Plane!' },
  { n: '05', date: 'jun → dec 2025', name: 'Freelancing', x: 1298, y: 385, side: 'down', at: 1.9, learnt: 'I found out that I am a good writer with horrible grammar! Learnt to form an opinion. Also that bringing people together over food is an art I want to practice.' },
  { n: '06', date: 'aug 2025 → sep 2026', name: 'Nexus', x: 1453, y: 300, side: 'up', at: 2.15, right: true, learnt: 'Built a marketplace app from scratch. Learnt how to care for opinions and egos, why build scalable systems, and how to manage my first team.' }
];
const planeLogo = `<svg width="118" height="74" viewBox="0 0 579 361" role="img" aria-label="Plane logo"><path d="M0 20.6413C0 5.3174 16.1 -4.64793 29.7966 2.20067L147.972 61.3502V200.168C147.972 219.674 158.992 237.527 176.417 246.248L283.068 299.63V340.352C283.068 355.675 266.968 365.641 253.271 358.779L28.4447 246.248C11.0201 237.527 0 219.688 0 200.168V20.6413ZM147.972 20.6413C147.972 5.3174 164.072 -4.64793 177.769 2.21435L295.945 61.3638V200.182C295.945 219.688 306.965 237.541 324.39 246.262L431.041 299.643V340.366C431.041 355.689 414.94 365.654 401.244 358.792L283.068 299.643V160.826C283.068 141.306 272.048 123.466 254.623 114.744L147.972 61.3638V20.6413ZM295.931 20.6413C295.931 5.3174 312.032 -4.64793 325.728 2.21435L550.555 114.744C567.993 123.466 579 141.306 579 160.826V340.366C579 355.689 562.899 365.654 549.203 358.792L431.027 299.643V160.826C431.027 141.306 420.007 123.466 402.582 114.744L295.931 61.3638V20.6413Z" fill="#1C1B1F"></path></svg>`;
