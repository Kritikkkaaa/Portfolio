---
// /journey, "i could never do things straight!" — reached by clicking the centre photo (say hello) on the desk.
// Desktop: like the desk, a fixed 1512x982 two-page spread scaled to fill the window. Below 768px: one column.
// The idea: what she wanted to do vs what she ended up doing.
//  - A straight black line across the middle of the spread, with four cuts on it: the plans.
//  - The terracotta line ("My journey so far!", the heading on the live site) peels off it and roams up and down
//    the page through the stops; the loops are the detours. Hovering a stop unfurls what it taught her below it.
// Top right: "now you and i can work together!" as a pinned tear-off flyer whose chits are her socials
// (so the page has no separate socials row).
// The page turn from the desk (in index.astro, "fold") draws this page's Back and title in the same places.
import Analytics from '../components/Analytics.astro';

const TWITTER = 'https://x.com/verykritikal?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const SUBSTACK = 'https://substack.com/@verykritikal/posts?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const INSTAGRAM = 'https://www.instagram.com/verykritikal/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const LINKEDIN = 'https://www.linkedin.com/in/kritika-upadhyay-2001/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const EMAIL = 'mailto:kritikaupadhyay2001@gmail.com';
const WHATSAPP = 'https://wa.me/919109079518';
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};

const socials = [
  { label: 'Twitter', href: TWITTER, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><path d="M4 4l16 16M20 4L4 20"></path></svg>' },
  { label: 'Substack', href: SUBSTACK, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M5 4h14M5 8h14M5 12h14v9l-7-4-7 4z"></path></svg>' },
  { label: 'Instagram', href: INSTAGRAM, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".8" fill="#A9452A"></circle></svg>' },
  { label: 'LinkedIn', href: LINKEDIN, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><rect x="3.5" y="3.5" width="17" height="17" rx="3"></rect><path d="M8 10.5v6M8 7.5v.1M12 16.5v-6M12 13c0-1.6 1-2.6 2.3-2.6S16.5 11.3 16.5 13v3.5"></path></svg>' },
  { label: 'Email', href: EMAIL, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path></svg>' },
  { label: 'WhatsApp', href: WHATSAPP, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M4 20l1.4-4.2A8 8 0 1 1 8.4 19z"></path><path d="M9.2 9.2c.3 2.4 2.2 4.4 4.6 4.9l1-1.1 1.6.8" stroke-linecap="round"></path></svg>' }
];

const MID = 500; // the straight line's height on the spread
// what she wanted to do: cuts on the straight line (x, label above or below the line)
const plans = [
  { n: '01', text: 'study psychology, masters in sociology', x: 110, side: 'up' },
  { n: '02', text: 'become a professor', x: 612, side: 'up' },
  { n: '03', text: 'read books in museums in paris', x: 906, side: 'down' },
  { n: '04', text: 'fall in love!', x: 1196, side: 'up' }
];
// what she ended up doing: leaves the straight line at the left, then swings high and low across both pages
const red = 'M-20 500 C70 500 110 690 200 690 C290 690 330 410 440 410 C530 410 560 560 640 640 C690 690 760 720 770 670 C780 620 700 610 700 660 C700 710 760 712 800 690 C870 650 880 340 990 340 C1080 340 1110 560 1190 640 C1240 690 1310 720 1320 670 C1330 620 1250 610 1250 660 C1250 710 1310 712 1350 690 C1410 650 1400 360 1460 360 C1500 360 1520 390 1540 410';
// stops on the terracotta line; `learnt` unfolds on hover. Low stops hang their label below, high ones above.
const stops = [
  { n: '01', date: 'jul 2021', name: 'TEDx', x: 200, y: 690, side: 'down', at: 1.35, learnt: 'Curated a 6 hour long TEDx event. 120 attendees, 9 speakers, 5.5 lacs in sponsorships and 10k steps daily.' },
  { n: '02', date: 'may 2022', name: 'GTM intern', x: 440, y: 410, side: 'up', at: 1.6, learnt: 'Making cold calls. Found out that I am very good at understanding what people want and how to give it to them.' },
  { n: '03', date: 'mar → jul 2023', name: 'Plane', x: 700, y: 660, side: 'down', right: true, at: 1.95, learnt: 'First real job! What is product? What is first principles thinking, and why does any of it matter?' },
  { n: '04', date: 'aug 2023 → may 2024', name: 'Product Marketing Engineer', x: 908, y: 419, side: 'up', right: true, at: 2.3, learnt: 'Everything from landing pages, documents, community management. I did my best work at Plane!' },
  { n: '05', date: 'jun → dec 2025', name: 'Freelancing', x: 1154, y: 590, side: 'down', right: true, at: 2.65, learnt: 'I found out that I am a good writer with horrible grammar! Learnt to form an opinion. Also that bringing people together over food is an art I want to practice.' },
  { n: '06', date: 'aug 2025 → sep 2026', name: 'Nexus', x: 1460, y: 360, side: 'up', at: 2.95, right: true, learnt: 'Built a marketplace app from scratch. Learnt how to care for opinions and egos, why build scalable systems, and how to manage my first team.' }
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · i prefer the scenic route.</title>
<meta name="description" content="What Kritika wanted to do, and what she ended up doing.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Hanken+Grotesk:wght@400;500&amp;family=EB+Garamond:ital,wght@0,500;1,400&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#fff;color:#1C1B1F;font-family:'Hanken Grotesk',sans-serif}
a{color:#A9452A;text-decoration:none}a:hover{color:#8F3C21}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
/* the spread: same pages, gutter shadow and sheen as the desk, with a light paper grain */
.fold1{position:relative;height:100vh;overflow:hidden}
#stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}
.pageL{background:linear-gradient(100deg,#ffffff 0%,#fbfbf9 38%,#ffffff 52%,#f6f6f3 78%,#e9e8e4 96%,#d9d7d2 100%)}
.pageR{background:linear-gradient(80deg,#d6d4cf 0%,#e8e7e3 4%,#f7f7f4 20%,#ffffff 46%,#fafaf8 70%,#ffffff 100%)}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.75) 42%,rgba(255,255,255,0) 54%)}
.grain{position:absolute;inset:0;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.16;pointer-events:none}
.back{position:absolute;left:72px;top:76px;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
h1{position:absolute;left:72px;top:118px;width:600px;margin:0;font-family:Geist,sans-serif;font-weight:600;font-size:64px;line-height:1.02;letter-spacing:-.02em;color:#1C1B1F}
/* "now you and i can work together!": a pinned tear-off flyer, like the ones on a cafe noticeboard. One line, then
   tear-off chits with her socials (one chit already taken). Hovering a chit peels it. */
.flyer{position:absolute;left:964px;top:58px;margin:0;background:#fff;box-shadow:0 12px 26px rgba(70,50,35,.14),0 1px 3px rgba(70,50,35,.10);transform:rotate(1.6deg);transform-origin:50% 0}
.flyer .pin{position:absolute;left:50%;top:-7px;width:14px;height:14px;margin-left:-7px;border-radius:50%;background:#A9452A;box-shadow:0 2px 3px rgba(0,0,0,.25),inset -2px -2px 0 rgba(0,0,0,.15)}
.flyer .fh{margin:0;padding:24px 22px 18px;font-family:Geist,sans-serif;font-weight:500;font-size:19px;letter-spacing:-.01em;white-space:nowrap;color:#1C1B1F}
.flyer .tabs{display:flex;border-top:1.5px dashed #c9c4bd}
.flyer .tab{width:46px;height:74px;display:flex;align-items:center;justify-content:center;transform-origin:50% 0;border-left:1px dashed #d8d3cc;background:#fff;transition:transform .45s cubic-bezier(.3,1.5,.5,1),box-shadow .3s}
.flyer .tab:first-child{border-left:0}
.flyer .tab svg{display:block}
.flyer .tab:hover,.flyer .tab:focus-visible{transform:rotate(-8deg) translateY(3px);box-shadow:0 6px 10px rgba(70,50,35,.16)}
.flyer .tab.gone{flex:1;width:auto;background:transparent;border-left:1px dashed transparent;pointer-events:none}
.flyer .tab.gone::after{content:"";display:block;width:100%;height:8px;align-self:flex-start;background:#fff;clip-path:polygon(0 0,100% 0,100% 40%,85% 100%,70% 45%,55% 100%,40% 50%,25% 100%,10% 45%,0 90%)}
@media (prefers-reduced-motion: reduce){.flyer .tab{transition:none}}
.lines{position:absolute;left:0;top:0;width:1512px;height:982px;overflow:visible;pointer-events:none}
.lines path{fill:none;stroke-linecap:round;stroke-linejoin:round}
/* the straight plan draws across first, evenly; then the terracotta line peels off it and roams */
.lines .plan{stroke:#1C1B1F;stroke-width:1.6;stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1.1s linear .1s forwards}
.lines .terra{stroke:#A9452A;stroke-width:3;stroke-dasharray:1;stroke-dashoffset:1;animation:draw 2.4s cubic-bezier(.55,.1,.25,1) 1s forwards}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes inn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.ed{opacity:0;animation:inn .7s ease forwards}
/* the plans: a cut across the straight line, with the plan beside it */
.cut{position:absolute;top:500px;width:0;height:0}
.cut .mark{position:absolute;left:-1px;top:-11px;width:2px;height:22px;background:#1C1B1F}
.cut .pl{position:absolute;left:12px;width:180px;display:flex;flex-direction:column;gap:2px}
.cut.up .pl{bottom:12px}.cut.down .pl{top:12px}
.cut .pt{font-family:'EB Garamond',serif;font-style:italic;font-size:19px;line-height:1.2;color:#1C1B1F}
/* the stops: a dot on the terracotta line, a dotted leader, the label; hovering unfurls what it taught her */
.stop{position:absolute;width:0;height:0;outline:none;opacity:0;animation:inn .6s ease forwards}
.stop .dot{position:absolute;left:-6px;top:-6px;width:12px;height:12px;box-sizing:border-box;border-radius:50%;background:#A9452A;border:3px solid #fff;box-shadow:0 0 0 1px #A9452A;transition:transform .3s cubic-bezier(.3,1.6,.5,1)}
.stop .lead{position:absolute;left:-1px;width:0;height:40px;border-left:2px dotted #A9452A}
.stop.down .lead{top:12px}.stop.up .lead{bottom:12px}
.stop .lbl{position:absolute;left:-1px;width:240px;display:flex;flex-direction:column;gap:3px;cursor:default}
.stop.down .lbl{top:58px}.stop.up .lbl{bottom:58px}
.stop.right .lbl{left:auto;right:-1px;align-items:flex-end;text-align:right}
.stop .num{font-family:Geist,sans-serif;font-weight:500;font-size:13px;color:#A9452A}
.stop .date{display:block;margin-bottom:4px;font-family:'Hanken Grotesk',sans-serif;font-style:normal;font-size:12px;letter-spacing:.14em;color:#8a837d}
.stop .name{font-size:18px;color:#1C1B1F;transition:color .3s}
.stop .more{display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows .7s cubic-bezier(.2,.7,.2,1),opacity .5s ease .1s}
.stop .more>p{overflow:hidden;margin:0;font-family:'Hanken Grotesk',sans-serif;font-size:15px;line-height:1.5;color:#2a2724}
.stop .more>p span{display:block;padding-top:6px}
.stop:hover .more,.stop:focus-within .more,.stop:focus .more{grid-template-rows:1fr;opacity:1}
/* labels above the line keep their place: the description drops below the name, over the line, on a paper backing */
.stop.up .lbl{z-index:3}
.stop.up .more{position:absolute;top:100%;left:0;width:220px;margin-top:2px;background:rgba(251,251,249,.96);box-shadow:0 6px 18px rgba(70,50,35,.10)}
.stop.up .more>p span{padding:8px 10px 10px}
.stop.right.up .more{left:auto;right:0;text-align:right}
.stop:hover,.stop:focus{z-index:4}
.stop:hover .dot,.stop:focus .dot{transform:scale(1.45)}
.stop:hover .name,.stop:focus .name{color:#A9452A}
.stop:focus-visible .lbl{outline:2px solid #5B3FD9;outline-offset:4px}
@media (prefers-reduced-motion: reduce){.lines path,.ed,.stop{animation:none;stroke-dashoffset:0;opacity:1}.stop .more,.stop .dot{transition:none}}

/* phones: one column on the paper */
.m{display:none}
@media (max-width: 767px){
  .fold1{display:none}
  body{background:#fbfaf7}
  .m{display:flex;flex-direction:column;min-height:100vh;min-height:100svh;box-sizing:border-box;padding:48px 16px 32px}
  .m .back{position:static;align-self:flex-start;min-height:32px;box-sizing:border-box}
  .m h1{position:static;width:auto;margin:6px 0 0;font-size:44px}
  .m .mflyer{position:static;margin:24px 0 0;transform:none}
  .m .mflyer .fh{padding:20px 16px 16px;font-size:17px;white-space:normal}
  .m .mflyer .tab{flex:1;width:auto;height:64px}
  .m .mhead{margin:32px 0 10px;font-size:12px;letter-spacing:.24em}
  .m .mplans{list-style:none;margin:0;padding:0 0 0 16px;border-left:2px solid #1C1B1F;display:grid;gap:10px}
  .m .mplans li{font-family:'EB Garamond',serif;font-style:italic;font-size:20px;line-height:1.25}
  .m .mlines{margin:24px 0 0}
  .m .mlines svg{display:block;width:100%;height:auto}
  .m .mlines .plan{stroke-width:4}
  .m .mlines .terra{stroke-width:7}
  .m .mstops{list-style:none;margin:0 0 32px;padding:0 0 0 18px;border-left:2px dotted #A9452A;display:grid;gap:22px}
  .m .mstops li{position:relative;display:flex;flex-direction:column;gap:2px}
  .m .mstops li::before{content:"";position:absolute;left:-26px;top:3px;width:12px;height:12px;box-sizing:border-box;border-radius:50%;background:#A9452A;border:3px solid #fbfaf7;box-shadow:0 0 0 1px #A9452A}
  .m .mstops .date{font-size:12px;letter-spacing:.14em;color:#8a837d}
  .m .mstops .name{font-size:17px}
  .m .mstops .q{margin:4px 0 0;font-size:15px;line-height:1.5;color:#4A4542}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold1">
<div id="stage">
<div class="pageL" aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 756px; height: 982px"></div>
<div class="pageR" aria-hidden="true" style="position: absolute; left: 756px; top: 0; width: 756px; height: 982px"></div>
<div class="sheen" aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 1512px; height: 982px; opacity: .6"></div>
<div class="grain" aria-hidden="true"></div>

<a class="back" href="/#desk">Back</a>
<h1>i prefer the scenic route.</h1>
<aside class="flyer ed" style="animation-delay: .9s" aria-label="now you and i can work together!">
<span class="pin" aria-hidden="true"></span>
<p class="fh">now you and i can work together!</p>
<div class="tabs">
{socials.map((c) => <a class="tab" href={c.href} aria-label={c.label} {...ext(c.href)} set:html={c.svg}></a>)}
<span class="tab gone" aria-hidden="true"></span>
</div>
</aside>

<svg class="lines" viewBox="0 0 1512 982" aria-hidden="true">
<path class="plan" d={`M-20 ${MID} L1540 ${MID}`} pathLength="1"></path>
<path class="terra" d={red} pathLength="1"></path>
</svg>

<ol aria-label="What i wanted to do" style="margin: 0; padding: 0; list-style: none">
{plans.map((p, i) => (
<li class={`cut ${p.side}`} style={`left: ${p.x}px`}>
<span class="mark ed" aria-hidden="true" style={`animation-delay: ${0.25 + i * 0.22}s`}></span>
<span class="pl ed" style={`animation-delay: ${0.35 + i * 0.22}s`}><span class="pt">{p.text}</span></span>
</li>
))}
</ol>

<ol aria-label="My journey so far" style="margin: 0; padding: 0; list-style: none">
{stops.map((s) => (
<li class={`stop ${s.side}${s.right ? ' right' : ''}`} tabindex="0" style={`left: ${s.x}px; top: ${s.y}px; animation-delay: ${s.at}s`}>
<span class="dot" aria-hidden="true"></span><span class="lead" aria-hidden="true"></span>
<span class="lbl"><span class="name">{s.name}</span>
<span class="more"><p><span><em class="date">{s.date}</em>{s.learnt}</span></p></span></span>
</li>
))}
</ol>
</div>
</section>

<main class="m">
<a class="back" href="/#desk">Back</a>
<h1>i prefer the scenic route.</h1>
<aside class="flyer mflyer" aria-label="now you and i can work together!">
<p class="fh">now you and i can work together!</p>
<div class="tabs">{socials.map((c) => <a class="tab" href={c.href} aria-label={c.label} {...ext(c.href)} set:html={c.svg}></a>)}</div>
</aside>
<p class="mhead" style="color: #4A4542">what i wanted to do</p>
<ol class="mplans">
{plans.map((p) => <li>{p.text}</li>)}
</ol>
<div class="mlines" aria-hidden="true">
<svg class="lines" viewBox="0 280 1512 480" style="position: static">
<path class="plan" d={`M-20 ${MID} L1540 ${MID}`} pathLength="1"></path>
<path class="terra" d={red} pathLength="1"></path>
</svg>
</div>
<p class="mhead" style="color: #A9452A">My journey so far!</p>
<ol class="mstops">
{stops.map((s) => <li><span class="name">{s.name}</span><span class="date">{s.date}</span><p class="q">{s.learnt}</p></li>)}
</ol>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// The spread is zoomed in to cover the whole window (same as the desk), trimming the sides evenly and a little
// more from the bottom than the top; on very unusual window shapes it stops at 18% trimmed.
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82),st=document.getElementById('stage');st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';}
addEventListener('resize',fit);fit();
</script>
</body>
</html>
