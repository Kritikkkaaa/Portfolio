<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · i could never do things straight!</title>
<meta name="description" content="Kritika's journey so far, which was never a straight line.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Hanken+Grotesk:wght@400;500&amp;family=EB+Garamond:ital,wght@0,500;1,400&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#fff;color:#1C1B1F;font-family:'Hanken Grotesk',sans-serif}
a{color:#A9452A;text-decoration:none}a:hover{color:#8F3C21}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
/* the spread: same pages, gutter shadow and sheen as the desk */
.fold1{position:relative;height:100vh;overflow:hidden}
#stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}
.pageL{background:linear-gradient(100deg,#ffffff 0%,#fbfbf9 38%,#ffffff 52%,#f6f6f3 78%,#e9e8e4 96%,#d9d7d2 100%)}
.pageR{background:linear-gradient(80deg,#d6d4cf 0%,#e8e7e3 4%,#f7f7f4 20%,#ffffff 46%,#fafaf8 70%,#ffffff 100%)}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.75) 42%,rgba(255,255,255,0) 54%)}
.back{position:absolute;left:72px;top:76px;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
h1{position:absolute;left:72px;top:118px;width:600px;margin:0;font-family:Geist,sans-serif;font-weight:600;font-size:64px;line-height:1.02;letter-spacing:-.02em;color:#1C1B1F}
.socials{position:absolute;left:72px;top:864px;display:flex;gap:18px;align-items:center}
.socials a{display:flex}
.lines{position:absolute;left:0;width:1512px;height:600px;overflow:visible}
.lines path{fill:none;stroke-linecap:round;stroke-linejoin:round}
.lines .ink{stroke:#1C1B1F;stroke-width:1.1}
.lines .terra{stroke:#A9452A;stroke-width:3}
/* the straight plan draws across first, evenly; then the terracotta line peels off it and wanders */
.lines .plan{stroke:#1C1B1F;stroke-width:1.6;stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1.1s linear .1s forwards}
.lines .terra{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 2.2s cubic-bezier(.55,.1,.25,1) 1s forwards}
.wanted,.ended{position:absolute;font-size:12px;letter-spacing:.24em}
.wanted{color:#4A4542}.ended{color:#A9452A}
.planline{position:absolute;margin:0;font-family:'EB Garamond',serif;font-style:italic;font-size:27px;line-height:1.2;color:#1C1B1F}
@keyframes draw{to{stroke-dashoffset:0}}
/* stops: a dot on the line, a dotted leader, then number, date and name */
.stop{position:absolute;width:0;height:0;opacity:0;animation:stopIn .6s ease forwards}
.stop .dot{position:absolute;left:-6px;top:-6px;width:12px;height:12px;box-sizing:border-box;border-radius:50%;background:#A9452A;border:3px solid #fff;box-shadow:0 0 0 1px #A9452A}
.stop .lead{position:absolute;left:-1px;width:0;height:46px;border-left:2px dotted #A9452A}
.stop.down .lead{top:12px}.stop.up .lead{bottom:12px}
.stop .lbl{position:absolute;left:-1px;width:220px;display:flex;flex-direction:column;gap:3px;text-shadow:0 0 3px #fff,0 0 6px #fff,0 0 10px #fff}
.stop.down .lbl{top:66px}.stop.up .lbl{bottom:66px}
.stop.right .lbl{left:auto;right:-1px;align-items:flex-end;text-align:right}
.stop .num{font-family:Geist,sans-serif;font-weight:500;font-size:13px;color:#A9452A}
.stop .date{font-size:12px;letter-spacing:.14em;color:#8a837d}
.stop .name{font-size:17px;color:#1C1B1F}
@keyframes stopIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.stop{cursor:default;outline:none}
.stop .dot{transition:transform .25s cubic-bezier(.3,1.6,.5,1)}
.stop .name{transition:color .2s}
.stop.on .dot,.stop:focus-visible .dot{transform:scale(1.45)}
.stop.on .name,.stop:focus-visible .name{color:#A9452A}
.stop:focus-visible .lbl{outline:2px solid #5B3FD9;outline-offset:4px}
/* editorial layer: paper grain, big serif years, black-and-white cutouts on terracotta shapes, dek, tabs, marks */
.grain{position:absolute;inset:0;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.16;pointer-events:none}
.ed{position:absolute;opacity:0;animation:stopIn .9s ease forwards}
.drift{will-change:transform}
.year{font-family:'EB Garamond',serif;font-weight:500;font-size:92px;line-height:1;letter-spacing:-.01em;color:#A9452A}
.shape{background:#A9452A}
.bw{filter:grayscale(1) contrast(1.25) drop-shadow(0 8px 10px rgba(40,30,25,.22))}
.cut{transition:transform .5s cubic-bezier(.3,1.4,.5,1)}
.cut.on{transform:translateY(-6px) rotate(0deg) !important}
.dek{font-family:'EB Garamond',serif;font-style:italic;font-size:25px;color:#1C1B1F}
.by{font-size:12px;letter-spacing:.24em;color:#4A4542}
.tick{position:absolute;width:0;border-left:1px solid #1C1B1F}
.rule{position:absolute;height:0;border-top:1px solid #1C1B1F}
.tab{position:absolute;width:34px;height:46px;display:flex;align-items:center;justify-content:center;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.08);font-family:'EB Garamond',serif;font-style:italic;font-size:15px;color:#4A4542}
.plus{position:absolute;width:22px;height:22px;color:#A9452A}
.dots{position:absolute;height:0;border-top:3px dotted #A9452A}
.cap{position:absolute;left:880px;top:866px;width:540px;padding-left:16px;border-left:1px solid #1C1B1F}
.cap .cn{font-family:Geist,sans-serif;font-weight:500;font-size:13px;color:#A9452A;min-height:16px}
.cap .cq{margin:4px 0 0;font-family:'EB Garamond',serif;font-style:italic;font-size:19px;line-height:1.3;color:#1C1B1F;transition:opacity .25s}
@media (prefers-reduced-motion: reduce){.lines path,.stop,.ed{animation:none;stroke-dashoffset:0;opacity:1}}

/* phones: one column on the paper */
.m{display:none}
@media (max-width: 767px){
  .fold1{display:none}
  body{background:#fbfaf7}
  .m{display:flex;flex-direction:column;min-height:100vh;min-height:100svh;box-sizing:border-box;padding:48px 16px 32px}
  .m .back{position:static;align-self:flex-start;min-height:32px;box-sizing:border-box}
  .m h1{position:static;width:auto;margin:6px 0 0;font-size:44px}
  .m .mlines{margin:24px -16px 8px;overflow:hidden}
  .m .lines{position:static;display:block;width:100%;height:auto;margin:0}
  .m .lines .plan{stroke-width:3.6}
  .m .mwanted{margin:28px 0 0;font-size:12px;letter-spacing:.24em;color:#4A4542}
  .m .mplan{margin:4px 0 0;font-family:'EB Garamond',serif;font-style:italic;font-size:22px;line-height:1.25}
  .m .mended{margin:0 0 14px;font-size:12px;letter-spacing:.24em;color:#A9452A}
  .m .lines .terra{stroke-width:7}
  .m ol{list-style:none;margin:0 0 32px;padding:0 0 0 18px;border-left:2px dotted #A9452A;display:grid;gap:22px}
  .m li{position:relative;display:flex;flex-direction:column;gap:2px}
  .m li::before{content:"";position:absolute;left:-26px;top:3px;width:12px;height:12px;box-sizing:border-box;border-radius:50%;background:#A9452A;border:3px solid #fbfaf7;box-shadow:0 0 0 1px #A9452A}
  .m .socials{position:static;margin-top:auto;gap:6px;margin-left:-12px}
  .m .mdek{margin:10px 0 0;font-family:'EB Garamond',serif;font-style:italic;font-size:21px;color:#4A4542}
  .m li .num{font-family:Geist,sans-serif;font-weight:500;font-size:13px;color:#A9452A}
  .m li .date{font-size:12px;letter-spacing:.14em;color:#8a837d}
  .m li .name{font-size:17px}
  .m li .q{margin:4px 0 0;font-family:'EB Garamond',serif;font-style:italic;font-size:17px;line-height:1.3;color:#4A4542}
  .m .socials a{width:44px;height:44px;align-items:center;justify-content:center}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
