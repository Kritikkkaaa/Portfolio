---
// /journey, "i could never do things straight!" — reached by clicking the centre photo (say hello) on the desk.
// Desktop: like the desk, a fixed 1512x982 two-page spread (split down the middle) scaled to fit the window.
// The title, then a tangle of curvy lines: one terracotta (drawn in first, so it pulls the eye) and the rest black.
// The stops of the journey sit on the terracotta line; the loops are the detours. Below 768px it is one column.
// The page turn from the desk (in index.astro, "fold") draws this page's Back, title and socials in the same places.
import Analytics from '../components/Analytics.astro';

const TWITTER = 'https://x.com/verykritikal?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const SUBSTACK = 'https://substack.com/@verykritikal/posts?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const INSTAGRAM = 'https://www.instagram.com/verykritikal/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const LINKEDIN = 'https://www.linkedin.com/in/kritika-upadhyay-2001/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const EMAIL = 'mailto:kritikaupadhyay2001@gmail.com';
const WHATSAPP = 'https://wa.me/919109079518';
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};

const socials = [
  { label: 'Twitter', href: TWITTER, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><path d="M4 4l16 16M20 4L4 20"></path></svg>' },
  { label: 'Substack', href: SUBSTACK, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M5 4h14M5 8h14M5 12h14v9l-7-4-7 4z"></path></svg>' },
  { label: 'Instagram', href: INSTAGRAM, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".8" fill="#A9452A"></circle></svg>' },
  { label: 'LinkedIn', href: LINKEDIN, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><rect x="3.5" y="3.5" width="17" height="17" rx="3"></rect><path d="M8 10.5v6M8 7.5v.1M12 16.5v-6M12 13c0-1.6 1-2.6 2.3-2.6S16.5 11.3 16.5 13v3.5"></path></svg>' },
  { label: 'Email', href: EMAIL, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path></svg>' },
  { label: 'WhatsApp', href: WHATSAPP, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M4 20l1.4-4.2A8 8 0 1 1 8.4 19z"></path><path d="M9.2 9.2c.3 2.4 2.2 4.4 4.6 4.9l1-1.1 1.6.8" stroke-linecap="round"></path></svg>' }
];

// The lines, on a 1512 x 600 canvas placed at y = LINES_Y on the spread. None of them goes straight.
const LINES_Y = 300;
const black = [
  'M-20 300 C160 200 300 420 470 330 S760 140 930 280 S1230 470 1360 330 S1480 230 1540 260',
  'M-20 410 C200 470 330 270 560 360 S860 520 1030 400 S1300 220 1540 380',
  'M-20 200 C240 150 380 330 620 250 C780 200 820 120 940 170 S1250 330 1540 180',
  'M-20 480 C120 520 260 560 380 480 S640 330 760 450 C820 510 900 540 990 500 S1320 420 1540 520'
];
// the terracotta one makes two loops on its way across
const red = 'M-20 360 C150 260 260 470 420 380 C520 320 560 220 640 250 C720 280 690 380 620 360 C540 340 600 200 740 230 C900 265 950 430 1100 400 C1200 380 1230 290 1300 300 C1370 310 1360 390 1300 385 C1240 380 1280 280 1400 290 C1460 295 1500 320 1540 330';

// Stops on the terracotta line (x, y on the line canvas); the label hangs above or below on a dotted leader.
// `at` is when the dot appears, roughly when the drawing line reaches it.
const stops = [
  { n: '01', date: 'jul 2021', name: 'TEDx', x: 200, y: 365, side: 'down', at: 0.55 },
  { n: '02', date: 'may 2022', name: 'GTM intern', x: 458, y: 354, side: 'down', at: 0.85 },
  { n: '03', date: 'mar → jul 2023', name: 'Plane', x: 631, y: 245, side: 'up', at: 1.1 },
  { n: '04', date: 'aug 2023 → may 2024', name: 'Product Marketing Engineer', x: 994, y: 387, side: 'down', at: 1.55 },
  { n: '05', date: 'jun → dec 2025', name: 'Freelancing', x: 1298, y: 385, side: 'down', at: 1.9 },
  { n: '06', date: 'aug 2025 → sep 2026', name: 'Nexus', x: 1453, y: 300, side: 'up', at: 2.15, right: true }
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · i could never do things straight!</title>
<meta name="description" content="Kritika's journey so far, which was never a straight line.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Hanken+Grotesk:wght@400;500&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#fff;color:#1C1B1F;font-family:'Hanken Grotesk',sans-serif}
a{color:#A9452A;text-decoration:none}a:hover{color:#8F3C21}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
/* the spread: same pages, gutter shadow and sheen as the desk */
.fold1{position:relative;height:100vh;overflow:hidden}
#stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}
.pageL{background:linear-gradient(100deg,#ffffff 0%,#fbfbf9 38%,#ffffff 52%,#f6f6f3 78%,#e9e8e4 96%,#d9d7d2 100%)}
.pageR{background:linear-gradient(80deg,#d6d4cf 0%,#e8e7e3 4%,#f7f7f4 20%,#ffffff 46%,#fafaf8 70%,#ffffff 100%)}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.75) 42%,rgba(255,255,255,0) 54%)}
.back{position:absolute;left:72px;top:76px;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
h1{position:absolute;left:72px;top:118px;width:600px;margin:0;font-family:Geist,sans-serif;font-weight:600;font-size:64px;line-height:1.02;letter-spacing:-.02em;color:#1C1B1F}
.socials{position:absolute;left:72px;top:864px;display:flex;gap:18px;align-items:center}
.socials a{display:flex}
.lines{position:absolute;left:0;width:1512px;height:600px;overflow:visible}
.lines path{fill:none;stroke-linecap:round;stroke-linejoin:round}
.lines .ink{stroke:#1C1B1F;stroke-width:1.1}
.lines .terra{stroke:#A9452A;stroke-width:3}
/* the terracotta line draws itself in first, then the black ones follow, faintly */
.lines .terra{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 2.2s cubic-bezier(.55,.1,.25,1) .2s forwards}
.lines .ink{stroke-dasharray:1;stroke-dashoffset:1;opacity:.55;animation:draw 2.6s cubic-bezier(.55,.1,.25,1) forwards}
.lines .ink:nth-child(1){animation-delay:1.1s}.lines .ink:nth-child(2){animation-delay:1.3s}
.lines .ink:nth-child(3){animation-delay:1.5s}.lines .ink:nth-child(4){animation-delay:1.7s}
@keyframes draw{to{stroke-dashoffset:0}}
/* stops: a dot on the line, a dotted leader, then number, date and name */
.stop{position:absolute;width:0;height:0;opacity:0;animation:stopIn .6s ease forwards}
.stop .dot{position:absolute;left:-6px;top:-6px;width:12px;height:12px;box-sizing:border-box;border-radius:50%;background:#A9452A;border:3px solid #fff;box-shadow:0 0 0 1px #A9452A}
.stop .lead{position:absolute;left:-1px;width:0;height:46px;border-left:2px dotted #A9452A}
.stop.down .lead{top:12px}.stop.up .lead{bottom:12px}
.stop .lbl{position:absolute;left:-1px;width:220px;display:flex;flex-direction:column;gap:3px;text-shadow:0 0 3px #fff,0 0 6px #fff,0 0 10px #fff}
.stop.down .lbl{top:66px}.stop.up .lbl{bottom:66px}
.stop.right .lbl{left:auto;right:-1px;align-items:flex-end;text-align:right}
.stop .num{font-family:Geist,sans-serif;font-weight:500;font-size:13px;color:#A9452A}
.stop .date{font-size:12px;letter-spacing:.14em;color:#8a837d}
.stop .name{font-size:17px;color:#1C1B1F}
@keyframes stopIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion: reduce){.lines path,.stop{animation:none;stroke-dashoffset:0;opacity:1}}

/* phones: one column on the paper */
.m{display:none}
@media (max-width: 767px){
  .fold1{display:none}
  body{background:#fbfaf7}
  .m{display:flex;flex-direction:column;min-height:100vh;min-height:100svh;box-sizing:border-box;padding:48px 16px 32px}
  .m .back{position:static;align-self:flex-start;min-height:32px;box-sizing:border-box}
  .m h1{position:static;width:auto;margin:6px 0 0;font-size:44px}
  .m .mlines{margin:24px -16px 8px;overflow:hidden}
  .m .lines{position:static;display:block;width:260%;height:auto;margin-left:-95%}
  .m .lines .ink{stroke-width:1.7}
  .m .lines .terra{stroke-width:4.4}
  .m ol{list-style:none;margin:0 0 32px;padding:0 0 0 18px;border-left:2px dotted #A9452A;display:grid;gap:22px}
  .m li{position:relative;display:flex;flex-direction:column;gap:2px}
  .m li::before{content:"";position:absolute;left:-26px;top:3px;width:12px;height:12px;box-sizing:border-box;border-radius:50%;background:#A9452A;border:3px solid #fbfaf7;box-shadow:0 0 0 1px #A9452A}
  .m .socials{position:static;margin-top:auto;gap:6px;margin-left:-12px}
  .m .socials a{width:44px;height:44px;align-items:center;justify-content:center}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold1">
<div id="stage">
<div class="pageL" aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 756px; height: 982px"></div>
<div class="pageR" aria-hidden="true" style="position: absolute; left: 756px; top: 0; width: 756px; height: 982px"></div>
<div class="sheen" aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 1512px; height: 982px; opacity: .6"></div>

<a class="back" href="/#desk">Back</a>
<h1>i could never do things straight!</h1>

<svg class="lines" viewBox="0 0 1512 600" style={`top: ${LINES_Y}px`} aria-hidden="true">
<g>{black.map((d) => <path class="ink" d={d} pathLength="1"></path>)}</g>
<path class="terra" d={red} pathLength="1"></path>
</svg>

<ol aria-label="Stops along the way" style="margin: 0; padding: 0; list-style: none">
{stops.map((s) => (
<li class={`stop ${s.side}${s.right ? ' right' : ''}`} style={`left: ${s.x}px; top: ${LINES_Y + s.y}px; animation-delay: ${s.at}s`}>
<span class="dot" aria-hidden="true"></span><span class="lead" aria-hidden="true"></span>
<span class="lbl"><span class="num">{s.n}</span><span class="date">{s.date}</span><span class="name">{s.name}</span></span>
</li>
))}
</ol>

<nav class="socials" aria-label="Socials">
{socials.map((s) => <a href={s.href} aria-label={s.label} {...ext(s.href)} set:html={s.svg}></a>)}
</nav>
</div>
</section>

<main class="m">
<a class="back" href="/#desk">Back</a>
<h1>i could never do things straight!</h1>
<div class="mlines" aria-hidden="true">
<svg class="lines" viewBox="0 0 1512 600">
<g>{black.map((d) => <path class="ink" d={d} pathLength="1"></path>)}</g>
<path class="terra" d={red} pathLength="1"></path>
</svg>
</div>
<ol aria-label="Stops along the way">
{stops.map((s) => <li><span class="num">{s.n}</span><span class="date">{s.date}</span><span class="name">{s.name}</span></li>)}
</ol>
<nav class="socials" aria-label="Socials">
{socials.map((s) => <a href={s.href} aria-label={s.label} {...ext(s.href)} set:html={s.svg}></a>)}
</nav>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// scale the 1512x982 spread to fill the window (same as the desk)
// The spread is zoomed in to cover the whole window, centred, so nothing shows beside it; the overflow is trimmed
// off the sides evenly and a little more from the bottom than the top. On very unusual window shapes it stops zooming at 18% trimmed, so Back and the socials stay in view.
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82),st=document.getElementById('stage');st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';}
addEventListener('resize',fit);fit();
</script>
</body>
</html>
