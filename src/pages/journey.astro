---
// /journey, "i could never do things straight!" — reached by clicking the centre photo (say hello) on the desk.
// Fold one: the title and a tangle of curvy lines, one terracotta (drawn in first, so it pulls the eye) and the rest black.
// Fold two will be the journey timeline (the old home's second fold), once its design is settled.
import Analytics from '../components/Analytics.astro';

const TWITTER = 'https://x.com/verykritikal?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const SUBSTACK = 'https://substack.com/@verykritikal/posts?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const INSTAGRAM = 'https://www.instagram.com/verykritikal/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const LINKEDIN = 'https://www.linkedin.com/in/kritika-upadhyay-2001/?utm_source=Portfolio&utm_medium=Footer&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const EMAIL = 'mailto:kritikaupadhyay2001@gmail.com';
const WHATSAPP = 'https://wa.me/919109079518';
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};

const socials = [
  { label: 'Twitter', href: TWITTER, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><path d="M4 4l16 16M20 4L4 20"></path></svg>' },
  { label: 'Substack', href: SUBSTACK, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M5 4h14M5 8h14M5 12h14v9l-7-4-7 4z"></path></svg>' },
  { label: 'Instagram', href: INSTAGRAM, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".8" fill="#A9452A"></circle></svg>' },
  { label: 'LinkedIn', href: LINKEDIN, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linecap="round"><rect x="3.5" y="3.5" width="17" height="17" rx="3"></rect><path d="M8 10.5v6M8 7.5v.1M12 16.5v-6M12 13c0-1.6 1-2.6 2.3-2.6S16.5 11.3 16.5 13v3.5"></path></svg>' },
  { label: 'Email', href: EMAIL, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path></svg>' },
  { label: 'WhatsApp', href: WHATSAPP, svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A9452A" stroke-width="1.8" stroke-linejoin="round"><path d="M4 20l1.4-4.2A8 8 0 1 1 8.4 19z"></path><path d="M9.2 9.2c.3 2.4 2.2 4.4 4.6 4.9l1-1.1 1.6.8" stroke-linecap="round"></path></svg>' }
];

// The lines, drawn on a 1512 x 600 canvas. None of them goes straight: they wander, cross and loop.
const black = [
  'M-20 300 C160 200 300 420 470 330 S760 140 930 280 S1230 470 1360 330 S1480 230 1540 260',
  'M-20 410 C200 470 330 270 560 360 S860 520 1030 400 S1300 220 1540 380',
  'M-20 200 C240 150 380 330 620 250 C780 200 820 120 940 170 S1250 330 1540 180',
  'M-20 480 C120 520 260 560 380 480 S640 330 760 450 C820 510 900 540 990 500 S1320 420 1540 520'
];
// the terracotta one makes two loops on its way across
const red = 'M-20 360 C150 260 260 470 420 380 C520 320 560 220 640 250 C720 280 690 380 620 360 C540 340 600 200 740 230 C900 265 950 430 1100 400 C1200 380 1230 290 1300 300 C1370 310 1360 390 1300 385 C1240 380 1280 280 1400 290 C1460 295 1500 320 1540 330';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · i could never do things straight!</title>
<meta name="description" content="Kritika's journey so far, which was never a straight line.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Hanken+Grotesk:wght@400;500&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#fbfaf7;color:#1C1B1F;font-family:'Hanken Grotesk',sans-serif}
a{color:#A9452A;text-decoration:none}a:hover{color:#8F3C21}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
.fold{position:relative;min-height:100vh;min-height:100svh;box-sizing:border-box;padding:76px 72px 56px;display:flex;flex-direction:column;overflow:hidden}
.back{align-self:flex-start;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
h1{margin:6px 0 0;max-width:760px;font-family:Geist,sans-serif;font-weight:600;font-size:64px;line-height:1.02;letter-spacing:-.02em;color:#1C1B1F}
.lines{flex:1;display:flex;align-items:center;margin:24px -72px}
.lines svg{display:block;width:100%;height:auto;overflow:visible}
.lines path{fill:none;stroke-linecap:round;stroke-linejoin:round}
.lines .ink{stroke:#1C1B1F;stroke-width:1.1}
.lines .terra{stroke:#A9452A;stroke-width:3}
/* the terracotta line draws itself in first, then the black ones follow, faintly */
.lines .terra{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 2.2s cubic-bezier(.55,.1,.25,1) .2s forwards}
.lines .ink{stroke-dasharray:1;stroke-dashoffset:1;opacity:.55;animation:draw 2.6s cubic-bezier(.55,.1,.25,1) forwards}
.lines .ink:nth-child(1){animation-delay:1.1s}.lines .ink:nth-child(2){animation-delay:1.3s}
.lines .ink:nth-child(3){animation-delay:1.5s}.lines .ink:nth-child(4){animation-delay:1.7s}
@keyframes draw{to{stroke-dashoffset:0}}
@media (prefers-reduced-motion: reduce){.lines path{animation:none;stroke-dashoffset:0}}
.socials{display:flex;gap:18px;align-items:center}
.socials a{display:flex}
@media (max-width: 767px){
  .fold{padding:48px 16px 32px}
  .back{min-height:32px}
  h1{font-size:44px}
  .lines{margin:24px -16px}
  .lines svg{width:260%;flex:none;margin-left:-95%}
  .lines .ink{stroke-width:1.7}
  .lines .terra{stroke-width:4.4}
  .socials{gap:6px;margin-left:-12px}
  .socials a{width:44px;height:44px;align-items:center;justify-content:center}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<main>
<section class="fold" aria-labelledby="title">
<a class="back" href="/#desk">Back</a>
<h1 id="title">i could never do things straight!</h1>
<div class="lines" aria-hidden="true">
<svg viewBox="0 0 1512 600" preserveAspectRatio="xMidYMid meet">
<g>
{black.map((d) => <path class="ink" d={d} pathLength="1"></path>)}
</g>
<path class="terra" d={red} pathLength="1"></path>
</svg>
</div>
<nav class="socials" aria-label="Socials">
{socials.map((s) => <a href={s.href} aria-label={s.label} {...ext(s.href)} set:html={s.svg}></a>)}
</nav>
</section>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>
</body>
</html>
