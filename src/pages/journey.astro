<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// scale the 1512x982 spread to fill the window (same as the desk)
// The spread is zoomed in to cover the whole window, centred, so nothing shows beside it; the overflow is trimmed
// off the sides evenly and a little more from the bottom than the top. On very unusual window shapes it stops zooming at 18% trimmed, so Back and the socials stay in view.
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82),st=document.getElementById('stage');st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';}
addEventListener('resize',fit);fit();

// Hovering (or tabbing to) a stop, or its cutout, lights it up and puts what it taught her in the caption.
(function(){
  var stops = document.querySelectorAll('#stage .stop'), cn = document.querySelector('[data-cap-n]'), cq = document.querySelector('[data-cap-q]');
  var hint = cq.textContent;
  function show(i){
    stops.forEach(function(s, k){ s.classList.toggle('on', k === i); });
    document.querySelectorAll('#stage .cut').forEach(function(c){ c.classList.toggle('on', +c.dataset.stop === i); });
    if (i < 0) { cn.textContent = ''; cq.textContent = hint; return; }
    cn.textContent = stops[i].dataset.n; cq.textContent = stops[i].dataset.q;
  }
  stops.forEach(function(s, i){
    s.addEventListener('mouseenter', function(){ show(i); }); s.addEventListener('focus', function(){ show(i); });
    s.addEventListener('mouseleave', function(){ show(-1); }); s.addEventListener('blur', function(){ show(-1); });
  });
  document.querySelectorAll('#stage .cut').forEach(function(c){
    var i = +c.dataset.stop, w = c.closest('.drift'); w.style.pointerEvents = 'auto';
    w.addEventListener('mouseenter', function(){ show(i); }); w.addEventListener('mouseleave', function(){ show(-1); });
  });
})();

// The cutouts, shapes and years drift a few pixels with the cursor, at different depths, so the page feels alive.
(function(){
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(hover: hover)').matches) return;
  var els = [].slice.call(document.querySelectorAll('#stage .drift')), tx = 0, ty = 0, x = 0, y = 0, raf = 0;
  function tick(){
    x += (tx - x) * 0.08; y += (ty - y) * 0.08;
    els.forEach(function(e){ var d = +e.dataset.d; e.style.translate = (x * d).toFixed(2) + 'px ' + (y * d).toFixed(2) + 'px'; });
    raf = (Math.abs(tx - x) > 0.001 || Math.abs(ty - y) > 0.001) ? requestAnimationFrame(tick) : 0;
  }
  addEventListener('mousemove', function(e){ tx = e.clientX / innerWidth * 2 - 1; ty = e.clientY / innerHeight * 2 - 1; if (!raf) raf = requestAnimationFrame(tick); });
})();
</script>
</body>
