---
// /recommendations/list: the places from /recommendations as one column of cards, filterable by city. Linked from the phone
// version of /recommendations ("directly see the list"). Same cards and page styles as /recommendations phone layout.
import Analytics from '../../components/Analytics.astro';
import { L, cityOf } from '../../data/places';
const CITIES = ['Bengaluru', 'Hyderabad', 'Goa'];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · list of reccos</title>
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@500;600&amp;family=EB+Garamond:ital,wght@0,400;1,400&amp;family=Hanken+Grotesk:wght@400;500&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#fff}
a{color:#A9452A;text-decoration:none}a:hover{color:#7E321D}
a:focus-visible,button:focus-visible{outline:2px solid #A9452A;outline-offset:4px}
.m{max-width:480px;margin:0 auto;box-sizing:border-box;padding:40px 16px 40px;font-family:'Hanken Grotesk',sans-serif;color:#1C1B1F}
.m-home{display:inline-flex;align-items:center;min-height:44px;font-size:15px;color:#A9452A;text-decoration:underline;text-underline-offset:3px}
.m h1{margin:4px 0 12px;font-family:Geist,sans-serif;font-weight:600;font-size:44px;line-height:1.02;letter-spacing:-.02em;color:#A9452A}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 24px}
.filters button{min-height:40px;padding:0 16px;border-radius:999px;border:1px solid rgba(169,69,42,.45);background:#fff;font-family:'Hanken Grotesk',sans-serif;font-size:15px;color:#A9452A;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:background-color .2s,color .2s}
.filters button[aria-pressed="true"]{background:#A9452A;border-color:#A9452A;color:#fff}
.m ul{list-style:none;margin:0;padding:0;display:grid;gap:16px}
.m li[hidden]{display:none}
.m-card{display:block;background:#fff;box-shadow:0 10px 28px rgba(70,50,35,.16),0 1px 4px rgba(70,50,35,.08);overflow:hidden;color:#1C1B1F;-webkit-tap-highlight-color:transparent}
.m-card img,.m-card video{display:block;width:100%;height:190px;object-fit:cover;background:#efece6}
.m-card .in{padding:16px 18px 18px}
.m-card .nm{margin:0;font-family:Geist,sans-serif;font-weight:600;font-size:20px;color:#A9452A}
.m-card .ar{margin:2px 0 0;font-size:13px;color:#6f6862}
.m-card .ln{margin:10px 0 0;font-family:'EB Garamond',serif;font-style:italic;font-size:18px;line-height:1.35;color:#2a2724}
.m-card .mp{display:inline-block;margin-top:12px;font-size:14px;color:#A9452A;text-decoration:underline;text-underline-offset:3px}
.m-talk{margin:0 0 20px;font-size:14px;line-height:1.5;color:#6f6862}
.m-talk a{text-decoration:underline;text-underline-offset:3px;white-space:nowrap}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<main class="m">
<a class="m-home" href="/recommendations">Back</a>
<h1>Genuine reccos.</h1>
<p class="m-talk">if you liked how i described these places, imagine what i’d write about yours. <a href="mailto:kritikaupadhyay2001@gmail.com">let’s talk</a></p>
<div class="filters" role="group" aria-label="Filter by city">
{CITIES.map((c) => <button type="button" data-city={c} aria-pressed="false">{c}</button>)}
</div>
<ul aria-label="places">
{L.map((p) => (
<li data-city={cityOf(p.area)}><a class="m-card" href={p.href} target="_blank" rel="noopener">
{p.kind === 'video'
  ? <video src={p.media} autoplay muted loop playsinline aria-label={p.alt}></video>
  : <img src={p.media} alt={p.alt} loading="lazy">}
<div class="in"><p class="nm">{p.name}</p><p class="ar">{p.area}</p><p class="ln">{p.line}</p><span class="mp">see on maps</span></div>
</a></li>
))}
</ul>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// City filter: tap a city to show only its places; tap it again to show them all.
(function(){
  var btns = document.querySelectorAll('.filters button'), items = document.querySelectorAll('.m li[data-city]');
  btns.forEach(function(b){
    b.addEventListener('click', function(){
      var on = b.getAttribute('aria-pressed') !== 'true';
      btns.forEach(function(x){ x.setAttribute('aria-pressed', x === b && on ? 'true' : 'false'); });
      items.forEach(function(li){ li.hidden = on && li.dataset.city !== b.dataset.city; });
    });
  });
})();
// make sure the card videos play muted inline
document.querySelectorAll('.m video').forEach(function(v){v.muted=true;v.play&&v.play().catch(function(){});});
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
</html>
