---
// /jobs, "work i have done." — opened from 4 on the desk (/home-redo).
// Desktop: one magazine page (1512x982, scaled to fill the window), like the desk. A soft terracotta panel on the
// left holds her skills (from her resume) in three groups. To its right: the heading on the left, a short note
// (under 100 words) on the right, then a neat grid of six in two rows: plain images (no border) and plain text.
// Hovering an image darkens all of it and shows the date, what it's about, and "Read more".
// Below 768px: one column.
import Analytics from '../components/Analytics.astro';

// the note, under 100 words: who she is, then how to read the page
const NOTE = 'i am a visual thinker who loves solving a logical problem with creativity and empathy. see my work to understand how.';
const HOWTO = 'read this like a contents page. the numbers in words are stories i lived; the pictures are the work itself. hover on a picture to see when it happened and what it was about, then click to read it whole. the skills i lean on most sit on the left. start anywhere.';

// skills, from her resume, grouped
const skills = [
  { group: 'Creatives', items: ['Positioning & messaging', 'Product copy', 'Landing pages', 'Video scripts', 'Event curation'] },
  { group: 'Technical', items: ['Go-to-market strategy', 'Competitive intelligence & battlecards', 'Activation & churn diagnosis', 'SEO & App Store optimisation', 'PostHog, Mixpanel, GA4'] },
  { group: 'People', items: ['Ideal customer profile (ICP)', 'Customer discovery (The Mom Test)', 'Developer communities', 'Partner ecosystems', 'Win-back campaigns'] }
];

// The grid, in reading order: words and pictures alternate. Swap any cell by editing this list.
// kind 'words': a story in words. kind 'pic': a case study as a picture; hover shows date + about.
const cells = [
  { kind: 'pic', title: 'Why positioning matters. How to get there?', date: 'apr 2025 → now', about: 'one page that decided who Nexus was for, what we said, and where we said it.', img: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&q=80&auto=format&fit=crop', href: '/work/icp-positioning-messaging-nexus' },
  { kind: 'words', at: 'Plane', title: 'How to build a Twitter account from scratch', line: 'Plane’s Twitter from zero: 500+ posts and 20+ release notes, in step with every release.', href: '/work/grow-planes-twitter/' },
  { kind: 'pic', title: 'How I ran a campaign for pricing launch', date: 'apr 2024', about: 'launching Plane One, a new paid plan, on Twitter: the tease, the reveal and the letter.', img: '/work/plane-one-campaign/img/reveal.jpg', href: '/work/plane-one-campaign/' },
  { kind: 'pic', title: 'How I would re-design Paper’s onboarding emails', date: 'coming soon', about: 'a teardown of Paper’s first emails: what they say, what they should, and why.', img: '/jobs/paper-envelope.png', href: '' },
  { kind: 'pic', title: 'How to build battle card for your competition', date: 'coming soon', about: 'battlecards for Nexus: who we were up against, where we won, and what to say when it came up.', img: 'https://images.unsplash.com/photo-1586165368502-1bad197a6461?w=800&q=80&auto=format&fit=crop', href: '' },
  { kind: 'words', at: 'coming soon', title: 'How to use AI for market research', line: 'the prompts, the checks and the workflow i use to understand a market fast.', href: '' }
];
// not on the page right now, kept for swapping in:
//  words: 'GitHub stars from one debate' (Plane, 82+ stars in 24 hours), 'who nexus is for, and how i got there' (/work/who-nexus-is-for),
//         'the metric that wouldn’t move' (/nexus), 'building Nexus, then selling it', 'What the Fork'
//  pictures: 'what it was like to pull off a TEDx event' (/desk/tedx-x.png, jul 2021)
// Positioning and battlecards use Unsplash photos as stand-ins (planning at a desk; two chess knights).
// grid: 3 columns x 2 rows; images are IW x IH with the caption below
const GX = [470, 840, 1210], GY = [304, 612], CW = 250, IH = 172;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · work i have done.</title>
<meta name="description" content="Kritika's work: skills, case studies and the stories behind them.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&amp;family=Hanken+Grotesk:wght@400;500&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#fff;color:#1C1B1F;font-family:'Hanken Grotesk',sans-serif}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
.fold{position:relative;height:100vh;overflow:hidden}
.stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}
.pageL{background:linear-gradient(100deg,#ffffff 0%,#fbfbf9 38%,#ffffff 52%,#f6f6f3 78%,#e9e8e4 96%,#d9d7d2 100%)}
.pageR{background:linear-gradient(80deg,#d6d4cf 0%,#e8e7e3 4%,#f7f7f4 20%,#ffffff 46%,#fafaf8 70%,#ffffff 100%)}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.75) 42%,rgba(255,255,255,0) 54%)}
.grain{position:absolute;inset:0;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.14;pointer-events:none}
.back{position:absolute;left:56px;top:62px;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
/* skills panel, a soft terracotta tint */
.panel{position:absolute;left:0;top:0;width:410px;height:982px;background:#F3E4DC}
.sk{position:absolute;left:56px;width:300px}
.sk h3{margin:0 0 10px;font-family:Geist,sans-serif;font-weight:500;font-size:15px;color:#A9452A}
.sk ul{list-style:none;margin:0;padding:0;font-size:14px;line-height:1.7;color:#4A4542}
/* heading on the left, note on the right */
h1{position:absolute;left:470px;top:92px;width:420px;margin:0;font-family:Geist,sans-serif;font-weight:600;font-size:64px;line-height:1.02;letter-spacing:-.02em;color:#1C1B1F}
.note{position:absolute;left:1000px;top:100px;width:440px;margin:0;font-size:15px;line-height:1.6;color:#4A4542}
.note .lead{display:block;margin-bottom:10px;color:#1C1B1F;font-weight:500}
/* the grid: plain images (no border) and plain text */
.cell{position:absolute;display:block}
.cell .pic{position:relative;display:block;overflow:hidden;background:#efece6}
.cell .pic img{width:100%;height:100%;object-fit:cover;display:block}
.cell .cap{display:flex;gap:8px;align-items:baseline;margin-top:10px;font-size:12px;line-height:1.35;color:#4A4542}
.cell .cap b{font-family:Geist,sans-serif;font-weight:500;color:#A9452A}
/* hover: the whole image darkens, then the date, what it's about, and Read more come up */
.cell .ov{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:18px;box-sizing:border-box;background:rgba(28,27,31,.78);color:#fff;opacity:0;transition:opacity .35s ease}
.cell .ov .d{font-size:11px;letter-spacing:.2em;color:#F3E4DC;transform:translateY(8px);transition:transform .45s cubic-bezier(.2,.7,.2,1)}
.cell .ov .a{margin-top:8px;font-size:13px;line-height:1.5;color:#f1eeea;transform:translateY(10px);transition:transform .5s cubic-bezier(.2,.7,.2,1)}
.cell .rm{display:inline-block;margin-top:14px;padding:8px 14px;border:1px solid #F3E4DC;font-size:13px;letter-spacing:.04em;color:#fff;opacity:0;transform:translateY(12px) scale(.94);transition:opacity .35s ease .08s,transform .5s cubic-bezier(.3,1.4,.5,1) .08s}
.cell:hover .ov,.cell:focus-visible .ov{opacity:1}
.cell:hover .ov .d,.cell:hover .ov .a,.cell:focus-visible .ov .d,.cell:focus-visible .ov .a{transform:none}
.cell:hover .rm,.cell:focus-visible .rm{opacity:1;transform:none}
/* words */
.cell.w{padding-top:2px}
.cell .num{display:block;font-family:Geist,sans-serif;font-weight:300;font-size:60px;line-height:1;letter-spacing:-.03em;color:#1C1B1F;transition:color .25s}
.cell .at{display:block;margin:12px 0 4px;font-size:11px;letter-spacing:.22em;color:#8a837d}
.cell .t{display:block;font-family:Geist,sans-serif;font-weight:500;font-size:16px;line-height:1.25;color:#1C1B1F}
.cell .l{display:block;margin-top:8px;font-size:13px;line-height:1.5;color:#6f6862}
.cell.w .rmw{display:inline-block;margin-top:12px;font-size:13px;color:#A9452A;text-decoration:underline;text-underline-offset:3px;opacity:0;transform:translateY(6px);transition:opacity .3s,transform .4s cubic-bezier(.3,1.4,.5,1)}
.cell.w:hover .num,.cell.w:focus-visible .num{color:#A9452A}
.cell.w:hover .rmw,.cell.w:focus-visible .rmw{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){.cell .ov,.cell .ov *,.cell .rm,.cell .rmw{transition:none}}

/* phones: one column of stamps */
.m{display:none}
@media (max-width: 767px){
  .fold{display:none}
  body{background:#fbfaf7}
  .m{display:block;padding:48px 16px 48px;box-sizing:border-box}
  .m .back{position:static;display:inline-block;min-height:32px}
  .m h1{position:static;width:auto;margin:6px 0 0;font-size:44px}
  .m .note{position:static;width:auto;margin:16px 0 0}
  .m .mskills{margin:28px -16px 0;padding:24px 16px 8px;background:#F3E4DC}
  .m .sk{position:static;width:auto;margin-bottom:18px}
  .m .mcells{display:grid;gap:28px;margin:36px 0 0}
  .m .cell{position:relative}
  .m .cell .pic{aspect-ratio:4/3}
  .m .cell .ov{position:static;opacity:1;background:none;color:#4A4542;padding:8px 0 0}
  .m .cell .ov .d{color:#8a837d;transform:none}
  .m .cell .ov .a{color:#4A4542;transform:none}
  .m .cell .rm{opacity:1;transform:none;margin-top:8px;padding:0;border:0;color:#A9452A;text-decoration:underline;text-underline-offset:3px}
  .m .cell.w .rmw{opacity:1;transform:none}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold" aria-labelledby="title">
<div class="stage">
<div class="pageL" aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 756px; height: 982px"></div>
<div class="pageR" aria-hidden="true" style="position: absolute; left: 756px; top: 0; width: 756px; height: 982px"></div>
<div class="sheen" aria-hidden="true" style="position: absolute; inset: 0; opacity: .6"></div>
<aside class="panel" aria-label="skills">
<a class="back" href="/home-redo#desk">Back</a>
{skills.map((g, i) => (
<div class="sk" style={`top: ${170 + i * 250}px`}>
<h3>{g.group}</h3>
<ul>{g.items.map((it) => <li>{it}</li>)}</ul>
</div>
))}
</aside>
<div class="grain" aria-hidden="true"></div>
<h1 id="title">work i have done.</h1>
<p class="note"><span class="lead">{NOTE}</span>{HOWTO}</p>
{cells.map((c, i) => {
  const n = String(i + 1).padStart(2, '0');
  const st = `left: ${GX[i % 3]}px; top: ${GY[Math.floor(i / 3)]}px; width: ${CW}px`;
  const more = c.href ? 'Read more' : 'coming soon';
  const inner = c.kind === 'words'
    ? <><span class="num">{n}</span><span class="at">{c.at}</span><span class="t">{c.title}</span><span class="l">{c.line}</span><span class="rmw">{more}</span></>
    : <><span class="pic" style={`height: ${IH}px`}><img src={c.img} alt="" loading="lazy"><span class="ov"><span class="d">{c.date}</span><span class="a">{c.about}</span><span class="rm">{more}</span></span></span><span class="cap"><b>{n}</b><span>{c.title}</span></span></>;
  const cls = `cell ${c.kind === 'words' ? 'w' : 'p'}`;
  return c.href ? <a class={cls} href={c.href} style={st}>{inner}</a> : <div class={cls} tabindex="0" style={st}>{inner}</div>;
})}
</div>
</section>

<main class="m">
<a class="back" href="/home-redo#desk">Back</a>
<h1>work i have done.</h1>
<p class="note"><span class="lead">{NOTE}</span>{HOWTO}</p>
<section class="mskills" aria-label="skills">
{skills.map((g) => <div class="sk"><h3>{g.group}</h3><ul>{g.items.map((it) => <li>{it}</li>)}</ul></div>)}
</section>
<div class="mcells">
{cells.map((c, i) => {
  const n = String(i + 1).padStart(2, '0');
  const more = c.href ? 'Read more' : 'coming soon';
  const inner = c.kind === 'words'
    ? <><span class="num">{n}</span><span class="at">{c.at}</span><span class="t">{c.title}</span><span class="l">{c.line}</span><span class="rmw">{more}</span></>
    : <><span class="pic"><img src={c.img} alt="" loading="lazy"></span><span class="cap"><b>{n}</b><span>{c.title}</span></span><span class="ov"><span class="d">{c.date}</span><span class="a">{c.about}</span><span class="rm">{more}</span></span></>;
  const cls = `cell ${c.kind === 'words' ? 'w' : 'p'}`;
  return c.href ? <a class={cls} href={c.href}>{inner}</a> : <div class={cls}>{inner}</div>;
})}
</div>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// the page is zoomed to cover the window, like the desk (stops at 18% trimmed on unusual window shapes)
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82);document.querySelectorAll('.stage').forEach(function(st){st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';});}
addEventListener('resize',fit);fit();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
</html>
