---
// /jobs, "work i have done." — opened from 4 on the desk (/home-redo).
// Desktop: one magazine spread (1512x982, scaled to fill the window), like the desk.
//  Right page: the top half is the heading ("case files."), set huge; the bottom half splits into two quarters, the left one
//  the whole "Why positioning matters" picture (the chess linocut, zoomed to fill), the right one her skills.
//  Left page: a grid of 2 columns x 3 rows: 02 spans both columns, then 03 and 04, then 05 on its own.
//  Each has a picture (15:20, or wide), its number, section name and title. Pictures are black and white;
//  hovering darkens the picture and shows "Read more".
// Below 768px: one column.
import Analytics from '../components/Analytics.astro';

// a line under the heading
const DEK = 'proof that overthinking can be a skill.';

const skills = [
  { group: 'Creatives', items: ['Positioning & messaging', 'Product copy', 'Landing pages'] },
  { group: 'Technical', items: ['Go-to-market strategy', 'Competitive intelligence & battlecards', 'Activation & churn diagnosis'] },
  { group: 'People', items: ['Ideal customer profile (ICP)', 'Customer discovery (The Mom Test)', 'Developer communities'] }
];

// the case studies on the left page (01, positioning, is the big picture on the right page).
// n is the number shown; wide spans both columns.
const cells = [
  { n: '02', kicker: 'Field Notes', title: 'How to build a Twitter account from scratch', date: 'mar 2023 → may 2024', about: 'Plane’s Twitter from zero: 500+ posts and 20+ release notes, in step with every release.', img: '/jobs/twitter-network.webp', href: '/work/grow-planes-twitter/', wide: true },
  { n: '03', kicker: 'The Campaign', title: 'How I ran a campaign for pricing launch', date: 'apr 2024', about: 'launching Plane One, a new paid plan, on Twitter: the tease, the reveal and the letter.', img: '/jobs/pricing-invoice.webp', href: '/work/plane-one-campaign/' },
  { n: '04', kicker: 'The Teardown', title: 'How I would re-design Paper’s onboarding emails', date: 'coming soon', about: 'a teardown of Paper’s first emails: what they say, what they should, and why.', img: '/jobs/paper-envelope.png', href: '' },
  { n: '05', kicker: 'The Interview', title: 'how do i use AI in market research', date: 'coming soon', about: 'the prompts, the checks and the workflow i use to understand a market fast.', img: '/jobs/ai-scribble.webp', href: '' }
];
// left page grid: 2 columns x 3 rows; row 1 is the wide one, row 2 two side by side, row 3 one on the left.
// pictures are 15:20 (IW x IH); the wide one is WW x IH.
const PLACES = [[72, 118], [72, 380], [404, 380], [72, 642]];
const IW = 138, IH = 184, WW = 420;
// the big positioning picture, bottom-left quarter of the right page
const FEATURE = { kicker: 'The Briefing', title: 'Why positioning matters. How to get there?', img: '/jobs/chess-linocut.png', href: '/work/icp-positioning-messaging-nexus', date: 'apr 2025 → now', about: 'one page that decided who Nexus was for, what we said, and where we said it.' };
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · case files.</title>
<meta name="description" content="Kritika's work: case studies, the stories behind them, and the skills she leans on.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&amp;family=Geist:wght@300;400;500;600&amp;family=Hanken+Grotesk:wght@400;500&amp;family=EB+Garamond:ital@1&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#fff;color:#1C1B1F;font-family:'Hanken Grotesk',sans-serif}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
.fold{position:relative;height:100vh;overflow:hidden}
.stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}
.pageL{background:linear-gradient(100deg,#ffffff 0%,#fbfbf9 38%,#ffffff 52%,#f6f6f3 78%,#e9e8e4 96%,#d9d7d2 100%)}
.pageR{background:linear-gradient(80deg,#d6d4cf 0%,#e8e7e3 4%,#f7f7f4 20%,#ffffff 46%,#fafaf8 70%,#ffffff 100%)}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.75) 42%,rgba(255,255,255,0) 54%)}
.grain{position:absolute;inset:0;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.14;pointer-events:none}
.back{position:absolute;left:72px;top:56px;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
.rule{position:absolute;background:rgba(28,27,31,.18)}
.folio{position:absolute;top:930px;margin:0;font-size:11px;letter-spacing:.2em;color:#8a837d}
/* right page, top half: the heading, huge */
h1{position:absolute;left:812px;top:52px;width:660px;margin:0;font-family:Anton,'Geist',sans-serif;font-weight:400;font-size:212px;line-height:.9;letter-spacing:-.005em;color:#1C1B1F}
.dek{position:absolute;left:812px;top:444px;margin:0;font-family:'EB Garamond',serif;font-style:italic;font-size:22px;color:#A9452A}
/* right page, bottom-left quarter: the positioning picture */
.feat{position:absolute;left:812px;top:512px;width:300px;height:398px;display:block;overflow:hidden;background:#111}
.feat img{width:100%;height:100%;object-fit:cover;object-position:50% 38%;display:block;transform:scale(1.12);transition:transform .9s cubic-bezier(.2,.7,.2,1)}
.feat .lbl{position:absolute;left:0;right:0;bottom:0;padding:22px 16px 16px;background:linear-gradient(0deg,rgba(17,17,17,.96) 0%,rgba(17,17,17,.96) 72%,rgba(17,17,17,0) 100%);color:#fff}
.feat .lbl .k{display:block;font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#E6A58C}
.feat .lbl .t{display:block;margin-top:4px;font-family:Geist,sans-serif;font-weight:500;font-size:16px;line-height:1.25}
/* right page, bottom-right quarter: skills */
.skills{position:absolute;left:1162px;top:512px;width:290px}
.sk{margin:0 0 26px}
.sk h3{margin:0 0 8px;font-family:Geist,sans-serif;font-weight:500;font-size:14px;letter-spacing:.02em;color:#A9452A}
.sk ul{list-style:none;margin:0;padding:0;font-size:13px;line-height:1.6;color:#4A4542}
/* left page: the case-study grid */
.cell{position:absolute;display:flex;gap:18px;width:300px}
.cell .pic{position:relative;flex:none;overflow:hidden;background:#efece6}
.cell .pic img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cell .pic .duo{position:absolute;inset:0;transition:opacity .5s ease}
.cell .pic .duo img{filter:grayscale(1) contrast(1.05)}
.cell .txt{display:flex;flex-direction:column;padding-top:2px}
.cell .num{font-family:Anton,'Geist',sans-serif;font-size:40px;line-height:1;color:#1C1B1F;transition:color .25s}
.cell .k{margin-top:10px;font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#A9452A}
.cell .t{margin-top:6px;font-family:Geist,sans-serif;font-weight:500;font-size:15px;line-height:1.3;color:#1C1B1F}
/* hover: the picture blooms into colour under a full overlay with the date, the line, and Read more */
.ov{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:12px;box-sizing:border-box;background:rgba(28,27,31,.8);color:#fff;opacity:0;transition:opacity .35s ease}
.ov .d{font-size:9px;letter-spacing:.2em;color:#F3E4DC}
.ov .a{margin-top:5px;font-size:11px;line-height:1.4;color:#f1eeea}
.ov .rm{padding:7px 14px;border:1px solid #F3E4DC;font-size:13px;color:#fff;opacity:0;transform:translateY(8px) scale(.94);transition:opacity .3s ease .08s,transform .45s cubic-bezier(.3,1.4,.5,1) .08s}
.cell:hover .duo,.cell:focus-visible .duo{opacity:0}
.cell:hover .ov,.cell:focus-visible .ov,.feat:hover .ov,.feat:focus-visible .ov{opacity:1}
.cell:hover .rm,.cell:focus-visible .rm,.feat:hover .rm,.feat:focus-visible .rm{opacity:1;transform:none}
.cell:hover .num,.cell:focus-visible .num{color:#A9452A}
.feat .ov{padding:18px;justify-content:center}
.feat .ov .rm{font-size:14px;padding:9px 16px}
.feat:hover img,.feat:focus-visible img{transform:scale(1.18)}
@media (prefers-reduced-motion: reduce){.ov,.ov .rm,.cell .pic .duo,.feat img{transition:none}}

/* phones: one column */
.m{display:none}
@media (max-width: 767px){
  .fold{display:none}
  body{background:#fbfaf7}
  .m{display:block;padding:48px 16px 48px;box-sizing:border-box}
  .m .back{position:static;display:inline-block;min-height:32px}
  .m h1{position:static;width:auto;margin:10px 0 0;font-size:110px}
  .m .dek{position:static;margin:10px 0 0;font-size:20px}
  .m .feat{position:relative;left:auto;top:auto;width:auto;height:340px;margin:24px 0 0}
  .m .feat .ov{display:none}
  .m .skills{position:static;width:auto;margin:28px 0 0}
  .m .mcells{display:grid;gap:22px;margin:32px 0 0}
  .m .cell{position:relative;width:auto}
  .m .cell .ov{display:none}
  .m .cell .a2{margin-top:6px;font-size:13px;line-height:1.45;color:#6f6862}
  .m .cell .rm2{margin-top:6px;font-size:13px;color:#A9452A;text-decoration:underline;text-underline-offset:3px}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold" aria-labelledby="title">
<div class="stage">
<div class="pageL" aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 756px; height: 982px"></div>
<div class="pageR" aria-hidden="true" style="position: absolute; left: 756px; top: 0; width: 756px; height: 982px"></div>
<div class="sheen" aria-hidden="true" style="position: absolute; inset: 0; opacity: .6"></div>
<div class="grain" aria-hidden="true"></div>

<a class="back" href="/home-redo#desk">Back</a>

<!-- left page: the case studies -->
{cells.map((c, i) => {
  const more = c.href ? 'Read more' : 'coming soon';
  const inner = <>
    <span class="pic" style={`width: ${c.wide ? WW : IW}px; height: ${IH}px`}><img src={c.img} alt="" loading="lazy"><span class="duo" aria-hidden="true"><img src={c.img} alt="" loading="lazy"></span><span class="ov"><span class="rm">{more}</span></span></span>
    <span class="txt"><span class="num">{c.n}</span><span class="k">{c.kicker}</span><span class="t">{c.title}</span></span>
  </>;
  const st = `left: ${PLACES[i][0]}px; top: ${PLACES[i][1]}px${c.wide ? '; width: 632px' : ''}`;
  return c.href ? <a class="cell" href={c.href} style={st}>{inner}</a> : <div class="cell" tabindex="0" style={st}>{inner}</div>;
})}
<p class="folio" style="left: 72px">case files · p. 01</p>

<!-- right page -->
<h1 id="title">case<br>files.</h1>
<p class="dek">{DEK}</p>
<span class="rule" aria-hidden="true" style="left: 812px; top: 486px; width: 640px; height: 1px"></span>
<a class="feat" href={FEATURE.href}>
<img src={FEATURE.img} alt="a black and white linocut of a chess board with figures" loading="lazy">
<span class="lbl"><span class="k">{FEATURE.kicker}</span><span class="t">{FEATURE.title}</span></span>
<span class="ov"><span class="rm">Read more</span></span>
</a>
<span class="rule" aria-hidden="true" style="left: 1137px; top: 512px; width: 1px; height: 398px"></span>
<aside class="skills" aria-label="skills">
{skills.map((g) => <div class="sk"><h3>{g.group}</h3><ul>{g.items.map((it) => <li>{it}</li>)}</ul></div>)}
</aside>
<p class="folio" style="left: 1340px">p. 02</p>

<svg width="0" height="0" style="position: absolute" aria-hidden="true"><filter id="duotone" color-interpolation-filters="sRGB"><feColorMatrix type="saturate" values="0"></feColorMatrix><feComponentTransfer><feFuncR type="table" tableValues="0.11 0.66 0.95"></feFuncR><feFuncG type="table" tableValues="0.106 0.27 0.89"></feFuncG><feFuncB type="table" tableValues="0.12 0.165 0.86"></feFuncB></feComponentTransfer></filter></svg>
</div>
</section>

<main class="m">
<a class="back" href="/home-redo#desk">Back</a>
<h1>case files.</h1>
<p class="dek">{DEK}</p>
<a class="feat" href={FEATURE.href}><img src={FEATURE.img} alt="a black and white linocut of a chess board with figures" loading="lazy"><span class="lbl"><span class="k">{FEATURE.kicker}</span><span class="t">{FEATURE.title}</span></span></a>
<aside class="skills" aria-label="skills">
{skills.map((g) => <div class="sk"><h3>{g.group}</h3><ul>{g.items.map((it) => <li>{it}</li>)}</ul></div>)}
</aside>
<div class="mcells">
{cells.map((c, i) => {
  const inner = <>
    <span class="pic" style={`width: ${IW}px; height: ${IH}px`}><img src={c.img} alt="" loading="lazy"><span class="duo" aria-hidden="true"><img src={c.img} alt="" loading="lazy"></span></span>
    <span class="txt"><span class="num">{c.n}</span><span class="k">{c.kicker}</span><span class="t">{c.title}</span><span class="a2">{c.date} · {c.about}</span><span class="rm2">{c.href ? 'Read more' : 'coming soon'}</span></span>
  </>;
  return c.href ? <a class="cell" href={c.href}>{inner}</a> : <div class="cell">{inner}</div>;
})}
</div>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// the spread is zoomed to cover the window, like the desk (stops at 18% trimmed on unusual window shapes)
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82);document.querySelectorAll('.stage').forEach(function(st){st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';});}
addEventListener('resize',fit);fit();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
</html>
