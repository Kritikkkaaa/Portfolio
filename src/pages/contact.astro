---
// /contact, "Let's talk!" — opened from the rotary phone on the desk (the home page, /).
// Desktop: one magazine spread (1512x982, scaled to fill the window), a 6x3 grid of tiles:
//  row 1: TALK, then three questions. row 2: X, Email, LinkedIn, a question, a drawing (phone), a question.
//  row 3: a drawing (laptop), Instagram, a drawing (conversation), then FAQs.
//  Channels are line-icon tiles (hovering shows just the button). A question zooms on hover or tap to show its answer.
// Below 768px: a note that the page is best on desktop, the channels as square tiles two to a row (tap shows the
// note, tap again opens), then the questions, then the three pictures.
import Analytics from '../components/Analytics.astro';

const UTM = 'utm_source=Portfolio&utm_medium=Lets+talk&utm_campaign=Portfolio+launch&utm_id=kritikal-work';
const INK = '#6E1E2B';
const icon = (inner: string, extra = '') => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${INK}" stroke-width="1.8" ${extra}>${inner}</svg>`;

// the channels. `btn` is the button shown on hover.
const ch = {
  linkedin: { btn: 'me too!', name: 'LinkedIn', href: `https://www.linkedin.com/in/kritika-upadhyay-2001/?${UTM}`, svg: icon('<rect x="3.5" y="3.5" width="17" height="17" rx="3"></rect><path d="M8 10.5v6M8 7.5v.1M12 16.5v-6M12 13c0-1.6 1-2.6 2.3-2.6S16.5 11.3 16.5 13v3.5"></path>', 'stroke-linecap="round"') },
  x: { btn: 'yes', name: 'X', href: `https://x.com/verykritikal?${UTM}`, svg: icon('<path d="M4 4l11.7 16H20L8.3 4z"></path><path d="M4.4 20l6.4-7.1M13.2 10.2L19.6 4"></path>', 'stroke-linecap="round" stroke-linejoin="round"') },
  instagram: { btn: 'ooooh! interesting.', name: 'Instagram', href: `https://www.instagram.com/verykritikal/?${UTM}`, svg: icon(`<rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".8" fill="${INK}"></circle>`) },
  email: { btn: 'Yes.', name: 'Email', href: 'mailto:kritikaupadhyay2001@gmail.com', svg: icon('<rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path>', 'stroke-linejoin="round"') },
};
const channels = [ch.x, ch.email, ch.linkedin, ch.instagram];
// the same icon, drawn big and thin for the tiles
const big = (svg: string) => svg.replace('width="16" height="16"', 'width="84" height="84"').replace('stroke-width="1.8"', 'stroke-width="1.05"');

// the FAQs, in her words.
const faqs = [
  { q: 'are you open to freelance projects?', a: 'depends on the project. tell me what it is and we’ll see.' },
  { q: 'what can you do?', a: 'marketer, writer, creative. ex product manager. stories, films, campaigns, landing pages and a grown Twitter.' },
  { q: 'how do i know you are good?', a: 'you don’t. check the site, trust your gut, call me.' },
  { q: 'when can you join us?', a: 'the moment you say “welcome aboard!”' },
  { q: 'what kind of teams do you work best with?', a: 'small product teams that ship fast and let people try things. startups, mostly. i grew up in them.' }
];

// the spread: 6 tiles across (3 per page), 3 rows. A band (TALK, FAQs) spans its page's 3 tiles and doesn't zoom.
// `col`/`row` place each tile so the zoom grows inward from its spot on the page.
type Tile = { band?: string; art?: string; ch?: typeof ch.x; faq?: number; bg: string; col: number; row: number };
const W = '#f6f1e8', T = '#6E1E2B';
// the three pictures (public/contact/): `art` tiles. White-background drawings, so they blend into the cream tile.
const ART: Record<string, { src: string }> = {
  laptop: { src: '/contact/laptop.webp' },
  conversation: { src: '/contact/conversation.webp' },
  phone: { src: '/contact/phone.webp' }
};
const tiles: Tile[] = [
  { band: 'TALK', bg: W, col: 0, row: 0 }, { faq: 0, bg: T, col: 3, row: 0 }, { faq: 1, bg: T, col: 4, row: 0 }, { faq: 2, bg: T, col: 5, row: 0 },
  { ch: ch.x, bg: W, col: 0, row: 1 }, { ch: ch.email, bg: W, col: 1, row: 1 }, { ch: ch.linkedin, bg: W, col: 2, row: 1 }, { faq: 3, bg: T, col: 3, row: 1 }, { art: 'phone', bg: W, col: 4, row: 1 }, { faq: 4, bg: T, col: 5, row: 1 },
  { art: 'laptop', bg: W, col: 0, row: 2 }, { ch: ch.instagram, bg: W, col: 1, row: 2 }, { art: 'conversation', bg: W, col: 2, row: 2 }, { band: 'FAQs', bg: W, col: 3, row: 2 }
];
const origin = (t: Tile) => `${['left', 'center', 'right'][t.col % 3]} ${['top', 'center', 'bottom'][t.row]}`;
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · Let's talk!</title>
<meta name="description" content="Where to find Kritika (X, Instagram, LinkedIn and email), and a few FAQs.">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&amp;family=EB+Garamond:ital,wght@0,400;0,500;1,400&amp;family=Courier+Prime:wght@400;700&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#f6f1e8;color:#6E1E2B;font-family:Cinzel,serif}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:2px solid #6E1E2B;outline-offset:-4px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.fold{position:relative;height:100vh;overflow:hidden;background:#f6f1e8}
.stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}

/* the spread: 6 x 3 tiles, 3 per page */
.grid{position:absolute;inset:0;display:grid;grid-template-columns:repeat(6,1fr);grid-template-rows:repeat(3,1fr)}
.tl{position:relative;box-shadow:inset -1px -1px 0 rgba(90,22,38,.12)}
.tl.bd{grid-column:span 3;display:flex;align-items:center;justify-content:center;font-family:Cinzel,serif;font-weight:500;font-size:200px;line-height:1;letter-spacing:.02em;color:#6E1E2B;align-items:center;justify-content:center}
/* TALK carries a cover line */
.talk .cover{position:absolute;right:96px;bottom:44px;margin:0;font-family:'EB Garamond',serif;font-style:italic;font-weight:400;font-size:30px;line-height:1;letter-spacing:.01em;color:rgba(110,30,43,.78);transform:rotate(-3deg)}
.talk .cover svg{display:block;width:100%;height:8px;margin-top:3px}
/* picture tiles */
.tl.art{box-shadow:none;overflow:hidden}
.tl.art img,.m .strip .art img{position:absolute;inset:9%;width:82%;height:82%;object-fit:contain;display:block;mix-blend-mode:multiply}
/* every interactive tile zooms in place */
.z{position:absolute;inset:0;display:flex;flex-direction:column;box-sizing:border-box;border:0;margin:0;padding:0;font:inherit;color:inherit;text-align:left;cursor:pointer;z-index:1;transition:transform .5s cubic-bezier(.2,.7,.2,1),box-shadow .4s ease}
.z:hover,.z:focus-visible,.z.open{transform:scale(1.5);z-index:5;box-shadow:0 18px 40px rgba(50,12,22,.3)}
/* channel tiles: a thin line icon with the platform under it. No zoom: hovering shows a note and a button. */
.chn{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;cursor:pointer}
.chn .ov{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;background:rgba(90,22,38,.93);color:#f6f1e8;opacity:0;transition:opacity .25s ease}
.chn:hover .ov,.chn:focus-visible .ov{opacity:1}
.chn .btn{display:inline-flex;align-items:center;min-height:38px;padding:0 18px;border-radius:999px;background:#f6f1e8;color:#5a1626;font-family:Cinzel,serif;font-weight:600;font-size:13px;letter-spacing:.06em}
.chn .btn::after{content:'\2192';margin-left:8px}
.chn .ic{display:block;line-height:0}
.chn .ic svg{display:block}
.chn .tag{font-family:'Courier Prime',monospace;font-weight:700;font-size:16px;letter-spacing:.2em;text-transform:uppercase;color:#6E1E2B}
/* question tiles: a checkbox, the question, and the answer once the tile is open */
.qa{padding:28px 24px;color:#f6f1e8}
.qa:focus-visible{outline-color:#f6f1e8}
.qa .qh{display:flex;align-items:flex-start;gap:14px}
.qa .cb{position:relative;flex:none;width:22px;height:22px;margin-top:6px;box-sizing:border-box;border:2px solid #f6f1e8;border-radius:4px}
.qa:hover .cb::after,.qa:focus-visible .cb::after,.qa.open .cb::after{content:'';position:absolute;left:5px;top:0;width:6px;height:12px;border:solid #f6f1e8;border-width:0 2px 2px 0;transform:rotate(45deg)}
.qa .q{display:block;font-family:'EB Garamond',serif;font-weight:500;font-size:29px;line-height:1.16;color:#fffaf0}
.qa .a{display:block;white-space:pre-line;margin:14px 0 0 36px;font-family:'EB Garamond',serif;font-size:19px;line-height:1.35;color:#fffaf0;opacity:0;transition:opacity .3s ease}
.qa:hover .a,.qa:focus-visible .a,.qa.open .a{opacity:1;transition-delay:.12s}
@media (prefers-reduced-motion: reduce){.z,.qa .a,.chn .ov{transition:none}}
/* paper: the fold down the middle, a soft sheen and grain over the whole spread */
.spine{position:absolute;left:calc(50% - 40px);top:0;width:80px;height:100%;pointer-events:none;z-index:6;background:linear-gradient(90deg,rgba(0,0,0,0) 0%,rgba(60,30,20,.06) 42%,rgba(60,30,20,.13) 50%,rgba(255,255,255,.10) 54%,rgba(0,0,0,0) 100%)}
.sheen{position:absolute;inset:0;pointer-events:none;z-index:6;background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.22) 42%,rgba(255,255,255,0) 54%)}
.grain{position:absolute;inset:0;pointer-events:none;z-index:6;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.16}
.back{position:absolute;left:30px;top:26px;z-index:7;padding:6px 0;font-family:'EB Garamond',serif;font-size:19px;color:#6E1E2B;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}

/* phones: one column */
.m{display:none}
@media (max-width: 767px){
  .fold{display:none}
  .m{display:block;padding:48px 16px 40px;box-sizing:border-box}
  .m .back{position:static;display:inline-block;min-height:32px}
  .m h2{margin:22px 0 14px;font-family:'EB Garamond',serif;font-weight:500;font-size:30px}
  .m .list{display:grid;gap:14px}
  .m .z{position:relative;inset:auto}
  .m .z:hover,.m .z:focus-visible,.m .z.open{transform:none;box-shadow:none}
  .m .chn{position:relative;inset:auto;height:220px}
  /* channels: square tiles, two to a row. The first tap shows the note and button, a second tap opens it. */
  .m .list.sq{grid-template-columns:1fr 1fr;gap:10px}
  .m .sq .chn{height:auto;aspect-ratio:1}
  .m .sq .chn{gap:14px}
  .m .sq .chn .ic svg{width:56px;height:56px}
  .m .sq .chn .tag{font-size:12px;letter-spacing:.16em}
  .m .sq .chn .ov{gap:10px;padding:14px 12px;pointer-events:none}
  .m .sq .chn.on .ov{opacity:1}
  .m .sq .chn:hover .ov{opacity:0}
  .m .sq .chn.on:hover .ov{opacity:1}
  .m .sq   .m .sq .chn .btn{min-height:32px;padding:0 11px;font-size:11px;letter-spacing:.02em;white-space:nowrap}
  .m .sq .chn .btn::after{margin-left:6px}
  /* the desktop-mode note */
  .m .dm{display:flex;align-items:center;gap:12px;margin:18px 0 4px;padding:14px 16px;border:1px solid rgba(110,30,43,.35);border-radius:14px;background:#f6f1e8;font-size:15px;line-height:1.4;color:#6E1E2B;animation:dmIn .7s cubic-bezier(.2,.7,.2,1) .3s both}
  .m .dm svg{flex:none;animation:dmNod 1.6s ease-in-out 1.1s 2}
  .m .dm a{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
  @keyframes dmIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
  @keyframes dmNod{0%,100%{transform:none}30%{transform:rotate(-8deg)}60%{transform:rotate(6deg)}}
  @media (prefers-reduced-motion: reduce){.m .dm,.m .dm svg{animation:none}}
  .m .qa{padding:20px 18px}
  .m .qa .q{font-size:26px}
  .m .qa .a{margin-left:36px}
  .m .strip{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
  .m .strip .art{position:relative;display:block;aspect-ratio:252/327;overflow:hidden}
  .m .qa .a{display:none;font-size:13px;opacity:1}
  .m .qa.open .a{display:block}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold" aria-label="Let's talk!">
<div class="stage">
<h1 class="sr">Let's talk!</h1>
<div class="grid">
{tiles.map((t) => {
  const o = `transform-origin: ${origin(t)}; background: ${t.bg}`;
  if (t.band === 'TALK') return <div class="tl bd talk"><span aria-hidden="true">TALK</span><p class="cover">pick your stage, darling!<svg viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9c60-6 140-8 296-3" fill="none" stroke="#6E1E2B" stroke-width="2.4" stroke-linecap="round"/></svg></p></div>;
  if (t.band) return <div class="tl bd" aria-hidden="true">{t.band}</div>;
  if (t.art) { const a = ART[t.art]; return <div class="tl art" style="background: #f6f1e8" aria-hidden="true"><img src={a.src} alt="" loading="lazy" decoding="async"></div>; }
  if (t.ch) return <div class="tl"><a class="chn" href={t.ch.href} aria-label={`${t.ch.name}: ${t.ch.btn}`} style={`background: ${t.bg}`} {...ext(t.ch.href)}><span class="ic" aria-hidden="true"><Fragment set:html={big(t.ch.svg)} /></span><span class="tag">{t.ch.name}</span><span class="ov" aria-hidden="true"><span class="btn">{t.ch.btn}</span></span></a></div>;
  const f = faqs[t.faq!];
  return <div class="tl"><button class="z qa" type="button" aria-expanded="false" style={o}><span class="qh"><i class="cb" aria-hidden="true"></i><span class="q">{f.q}</span></span><span class="a">{f.a}</span></button></div>;
})}
</div>
<div class="spine" aria-hidden="true"></div>
<div class="sheen" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>
<a class="back" href="/#desk">Back</a>
</div>
</section>

<main class="m">
<a class="back" href="/#desk">Back</a>
<h1 class="sr">Let's talk!</h1>
<p class="dm"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6E1E2B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="11" rx="1.5"></rect><path d="M2 19h20"></path></svg><span>This page is best experienced in <a href="https://www.google.com/search?q=how+to+enable+desktop+mode" target="_blank" rel="noopener">desktop mode</a>.</span></p>
<h2>i can be found on...</h2>
<div class="list sq">
{channels.map((c) => <a class="z chn" href={c.href} aria-label={`${c.name}: ${c.btn}`} style="background: #f6f1e8" {...ext(c.href)}><span class="ov" aria-hidden="true"><span class="btn">{c.btn}</span></span><span class="ic" aria-hidden="true"><Fragment set:html={big(c.svg)} /></span><span class="tag">{c.name}</span></a>)}
</div>
<h2>FAQs</h2>
<div class="list">
{faqs.map((f) => <button class="z qa" type="button" aria-expanded="false" style={`background: ${T}`}><span class="qh"><i class="cb" aria-hidden="true"></i><span class="q">{f.q}</span></span><span class="a">{f.a}</span></button>)}
</div>
<div class="strip" aria-hidden="true">{['laptop', 'phone', 'conversation'].map((k) => <span class="art" style="background: #f6f1e8"><img src={ART[k].src} alt="" loading="lazy" decoding="async"></span>)}</div>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// phones: the first tap on a channel shows its note and button; a second tap opens it
document.querySelectorAll('.m .sq .chn').forEach(function(a){a.addEventListener('click',function(e){if(a.classList.contains('on'))return;e.preventDefault();document.querySelectorAll('.m .sq .chn.on').forEach(function(o){o.classList.remove('on')});a.classList.add('on')})});
document.addEventListener('click',function(e){if(!(e.target.closest&&e.target.closest('.m .sq .chn')))document.querySelectorAll('.m .sq .chn.on').forEach(function(o){o.classList.remove('on')})});
addEventListener('pageshow',function(){document.querySelectorAll('.m .sq .chn.on').forEach(function(o){o.classList.remove('on')})});
// tap (or click) a question to keep it open; opening another closes the last one
document.querySelectorAll('.qa').forEach(function(b){b.addEventListener('click',function(){var was=b.classList.contains('open');document.querySelectorAll('.qa.open').forEach(function(o){o.classList.remove('open');o.setAttribute('aria-expanded','false')});if(!was){b.classList.add('open');b.setAttribute('aria-expanded','true')}})});
// the spread fills the window exactly: scaled to fit, then the grid stretches to the window's shape, so no row is ever cut off
function fit(){var s=Math.min(innerWidth/1512,innerHeight/982);document.querySelectorAll('.stage').forEach(function(st){st.style.transform='scale('+s+')';st.style.width=(innerWidth/s)+'px';st.style.height=(innerHeight/s)+'px';});}
addEventListener('resize',fit);fit();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
</html>
