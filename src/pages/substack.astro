---
// /substack (was /substacks, which redirects here), "i write on Substack." — opened from the typewriter on the home page (/).
// Desktop: one magazine spread (1512x982, scaled to fill the window), like /jobs.
//  Right page: pink paper with a typewriter at its foot; her story types itself onto the sheet in the roller.
//  Left page: her jasmine-tree photo, mirrored, with every post as a picture, three across.
// Below 768px: one column.
// Posts are pulled from Substack's public archive at build time, so titles, covers and dates stay current.
// Descriptions are set by hand in `posts` below (`desc`); a new post that isn't listed there uses its Substack subtitle.
import Analytics from '../components/Analytics.astro';

const PUB = 'https://verykritikal.substack.com';
// the call to action under the story
const CTA = 'Let me write something for you →';
const CTA_HREF = '/contact';
// the second button, under the first
const WORK_CTA = 'See my work →';
const WORK_HREF = '/work';
const UTM = 'utm_source=Portfolio&utm_medium=Substacks+page&utm_campaign=Portfolio+launch&utm_id=kritikal-work';

// the letter on the typewriter: how she started, in a few short lines.
const STORY = [
  'Writing on Substack started as a joke. I came back from Pondicherry with something too tender for an Instagram caption, so I wrote it down instead.',
  'Some of it is funny, some of it is hard to read. All of it is the most honest version of me on the internet.',
  'Writing like this is how I learn what to say, and how, in my marketing.'
];
const INITIAL = STORY[0][0];

// the three pictures across the top of the left page
const TOP = ['gunshot-diary', 'was-he-a-fckboy', 'love-is-usually-just-around-the-corner'];

// posts left out of the list on the right (and on phones)
const HIDE = ['to-monish-aastha-tanay-krishna-and', 'on-being-watched-being-warned-and'];

// her posts, newest first. `desc` is the description under each picture (her Substack subtitles for now).
// title/date/cover are the fallback if Substack can't be reached. `quote` stands in for a missing cover.
// `pic` is a different picture from inside the post, for posts whose cover is already used across the top of the left page.
const posts = [
  { slug: 'a-house-by-the-beach-someday', desc: 'a post card from Goa', title: 'A house by the beach, someday', date: '2026-10-20T09:20:23.602Z', words: 821, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/22851840-4fb3-40a3-8e5c-47cdf4798ccb_736x736.jpeg' },
  { slug: 'on-being-watched-being-warned-and', desc: 'Small rules, quiet costs, and one uncomfortable morning', title: 'On being watched, being warned, and never being asked', date: '2026-10-10T10:59:03.893Z', words: 1274, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/43338fa9-9fb3-43a1-bb64-4c89ad6477cb_1080x1349.jpeg' },
  { slug: 'love-is-usually-just-around-the-corner', pic: 'https://substack-post-media.s3.amazonaws.com/public/images/eac18482-2254-4a7d-b8ea-d8f9981510ea_914x775.jpeg', desc: 'but are you someone who won’t scare it away?', title: 'Love is usually just around the corner', date: '2026-08-15T10:07:58.364Z', words: 731, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/5d2fa710-31d8-4d0c-91de-b5783773b674_736x538.jpeg' },
  { slug: 'unthought-known', pic: 'https://substack-post-media.s3.amazonaws.com/public/images/a1d05e2d-d487-4d76-9f57-bb085f0238e6_1200x1200.jpeg', desc: 'Some things are known before they are ever thought. This is one of those stories.', title: 'Unthought known', date: '2026-07-02T14:50:30.012Z', words: 1075, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/bb1646bf-5cdd-4839-8308-b33d54c4d672_1584x396.png' },
  { slug: 'data-vs-instincts', desc: 'And why what you can see is not enough!', title: 'Data vs instincts', date: '2026-06-15T10:31:17.888Z', words: 1329, cover: '', quote: 'I defended first and answered after.' },
  { slug: 'was-he-a-fckboy', pic: 'https://substack-post-media.s3.amazonaws.com/public/images/6b54bb5d-a4b8-4d0b-9afb-f008eb81706d_1509x1795.jpeg', desc: 'On charm, damage, and the art of finally seeing them clearly', title: 'Was he a F*ckboy?', date: '2026-05-28T12:41:35.055Z', words: 862, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/4775d1f2-7a05-47ce-b211-73d7730dc316_1602x1190.jpeg' },
  { slug: 'gunshot-diary', pic: 'https://substack-post-media.s3.amazonaws.com/public/images/910cc456-35a5-4ef2-a5ed-09b4ce85719c_1535x1833.jpeg', desc: 'A story about an elongated sleepover with a stranger', title: 'Gunshot diary', date: '2026-03-27T11:40:06.497Z', words: 1474, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/ebc3dc39-5c4d-46f8-afe2-ad528a0a3e18_1170x892.png' },
  { slug: 'to-monish-aastha-tanay-krishna-and', desc: 'a postcard from Pondicherry 💌', title: 'to Monish, Aastha, Tanay, Krishna and others', date: '2025-09-01T08:39:02.886Z', words: 1509, cover: 'https://substack-post-media.s3.amazonaws.com/public/images/f22b8cdd-bec9-4e95-a8ec-6ff0ab7f0a4f_3912x2373.jpeg' }
];

// sentence-case titles for this page (the live Substack titles differ)
const TITLES: Record<string, string> = { 'love-is-usually-just-around-the-corner': 'Love is usually just around the corner', 'data-vs-instincts': 'Data vs instincts' };
// email open rate per post, from the Substack dashboard on 23 Nov 2026. Update by hand.
const OPEN: Record<string, number> = { 'a-house-by-the-beach-someday': 65, 'gunshot-diary': 71, 'unthought-known': 60, 'data-vs-instincts': 60, 'was-he-a-fckboy': 44, 'love-is-usually-just-around-the-corner': 50 };

// pull the live archive; if it fails, the list above is used
let live: any[] = [];
try {
  const r = await fetch(`${PUB}/api/v1/archive?sort=new&limit=50`, { signal: AbortSignal.timeout(8000) });
  if (r.ok) live = await r.json();
} catch {}
live = live.filter((l) => l && l.slug && l.type !== 'podcast');
const mine = new Map(posts.map((p) => [p.slug, p]));
const all: any[] = live.length
  ? live.map((l) => {
      const p: any = mine.get(l.slug) || {};
      return { ...p, slug: l.slug, title: TITLES[l.slug] || l.title || p.title, desc: p.desc || l.subtitle || '', date: l.post_date || p.date, words: l.wordcount || p.words, cover: l.cover_image || p.cover || '' };
    })
  : posts;

// covers come through Substack's image CDN at the size they're shown, not full size
const img = (url: string, w = 600) => !url ? '' : url.includes('substackcdn.com/image/fetch') ? url : `https://substackcdn.com/image/fetch/w_${w},c_limit,f_auto,q_auto:good,fl_progressive:steep/${encodeURIComponent(url)}`;
const href = (slug: string) => `${PUB}/p/${slug}?${UTM}`;
const mins = (w: number) => Math.max(1, Math.round(w / 215));
const meta = (p: any) => OPEN[p.slug] ? `Email open rate: ${OPEN[p.slug]}% ↗` : 'read on Substack ↗';
const top = TOP.map((s) => all.find((p) => p.slug === s)).filter(Boolean);

// three columns, filled top to bottom, newest first. pictures get uneven heights (weights) so the columns don't line up.
// the order on the right, filled column by column (two per column). new posts not listed here go first.
const ORDER = ['a-house-by-the-beach-someday', 'gunshot-diary', 'unthought-known', 'data-vs-instincts', 'was-he-a-fckboy', 'love-is-usually-just-around-the-corner'];
const rank = (slug: string) => { const i = ORDER.indexOf(slug); return i < 0 ? -1 : i; };
const shown = all.filter((p) => !HIDE.includes(p.slug)).sort((a, b) => rank(a.slug) - rank(b.slug));
const per = Math.ceil(shown.length / 3);
const weights = [[1.3, 0.9, 1.1], [0.8, 1.25, 1], [1.1, 1, 0.9]];
const cols = [0, 1, 2].map((c) => shown.slice(c * per, c * per + per).map((p, i) => ({ ...p, w: weights[c][i % 3] })));
