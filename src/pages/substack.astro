<script is:inline>
// the spread is zoomed to cover the window, like the desk (stops at 18% trimmed on unusual window shapes)
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82);document.querySelectorAll('.stage').forEach(function(st){st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';});}
addEventListener('resize',fit);fit();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
