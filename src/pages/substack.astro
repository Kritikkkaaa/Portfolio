<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kritika · i write on Substack.</title>
<meta name="description" content="Kritika's Substack, VeryKritikal: essays on love, living alone, work, and the places that change her a little.">
<link rel="stylesheet" href="/buttons.css">
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<link rel="icon" href="/mark-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/mark-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&amp;family=Marcellus&amp;family=Courier+Prime:ital,wght@0,400;0,700;1,400&amp;display=swap" rel="stylesheet">
<style is:inline>
html,body{margin:0;background:#f6f1e8;color:#3d2430;font-family:'Courier Prime',ui-monospace,monospace}
/* past the spread's edges (very wide or tall windows) each page carries on: jasmine on the left, ivory on the right */
@media (min-width: 768px){
  html{background:#f6f1e8}
  body{background:transparent}
  body::before{content:"";position:fixed;left:0;top:0;bottom:0;width:50%;z-index:-1;background:url(/desk/jasmine.jpg) center/cover no-repeat;transform:scaleX(-1);filter:saturate(.72) contrast(.9) brightness(1.03)}
}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.fold{position:relative;height:100vh;overflow:hidden}
.stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}
.pageL{background:linear-gradient(100deg,#ffffff 0%,#fbfbf9 38%,#ffffff 52%,#f6f6f3 78%,#e9e8e4 96%,#d9d7d2 100%)}
.pageR{background:linear-gradient(80deg,#d6d4cf 0%,#e8e7e3 4%,#f7f7f4 20%,#ffffff 46%,#fafaf8 70%,#ffffff 100%)}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.75) 42%,rgba(255,255,255,0) 54%)}
.back{position:absolute;left:64px;top:40px;z-index:3;min-height:40px;padding:8px 18px}


/* right page: quiet ivory. A small-caps heading in the engraved Roman style, then a short letter in the typewriter font */
.rcol{position:absolute;left:756px;top:0;width:756px;height:982px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;background:linear-gradient(180deg,#f9f5ed 0%,#f3ede2 100%);border-left:1px solid rgba(110,30,43,.16)}
.rtitle{margin:0 0 34px;display:flex;flex-direction:column;align-items:center;text-align:center;font-family:Cinzel,serif;text-transform:uppercase;color:#6E1E2B}
.rt-a{font-weight:600;font-size:20px;letter-spacing:.5em;margin-right:-.5em}
.rt-b{margin-top:12px;font-weight:500;font-size:78px;line-height:1;letter-spacing:.1em;margin-right:-.1em}
.rt-line{display:block;width:56px;height:1px;margin-top:28px;background:rgba(110,30,43,.45)}
.letter{width:480px;font-family:'Courier Prime',ui-monospace,monospace;font-size:18px;line-height:1.7;color:#3d2430}
.letter p{margin:0}
.letter p+p{margin-top:16px}
.letter .kbtn{display:flex;width:max-content;max-width:100%;margin:32px auto 0}
.letter .kbtn+.kbtn{margin-top:14px}

/* left page: three pictures set close together */
.trio{position:absolute;left:64px;top:96px;width:636px;height:420px;display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
.trio span{display:block;overflow:hidden;background:#efece6}
.trio img{width:100%;height:100%;object-fit:cover;display:block}
/* the giant initial, bleeding off the left edge, and the story beside it */
.cap{position:absolute;left:-150px;top:516px;margin:0;font-family:Geist,sans-serif;font-weight:600;font-size:500px;line-height:1;letter-spacing:-.04em;color:#1C1B1F;pointer-events:none}
.story{position:absolute;left:372px;top:574px;width:328px;margin:0;font-family:'EB Garamond',serif;font-size:17.5px;line-height:1.36;color:#1C1B1F;text-align:justify;hyphens:auto}
.story p,.m .mstory p{margin:0}
.story p+p,.m .mstory p+p{margin-top:14px}

/* right page: three columns, tall pictures of uneven height */
.cols{position:absolute;left:812px;top:56px;width:640px;height:880px;display:grid;grid-template-columns:repeat(3,1fr);gap:0 14px}
.col{display:flex;flex-direction:column;gap:36px;min-height:0}
.en{display:flex;flex-direction:column;min-height:0}
.en .pic{flex:1 1 0;min-height:60px;overflow:hidden;background:#efece6}
.en .pic img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
.en .pic.none{display:flex;align-items:center;padding:16px;box-sizing:border-box;background:#F3E4DC;font-family:'EB Garamond',serif;font-style:italic;font-size:22px;line-height:1.2;color:#A9452A}
.en:hover .pic img,.en:focus-visible .pic img{transform:scale(1.04)}
.en .t{display:block;margin-top:9px;font-family:Marcellus,Georgia,serif;font-weight:400;font-size:17px;line-height:1.25;color:#3d2430;transition:color .25s}
.en:hover .t,.en:focus-visible .t{color:#6E1E2B}
.en .d{display:block;margin-top:3px;font-size:12.5px;line-height:1.38;color:#6f6862}
.en .mt{display:block;margin-top:auto;padding-top:8px;font-size:11px;line-height:1.3;white-space:nowrap;letter-spacing:-.01em;color:#5f4d4d;opacity:.6}
  @media (max-width: 380px){.en .mt{font-size:10px}}
@media (prefers-reduced-motion: reduce){.en .pic img{transition:none}}


/* left page: her jasmine-tree photo, mirrored and softened so it stays calm; the posts sit
   on it in a grid, three across, each framed: a paper mat with an ink line around it in the story's colour */
.tree{position:absolute;left:0;top:0;width:756px;height:982px;overflow:hidden;isolation:isolate;background:#6f5a4a}
.tree .still{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scaleX(-1);filter:saturate(.72) contrast(.9) brightness(1.03)}
.tree::before{content:"";position:absolute;inset:0;z-index:1;background:radial-gradient(ellipse 72% 64% at 50% 52%,rgba(250,243,232,.62) 0%,rgba(250,243,232,.44) 50%,rgba(250,243,232,0) 100%);pointer-events:none}
.tree::after{content:"";position:absolute;inset:0;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.12}
.leaves{position:absolute;left:68px;top:0;width:620px;height:982px;display:grid;grid-template-columns:repeat(3,1fr);align-content:center;gap:30px 28px}
.leaf{position:relative;display:flex;flex-direction:column;box-sizing:border-box;padding:6px 6px 12px;background:#faf6ee;box-shadow:0 1px 2px rgba(20,12,6,.18),0 10px 22px rgba(20,12,6,.2)}
.leaf .pic{display:block;aspect-ratio:4/5;overflow:hidden;background:#efe7d8}
.leaf img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.92) contrast(.98);transition:transform .8s cubic-bezier(.2,.7,.2,1);clip-path:inset(0)}
.leaf .pic.none{display:flex;align-items:center;padding:16px;box-sizing:border-box;background:#efe6da;font-family:'Courier Prime',ui-monospace,monospace;font-style:italic;font-size:17px;line-height:1.4;color:#6E1E2B}
.leaf .lt{display:block;margin-top:10px;padding:0 4px;font-family:Marcellus,Georgia,serif;font-weight:400;font-size:17.5px;line-height:1.25;color:#3d2430;transition:color .25s}
.leaf .lm{display:block;margin-top:auto;padding:12px 4px 0;font-size:12.5px;line-height:1.3;color:#5f4d4d;opacity:.6}
.leaf:hover img,.leaf:focus-visible img{transform:scale(1.03)}
.leaf:hover .lt,.leaf:focus-visible .lt{color:#6E1E2B}
@media (prefers-reduced-motion: reduce){.leaf img{transition:none}}

/* phones: one column */
.m{display:none}
@media (max-width: 767px){
  .fold{display:none}
  body{background:#f6f1e8}
  .m{display:block;padding:0 16px 40px;box-sizing:border-box}
  .m .mhero{margin:0 -16px;min-height:100svh;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:max(16px,env(safe-area-inset-top)) 22px 48px;background:linear-gradient(180deg,#f9f5ed 0%,#f3ede2 100%);position:relative}
  .m .mhero .back{position:absolute;left:16px;top:max(16px,env(safe-area-inset-top));min-height:40px;padding:8px 14px;box-sizing:border-box}
  .m .rtitle{margin:56px 0 28px}
  .m .rt-a{font-size:14px;letter-spacing:.42em;margin-right:-.42em}
  .m .rt-b{font-size:40px;letter-spacing:.08em;margin-right:-.08em;margin-top:10px}
  .m .rt-line{margin-top:22px}
  .m .letter{width:100%;max-width:420px;font-size:16px;line-height:1.65}
  .m .trio{position:static;width:auto;height:240px;margin-top:12px;gap:4px}
  .m .mstory{position:relative;margin-top:0;font-family:'EB Garamond',serif;font-size:18px;line-height:1.42;color:#1C1B1F}
  .m .mstory .big{float:left;margin:-2px 10px 0 -4px;font-family:Geist,sans-serif;font-weight:600;font-size:118px;line-height:.78;letter-spacing:-.04em}
  /* the posts: pictures only, two across, printed flat on the jasmine tree like on the laptop */
  .m .list{position:relative;display:grid;grid-template-columns:repeat(2,1fr);align-content:center;gap:18px 14px;min-height:100svh;box-sizing:border-box;margin:0 -16px -40px;padding:40px 22px max(40px,env(safe-area-inset-bottom));background:#f3eee6;isolation:isolate}
  .m .list::after{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse 85% 70% at 50% 50%,rgba(250,243,232,.6) 0%,rgba(250,243,232,.42) 55%,rgba(250,243,232,0) 100%)}
  .m .list::before{content:"";position:absolute;inset:0;z-index:-1;background:url(/desk/jasmine.jpg) center/cover no-repeat;transform:scaleX(-1);filter:saturate(.72) contrast(.9) brightness(1.03)}
  .m .en{-webkit-tap-highlight-color:transparent;transition:opacity .15s ease}
  .m .en:active{opacity:.8}
  .m .en{background:#f2eadf;padding:6px 6px 10px;box-shadow:0 2px 4px rgba(20,12,6,.25),0 14px 28px rgba(20,12,6,.38)}
  .m .en .pic{flex:none;aspect-ratio:4/5;overflow:hidden;background:#efe7d8}
  .m .en .t,.m .en .mt{padding:0 3px}
  .m .en .pic img{clip-path:inset(0)}
  .m .en .pic.none{aspect-ratio:4/5;padding:12px;font-size:15px}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold" aria-label="i write on Substack">
<div class="stage">
<div class="tree" aria-hidden="true"><img class="still" src="/desk/jasmine.jpg" alt=""></div>
<a class="back kbtn" href="/home">← Back</a>
<div class="rcol">
