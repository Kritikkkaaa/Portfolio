<style is:inline>
html,body{margin:0;background:#fff;color:#1C1B1F;font-family:'Hanken Grotesk',sans-serif}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid #5B3FD9;outline-offset:4px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.fold{position:relative;height:100vh;overflow:hidden}
.stage{position:absolute;left:0;top:0;width:1512px;height:982px;transform-origin:0 0}
.pageL{background:linear-gradient(100deg,#ffffff 0%,#fbfbf9 38%,#ffffff 52%,#f6f6f3 78%,#e9e8e4 96%,#d9d7d2 100%)}
.pageR{background:linear-gradient(80deg,#d6d4cf 0%,#e8e7e3 4%,#f7f7f4 20%,#ffffff 46%,#fafaf8 70%,#ffffff 100%)}
.sheen{background:linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.75) 42%,rgba(255,255,255,0) 54%)}
.grain{position:absolute;inset:0;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.14;pointer-events:none}
.back{position:absolute;left:64px;top:40px;padding:6px 0;font-size:15px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}


/* right page: pink paper, and a typewriter at the foot of it; her story is typed onto the sheet in the roller */
.lphoto{position:absolute;left:756px;top:0;width:756px;height:982px;background:#d9a3a3 url(/desk/pink-paper.jpg) center/cover no-repeat}
.rcol{position:absolute;left:756px;top:0;width:756px;height:982px;display:flex;flex-direction:column;align-items:center;justify-content:space-between}
.rtitle{margin:52px 0 0;font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600;font-size:72px;line-height:1;letter-spacing:-.01em;color:#9C2F55}
.tw{position:relative;width:560px;filter:drop-shadow(0 18px 30px rgba(80,30,40,.28))}
.tw-sheet{position:relative;margin-left:16%;width:66.4%;box-sizing:border-box;padding:34px;background:#f2eadf;border-top-left-radius:26px 12px;font-family:'Courier Prime',ui-monospace,monospace;font-size:13.4px;line-height:1.62;color:#2a2420;text-shadow:0 0 .5px rgba(42,36,32,.55)}
.tw-sheet p{margin:0}
.tw-sheet p+p{margin-top:12px}
.tw-base{display:block;width:100%;height:auto;margin-top:-2px}
.tw-sheet .cta{position:static;display:block;margin-top:18px;padding:0;text-align:right;font-family:inherit;font-size:inherit;font-weight:700;color:#2a2420;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px;opacity:0;transition:opacity .5s ease}
.tw-sheet.done .cta{opacity:1}
.tw-sheet.now .cta{transition:none}
.tw-sheet .w{white-space:nowrap}
.tw-sheet .k{visibility:hidden}
.tw-sheet .k.on{visibility:visible}
.caret{display:inline-block;width:.55em;height:1.05em;margin-left:1px;vertical-align:-.15em;background:#2a2420;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
/* Back: a small paper tag in the typed font, framed in the same ink as the pictures */
.back{z-index:3;left:64px !important;top:36px !important;display:inline-flex;align-items:center;gap:8px;padding:7px 14px 7px 12px !important;background:#f2eadf;color:#2a2420 !important;font-family:'Courier Prime',ui-monospace,monospace !important;font-size:14px !important;font-weight:700;letter-spacing:.02em;text-decoration:none !important;outline:2px solid #2a2420;box-shadow:3px 3px 0 #2a2420;transform:rotate(-2deg);transition:transform .2s ease,box-shadow .2s ease}
.back:hover,.back:focus-visible{transform:rotate(-2deg) translate(-1px,-1px);box-shadow:4px 4px 0 #2a2420}
.back:active{transform:rotate(-2deg) translate(2px,2px);box-shadow:1px 1px 0 #2a2420}
@media (prefers-reduced-motion: reduce){.caret{animation:none}.back{transition:none}}

/* left page: three pictures set close together */
.trio{position:absolute;left:64px;top:96px;width:636px;height:420px;display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
.trio span{display:block;overflow:hidden;background:#efece6}
.trio img{width:100%;height:100%;object-fit:cover;display:block}
/* the giant initial, bleeding off the left edge, and the story beside it */
.cap{position:absolute;left:-150px;top:516px;margin:0;font-family:Geist,sans-serif;font-weight:600;font-size:500px;line-height:1;letter-spacing:-.04em;color:#1C1B1F;pointer-events:none}
.cta{position:absolute;left:372px;padding:6px 0;font-family:Geist,sans-serif;font-weight:500;font-size:16px;color:#A9452A;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px;transition:color .25s}
.cta:hover,.cta:focus-visible{color:#8E3820}
.story{position:absolute;left:372px;top:574px;width:328px;margin:0;font-family:'EB Garamond',serif;font-size:17.5px;line-height:1.36;color:#1C1B1F;text-align:justify;hyphens:auto}
.story p,.m .mstory p{margin:0}
.story p+p,.m .mstory p+p{margin-top:14px}

/* right page: three columns, tall pictures of uneven height */
.cols{position:absolute;left:812px;top:56px;width:640px;height:880px;display:grid;grid-template-columns:repeat(3,1fr);gap:0 14px}
.col{display:flex;flex-direction:column;gap:36px;min-height:0}
.en{display:flex;flex-direction:column;min-height:0}
.en .pic{flex:1 1 0;min-height:60px;overflow:hidden;background:#efece6}
.en .pic img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
.en .pic.none{display:flex;align-items:center;padding:16px;box-sizing:border-box;background:#F3E4DC;font-family:'EB Garamond',serif;font-style:italic;font-size:22px;line-height:1.2;color:#A9452A}
.en:hover .pic img,.en:focus-visible .pic img{transform:scale(1.04)}
.en .t{display:block;margin-top:9px;font-family:Geist,sans-serif;font-weight:500;font-size:14.5px;line-height:1.25;color:#1C1B1F;transition:color .25s}
.en:hover .t,.en:focus-visible .t{color:#A9452A}
.en .d{display:block;margin-top:3px;font-size:12.5px;line-height:1.38;color:#6f6862}
.en .mt{display:block;margin-top:5px;font-size:10px;letter-spacing:.18em;color:#8a837d}
@media (prefers-reduced-motion: reduce){.en .pic img{transition:none}}


/* left page: her jasmine-tree photo, mirrored and softened so it stays calm; the posts sit
   on it in a grid, three across, each framed: a paper mat with an ink line around it in the story's colour */
.tree{position:absolute;left:0;top:0;width:756px;height:982px;overflow:hidden;background:#6f5a4a}
.tree .still{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scaleX(-1);filter:saturate(.72) contrast(.9) brightness(1.03)}
.tree::after{content:"";position:absolute;inset:0;background:url(/desk/paper.jpg);background-size:900px auto;mix-blend-mode:multiply;opacity:.12}
.leaves{position:absolute;left:68px;top:0;width:620px;height:982px;display:grid;grid-template-columns:repeat(3,1fr);align-content:center;gap:30px 28px}
.leaf{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;background:#efe7d8}
.leaf img{position:relative}
.leaf > *{overflow:hidden}
.leaf img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.92) contrast(.98);transition:transform .8s cubic-bezier(.2,.7,.2,1);clip-path:inset(0)}
.leaf.none{display:flex;align-items:center;padding:16px;box-sizing:border-box;background:#F3E4DC;font-family:'EB Garamond',serif;font-style:italic;font-size:20px;line-height:1.2;color:#A9452A}
.leaf:hover img,.leaf:focus-visible img{transform:scale(1.03)}
@media (prefers-reduced-motion: reduce){.leaf img{transition:none}}

/* phones: one column */
.m{display:none}
@media (max-width: 767px){
  .fold{display:none}
  body{background:#fbfaf7}
  .m{display:block;padding:0 16px 40px;box-sizing:border-box}
  .m .mhero{margin:0 -16px;padding:max(16px,env(safe-area-inset-top)) 16px 0;background:#d9a3a3 url(/desk/pink-paper.jpg) center/cover no-repeat;overflow:hidden}
  .m .mhero .back{position:relative;display:inline-flex;min-height:40px;box-sizing:border-box;margin:6px 0 0 4px}
  /* the typewriter: the sheet is a real block (so the whole story fits), sitting in the roller of the machine below */
  .m .rtitle{margin:18px 0 0;font-size:48px}
  .m .tw-m{position:relative;margin:22px -16px 0;filter:drop-shadow(0 14px 22px rgba(80,30,40,.25))}
  .m .tw-sheet{position:relative;margin-left:16%;width:66.4%;box-sizing:border-box;padding:20px;background:#f2eadf;border-top-left-radius:22px 10px;font-family:'Courier Prime',ui-monospace,monospace;font-size:13.5px;line-height:1.6;color:#2a2420}
  .m .tw-sheet p{margin:0}
  .m .tw-sheet p+p{margin-top:12px}
  .m .tw-base{display:block;width:100%;height:auto;margin-top:-2px}
  .m .back{position:static;display:inline-block;min-height:32px}
  .m .trio{position:static;width:auto;height:240px;margin-top:12px;gap:4px}
  .m .mstory{position:relative;margin-top:0;font-family:'EB Garamond',serif;font-size:18px;line-height:1.42;color:#1C1B1F}
  .m .mstory .big{float:left;margin:-2px 10px 0 -4px;font-family:Geist,sans-serif;font-weight:600;font-size:118px;line-height:.78;letter-spacing:-.04em}
  .m .cta{position:static;display:inline-block;margin-top:14px}
  /* the posts: pictures only, two across, printed flat on the jasmine tree like on the laptop */
  .m .list{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:20px 18px;margin:0 -16px -40px;padding:28px 16px 44px;background:#f3eee6;isolation:isolate}
  .m .list::before{content:"";position:absolute;inset:0;z-index:-1;background:url(/desk/jasmine.jpg) center/cover no-repeat;transform:scaleX(-1);filter:saturate(.72) contrast(.9) brightness(1.03)}
  .m .en{-webkit-tap-highlight-color:transparent;transition:opacity .15s ease}
  .m .en:active{opacity:.8}
  .m .en .pic{flex:none;aspect-ratio:4/5;overflow:hidden;background:#efe7d8}
  .m .en .pic img{clip-path:inset(0)}
  .m .en .pic.none{aspect-ratio:4/5;font-size:18px}
}
.cb-yes,.cb-no{min-height:40px;padding:0 20px;border-radius:10px;font-family:inherit;font-size:14px;cursor:pointer}
.cb-yes{border:0;background:#E8EBF0;color:#0B0A0F;font-weight:600}
.cb-no{background:none;border:1px solid #3A3842;color:#E8EBF0}
</style>
<Analytics />
</head>
<body>
<section class="fold" aria-label="i write on Substack">
<div class="stage">
<div class="tree" aria-hidden="true"><img class="still" src="/desk/jasmine.jpg" alt=""></div>
<div class="lphoto" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>
<a class="back" href="/home-redo#desk">Back</a>
<div class="rcol">
<h1 class="rtitle">i write on Substack.</h1>
<div class="tw">
<div class="tw-sheet" data-type>
{STORY.map((t) => <p>{t}</p>)}
<a class="cta" href={CTA_HREF}>{CTA}</a>
</div>
<img class="tw-base" src="/desk/typewriter-base.png" alt="" aria-hidden="true">
</div>
</div>

<div class="leaves">
{shown.map((p) => (
<a class={`leaf${(p.pic || p.cover) ? '' : ' none'}`} href={href(p.slug)} target="_blank" rel="noopener" aria-label={p.title} title={p.title}>
{(p.pic || p.cover) ? <img src={img(p.pic || p.cover, 500)} alt="" loading="lazy"> : `“${p.quote || p.title}”`}
</a>
))}
</div>
</div>
</div>
</section>

<main class="m">
<div class="mhero">
<a class="back" href="/home-redo#desk">Back</a>
<h1 class="rtitle">i write on Substack.</h1>
<div class="tw-m">
<div class="tw-sheet" data-type>
{STORY.map((t) => <p>{t}</p>)}
<a class="cta" href={CTA_HREF}>{CTA}</a>
</div>
<img class="tw-base" src="/desk/typewriter-base.png" alt="" aria-hidden="true">
</div>
</div>
<div class="list">
{shown.map((p) => (
<a class="en" href={href(p.slug)} target="_blank" rel="noopener" aria-label={p.title}>
{(p.pic || p.cover)
  ? <span class="pic"><img src={img(p.pic || p.cover)} alt="" loading="lazy"></span>
  : <span class="pic none">“{p.quote || p.title}”</span>}
</a>
))}
</div>
</main>

<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="cb-yes" type="button" data-consent="yes">Yes!</button>
<button class="cb-no" type="button" data-consent="no">No thanks</button>
</div>
</div>

<script is:inline>
// the spread is zoomed to cover the window, like the desk (stops at 18% trimmed on unusual window shapes)
function fit(){var a=innerWidth/1512,b=innerHeight/982,lo=Math.min(a,b),s=Math.min(Math.max(a,b),lo/0.82);document.querySelectorAll('.stage').forEach(function(st){st.style.transform='scale('+s+')';st.style.left=((innerWidth-1512*s)/2)+'px';st.style.top=((innerHeight-982*s)*0.4)+'px';});}
addEventListener('resize',fit);fit();
// the story types itself onto the sheet, letter by letter, once per visit; then the link appears
(function(){
  var el=[].slice.call(document.querySelectorAll('[data-type]')).filter(function(n){return n.offsetParent!==null})[0];
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce)document.querySelectorAll('.tree video').forEach(function(v){v.pause();v.removeAttribute('autoplay');});
  if(!el)return;
  var seen=false;try{seen=sessionStorage.getItem('substack-typed')==='1'}catch(e){}
  if(seen||reduce){el.classList.add('done','now');return;}
  var ks=[];
  el.querySelectorAll('p').forEach(function(p){
    var text=p.textContent;p.textContent='';
    text.split(' ').forEach(function(word,i,all){
      var w=document.createElement('span');w.className='w';
      for(var j=0;j<word.length;j++){var k=document.createElement('span');k.className='k';k.textContent=word[j];w.appendChild(k);ks.push(k);}
      p.appendChild(w);if(i<all.length-1)p.appendChild(document.createTextNode(' '));
    });
  });
  var caret=document.createElement('span');caret.className='caret';caret.setAttribute('aria-hidden','true');
  var i=0;
  function step(){
    if(i>=ks.length){el.classList.add('done');setTimeout(function(){caret.remove();},2400);try{sessionStorage.setItem('substack-typed','1')}catch(e){}return;}
    var k=ks[i++];k.classList.add('on');k.after(caret);
    setTimeout(step,/[.,!?]/.test(k.textContent)?240:26+Math.random()*30);
  }
  setTimeout(step,800);
})();
</script>
<script is:inline src="/kritikal-cursor.js" defer></script>
</body>
</html>
