<main class="m">
<div class="mhero">
<a class="back kbtn" href="/home">← Back</a>
<h1 class="rtitle"><span class="rt-a">i write on</span><span class="rt-b">Substack</span><span class="rt-line" aria-hidden="true"></span></h1>
<div class="letter">
{STORY.map((t) => <p>{t}</p>)}
