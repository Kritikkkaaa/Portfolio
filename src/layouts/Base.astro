---
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
interface Props { title?: string; description?: string }
const {
  title = 'Kritika Upadhyay · marketer, product manager, storyteller',
  description = 'Kritika Upadhyay grew up in product startups: marketing, product, content and support. Work owned, shipped and measured.'
} = Astro.props;
// PostHog project API key (starts with phc_). It is public by design, so it lives here.
const POSTHOG_KEY = 'phc_BFiZuYUpQZmTD4cszQZUZNj3BzE7329cJfn97dwvB5s6';
const POSTHOG_HOST = 'https://us.i.posthog.com'; // use https://eu.i.posthog.com for an EU project
// Google Analytics 4 measurement ID (starts with G-).
const GA_ID = 'G-RZWTH5REJH';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta name="theme-color" content="#080808">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Commissioner:wght@400;500;600;700&family=Kalam:wght@300&display=swap" rel="stylesheet">
<script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST, GA_ID }}>
  // Small wrapper so private browsing or blocked storage never breaks the page.
  const store = {
    get: (k) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k, v) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} }
  };

  // Your own visits: open the site once with ?notrack=on on each device and browser you use
  // (?notrack=off undoes it). That browser then loads no analytics at all.
  const flag = new URLSearchParams(location.search).get('notrack');
  if (flag === 'on') store.set('kt-notrack', '1');
  if (flag === 'off') store.set('kt-notrack', null);

  // Analytics never run on localhost or for your own visits, so neither shows up in the numbers.
  const live = !/^(localhost|127\.0\.0\.1)$/.test(location.hostname) && store.get('kt-notrack') !== '1';

  // Consent: visitors in EU/UK time zones are asked first; until they agree, nothing is stored
  // on their device and session recording stays off. Everyone else is tracked as before.
  const askFirst = /^Europe\//.test(Intl.DateTimeFormat().resolvedOptions().timeZone || '');
  const choice = store.get('kt-consent');
  const allowed = !askFirst || choice === 'yes';

  // Google Analytics 4 (gtag.js), the tag from GA's setup screen.
  if (GA_ID && live) {
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('consent', 'default', {
      analytics_storage: allowed ? 'granted' : 'denied',
      ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied'
    });
    gtag('js', new Date());
    gtag('config', GA_ID);
  }

  // PostHog SDK, loaded with the official snippet. Off until a key is set.
  if (POSTHOG_KEY && live) {
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags on onFeatureFlags onSessionId identify setPersonProperties group resetGroups reset get_distinct_id get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording captureException get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    posthog.init(POSTHOG_KEY, {
      api_host: POSTHOG_HOST,
      person_profiles: 'identified_only',
      persistence: allowed ? 'localStorage+cookie' : 'memory',
      disable_session_recording: !allowed
    });
  }

  // The banner (in the page body) only appears for visitors who haven't chosen yet.
  if (live && askFirst && !choice) {
    document.addEventListener('DOMContentLoaded', () => {
      const banner = document.getElementById('consent');
      if (!banner) return;
      banner.hidden = false;
      banner.addEventListener('click', (e) => {
        const btn = e.target instanceof Element ? e.target.closest('[data-consent]') : null;
        if (!btn) return;
        const yes = btn.dataset.consent === 'yes';
        store.set('kt-consent', yes ? 'yes' : 'no');
        if (yes && window.gtag) gtag('consent', 'update', { analytics_storage: 'granted' });
        if (yes && window.posthog) {
          posthog.set_config({ persistence: 'localStorage+cookie' });
          posthog.startSessionRecording();
        }
        banner.hidden = true;
      });
    });
  }

  // Named events for the moments that matter, sent to both tools.
  // GA4 wants snake_case names, so 'case study opened' arrives there as case_study_opened.
  const track = (name, props) => {
    if (window.posthog) posthog.capture(name, props);
    if (window.gtag) gtag('event', name.replace(/ /g, '_'), props);
  };
  if (live) {
    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (!el) return;
      const card = el.closest('.sp-card');
      if (card) return track('case study opened', { card: card.dataset.card, title: card.dataset.title });
      if (el.closest('#orb')) return track('crystal ball touched');
      const a = el.closest('a[href]');
      if (!a) return;
      const label = (a.getAttribute('aria-label') || a.textContent || '').trim();
      if (a.hasAttribute('download') || /resume/i.test(a.href)) return track('resume downloaded');
      if (a.hostname && a.hostname !== location.hostname) track('outbound link clicked', { url: a.href, label });
    });
  }
</script>
</head>
<body>
<div class="sky" style="background: #080808; color: #EFEFEE; font-family: 'Commissioner', system-ui, sans-serif; font-size: 17px; line-height: 1.7; min-height: 100vh; position: relative; overflow: clip">
<slot />
</div>
<div id="consent" role="dialog" aria-label="Cookie choice" hidden style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 55; max-width: 360px; box-sizing: border-box; padding: 18px 20px; border-radius: 16px; background: #141319; border: 1px solid #3A3842; box-shadow: 0 20px 50px rgba(0,0,0,0.6); font-family: 'Commissioner', system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #C9CDD5">
<p style="margin: 0 0 14px">Allow cookies on your visit so I know what you resonate with. No ads, I promise.</p>
<div style="display: flex; gap: 10px">
<button class="ft-primary" type="button" data-consent="yes" style="min-height: 40px; padding: 0 20px; border: 0; font-family: inherit; font-size: 14px; cursor: pointer">Yes!</button>
<button class="ft-secondary" type="button" data-consent="no" style="min-height: 40px; padding: 0 18px; background: none; font-family: inherit; font-size: 14px; cursor: pointer">No thanks</button>
</div>
</div>
<Cursor />
</body>
</html>
