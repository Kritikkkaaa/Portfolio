---
// Third fold: typing heading, the two exits, the coffee-card deck, constellation socials and the hairline row.
import moon from '../parts/dkmoon.html?raw';
const closed = [-16, -8, 0, 8, 16];
const LINKEDIN = 'https://linkedin.com/in/kritika-upadhyay-2001';
const RESUME = '#resume'; // TODO: replace with '/resume.pdf' once the PDF is in /public
const INSTAGRAM = '#instagram'; // TODO: your Instagram profile link
const TWITTER = '#twitter'; // TODO: your Twitter (X) profile link
const SUBSTACK = 'https://substack.com/@verykritikal/posts';
---
<footer style="position: relative; min-height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; background-color: #0B0A0F; color: #E8EBF0; font-family: 'Inter', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

<div style="flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 36px; padding: 100px 24px 60px; text-align: center">
<h2 style="margin: 0; max-width: 1180px; font-weight: 500; font-size: clamp(30px, 4vw, 56px); line-height: 1.1; letter-spacing: -0.02em; text-wrap: balance">Let's get coffee. <span class="tw" style="font-family: 'Newsreader', serif; font-weight: 400; font-style: italic; letter-spacing: 0"><span class="tw-sizer" aria-hidden="true">I will bring the cards!</span><span class="tw-live" aria-hidden="true"><span id="tw-text"></span><span class="caret"></span></span><span class="sr-only">I will bring the cards!</span></span></h2>

<div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px">
<a class="ft-primary" href={LINKEDIN} target="_blank" rel="noopener">Connect on LinkedIn<span aria-hidden="true">↗</span></a>
<a class="ft-secondary" href={RESUME} download="">Download résumé<span aria-hidden="true">↓</span></a>
</div>

<div class="deck" id="deck">
{closed.map((a, i) => (
<button class="dk-card" type="button" aria-label={`Draw card ${i + 1} of 5`} aria-pressed="false" data-i={i} style={`transform: rotate(${a}deg); z-index: ${i + 1}`}>
<span class="dk-inner" style={`animation-delay: ${(-i * 0.6).toFixed(1)}s`}>
<span class="dk-face"><span class="dk-frame" set:html={moon}></span></span>
<span class="dk-face dk-back"><span class="dk-frame" style="flex-direction: column; gap: 8px; padding: 10px 9px; text-align: center"><span style="font-size: 8px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #D8C9A3">your coffee card</span><span class="dk-fortune" style="font-family: 'Newsreader', serif; font-style: italic; font-size: 13px; line-height: 1.25; color: #E8EBF0"></span><span class="dk-close" style="position: absolute; left: 0; right: 0; bottom: 12px; font-size: 8px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #A9AFB9">close ×</span></span></span>
</span>
</button>
))}
</div>
<div id="deck-hint" aria-live="polite" style="min-height: 22px; margin-top: -14px; font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: #8A8D96">pick a card</div>
</div>

<div style="display: flex; justify-content: center; padding: 0 24px 30px">
<nav class="const" aria-label="Elsewhere">
<svg class="lines" aria-hidden="true" width="260" height="64" viewBox="0 0 260 64"><path class="cline" d="M40 40 L130 18 L220 40" fill="none"></path><path class="cline" d="M40 40 L8 56 M220 40 L252 54 M130 18 L150 2" fill="none"></path><circle class="cdot" cx="8" cy="56" r="1.6"></circle><circle class="cdot" cx="252" cy="54" r="1.6"></circle><circle class="cdot" cx="150" cy="2" r="1.4"></circle></svg>
<a class="ft-icon" href={INSTAGRAM} aria-label="Instagram" title="Instagram" style="left: 40px; top: 40px"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="0.6"></circle></svg></a>
<a class="ft-icon" href={TWITTER} aria-label="Twitter (X)" title="Twitter (X)" style="left: 130px; top: 18px"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4 L20 20 M20 4 L4 20"></path></svg></a>
<a class="ft-icon" href={SUBSTACK} target="_blank" rel="noopener" aria-label="Substack" title="Substack" style="left: 220px; top: 40px"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4 H19 M5 8 H19 M5 12 H19 V21 L12 17 L5 21 Z"></path></svg></a>
</nav>
</div>

<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin: 0 auto; width: 100%; max-width: 1180px; box-sizing: border-box; padding: 18px 24px 26px; border-top: 1px solid #222128; font-size: 13px; color: #8A8D96">
<div style="display: flex; align-items: center; gap: 10px">
<svg class="ft-seer" aria-hidden="true" width="26" height="26" viewBox="0 0 200 200" style="overflow: visible"><path class="seer-star" fill="#E8EBF0" d="M104 4 C114 66 142 88 196 104 C134 114 112 142 96 196 C86 134 58 112 4 96 C66 86 88 58 104 4 Z"></path><g class="seer-lid"><path fill="#0B0A0F" d="M58 100 C86 68 114 68 142 100 C114 132 86 132 58 100 Z"></path><circle cx="100" cy="100" r="15" fill="#E8EBF0"></circle><circle cx="106.5" cy="96.5" r="12.4" fill="#0B0A0F"></circle></g></svg>
<span style="font-family: 'Newsreader', serif; font-style: italic; font-size: 16px; color: #A9AFB9">cards never lie.</span>
</div>
<div style="display: flex; align-items: center; gap: 8px">
<span>Made with love on Claude Code</span>
<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24"><path fill="#D8C9A3" d="M12 0 C12.9 7.6 16.4 11.1 24 12 C16.4 12.9 12.9 16.4 12 24 C11.1 16.4 7.6 12.9 0 12 C7.6 11.1 11.1 7.6 12 0 Z"></path></svg>
</div>
</div>

</footer>

<script>
  // Typing heading: types, rests ~6s, erases, repeats.
  const full = 'I will bring the cards!';
  const tw = document.getElementById('tw-text') as HTMLElement;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tw.textContent = full;
  } else {
    let n = 0, dir = 1;
    const step = () => {
      let wait: number;
      if (dir === 1) {
        if (n < full.length) { n++; wait = 70 + Math.random() * 60; } else { dir = -1; wait = 6000; }
      } else {
        if (n > 0) { n--; wait = 35; } else { dir = 1; wait = 700; }
      }
      tw.textContent = full.slice(0, n);
      setTimeout(step, wait);
    };
    setTimeout(step, 600);
  }

  // The coffee-card deck.
  const F = [
    'you will leave with one GTM idea you did not walk in with.',
    'your best feature is hiding three clicks deep.',
    'the right people are closer than your funnel thinks.',
    'a launch you are planning needs a better first sentence.',
    'someone on your team already knows the answer. ask them.'
  ];
  const deck = document.getElementById('deck') as HTMLElement;
  const hint = document.getElementById('deck-hint') as HTMLElement;
  const cards = Array.from(deck.querySelectorAll<HTMLButtonElement>('.dk-card'));
  const fortunes = Array.from(deck.querySelectorAll<HTMLElement>('.dk-fortune'));
  const closed = [-16, -8, 0, 8, 16];
  const opened = [-30, -15, 0, 15, 30];
  let fan = false, drawn = -1, f = 0;
  const render = () => {
    deck.classList.toggle('has', drawn >= 0);
    hint.textContent = drawn >= 0 ? '' : 'pick a card';
    fortunes.forEach((el) => { el.textContent = F[f]; });
    cards.forEach((c, i) => {
      const isDrawn = drawn === i;
      const ang = isDrawn ? 0 : (fan || drawn >= 0 ? opened[i] : closed[i]);
      c.style.transform = isDrawn ? 'translateY(-10px) rotate(0deg) scale(1.3)' : `rotate(${ang}deg)`;
      c.style.zIndex = String(isDrawn ? 10 : i + 1);
      c.classList.toggle('drawn', isDrawn);
      c.setAttribute('aria-pressed', String(isDrawn));
      c.setAttribute('aria-label', isDrawn ? `Your coffee card: ${F[f]} Close` : `Draw card ${i + 1} of 5`);
    });
  };
  deck.addEventListener('mouseenter', () => { fan = true; render(); });
  deck.addEventListener('mouseleave', () => { fan = false; render(); });
  cards.forEach((c, i) => c.addEventListener('click', () => {
    if (drawn === i) { drawn = -1; render(); return; }
    let next = Math.floor(Math.random() * F.length);
    if (next === f) next = (next + 1) % F.length;
    f = next; drawn = i;
    render();
  }));
  render();
</script>
